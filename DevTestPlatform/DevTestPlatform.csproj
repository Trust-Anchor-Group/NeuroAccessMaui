<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DevTestPlatform</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>NeuroAccess Dev Test Platform</ApplicationTitle>
    <ApplicationId>com.tag.neuroaccess.devtestplatform</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\devstorybook.svg" ForegroundFile="Resources\AppIcon\devstorybookfg.svg" BaseSize="512,512" ForegroundScale="0.60" Color="#181F25" />
    <MauiSplashScreen Include="Resources\Splash\devstorybook_splash.svg" Color="#181F25" BaseSize="160,160" />
    <PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
    <ProjectReference Include="..\NeuroAccessMaui\NeuroAccessMaui.csproj" AdditionalProperties="StorybookReferenceBuild=true;OutputType=Library;IntermediateOutputPath=obj\DevTestPlatformReference\;OutputPath=bin\DevTestPlatformReference\" />
  </ItemGroup>
  <Target Name="KeepDeveloperApplicationArtwork" AfterTargets="ResizetizeCollectItems" BeforeTargets="Resizetize">
    <ItemGroup>
      <MauiIcon Remove="@(MauiIcon)" Condition="'%(MauiIcon.Filename)' != 'devstorybook'" />
      <MauiImage Remove="@(MauiImage)" Condition="'%(MauiImage.IsAppIcon)' == 'True' and '%(MauiImage.Filename)' != 'devstorybook'" />
      <MauiSplashScreen Remove="@(MauiSplashScreen)" Condition="'%(MauiSplashScreen.Filename)' != 'devstorybook_splash'" />
    </ItemGroup>
  </Target>
</Project>
