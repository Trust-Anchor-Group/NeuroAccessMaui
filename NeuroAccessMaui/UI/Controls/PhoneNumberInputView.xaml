<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="NeuroAccessMaui.UI.Controls.PhoneNumberInputView"
             x:Name="ThisControl"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <Entry x:Name="PhoneEntry"
           VerticalOptions="Center"
           IsEnabled="{Binding IsInputEnabled, Source={x:Reference ThisControl}}"
           IsReadOnly="{Binding IsReadOnly, Source={x:Reference ThisControl}}"
           IsSpellCheckEnabled="False"
           Keyboard="Telephone"
           Text="{Binding PhoneNumber, Source={x:Reference ThisControl}, Mode=TwoWay}"
           AutomationId="input_phone_number">
        <Entry.Behaviors>
            <mct:MultiValidationBehavior Flags="ValidateOnValueChanged">
                <mct:CharactersValidationBehavior IsValid="{Binding TypeIsValid, Source={x:Reference ThisControl}, Mode=TwoWay}"
                                                  RegexPattern="^\d*$" />
                <mct:TextValidationBehavior IsValid="{Binding LengthIsValid, Source={x:Reference ThisControl}, Mode=TwoWay}"
                                            RegexPattern="^$|^\d{4,}$" />
            </mct:MultiValidationBehavior>
        </Entry.Behaviors>
    </Entry>
</ContentView>
