<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.Views.TokenStateMachineView"
			 x:DataType="viewmodel:TokenDetailsViewModel"
			 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
			 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
			 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails">
	<!-- The state machine's sections: its variables, the commands that apply now, and its reports. The current state
		 itself is a chip in the hero. -->
	<VerticalStackLayout>

		<!-- Flow: the step the token is in now, with what moves it on from there, and the steps it can move on to. Read
			 from the token's definition, so it needs no server call. -->
		<VerticalStackLayout IsVisible="{Binding HasFlow}">
			<Label Text="{l:Localize StateDiagram}"
				   Style="{DynamicResource ListCardSectionLabel}" />

			<Border Style="{DynamicResource ListCardBorder}"
					Padding="16,14,16,0">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding FlowSteps}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="viewmodel:TokenFlowStepItem">
							<Grid ColumnDefinitions="20,*"
								  ColumnSpacing="12">
								<!-- The line of the flow: a dot for the step, and a bar on to the next step -->
								<Grid Grid.Column="0"
									  RowDefinitions="Auto,*">
									<!-- A ring around the dot of the step the token is in now -->
									<Ellipse WidthRequest="20"
											 HeightRequest="20"
											 Fill="{DynamicResource TnPSuccessbgWL}"
											 HorizontalOptions="Center"
											 VerticalOptions="Start"
											 IsVisible="{Binding IsCurrent}" />
									<!-- The dot: filled for the step now, dashed for a step reached when something fails, and
										 square where the flow ends -->
									<Border WidthRequest="12"
											HeightRequest="12"
											Margin="0,4,0,0"
											Padding="0"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="2"
											Stroke="{DynamicResource ContentSecondaryWL}"
											BackgroundColor="{DynamicResource SurfaceElevation1WL}"
											HorizontalOptions="Center"
											VerticalOptions="Start">
										<Border.Triggers>
											<DataTrigger TargetType="Border"
														 Binding="{Binding IsFailureStep}"
														 Value="True">
												<Setter Property="StrokeDashArray"
														Value="2,2" />
											</DataTrigger>
											<DataTrigger TargetType="Border"
														 Binding="{Binding IsEnd}"
														 Value="True">
												<Setter Property="StrokeShape"
														Value="RoundRectangle 3" />
											</DataTrigger>
											<DataTrigger TargetType="Border"
														 Binding="{Binding IsCurrent}"
														 Value="True">
												<Setter Property="Stroke"
														Value="{DynamicResource ContentAccessWL}" />
												<Setter Property="BackgroundColor"
														Value="{DynamicResource ContentAccessWL}" />
											</DataTrigger>
										</Border.Triggers>
									</Border>
									<BoxView Grid.Row="1"
											 WidthRequest="2"
											 MinimumHeightRequest="14"
											 HorizontalOptions="Center"
											 VerticalOptions="Fill"
											 Color="{DynamicResource SurfaceDividerWL}"
											 IsVisible="{Binding HasRailBelow}">
										<BoxView.Triggers>
											<DataTrigger TargetType="BoxView"
														 Binding="{Binding IsCurrent}"
														 Value="True">
												<Setter Property="Color"
														Value="{DynamicResource ContentAccessWL}" />
											</DataTrigger>
										</BoxView.Triggers>
									</BoxView>
								</Grid>

								<VerticalStackLayout Grid.Column="1"
													 Spacing="4"
													 Padding="0,0,0,14">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="8">
										<Label Grid.Column="0"
											   Text="{Binding Name}"
											   FontFamily="SpaceGroteskSemiBold"
											   FontSize="{StaticResource FontSizeMd}"
											   TextColor="{DynamicResource ContentPrimaryWL}"
											   VerticalOptions="Center">
											<Label.Triggers>
												<DataTrigger TargetType="Label"
															 Binding="{Binding IsFailureStep}"
															 Value="True">
													<Setter Property="TextColor"
															Value="{DynamicResource ContentSecondaryWL}" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
										<Border Grid.Column="1"
												StrokeShape="RoundRectangle 6"
												StrokeThickness="0"
												Padding="6,2"
												BackgroundColor="{DynamicResource ButtonAccessPrimarybgWL}"
												VerticalOptions="Center"
												IsVisible="{Binding IsCurrent}">
											<Label Text="{Binding BadgeText}"
												   FontFamily="HaasGroteskBold"
												   FontSize="11"
												   TextTransform="Uppercase"
												   TextColor="{DynamicResource ButtonAccessPrimaryContentWL}" />
										</Border>
									</Grid>

									<!-- What moves the token on, for the step it is in now -->
									<VerticalStackLayout Spacing="4"
														 IsVisible="{Binding HasWhenLines}"
														 BindableLayout.ItemsSource="{Binding WhenLines}">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="viewmodel:TokenFlowWhenLine">
												<Grid ColumnDefinitions="Auto,*"
													  ColumnSpacing="6">
													<Path Grid.Column="0"
														  Data="{Binding Icon}"
														  Fill="{DynamicResource ContentSecondaryWL}"
														  Aspect="Uniform"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Start"
														  Margin="0,2,0,0" />
													<Label Grid.Column="1"
														   Text="{Binding Text}"
														   FontSize="13"
														   TextColor="{DynamicResource ContentSecondaryWL}" />
												</Grid>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>

									<!-- How the token gets to a step it can move on to -->
									<Label Text="{Binding IncomingText}"
										   FontSize="13"
										   TextColor="{DynamicResource ContentSecondaryWL}"
										   IsVisible="{Binding HasIncomingText}" />
								</VerticalStackLayout>
							</Grid>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</Border>

			<!-- The whole flow, with what moves it on from each step -->
			<Grid ColumnDefinitions="*,Auto"
				  Padding="4,0"
				  MinimumHeightRequest="48"
				  SemanticProperties.Description="{l:Localize FlowSeeAll}">
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SeeFullFlowCommand}" />
				</Grid.GestureRecognizers>
				<Label Grid.Column="0"
					   Text="{l:Localize FlowSeeAll}"
					   FontFamily="HaasGroteskMedium"
					   FontSize="{StaticResource FontSizeSm}"
					   TextColor="{DynamicResource ContentAccessWL}"
					   VerticalOptions="Center" />
				<Label Grid.Column="1"
					   Text="›"
					   FontFamily="HaasGroteskMedium"
					   FontSize="{StaticResource FontSizeLg}"
					   TextColor="{DynamicResource ContentAccessWL}"
					   VerticalOptions="Center" />
			</Grid>
		</VerticalStackLayout>

		<!-- Values: the first few, and a row that opens all of them -->
		<VerticalStackLayout IsVisible="{Binding ShowStateSection}">
			<Label Text="{l:Localize TokenValues}"
				   Style="{DynamicResource ListCardSectionLabel}" />

			<controls:TaskView Task="{Binding MachineStateTask}">
				<controls:TaskView.RunningView>
					<!-- Rows shaped like variables while the state loads -->
					<Border Style="{DynamicResource ListCardBorder}"
							AutomationProperties.IsInAccessibleTree="False">
						<Grid>
							<VerticalStackLayout>
								<Grid ColumnDefinitions="*,Auto"
									  Padding="16,0"
									  HeightRequest="52">
									<Grid ColumnDefinitions="40*,60*"
										  VerticalOptions="Center">
										<BoxView Style="{DynamicResource ListCardPlaceholderTitle}" />
									</Grid>
									<BoxView Grid.Column="1"
											 Style="{DynamicResource ListCardPlaceholderValue}"
											 WidthRequest="36" />
								</Grid>
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
								<Grid ColumnDefinitions="*,Auto"
									  Padding="16,0"
									  HeightRequest="52"
									  Opacity="0.6">
									<Grid ColumnDefinitions="30*,70*"
										  VerticalOptions="Center">
										<BoxView Style="{DynamicResource ListCardPlaceholderTitle}" />
									</Grid>
									<BoxView Grid.Column="1"
											 Style="{DynamicResource ListCardPlaceholderValue}"
											 WidthRequest="28" />
								</Grid>
							</VerticalStackLayout>
							<controls:IndeterminateProgressLine IsRunning="{Binding MachineStateTask.IsRunning}"
																Color="{DynamicResource ContentAccessWL}" />
						</Grid>
					</Border>
				</controls:TaskView.RunningView>

				<controls:TaskView.ErrorView>
					<Border Style="{DynamicResource IdentityFlowCard}">
						<VerticalStackLayout Spacing="12">
							<Label Text="{Binding MachineStateErrorText}"
								   Style="{DynamicResource IdentityFlowCaptionLabel}" />
							<controls:TextButton LabelData="{l:Localize TryAgain}"
												 Command="{Binding MachineStateTask.ReloadCommand}"
												 Style="{DynamicResource OutlinedTextButton}"
												 HorizontalOptions="Start" />
						</VerticalStackLayout>
					</Border>
				</controls:TaskView.ErrorView>

				<controls:TaskView.SucceededView>
					<VerticalStackLayout>
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Variables}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="viewmodel:TokenVariableItem">
									<!-- A value that changed a moment ago is tinted, with the value it had before -->
									<Grid SemanticProperties.Description="{Binding AccessibleDescription}">
										<controls:ListCardSegment Position="{Binding CardPosition}"
																  FillColor="{DynamicResource SurfaceElevation1WL}"
																  StrokeColor="{DynamicResource SurfaceDividerWL}"
																  DividerInset="16">
											<controls:ListCardSegment.Triggers>
												<DataTrigger TargetType="controls:ListCardSegment"
															 Binding="{Binding IsChanged}"
															 Value="True">
													<Setter Property="FillColor"
															Value="{DynamicResource TnPSuccessbgWL}" />
												</DataTrigger>
											</controls:ListCardSegment.Triggers>
										</controls:ListCardSegment>
										<Grid ColumnDefinitions="*,Auto,Auto"
											  ColumnSpacing="12"
											  Padding="16,0"
											  MinimumHeightRequest="52">
											<Label Grid.Column="0"
												   Text="{Binding DisplayName}"
												   Style="{DynamicResource ListCardRowKeyLabel}" />
											<Label Grid.Column="1"
												   Text="{Binding PreviousValueText}"
												   IsVisible="{Binding IsChanged}"
												   Style="{DynamicResource ListCardRowDetailLabel}" />
											<Label Grid.Column="2"
												   Text="{Binding DisplayValue}"
												   Style="{DynamicResource ListCardRowTitleLabel}"
												   MaximumWidthRequest="180"
												   HorizontalTextAlignment="End" />
										</Grid>
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>

						<Grid IsVisible="{Binding HasVariables}">
							<controls:ListCardSegment Position="Last"
													  FillColor="{DynamicResource SurfaceElevation1WL}"
													  StrokeColor="{DynamicResource SurfaceDividerWL}"
													  DividerInset="16" />
							<controls:TemplatedButton Command="{Binding VariablesReportCommand}"
													  SemanticProperties.Description="{Binding AllVariablesText}">
								<Grid ColumnDefinitions="*,Auto"
									  ColumnSpacing="12"
									  Padding="16,0"
									  MinimumHeightRequest="52">
									<Label Grid.Column="0"
										   Text="{Binding AllVariablesText}"
										   Style="{DynamicResource ListCardRowLinkLabel}" />
									<controls:SvgView Grid.Column="1"
													  Source="arrow_forward_ios.svg"
													  WidthRequest="14"
													  HeightRequest="14"
													  VerticalOptions="Center"
													  TintColor="{DynamicResource ContentSecondaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
								</Grid>
							</controls:TemplatedButton>
						</Grid>
					</VerticalStackLayout>
				</controls:TaskView.SucceededView>
			</controls:TaskView>
		</VerticalStackLayout>

		<!-- Actions: the note commands that apply now -->
		<VerticalStackLayout IsVisible="{Binding ShowActionsSection}">
			<Label Text="{l:Localize Actions}"
				   Style="{DynamicResource ListCardSectionLabel}" />

			<!-- Rows shaped like commands while the state and the commands load -->
			<controls:ListCardPlaceholder IsVisible="{Binding IsLoadingNoteCommands}" />

			<VerticalStackLayout IsVisible="False"
								 controls:Reveal.IsShown="{Binding HasNoteCommands}"
								 controls:ListCard.IsEnabled="True"
								 BindableLayout.ItemsSource="{Binding NoteCommands}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="viewmodel:NoteCommandItem">
						<Grid>
							<controls:ListCardSegment Position="{Binding CardPosition}"
													  FillColor="{DynamicResource SurfaceElevation1WL}"
													  StrokeColor="{DynamicResource SurfaceDividerWL}" />
							<!-- A command that asks for values ends with a chevron. One that runs at once ends with "Run". -->
							<controls:TemplatedButton Command="{Binding RunCommand}"
													  SemanticProperties.Description="{Binding AccessibleDescription}">
								<Grid ColumnDefinitions="44,*,40"
									  ColumnSpacing="14"
									  Padding="16,12,8,12"
									  MinimumHeightRequest="68">
									<Grid.Triggers>
										<DataTrigger TargetType="Grid"
													 Binding="{Binding IsRunning}"
													 Value="True">
											<Setter Property="Opacity"
													Value="0.5" />
										</DataTrigger>
									</Grid.Triggers>
									<Border Grid.Column="0"
											Style="{DynamicResource ListCardTileBorder}"
											AutomationProperties.IsInAccessibleTree="False">
										<Label Text="{Binding Monogram}"
											   Style="{DynamicResource ListCardMonogramLabel}" />
									</Border>
									<VerticalStackLayout Grid.Column="1"
														 Spacing="3"
														 VerticalOptions="Center">
										<Label Text="{Binding Title}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<Label Text="{Binding ToolTip}"
											   IsVisible="{Binding HasToolTip}"
											   Style="{DynamicResource ListCardRowDetailLabel}"
											   MaxLines="2" />
									</VerticalStackLayout>
									<controls:SvgView Grid.Column="2"
													  Source="arrow_forward_ios.svg"
													  IsVisible="{Binding HasParameters}"
													  WidthRequest="14"
													  HeightRequest="14"
													  HorizontalOptions="Center"
													  VerticalOptions="Center"
													  TintColor="{DynamicResource ContentSecondaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
									<Label Grid.Column="2"
										   Text="{l:Localize Run}"
										   IsVisible="{Binding RunsAtOnce}"
										   FontFamily="SpaceGroteskBold"
										   FontSize="{StaticResource FontSizeSm}"
										   TextColor="{DynamicResource ContentAccessWL}"
										   HorizontalOptions="Center"
										   VerticalOptions="Center"
										   AutomationProperties.IsInAccessibleTree="False" />
								</Grid>
							</controls:TemplatedButton>
						</Grid>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>

			<!-- Nothing can be run now: the machine has ended, or no command applies in the current state -->
			<Border Style="{DynamicResource IdentityFlowCard}"
					IsVisible="False"
					controls:Reveal.IsShown="{Binding ShowNoActions}">
				<Grid ColumnDefinitions="44,*"
					  ColumnSpacing="14">
					<Border Grid.Column="0"
							Style="{DynamicResource ListCardTileBorder}"
							BackgroundColor="{DynamicResource SurfaceDividerWL}"
							AutomationProperties.IsInAccessibleTree="False">
						<Path Data="M10,3.5 A6.5,6.5 0 1 1 9.99,3.5 M8,7.5 L8,12.5 M12,7.5 L12,12.5"
							  Stroke="{DynamicResource ContentSecondaryWL}"
							  StrokeThickness="1.8"
							  StrokeLineCap="Round"
							  Aspect="None"
							  WidthRequest="20"
							  HeightRequest="20"
							  HorizontalOptions="Center"
							  VerticalOptions="Center" />
					</Border>
					<VerticalStackLayout Grid.Column="1"
										 Spacing="3"
										 VerticalOptions="Center">
						<Label Text="{l:Localize NoActionsNow}"
							   Style="{DynamicResource ListCardRowTitleLabel}" />
						<Label Text="{Binding NoActionsText}"
							   Style="{DynamicResource IdentityFlowCaptionLabel}" />
					</VerticalStackLayout>
				</Grid>
			</Border>
		</VerticalStackLayout>

		<!-- Reports. Profiling is under Technical details. -->
		<Label Text="{l:Localize Reports}"
			   Style="{DynamicResource ListCardSectionLabel}" />
		<Border Style="{DynamicResource ListCardBorder}">
			<VerticalStackLayout>
				<controls:TemplatedButton Command="{Binding PresentReportCommand}"
										  SemanticProperties.Description="{l:Localize Present}"
										  SemanticProperties.Hint="{l:Localize PresentReportDescription}">
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="12"
						  Padding="16,10"
						  MinimumHeightRequest="64">
						<VerticalStackLayout Grid.Column="0"
											 Spacing="3"
											 VerticalOptions="Center">
							<Label Text="{l:Localize Present}"
								   Style="{DynamicResource ListCardRowTitleLabel}" />
							<Label Text="{l:Localize PresentReportDescription}"
								   Style="{DynamicResource ListCardRowDetailLabel}" />
						</VerticalStackLayout>
						<controls:SvgView Grid.Column="1"
										  Source="arrow_forward_ios.svg"
										  WidthRequest="14"
										  HeightRequest="14"
										  VerticalOptions="Center"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  AutomationProperties.IsInAccessibleTree="False" />
					</Grid>
				</controls:TemplatedButton>
				<BoxView Style="{DynamicResource ListCardRowDivider}" />
				<controls:TemplatedButton Command="{Binding HistoryReportCommand}"
										  SemanticProperties.Description="{l:Localize HistoryValueChart}"
										  SemanticProperties.Hint="{l:Localize HistoryReportDescription}">
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="12"
						  Padding="16,10"
						  MinimumHeightRequest="64">
						<VerticalStackLayout Grid.Column="0"
											 Spacing="3"
											 VerticalOptions="Center">
							<Label Text="{l:Localize HistoryValueChart}"
								   Style="{DynamicResource ListCardRowTitleLabel}" />
							<Label Text="{l:Localize HistoryReportDescription}"
								   Style="{DynamicResource ListCardRowDetailLabel}" />
						</VerticalStackLayout>
						<controls:SvgView Grid.Column="1"
										  Source="arrow_forward_ios.svg"
										  WidthRequest="14"
										  HeightRequest="14"
										  VerticalOptions="Center"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  AutomationProperties.IsInAccessibleTree="False" />
					</Grid>
				</controls:TemplatedButton>
				<BoxView Style="{DynamicResource ListCardRowDivider}" />
				<controls:TemplatedButton Command="{Binding StatesReportCommand}"
										  SemanticProperties.Description="{l:Localize FlowDiagramReport}"
										  SemanticProperties.Hint="{l:Localize StatesReportDescription}">
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="12"
						  Padding="16,10"
						  MinimumHeightRequest="64">
						<VerticalStackLayout Grid.Column="0"
											 Spacing="3"
											 VerticalOptions="Center">
							<Label Text="{l:Localize FlowDiagramReport}"
								   Style="{DynamicResource ListCardRowTitleLabel}" />
							<Label Text="{l:Localize StatesReportDescription}"
								   Style="{DynamicResource ListCardRowDetailLabel}" />
						</VerticalStackLayout>
						<controls:SvgView Grid.Column="1"
										  Source="arrow_forward_ios.svg"
										  WidthRequest="14"
										  HeightRequest="14"
										  VerticalOptions="Center"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  AutomationProperties.IsInAccessibleTree="False" />
					</Grid>
				</controls:TemplatedButton>
			</VerticalStackLayout>
		</Border>
	</VerticalStackLayout>
</ContentView>
