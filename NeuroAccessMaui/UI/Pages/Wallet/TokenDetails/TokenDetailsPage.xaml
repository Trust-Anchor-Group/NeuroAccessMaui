<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
							 x:Class="NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.TokenDetailsPage"
							 x:DataType="viewmodel:TokenDetailsViewModel"
							 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
							 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
							 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
							 xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.Views"
							 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails">
	<base:BaseContentPage.Resources>
		<!-- A labeled value. Values that open something are shown as links. Every value can be copied. -->
		<DataTemplate x:Key="PropertyTemplate" x:DataType="viewmodel:TokenPropertyItem">
			<Grid ColumnDefinitions="*,auto" ColumnSpacing="8" Padding="0,4">
				<VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
					<Label Text="{Binding Label}"
						   Style="{DynamicResource ItemDescriptionLabel}"
						   FontSize="{StaticResource FontSizeXs}"
						   TextColor="{DynamicResource ContentSecondaryWL}" />
					<Label Text="{Binding Value}"
						   Style="{DynamicResource ItemDescriptionLabel}"
						   TextColor="{DynamicResource ContentPrimaryWL}"
						   LineBreakMode="CharacterWrap">
						<Label.Triggers>
							<DataTrigger TargetType="Label" Binding="{Binding IsActionable}" Value="True">
								<Setter Property="TextColor" Value="{DynamicResource ContentLinkWL}" />
								<Setter Property="TextDecorations" Value="Underline" />
							</DataTrigger>
						</Label.Triggers>
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding OpenCommand}" />
						</Label.GestureRecognizers>
					</Label>
				</VerticalStackLayout>
				<controls:SvgButton Grid.Column="1"
									SvgSource="content_copy.svg"
									Style="{DynamicResource IconButtonOnBackground}"
									Command="{Binding CopyCommand}"
									VerticalOptions="Center"
									SemanticProperties.Description="{l:Localize CopyToClipboard}" />
			</Grid>
		</DataTemplate>
	</base:BaseContentPage.Resources>

	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}">

		<controls:Background/>

		<Grid RowDefinitions="auto,*">
			<!-- Top bar -->
			<Grid ColumnDefinitions="auto,*" ColumnSpacing="8" Margin="16,8,16,8">
				<controls:SvgButton Grid.Column="0"
									HorizontalOptions="Start"
									Command="{Binding GoBackCommand}"
									Style="{DynamicResource IconButton}"
									SvgSource="close.svg"
									SemanticProperties.Description="{l:Localize Close}" />
				<Label Grid.Column="1"
					   Text="{l:Localize TokenDetails}"
					   Style="{DynamicResource PageTitleLabel}"
					   HorizontalOptions="End"
					   SemanticProperties.HeadingLevel="Level1" />
			</Grid>

			<ScrollView Grid.Row="1">
				<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}" Padding="16,0,16,16">

					<!-- Banners -->
					<Border IsVisible="{Binding IsUnverifiedCopy}" BackgroundColor="{DynamicResource TnPWarningbgWL}"
							Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="12">
						<Label Text="{l:Localize TokenUnverifiedCopy}" TextColor="{DynamicResource TnPWarningContentWL}"/>
					</Border>
					<Border IsVisible="{Binding ChangedSinceShared}" BackgroundColor="{DynamicResource TnPWarningbgWL}"
							Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="12">
						<Label Text="{l:Localize TokenChangedSinceShared}" TextColor="{DynamicResource TnPWarningContentWL}"/>
					</Border>
					<Border IsVisible="{Binding HasLeftWallet}" BackgroundColor="{DynamicResource TnPInfobgWL}"
							Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="12">
						<Label Text="{l:Localize TokenNoLongerInWallet}" TextColor="{DynamicResource TnPInfoContentWL}"/>
					</Border>

					<!-- Hero: the embedded layout or the glyph, the name, the value and who owns it -->
					<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="16">
						<VerticalStackLayout Spacing="12">
							<Grid HorizontalOptions="Center">
								<controls:TemplatedButton IsVisible="{Binding HasEmbeddedLayoutImage}"
														  Command="{Binding PresentEmbeddedLayoutCommand}"
														  HorizontalOptions="Center"
														  SemanticProperties.Description="{l:Localize ViewEmbeddedLayout}">
									<Image Source="{Binding EmbeddedLayoutImage}"
										   Aspect="AspectFit"
										   MaximumHeightRequest="240"
										   HorizontalOptions="Center"
										   AutomationProperties.IsInAccessibleTree="False" />
								</controls:TemplatedButton>
								<Grid IsVisible="{Binding HasEmbeddedLayoutImage, Converter={StaticResource InvertedBoolConverter}}">
									<Image Source="{Binding GlyphImage}"
										   IsVisible="{Binding HasGlyphImage}"
										   WidthRequest="{Binding GlyphWidth}"
										   HeightRequest="{Binding GlyphHeight}"
										   Aspect="AspectFit"
										   HorizontalOptions="Center"
										   VerticalOptions="Center"
										   SemanticProperties.Description="{Binding FriendlyName}" />
									<Path Data="{x:Static ui:Geometries.TokenPath}"
										  IsVisible="{Binding ShowGlyphPlaceholder}"
										  Fill="{DynamicResource ContentSecondaryWL}"
										  Aspect="Uniform"
										  WidthRequest="{Binding GlyphWidth}"
										  HeightRequest="{Binding GlyphHeight}"
										  HorizontalOptions="Center"
										  VerticalOptions="Center"
										  AutomationProperties.IsInAccessibleTree="False" />
								</Grid>
							</Grid>

							<VerticalStackLayout Spacing="4">
								<Label Text="{Binding FriendlyName}"
									   Style="{DynamicResource PageTitleLabelSmall}"
									   TextColor="{DynamicResource ContentPrimaryWL}"
									   HorizontalOptions="Center"
									   HorizontalTextAlignment="Center"
									   SemanticProperties.HeadingLevel="Level2" />
								<Label HorizontalOptions="Center"
									   HorizontalTextAlignment="Center"
									   Style="{DynamicResource Brand2LabelS}">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding Value, Converter={converters:MoneyToString}}" />
											<Span Text=" " />
											<Span Text="{Binding Currency}" />
										</FormattedString>
									</Label.FormattedText>
								</Label>
								<Label Text="{Binding Category}"
									   IsVisible="{Binding HasCategory}"
									   Style="{DynamicResource ItemDescriptionLabel}"
									   TextColor="{DynamicResource ContentSecondaryWL}"
									   HorizontalOptions="Center"
									   HorizontalTextAlignment="Center" />
							</VerticalStackLayout>

							<!-- Ownership and expiry chips -->
							<FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
								<Border IsVisible="{Binding IsVerified}"
										StrokeShape="RoundRectangle 12"
										StrokeThickness="0"
										Padding="8,2"
										Margin="4,2"
										BackgroundColor="{DynamicResource TnPInfobgWL}">
									<Border.Triggers>
										<DataTrigger TargetType="Border" Binding="{Binding IsMyToken}" Value="True">
											<Setter Property="BackgroundColor" Value="{DynamicResource TnPSuccessbgWL}" />
										</DataTrigger>
									</Border.Triggers>
									<Label Text="{Binding OwnershipText}"
										   FontSize="{StaticResource FontSizeSm}"
										   TextColor="{DynamicResource TnPInfoContentWL}">
										<Label.Triggers>
											<DataTrigger TargetType="Label" Binding="{Binding IsMyToken}" Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPSuccessContentWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>
								<Border IsVisible="{Binding HasExpiryText}"
										StrokeShape="RoundRectangle 12"
										StrokeThickness="0"
										Padding="8,2"
										Margin="4,2"
										BackgroundColor="{DynamicResource TnPWarningbgWL}">
									<Border.Triggers>
										<DataTrigger TargetType="Border" Binding="{Binding IsExpired}" Value="True">
											<Setter Property="BackgroundColor" Value="{DynamicResource TnPDangerbgWL}" />
										</DataTrigger>
									</Border.Triggers>
									<Label Text="{Binding ExpiryText}"
										   FontSize="{StaticResource FontSizeSm}"
										   TextColor="{DynamicResource TnPWarningContentWL}">
										<Label.Triggers>
											<DataTrigger TargetType="Label" Binding="{Binding IsExpired}" Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPDangerContentWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>
							</FlexLayout>
						</VerticalStackLayout>
					</Border>

					<!-- Actions -->
					<FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
						<controls:TextButton LabelData="{l:Localize Sell}"
											 Command="{Binding SellCommand}"
											 IsVisible="{Binding CanSell}"
											 Style="{DynamicResource FilledTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{l:Localize OfferToBuy}"
											 Command="{Binding OfferToBuyCommand}"
											 IsVisible="{Binding CanOfferToBuy}"
											 Style="{DynamicResource FilledTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{l:Localize Give}"
											 Command="{Binding GiveCommand}"
											 IsVisible="{Binding CanGive}"
											 Style="{DynamicResource OutlinedTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{Binding HistoryLabel}"
											 Command="{Binding ViewEventsCommand}"
											 IsVisible="{Binding CanViewHistory}"
											 Style="{DynamicResource OutlinedTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{l:Localize Share}"
											 Command="{Binding ShareCommand}"
											 Style="{DynamicResource OutlinedTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{l:Localize SendToContact}"
											 Command="{Binding SendToContactCommand}"
											 Style="{DynamicResource OutlinedTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{l:Localize OpenOnWeb}"
											 Command="{Binding OpenOnWebCommand}"
											 IsVisible="{Binding HasWebUrl}"
											 Style="{DynamicResource OutlinedTextButton}"
											 Margin="4" />
						<controls:TextButton LabelData="{l:Localize ShareLink}"
											 Command="{Binding ShareLinkCommand}"
											 IsVisible="{Binding HasWebUrl}"
											 Style="{DynamicResource OutlinedTextButton}"
											 Margin="4" />
					</FlexLayout>

					<!-- The ways to sell, when there is more than one -->
					<Border IsVisible="{Binding IsSellOptionsVisible}" Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
						<VerticalStackLayout Spacing="8">
							<controls:TextButton LabelData="{l:Localize OfferToSell}"
												 Command="{Binding OfferToSellCommand}"
												 IsVisible="{Binding CanOfferToSell}"
												 Style="{DynamicResource FilledTextButton}" />
							<controls:TextButton LabelData="{l:Localize ConsignToAuction}"
												 Command="{Binding PublishMarketplaceCommand}"
												 IsVisible="{Binding CanConsign}"
												 Style="{DynamicResource OutlinedTextButton}" />
						</VerticalStackLayout>
					</Border>

					<Label Text="{Binding TransferBlockedText}"
						   IsVisible="{Binding HasTransferBlockedText}"
						   Style="{DynamicResource ItemDescriptionLabel}"
						   TextColor="{DynamicResource ContentSecondaryWL}"
						   HorizontalTextAlignment="Center" />

					<!-- Description -->
					<Border IsVisible="{Binding HasDescription}" Style="{DynamicResource BorderSet}" Margin="0" Padding="16">
						<VerticalStackLayout Spacing="8">
							<Label Text="{l:Localize Description}"
								   Style="{DynamicResource SectionTitleLabel}"
								   SemanticProperties.HeadingLevel="Level2" />
							<controls:TaskView Task="{Binding DescriptionTask}">
								<controls:TaskView.RunningView>
									<ActivityIndicator IsRunning="True" Color="{DynamicResource PrimaryWL}" HorizontalOptions="Center"/>
								</controls:TaskView.RunningView>
								<controls:TaskView.ErrorView>
									<controls:TextButton LabelData="{l:Localize TryAgain}" Command="{Binding DescriptionTask.ReloadCommand}"
														 Style="{DynamicResource OutlinedTextButton}" HorizontalOptions="Center"/>
								</controls:TaskView.ErrorView>
								<controls:TaskView.SucceededView>
									<ContentView Content="{Binding Description}" VerticalOptions="Start"/>
								</controls:TaskView.SucceededView>
							</controls:TaskView>
						</VerticalStackLayout>
					</Border>

					<!-- Ownership and dates -->
					<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="16">
						<VerticalStackLayout Spacing="4">
							<Label Text="{l:Localize OwnershipAndDates}"
								   Style="{DynamicResource SectionTitleLabel}"
								   SemanticProperties.HeadingLevel="Level2" />
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding OwnershipProperties}"
												 BindableLayout.ItemTemplate="{StaticResource PropertyTemplate}" />
						</VerticalStackLayout>
					</Border>

					<!-- Tags -->
					<Border IsVisible="{Binding HasTags}" Style="{DynamicResource BorderSet}" Margin="0" Padding="16">
						<VerticalStackLayout Spacing="4">
							<Label Text="{l:Localize Tags}"
								   Style="{DynamicResource SectionTitleLabel}"
								   SemanticProperties.HeadingLevel="Level2" />
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding Tags}"
												 BindableLayout.ItemTemplate="{StaticResource PropertyTemplate}" />
						</VerticalStackLayout>
					</Border>

					<!-- State machine -->
					<views:TokenStateMachineView IsVisible="{Binding HasStateMachine}" />

					<!-- Technical details, collapsed until asked for -->
					<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="16">
						<VerticalStackLayout Spacing="8">
							<controls:TemplatedButton Command="{Binding ToggleTechnicalDetailsCommand}"
													  SemanticProperties.Description="{l:Localize TechnicalDetails}">
								<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
									<Label Grid.Column="0"
										   Text="{l:Localize TechnicalDetails}"
										   Style="{DynamicResource SectionTitleLabel}"
										   VerticalOptions="Center"
										   SemanticProperties.HeadingLevel="Level2" />
									<Path Grid.Column="1"
										  Data="{x:Static ui:Geometries.DropDownArrowPath}"
										  Fill="{DynamicResource ContentSecondaryWL}"
										  VerticalOptions="Center"
										  AutomationProperties.IsInAccessibleTree="False">
										<Path.Triggers>
											<DataTrigger TargetType="Path" Binding="{Binding IsTechnicalDetailsExpanded}" Value="True">
												<Setter Property="Rotation" Value="180" />
											</DataTrigger>
										</Path.Triggers>
									</Path>
								</Grid>
							</controls:TemplatedButton>

							<VerticalStackLayout IsVisible="{Binding IsTechnicalDetailsExpanded}" Spacing="8">
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding TechnicalProperties}"
													 BindableLayout.ItemTemplate="{StaticResource PropertyTemplate}" />
								<controls:TextButton LabelData="{l:Localize ViewDefinition}"
													 Command="{Binding ViewDefinitionCommand}"
													 IsVisible="{Binding IsVerified}"
													 Style="{DynamicResource OutlinedTextButton}" />
								<controls:TextButton LabelData="{l:Localize ViewEmbeddedLayout}"
													 Command="{Binding PresentEmbeddedLayoutCommand}"
													 IsVisible="{Binding HasEmbeddedLayout}"
													 Style="{DynamicResource OutlinedTextButton}" />
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>

					<!-- Destroying can't be undone, so it is kept apart from the other actions, at the end -->
					<controls:TextButton LabelData="{l:Localize Destroy}"
										 Command="{Binding DestroyCommand}"
										 IsVisible="{Binding CanDestroy}"
										 Style="{DynamicResource FilledTextButtonDecline}"
										 HorizontalOptions="Center" />
				</VerticalStackLayout>
			</ScrollView>
		</Grid>
	</Grid>
</base:BaseContentPage>
