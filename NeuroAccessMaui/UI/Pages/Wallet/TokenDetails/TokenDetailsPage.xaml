<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.TokenDetailsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:contractsobjectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.ObjectModels"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails"
	x:DataType="viewmodel:TokenDetailsViewModel">

	<base:BaseContentPage.Resources>
		<contractsobjectmodel:ParameterTemplateSelector
			x:Key="TokenCommandParameterTemplateSelector"
			BooleanTemplate="{StaticResource BooleanParameterTemplate}"
			DateTemplate="{StaticResource DateParameterTemplate}"
			DateTimeTemplate="{StaticResource DateTimeParameterTemplate}"
			DurationTemplate="{StaticResource DurationParameterTemplate}"
			NumericalTemplate="{StaticResource NumericalParameterTemplate}"
			StringTemplate="{StaticResource StringParameterTemplate}"
			TimeTemplate="{StaticResource TimeParameterTemplate}"
			DefaultTemplate="{StaticResource DefaultParameterTemplate}" />

		<DataTemplate
			x:Key="TokenActionTemplate"
			x:DataType="objectmodel:TokenActionItem">
			<controls:TemplatedButton
				Command="{Binding Command}"
				IsEnabled="{Binding IsAvailable}"
				SemanticProperties.Description="{Binding Title}">
				<Border
					Margin="0,4"
					Padding="14"
					Style="{DynamicResource BorderSet}">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<VerticalStackLayout Spacing="3">
							<Label
								FontAttributes="Bold"
								FontSize="16"
								Text="{Binding Title}"
								TextColor="{DynamicResource ContentPrimaryWL}" />
							<Label
								IsVisible="{Binding HasDescription}"
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{Binding Description}"
								TextColor="{DynamicResource ContentSecondaryWL}" />
							<Label
								IsVisible="{Binding HasAvailabilityExplanation}"
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{Binding AvailabilityExplanation}"
								TextColor="{DynamicResource ContentSecondaryWL}" />
						</VerticalStackLayout>
						<Label
							Grid.Column="1"
							FontSize="20"
							Text="›"
							TextColor="{DynamicResource ContentSecondaryWL}"
							VerticalTextAlignment="Center" />
					</Grid>
				</Border>
			</controls:TemplatedButton>
		</DataTemplate>

		<DataTemplate
			x:Key="TokenTechnicalItemTemplate"
			x:DataType="objectmodel:TokenTechnicalItem">
			<Border
				Margin="0,3"
				Padding="12"
				Style="{DynamicResource BorderSubSet}">
				<VerticalStackLayout Spacing="6">
					<Label
						FontAttributes="Bold"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{Binding Label}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
					<Label
						LineBreakMode="MiddleTruncation"
						MaxLines="1"
						Text="{Binding Value}"
						TextColor="{DynamicResource ContentPrimaryWL}" />
					<HorizontalStackLayout
						HorizontalOptions="Start"
						Spacing="4"
						VerticalOptions="Center">
						<controls:TextButton
							Command="{Binding CopyCommand}"
							IsVisible="{Binding IsCopyable}"
							LabelData="{l:Localize CopyToClipboard}"
							Style="{DynamicResource TransparentTextButton}" />
						<controls:TextButton
							Command="{Binding OpenCommand}"
							IsVisible="{Binding IsOpenable}"
							LabelData="{l:Localize Details}"
							Style="{DynamicResource TransparentTextButton}" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate
			x:Key="TokenPartItemTemplate"
			x:DataType="viewmodel:PartItem">
			<Border
				Margin="0,3"
				Padding="12"
				Style="{DynamicResource BorderSubSet}">
				<VerticalStackLayout Spacing="6">
					<VerticalStackLayout Spacing="2">
						<Label
							FontAttributes="Bold"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{Binding Label}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<Label
							LineBreakMode="MiddleTruncation"
							MaxLines="1"
							Text="{Binding FriendlyName}"
							TextColor="{DynamicResource ContentPrimaryWL}" />
					</VerticalStackLayout>
					<HorizontalStackLayout
						HorizontalOptions="Start"
						Spacing="4"
						VerticalOptions="Center">
						<controls:TextButton
							Command="{Binding ViewIdentityCommand}"
							CommandParameter="{Binding LegalId}"
							IsVisible="{Binding CanViewIdentity}"
							LabelData="{l:Localize Details}"
							Style="{DynamicResource TransparentTextButton}" />
						<controls:TextButton
							Command="{Binding OpenChatCommand}"
							CommandParameter="{Binding ChatCommandParameter}"
							IsVisible="{Binding CanOpenChat}"
							LabelData="{l:Localize Chat}"
							Style="{DynamicResource TransparentTextButton}" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate
			x:Key="TokenActivityItemTemplate"
			x:DataType="objectmodel:TokenActivityItem">
			<controls:DisclosureSection
				IconSource="history.svg"
				IsExpanded="False"
				Summary="{Binding SummaryText}"
				Title="{Binding Title}">
				<VerticalStackLayout Spacing="10">
					<controls:StatusPill
						HorizontalOptions="Start"
						IsVisible="{Binding IsPersonal}"
						Text="{Binding PrivacyText}"
						Tone="Information" />

					<Border
						IsVisible="{Binding HasContent}"
						Padding="12"
						Style="{DynamicResource BorderSubSet}">
						<VerticalStackLayout Spacing="6">
							<Label
								FontAttributes="Bold"
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{Binding ContentLabel}"
								TextColor="{DynamicResource ContentSecondaryWL}" />
							<Label
								LineBreakMode="TailTruncation"
								MaxLines="8"
								Text="{Binding ContentPreview}"
								TextColor="{DynamicResource ContentPrimaryWL}" />
						</VerticalStackLayout>
					</Border>

					<Grid
						IsVisible="{Binding HasActor}"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="8">
						<Label
							FontAttributes="Bold"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{Binding ActorLabel}"
							TextColor="{DynamicResource ContentSecondaryWL}"
							VerticalTextAlignment="Center" />
						<Label
							Grid.Column="1"
							LineBreakMode="TailTruncation"
							Text="{Binding ActorName}"
							TextColor="{DynamicResource ContentPrimaryWL}"
							VerticalTextAlignment="Center" />
						<controls:TextButton
							Grid.Column="2"
							Command="{Binding OpenActorCommand}"
							IsVisible="{Binding CanOpenActor}"
							LabelData="{l:Localize Details}"
							Style="{DynamicResource TransparentTextButton}" />
					</Grid>

					<Grid
						IsVisible="{Binding HasOwner}"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="8">
						<Label
							FontAttributes="Bold"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize Owner}"
							TextColor="{DynamicResource ContentSecondaryWL}"
							VerticalTextAlignment="Center" />
						<Label
							Grid.Column="1"
							LineBreakMode="TailTruncation"
							Text="{Binding OwnerName}"
							TextColor="{DynamicResource ContentPrimaryWL}"
							VerticalTextAlignment="Center" />
						<controls:TextButton
							Grid.Column="2"
							Command="{Binding OpenOwnerCommand}"
							IsVisible="{Binding CanOpenOwner}"
							LabelData="{l:Localize Details}"
							Style="{DynamicResource TransparentTextButton}" />
					</Grid>

					<Grid
						IsVisible="{Binding HasValue}"
						ColumnDefinitions="Auto,*"
						ColumnSpacing="8">
						<Label
							FontAttributes="Bold"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize Value}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<Label
							Grid.Column="1"
							HorizontalTextAlignment="End"
							Text="{Binding ValueText}"
							TextColor="{DynamicResource ContentPrimaryWL}" />
					</Grid>

					<Border
						IsVisible="{Binding HasRelatedContract}"
						Padding="12"
						Style="{DynamicResource BorderSubSet}">
						<VerticalStackLayout Spacing="6">
							<Label
								FontAttributes="Bold"
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{l:Localize RelatedContract}"
								TextColor="{DynamicResource ContentSecondaryWL}" />
							<Label
								LineBreakMode="MiddleTruncation"
								Text="{Binding RelatedContractDisplayId}"
								TextColor="{DynamicResource ContentPrimaryWL}" />
							<controls:TextButton
								Command="{Binding OpenRelatedContractCommand}"
								HorizontalOptions="Start"
								LabelData="{l:Localize TokenActivityViewRelatedContract}"
								Style="{DynamicResource TransparentTextButton}" />
						</VerticalStackLayout>
					</Border>

					<Border
						IsVisible="{Binding HasSource}"
						Padding="12"
						Style="{DynamicResource BorderSubSet}">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<VerticalStackLayout Spacing="2">
								<Label
									FontAttributes="Bold"
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize From}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
								<Label
									LineBreakMode="TailTruncation"
									Text="{Binding Source}"
									TextColor="{DynamicResource ContentPrimaryWL}" />
							</VerticalStackLayout>
							<controls:TextButton
								Grid.Column="1"
								Command="{Binding OpenSourceCommand}"
								LabelData="{l:Localize Details}"
								Style="{DynamicResource TransparentTextButton}"
								VerticalOptions="Center" />
						</Grid>
					</Border>

					<controls:DisclosureSection
						IsVisible="{Binding HasRawDetails}"
						Title="{l:Localize RawDetails}">
						<VerticalStackLayout Spacing="8">
							<Border
								IsVisible="{Binding HasCompleteContent}"
								Padding="10"
								Style="{DynamicResource BorderSubSet}">
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<Label
										FontAttributes="Bold"
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{Binding ContentLabel}"
										TextColor="{DynamicResource ContentSecondaryWL}"
										VerticalTextAlignment="Center" />
									<controls:TextButton
										Grid.Column="1"
										Command="{Binding CopyContentCommand}"
										LabelData="{l:Localize CopyToClipboard}"
										Style="{DynamicResource TransparentTextButton}" />
								</Grid>
							</Border>
							<Label
								LineBreakMode="WordWrap"
								Text="{Binding RawDetails}"
								TextColor="{DynamicResource ContentSecondaryWL}" />
							<controls:TextButton
								Command="{Binding CopyRawDetailsCommand}"
								HorizontalOptions="Start"
								LabelData="{l:Localize CopyToClipboard}"
								Style="{DynamicResource TransparentTextButton}" />
						</VerticalStackLayout>
					</controls:DisclosureSection>
				</VerticalStackLayout>
			</controls:DisclosureSection>
		</DataTemplate>
	</base:BaseContentPage.Resources>

	<Grid
		BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		RowDefinitions="Auto,Auto,*">
		<controls:Background Grid.RowSpan="3" />

		<Grid
			Margin="16,8,16,12"
			ColumnDefinitions="Auto,*,Auto"
			ColumnSpacing="12">
			<controls:SvgButton
				Command="{Binding GoBackCommand}"
				HorizontalOptions="Start"
				SemanticProperties.Description="{l:Localize Close}"
				Style="{DynamicResource IconButton}"
				SvgSource="close.svg"
				VerticalOptions="Center" />
			<Label
				Grid.Column="1"
				LineBreakMode="TailTruncation"
				Style="{DynamicResource PageTitleLabel}"
				Text="{l:Localize TokenDetails}"
				VerticalTextAlignment="Center" />
			<controls:SvgButton
				Grid.Column="2"
				Command="{Binding RefreshTokenCommand}"
				IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertedBoolConverter}}"
				SemanticProperties.Description="{l:Localize Refresh}"
				Style="{DynamicResource IconButtonOnBackground}"
				SvgSource="refresh.svg"
				VerticalOptions="Center" />
		</Grid>

		<Border
			Grid.Row="1"
			Margin="16,0,16,8"
			MaximumWidthRequest="960"
			Padding="12,8"
			BackgroundColor="{DynamicResource TnPWarningbgWL}"
			HorizontalOptions="Fill"
			IsVisible="{Binding HasLoadError}"
			StrokeThickness="0"
			StrokeShape="RoundRectangle 8">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<Label
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding LoadErrorMessage}"
					TextColor="{DynamicResource TnPWarningContentWL}"
					VerticalTextAlignment="Center" />
				<controls:TextButton
					Grid.Column="1"
					Command="{Binding RefreshTokenCommand}"
					LabelData="{l:Localize Retry}"
					Style="{DynamicResource TransparentTextButton}" />
			</Grid>
		</Border>

		<Grid Grid.Row="2">
			<ScrollView IsVisible="{Binding HasContent}">
				<VerticalStackLayout
					Margin="16,0,16,20"
					MaximumWidthRequest="960"
					HorizontalOptions="Fill"
					Spacing="12">

					<Border Padding="18" Style="{DynamicResource BorderSet}">
						<Grid
							ColumnDefinitions="Auto,*"
							ColumnSpacing="16"
							RowDefinitions="Auto,Auto">
							<Border
								Grid.RowSpan="2"
								BackgroundColor="{DynamicResource SurfaceElevation2WL}"
								HeightRequest="72"
								Padding="8"
								Stroke="{DynamicResource SurfaceStrokeWL}"
								StrokeShape="RoundRectangle 16"
								VerticalOptions="Start"
								WidthRequest="72">
								<Grid>
									<Image
										Aspect="AspectFit"
										IsVisible="{Binding HasGlyphImage}"
										Source="{Binding GlyphImage}" />
									<Label
										FontAttributes="Bold"
										FontSize="28"
										HorizontalTextAlignment="Center"
										Text="{Binding FallbackGlyphText}"
										TextColor="{DynamicResource ContentPrimaryWL}"
										VerticalTextAlignment="Center">
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding HasGlyphImage}"
												TargetType="Label"
												Value="True">
												<Setter Property="IsVisible" Value="False" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Grid>
							</Border>

							<Grid Grid.Column="1">
								<VerticalStackLayout Spacing="3">
									<Label
										FontAttributes="Bold"
										FontSize="24"
										LineBreakMode="TailTruncation"
										Text="{Binding FriendlyName}"
										TextColor="{DynamicResource ContentPrimaryWL}" />
									<Label
										LineBreakMode="TailTruncation"
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{Binding Category}"
										TextColor="{DynamicResource ContentSecondaryWL}" />
									<Label
										IsVisible="{Binding HasDescription}"
										LineBreakMode="TailTruncation"
										MaxLines="2"
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{Binding DescriptionText}"
										TextColor="{DynamicResource ContentSecondaryWL}" />
								</VerticalStackLayout>
							</Grid>

							<VerticalStackLayout
								Grid.Row="1"
								Grid.Column="1"
								Margin="0,12,0,0"
								Spacing="6">
								<FlexLayout
									AlignItems="Center"
									Direction="Row"
									Wrap="Wrap">
									<controls:StatusPill
										Margin="0,0,10,4"
										Text="{Binding AttentionText}"
										Tone="{Binding StatusTone}" />
									<Label
										Margin="0,0,14,4"
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{Binding OwnershipText}"
										TextColor="{DynamicResource ContentPrimaryWL}" />
									<Label
										Margin="0,0,14,4"
										IsVisible="{Binding HasValue}"
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{Binding ValueText}"
										TextColor="{DynamicResource ContentPrimaryWL}" />
									<Label
										Margin="0,0,14,4"
										IsVisible="{Binding HasExpiry}"
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{Binding ExpiryText}"
										TextColor="{DynamicResource ContentSecondaryWL}">
										<Label.Triggers>
											<DataTrigger Binding="{Binding IsExpiringSoon}" TargetType="Label" Value="True">
												<Setter Property="IsVisible" Value="False" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</FlexLayout>
								<Label
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{Binding UpdatedText}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
						</Grid>
					</Border>

					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
						<controls:TemplatedButton Command="{Binding ShowOverviewCommand}" SemanticProperties.Description="{l:Localize Overview}">
							<Border BackgroundColor="{DynamicResource SurfaceElevation1WL}" MinimumHeightRequest="44" Padding="6" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
								<Label FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" Text="{l:Localize Overview}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center">
									<Label.Triggers>
										<DataTrigger Binding="{Binding IsOverviewSelected}" TargetType="Label" Value="True">
											<Setter Property="TextColor" Value="{DynamicResource ButtonAccessPrimaryContentWL}" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
								<Border.Triggers>
									<DataTrigger Binding="{Binding IsOverviewSelected}" TargetType="Border" Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource ButtonAccessPrimarybgWL}" />
										<Setter Property="Stroke" Value="{DynamicResource ButtonAccessPrimarybgWL}" />
									</DataTrigger>
								</Border.Triggers>
							</Border>
						</controls:TemplatedButton>
						<controls:TemplatedButton
							Grid.Column="1"
							Command="{Binding ShowActivityCommand}"
							SemanticProperties.Description="{l:Localize Activity}">
							<Border BackgroundColor="{DynamicResource SurfaceElevation1WL}" MinimumHeightRequest="44" Padding="6" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
								<Label FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" Text="{l:Localize Activity}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center">
									<Label.Triggers>
										<DataTrigger Binding="{Binding IsActivitySelected}" TargetType="Label" Value="True">
											<Setter Property="TextColor" Value="{DynamicResource ButtonAccessPrimaryContentWL}" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
								<Border.Triggers>
									<DataTrigger Binding="{Binding IsActivitySelected}" TargetType="Border" Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource ButtonAccessPrimarybgWL}" />
										<Setter Property="Stroke" Value="{DynamicResource ButtonAccessPrimarybgWL}" />
									</DataTrigger>
								</Border.Triggers>
							</Border>
						</controls:TemplatedButton>
						<controls:TemplatedButton
							Grid.Column="2"
							Command="{Binding ShowAdvancedCommand}"
							SemanticProperties.Description="{l:Localize Advanced}">
							<Border BackgroundColor="{DynamicResource SurfaceElevation1WL}" MinimumHeightRequest="44" Padding="6" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
								<Label FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" Text="{l:Localize Advanced}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center">
									<Label.Triggers>
										<DataTrigger Binding="{Binding IsAdvancedSelected}" TargetType="Label" Value="True">
											<Setter Property="TextColor" Value="{DynamicResource ButtonAccessPrimaryContentWL}" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
								<Border.Triggers>
									<DataTrigger Binding="{Binding IsAdvancedSelected}" TargetType="Border" Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource ButtonAccessPrimarybgWL}" />
										<Setter Property="Stroke" Value="{DynamicResource ButtonAccessPrimarybgWL}" />
									</DataTrigger>
								</Border.Triggers>
							</Border>
						</controls:TemplatedButton>
					</Grid>

					<VerticalStackLayout
						IsVisible="{Binding IsOverviewSelected}"
						Spacing="12">
						<VerticalStackLayout
							IsVisible="{Binding HasDescription}"
							Margin="4,8"
							Spacing="8">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									SemanticProperties.HeadingLevel="Level2"
									Text="{l:Localize Overview}" />
								<ContentView
									Content="{Binding Description}"
									IsVisible="{Binding HasRichDescription}" />
								<Label
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{Binding DescriptionText}"
									TextColor="{DynamicResource ContentSecondaryWL}">
									<Label.Triggers>
										<DataTrigger
											Binding="{Binding HasRichDescription}"
											TargetType="Label"
											Value="True">
											<Setter Property="IsVisible" Value="False" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
						</VerticalStackLayout>

						<Border Padding="16" Style="{DynamicResource BorderSet}">
							<VerticalStackLayout Spacing="10">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									SemanticProperties.HeadingLevel="Level2"
									Text="{l:Localize Actions}" />
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenActionTemplate}"
									BindableLayout.ItemsSource="{Binding PrimaryActions}" />
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenActionTemplate}"
									BindableLayout.ItemsSource="{Binding SecondaryActions}" />
							</VerticalStackLayout>
						</Border>

						<Border
							IsVisible="{Binding IsTokenCommandsLoading}"
							Padding="16"
							Style="{DynamicResource BorderSet}">
							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="10">
								<ActivityIndicator
									Color="{DynamicResource ContentPrimaryWL}"
									IsRunning="{Binding IsTokenCommandsLoading}" />
								<Label
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize LoadingTokenDefinedActions}"
									VerticalTextAlignment="Center" />
							</HorizontalStackLayout>
						</Border>

						<Border
							IsVisible="{Binding HasTokenCommandError}"
							Padding="14"
							BackgroundColor="{DynamicResource TnPWarningbgWL}"
							StrokeShape="RoundRectangle 8"
							StrokeThickness="0">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<Label
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{Binding TokenCommandErrorMessage}"
									TextColor="{DynamicResource TnPWarningContentWL}"
									VerticalTextAlignment="Center" />
								<controls:TextButton
									Grid.Column="1"
									Command="{Binding RefreshTokenCommand}"
									LabelData="{l:Localize Retry}"
									Style="{DynamicResource TransparentTextButton}" />
							</Grid>
						</Border>

						<Border
							IsVisible="{Binding HasTokenNoteCommands}"
							Padding="16"
							Style="{DynamicResource BorderSet}">
							<VerticalStackLayout Spacing="10">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									SemanticProperties.HeadingLevel="Level2"
									Text="{l:Localize TokenDefinedActions}" />
								<Label
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize TokenDefinedActionsDescription}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenActionTemplate}"
									BindableLayout.ItemsSource="{Binding TokenDefinedActions}" />
							</VerticalStackLayout>
						</Border>

						<Border
							IsVisible="{Binding HasSelectedTokenNoteCommand}"
							Padding="16"
							Style="{DynamicResource BorderSet}">
							<VerticalStackLayout Spacing="12">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									SemanticProperties.HeadingLevel="Level2"
									Text="{Binding SelectedTokenNoteCommand.Title}" />
								<Label
									IsVisible="{Binding SelectedTokenNoteCommand.HasHelpText}"
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{Binding SelectedTokenNoteCommand.HelpText}"
									TextColor="{DynamicResource ContentSecondaryWL}" />

								<Border Padding="12" Style="{DynamicResource BorderSubSet}">
									<VerticalStackLayout Spacing="6">
										<Label
											FontAttributes="Bold"
											Text="{Binding SelectedTokenCommandRoleText}"
											TextColor="{DynamicResource ContentPrimaryWL}" />
										<Grid
											IsVisible="{Binding SelectedTokenNoteCommand.HasCurrentState}"
											ColumnDefinitions="Auto,*"
											ColumnSpacing="8">
											<Label
												Style="{DynamicResource ItemDescriptionLabel}"
												Text="{l:Localize CurrentState}"
												TextColor="{DynamicResource ContentSecondaryWL}" />
											<Label
												Grid.Column="1"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedTokenNoteCommand.CurrentState}"
												TextColor="{DynamicResource ContentPrimaryWL}" />
										</Grid>
										<Label
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding SelectedTokenCommandVisibilityText}"
											TextColor="{DynamicResource ContentSecondaryWL}" />
									</VerticalStackLayout>
								</Border>

								<VerticalStackLayout
									IsVisible="{Binding HasSelectedTokenCommandParameters}"
									Spacing="8">
									<Label
										FontAttributes="Bold"
										SemanticProperties.HeadingLevel="Level3"
										Text="{l:Localize Parameters}" />
									<VerticalStackLayout
										BindableLayout.ItemTemplate="{StaticResource TokenCommandParameterTemplateSelector}"
										BindableLayout.ItemsSource="{Binding SelectedTokenCommandParameters}" />
								</VerticalStackLayout>

								<Border
									IsVisible="{Binding HasTokenCommandExecutionFeedback}"
									Padding="12"
									BackgroundColor="{DynamicResource TnPWarningbgWL}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										Text="{Binding TokenCommandExecutionFeedback}"
										TextColor="{DynamicResource TnPWarningContentWL}" />
								</Border>

								<ActivityIndicator
									Color="{DynamicResource ContentPrimaryWL}"
									HorizontalOptions="Center"
									IsRunning="{Binding IsExecutingTokenCommand}"
									IsVisible="{Binding IsExecutingTokenCommand}" />
								<controls:TextButton
									Command="{Binding ContinueTokenCommandCommand}"
									IsEnabled="{Binding CanContinueTokenCommand}"
									LabelData="{l:Localize Continue}"
									Style="{DynamicResource FilledTextButton}" />
								<controls:TextButton
									Command="{Binding CancelTokenCommandCommand}"
									IsEnabled="{Binding CanCancelTokenCommand}"
									LabelData="{l:Localize Cancel}"
									Style="{DynamicResource OutlinedTextButton}" />
							</VerticalStackLayout>
						</Border>

						<Border
							IsVisible="{Binding HasRelationships}"
							Padding="16"
							Style="{DynamicResource BorderSet}">
							<VerticalStackLayout Spacing="8">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									SemanticProperties.HeadingLevel="Level2"
									Text="{l:Localize PeopleAndSignatures}" />
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenPartItemTemplate}"
									BindableLayout.ItemsSource="{Binding Relationships}" />
							</VerticalStackLayout>
						</Border>

						<Border
							IsVisible="{Binding HasRelatedContracts}"
							Padding="16"
							Style="{DynamicResource BorderSet}">
							<VerticalStackLayout Spacing="8">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									SemanticProperties.HeadingLevel="Level2"
									Text="{l:Localize RelatedContract}" />
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenTechnicalItemTemplate}"
									BindableLayout.ItemsSource="{Binding RelatedContracts}" />
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout
						IsVisible="{Binding IsActivitySelected}"
						Spacing="12">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
							<Label
								FontAttributes="Bold"
								FontSize="20"
								SemanticProperties.HeadingLevel="Level2"
								Text="{l:Localize Activity}"
								VerticalTextAlignment="Center" />
							<controls:TextButton
								Grid.Column="1"
								Command="{Binding AddTokenUpdateCommand}"
								IsVisible="{Binding CanAddTokenUpdate}"
								LabelData="{l:Localize AddTokenUpdate}"
								Style="{DynamicResource FilledTextButton}" />
						</Grid>

						<Border
							IsVisible="{Binding HasActivityError}"
							Padding="14"
							BackgroundColor="{DynamicResource TnPWarningbgWL}"
							StrokeShape="RoundRectangle 8"
							StrokeThickness="0">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<Label
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{Binding ActivityErrorMessage}"
									TextColor="{DynamicResource ContentPrimaryWL}"
									VerticalTextAlignment="Center" />
								<controls:TextButton
									Grid.Column="1"
									Command="{Binding RefreshTokenCommand}"
									IsEnabled="{Binding IsActivityLoading, Converter={StaticResource InvertedBoolConverter}}"
									LabelData="{l:Localize Retry}"
									Style="{DynamicResource TransparentTextButton}" />
							</Grid>
						</Border>

						<VerticalStackLayout
							IsVisible="{Binding IsActivityLoading}"
							Padding="20"
							Spacing="10">
							<ActivityIndicator
								Color="{DynamicResource ContentPrimaryWL}"
								HorizontalOptions="Center"
								IsRunning="{Binding IsActivityLoading}" />
							<Label
								HorizontalTextAlignment="Center"
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{l:Localize Refreshing}"
								TextColor="{DynamicResource ContentSecondaryWL}" />
						</VerticalStackLayout>

						<Border
							IsVisible="{Binding ShowActivityEmpty}"
							Padding="20"
							Style="{DynamicResource BorderSet}">
							<VerticalStackLayout Spacing="10">
								<Label
									FontAttributes="Bold"
									FontSize="20"
									HorizontalTextAlignment="Center"
									SemanticProperties.HeadingLevel="Level2"
									Text="{l:Localize TokenActivityEmptyTitle}" />
								<Label
									HorizontalTextAlignment="Center"
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize TokenActivityEmptyDescription}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
						</Border>

						<VerticalStackLayout
							BindableLayout.ItemTemplate="{StaticResource TokenActivityItemTemplate}"
							BindableLayout.ItemsSource="{Binding ActivityItems}"
							IsVisible="{Binding HasActivityItems}" />
					</VerticalStackLayout>

					<VerticalStackLayout
						IsVisible="{Binding IsAdvancedSelected}"
						Spacing="10">
						<controls:DisclosureSection
							Summary="{l:Localize MachineReadableInfoTextToken}"
							Title="{l:Localize TechnicalDetails}">
							<VerticalStackLayout Spacing="4">
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenTechnicalItemTemplate}"
									BindableLayout.ItemsSource="{Binding TechnicalItems}" />
								<Label
									FontAttributes="Bold"
									IsVisible="{Binding HasTags}"
									Margin="0,10,0,2"
									SemanticProperties.HeadingLevel="Level3"
									Text="{l:Localize Tags}" />
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenTechnicalItemTemplate}"
									BindableLayout.ItemsSource="{Binding TagItems}"
									IsVisible="{Binding HasTags}" />
							</VerticalStackLayout>
						</controls:DisclosureSection>

						<controls:DisclosureSection
							IsVisible="{Binding HasParticipants}"
							Summary="{l:Localize TokenPartsInfoText}"
							Title="{l:Localize PeopleAndSignatures}">
							<VerticalStackLayout
								BindableLayout.ItemTemplate="{StaticResource TokenPartItemTemplate}"
								BindableLayout.ItemsSource="{Binding Participants}" />
						</controls:DisclosureSection>

						<controls:DisclosureSection
							IsVisible="{Binding HasPermissions}"
							Summary="{l:Localize TokenRulesAndPermissionsDescription}"
							Title="{l:Localize TokenRulesAndPermissions}">
							<VerticalStackLayout
								BindableLayout.ItemTemplate="{StaticResource TokenTechnicalItemTemplate}"
								BindableLayout.ItemsSource="{Binding PermissionItems}" />
						</controls:DisclosureSection>

						<controls:DisclosureSection
							Summary="{l:Localize StateAndVariablesDescription}"
							Title="{l:Localize StateAndVariables}">
							<VerticalStackLayout Spacing="8">
								<controls:TextButton
									Command="{Binding VariablesReportCommand}"
									IsVisible="{Binding HasStateMachine}"
									LabelData="{l:Localize Variables}"
									Style="{DynamicResource OutlinedTextButton}" />
								<Label
									IsVisible="{Binding HasStateMachine, Converter={StaticResource InvertedBoolConverter}}"
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize StateMachineUnavailableDescription}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
						</controls:DisclosureSection>

						<controls:DisclosureSection
							Summary="{l:Localize ReportsAndPresentationDescription}"
							Title="{l:Localize ReportsAndPresentation}">
							<VerticalStackLayout Spacing="8">
								<controls:TextButton
									Command="{Binding PresentEmbeddedLayoutCommand}"
									IsVisible="{Binding HasEmbeddedLayout}"
									LabelData="{l:Localize ViewEmbeddedLayout}"
									Style="{DynamicResource OutlinedTextButton}" />
								<controls:TextButton
									Command="{Binding PresentReportCommand}"
									IsVisible="{Binding HasStateMachine}"
									LabelData="{l:Localize Present}"
									Style="{DynamicResource OutlinedTextButton}" />
								<controls:TextButton
									Command="{Binding HistoryReportCommand}"
									IsVisible="{Binding HasStateMachine}"
									LabelData="{l:Localize History}"
									Style="{DynamicResource OutlinedTextButton}" />
								<controls:TextButton
									Command="{Binding StatesReportCommand}"
									IsVisible="{Binding HasStateMachine}"
									LabelData="{l:Localize States}"
									Style="{DynamicResource OutlinedTextButton}" />
								<controls:TextButton
									Command="{Binding ProfilingReportCommand}"
									IsVisible="{Binding HasStateMachine}"
									LabelData="{l:Localize Profiling}"
									Style="{DynamicResource OutlinedTextButton}" />
								<Label
									IsVisible="{Binding HasAdvancedPresentations, Converter={StaticResource InvertedBoolConverter}}"
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize ReportsAndPresentationUnavailable}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
						</controls:DisclosureSection>

						<controls:DisclosureSection
							IsVisible="{Binding HasMarketplaceActions}"
							Summary="{l:Localize MarketplaceActionsDescription}"
							Title="{l:Localize MarketplaceActions}">
							<VerticalStackLayout
								BindableLayout.ItemTemplate="{StaticResource TokenActionTemplate}"
								BindableLayout.ItemsSource="{Binding MarketplaceActions}" />
						</controls:DisclosureSection>

						<controls:DisclosureSection
							Summary="{l:Localize RawDetailsDescription}"
							Title="{l:Localize RawDetails}">
							<VerticalStackLayout Spacing="8">
								<VerticalStackLayout
									BindableLayout.ItemTemplate="{StaticResource TokenTechnicalItemTemplate}"
									BindableLayout.ItemsSource="{Binding RawItems}" />
								<controls:TextButton
									Command="{Binding ShowM2mInfoCommand}"
									IsVisible="{Binding HasMachineReadableDefinition}"
									LabelData="{l:Localize ShowM2MInfo}"
									Style="{DynamicResource OutlinedTextButton}" />
								<Label
									IsVisible="{Binding HasRawDetails, Converter={StaticResource InvertedBoolConverter}}"
									Style="{DynamicResource ItemDescriptionLabel}"
									Text="{l:Localize RawDetailsUnavailable}"
									TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
						</controls:DisclosureSection>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</ScrollView>

			<VerticalStackLayout
				HorizontalOptions="Center"
				IsVisible="{Binding IsInitialLoading}"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator
					HorizontalOptions="Center"
					IsRunning="{Binding IsInitialLoading}" />
				<Label
					HorizontalTextAlignment="Center"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{l:Localize LoadingTokens}" />
			</VerticalStackLayout>

			<VerticalStackLayout
				HorizontalOptions="Center"
				IsVisible="{Binding HasLoadError}"
				MaximumWidthRequest="440"
				Padding="24"
				Spacing="12"
				VerticalOptions="Center">
				<VerticalStackLayout.Triggers>
					<DataTrigger
						Binding="{Binding HasContent}"
						TargetType="VerticalStackLayout"
						Value="True">
						<Setter Property="IsVisible" Value="False" />
					</DataTrigger>
				</VerticalStackLayout.Triggers>
				<Label
					FontAttributes="Bold"
					FontSize="20"
					HorizontalTextAlignment="Center"
					Text="{l:Localize Unavailable}" />
				<Label
					HorizontalTextAlignment="Center"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding LoadErrorMessage}"
					TextColor="{DynamicResource ContentSecondaryWL}" />
				<controls:TextButton
					Command="{Binding RefreshTokenCommand}"
					LabelData="{l:Localize Retry}"
					Style="{DynamicResource FilledTextButton}" />
			</VerticalStackLayout>
		</Grid>
	</Grid>
</base:BaseContentPage>
