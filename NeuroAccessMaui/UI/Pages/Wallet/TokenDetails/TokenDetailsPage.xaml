<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
							 x:Class="NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.TokenDetailsPage"
							 x:DataType="viewmodel:TokenDetailsViewModel"
							 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
							 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
							 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
							 xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails.Views"
							 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenDetails"
							 xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
	<base:BaseContentPage.Resources>
		<!-- A labeled value as a row of a card. Values that open something are links. A tap opens, a long press copies. -->
		<DataTemplate x:Key="PropertyRowTemplate"
					  x:DataType="viewmodel:TokenPropertyItem">
			<Grid SemanticProperties.Description="{Binding AccessibleDescription}"
				  SemanticProperties.Hint="{Binding AccessibleHint}">
				<Grid.Behaviors>
					<mct:TouchBehavior Command="{Binding OpenCommand}"
									   LongPressCommand="{Binding CopyCommand}"
									   PressedOpacity="0.6" />
				</Grid.Behaviors>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}"
										  DividerInset="16" />
				<VerticalStackLayout Padding="16,10"
									 Spacing="2"
									 MinimumHeightRequest="60">
					<Label Text="{Binding Label}"
						   FontSize="{StaticResource FontSizeSm}"
						   TextColor="{DynamicResource ContentSecondaryWL}"
						   LineBreakMode="TailTruncation"
						   MaxLines="1" />
					<Label Text="{Binding Value}"
						   FontSize="{StaticResource FontSizeMd}"
						   TextColor="{DynamicResource ContentPrimaryWL}"
						   LineBreakMode="CharacterWrap">
						<Label.Triggers>
							<DataTrigger TargetType="Label"
										 Binding="{Binding IsActionable}"
										 Value="True">
								<Setter Property="TextColor"
										Value="{DynamicResource ContentAccessWL}" />
								<Setter Property="FontFamily"
										Value="SpaceGroteskSemiBold" />
							</DataTrigger>
						</Label.Triggers>
					</Label>
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>
	</base:BaseContentPage.Resources>

	<!-- Built from the same parts as My Tokens: a centered header, and cards with thin dividers. Selling and buying are
		 under More. -->
	<controls:IdentityFlowShell Title="{l:Localize TokenDetails}"
								ShowLeadingAction="True"
								LeadingActionCommand="{Binding GoBackCommand}"
								LeadingActionDescription="{l:Localize Close}">
		<controls:IdentityFlowShell.BodyContent>
			<ScrollView>
				<VerticalStackLayout Padding="16,4,16,24">

					<!-- Banners -->
					<Border IsVisible="{Binding IsUnverifiedCopy}"
							Style="{DynamicResource IdentityFlowWarningCard}"
							Margin="0,0,0,12">
						<Label Text="{l:Localize TokenUnverifiedCopy}"
							   TextColor="{DynamicResource TnPWarningContentWL}" />
					</Border>
					<Border IsVisible="{Binding ChangedSinceShared}"
							Style="{DynamicResource IdentityFlowWarningCard}"
							Margin="0,0,0,12">
						<Label Text="{l:Localize TokenChangedSinceShared}"
							   TextColor="{DynamicResource TnPWarningContentWL}" />
					</Border>
					<Border IsVisible="{Binding HasLeftWallet}"
							Style="{DynamicResource IdentityFlowInfoCard}"
							Margin="0,0,0,12">
						<Label Text="{l:Localize TokenNoLongerInWallet}"
							   TextColor="{DynamicResource TnPInfoContentWL}" />
					</Border>

					<!-- Hero: the glyph on a tile, the name and category, the value, and chips for who owns it, its state and
						 its expiry. An embedded layout is shown above them. -->
					<Border Style="{DynamicResource IdentityFlowCard}">
						<VerticalStackLayout Spacing="14">
							<controls:TemplatedButton IsVisible="{Binding HasEmbeddedLayoutImage}"
													  Command="{Binding PresentEmbeddedLayoutCommand}"
													  HorizontalOptions="Center"
													  SemanticProperties.Description="{l:Localize ViewEmbeddedLayout}">
								<Image Source="{Binding EmbeddedLayoutImage}"
									   Aspect="AspectFit"
									   MaximumHeightRequest="240"
									   HorizontalOptions="Center"
									   AutomationProperties.IsInAccessibleTree="False" />
							</controls:TemplatedButton>

							<Grid ColumnDefinitions="64,*,Auto"
								  ColumnSpacing="14">
								<Border Grid.Column="0"
										Style="{DynamicResource ListCardTileBorder}"
										WidthRequest="64"
										HeightRequest="64"
										StrokeShape="RoundRectangle 16">
									<Grid>
										<Image Source="{Binding GlyphImage}"
											   IsVisible="{Binding HasGlyphImage}"
											   WidthRequest="44"
											   HeightRequest="44"
											   Aspect="AspectFit"
											   HorizontalOptions="Center"
											   VerticalOptions="Center"
											   AutomationProperties.IsInAccessibleTree="False" />
										<Path Data="{x:Static ui:Geometries.TokenPath}"
											  IsVisible="{Binding ShowGlyphPlaceholder}"
											  Fill="{DynamicResource ContentAccessWL}"
											  Aspect="Uniform"
											  WidthRequest="30"
											  HeightRequest="30"
											  HorizontalOptions="Center"
											  VerticalOptions="Center"
											  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</Border>

								<VerticalStackLayout Grid.Column="1"
													 Spacing="4"
													 VerticalOptions="Center">
									<Label Text="{Binding FriendlyName}"
										   FontFamily="SpaceGroteskBold"
										   FontSize="{StaticResource FontSize2xl}"
										   TextColor="{DynamicResource ContentPrimaryWL}"
										   LineBreakMode="TailTruncation"
										   MaxLines="2"
										   SemanticProperties.HeadingLevel="Level1" />
									<Label Text="{Binding Category}"
										   IsVisible="{Binding HasCategory}"
										   Style="{DynamicResource ListCardRowDetailLabel}" />
								</VerticalStackLayout>

								<VerticalStackLayout Grid.Column="2"
													 Spacing="0"
													 VerticalOptions="Center"
													 HorizontalOptions="End">
									<Label Text="{Binding Value, Converter={converters:MoneyToString}}"
										   Style="{DynamicResource ListCardRowTitleLabel}"
										   FontSize="{StaticResource FontSizeXl}"
										   HorizontalOptions="End"
										   HorizontalTextAlignment="End"
										   LineBreakMode="NoWrap" />
									<Label Text="{Binding Currency}"
										   Style="{DynamicResource ListCardRowDetailLabel}"
										   HorizontalOptions="End"
										   HorizontalTextAlignment="End"
										   LineBreakMode="NoWrap" />
								</VerticalStackLayout>
							</Grid>

							<FlexLayout Direction="Row"
										Wrap="Wrap"
										AlignItems="Center"
										Margin="0,0,0,-8">
								<!-- Who owns it -->
								<Border IsVisible="{Binding IsVerified}"
										Style="{DynamicResource ListCardHeroChipBorder}"
										BackgroundColor="{DynamicResource TnPInfobgWL}">
									<Border.Triggers>
										<DataTrigger TargetType="Border"
													 Binding="{Binding IsMyToken}"
													 Value="True">
											<Setter Property="BackgroundColor"
													Value="{DynamicResource TnPSuccessbgWL}" />
										</DataTrigger>
									</Border.Triggers>
									<Label Text="{Binding OwnershipText}"
										   Style="{DynamicResource ListCardHeroChipLabel}"
										   TextColor="{DynamicResource TnPInfoContentWL}">
										<Label.Triggers>
											<DataTrigger TargetType="Label"
														 Binding="{Binding IsMyToken}"
														 Value="True">
												<Setter Property="TextColor"
														Value="{DynamicResource ContentAccessWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>

								<!-- The state machine's current state, or that it has ended -->
								<Border IsVisible="{Binding IsMachineStateKnown}"
										Style="{DynamicResource ListCardHeroChipBorder}"
										BackgroundColor="{DynamicResource TnPInfobgWL}"
										SemanticProperties.Description="{Binding MachineStateDescription}">
									<Border.Triggers>
										<DataTrigger TargetType="Border"
													 Binding="{Binding MachineEnded}"
													 Value="True">
											<Setter Property="BackgroundColor"
													Value="{DynamicResource SurfaceDividerWL}" />
										</DataTrigger>
									</Border.Triggers>
									<HorizontalStackLayout Spacing="6">
										<Ellipse WidthRequest="7"
												 HeightRequest="7"
												 VerticalOptions="Center"
												 Fill="{DynamicResource ContentAccessWL}"
												 AutomationProperties.IsInAccessibleTree="False">
											<Ellipse.Triggers>
												<DataTrigger TargetType="Ellipse"
															 Binding="{Binding MachineEnded}"
															 Value="True">
													<Setter Property="Fill"
															Value="{DynamicResource ContentSecondaryWL}" />
												</DataTrigger>
											</Ellipse.Triggers>
										</Ellipse>
										<Label Text="{Binding MachineStateText}"
											   Style="{DynamicResource ListCardHeroChipLabel}"
											   TextColor="{DynamicResource ContentPrimaryWL}" />
									</HorizontalStackLayout>
								</Border>

								<!-- Expiry -->
								<Border IsVisible="{Binding HasExpiryText}"
										Style="{DynamicResource ListCardHeroChipBorder}"
										BackgroundColor="{DynamicResource TnPWarningbgWL}">
									<Border.Triggers>
										<DataTrigger TargetType="Border"
													 Binding="{Binding IsExpired}"
													 Value="True">
											<Setter Property="BackgroundColor"
													Value="{DynamicResource TnPDangerbgWL}" />
										</DataTrigger>
									</Border.Triggers>
									<Label Text="{Binding ExpiryText}"
										   Style="{DynamicResource ListCardHeroChipLabel}"
										   TextColor="{DynamicResource TnPWarningContentWL}">
										<Label.Triggers>
											<DataTrigger TargetType="Label"
														 Binding="{Binding IsExpired}"
														 Value="True">
												<Setter Property="TextColor"
														Value="{DynamicResource TnPDangerContentWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>
							</FlexLayout>
						</VerticalStackLayout>
					</Border>

					<!-- Quick actions, sharing the width equally. Give appears once its template is found. More holds the rest. The gaps are padding inside each tile, since FlexLayout misplaces children with margins. -->
					<FlexLayout Direction="Row"
								AlignItems="Stretch"
								Margin="-4,12,-4,0">
						<controls:TemplatedButton FlexLayout.Grow="1"
												  FlexLayout.Basis="0"
												  Padding="4,0"
												  Command="{Binding GiveCommand}"
												  IsVisible="{Binding CanGive}"
												  SemanticProperties.Description="{l:Localize Give}">
							<Border Style="{DynamicResource ListCardActionTileBorder}">
								<VerticalStackLayout Spacing="6"
													 VerticalOptions="Center">
									<controls:SvgView Source="gift.svg"
													  WidthRequest="20"
													  HeightRequest="20"
													  HorizontalOptions="Center"
													  TintColor="{DynamicResource ContentPrimaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
									<Label Text="{l:Localize Give}"
										   Style="{DynamicResource ListCardActionTileLabel}" />
								</VerticalStackLayout>
							</Border>
						</controls:TemplatedButton>

						<controls:TemplatedButton FlexLayout.Grow="1"
												  FlexLayout.Basis="0"
												  Padding="4,0"
												  Command="{Binding ShareCommand}"
												  SemanticProperties.Description="{l:Localize Share}">
							<Border Style="{DynamicResource ListCardActionTileBorder}">
								<VerticalStackLayout Spacing="6"
													 VerticalOptions="Center">
									<controls:SvgView Source="share.svg"
													  WidthRequest="20"
													  HeightRequest="20"
													  HorizontalOptions="Center"
													  TintColor="{DynamicResource ContentPrimaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
									<Label Text="{l:Localize Share}"
										   Style="{DynamicResource ListCardActionTileLabel}" />
								</VerticalStackLayout>
							</Border>
						</controls:TemplatedButton>

						<controls:TemplatedButton FlexLayout.Grow="1"
												  FlexLayout.Basis="0"
												  Padding="4,0"
												  Command="{Binding ViewEventsCommand}"
												  IsVisible="{Binding CanViewHistory}"
												  SemanticProperties.Description="{Binding HistoryLabel}">
							<Border Style="{DynamicResource ListCardActionTileBorder}">
								<VerticalStackLayout Spacing="6"
													 VerticalOptions="Center">
									<controls:SvgView Source="history.svg"
													  WidthRequest="20"
													  HeightRequest="20"
													  HorizontalOptions="Center"
													  TintColor="{DynamicResource ContentPrimaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
									<Label Text="{l:Localize History}"
										   Style="{DynamicResource ListCardActionTileLabel}" />
								</VerticalStackLayout>
							</Border>
						</controls:TemplatedButton>

						<controls:TemplatedButton FlexLayout.Grow="1"
												  FlexLayout.Basis="0"
												  Padding="4,0"
												  Command="{Binding ToggleMoreCommand}"
												  SemanticProperties.Description="{l:Localize More}">
							<Border Style="{DynamicResource ListCardActionTileBorder}">
								<Border.Triggers>
									<DataTrigger TargetType="Border"
												 Binding="{Binding IsMoreVisible}"
												 Value="True">
										<Setter Property="Stroke"
												Value="{DynamicResource ContentPrimaryWL}" />
									</DataTrigger>
								</Border.Triggers>
								<VerticalStackLayout Spacing="6"
													 VerticalOptions="Center">
									<controls:SvgView Source="more_horiz.svg"
													  WidthRequest="20"
													  HeightRequest="20"
													  HorizontalOptions="Center"
													  TintColor="{DynamicResource ContentPrimaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
									<Label Text="{l:Localize More}"
										   Style="{DynamicResource ListCardActionTileLabel}" />
								</VerticalStackLayout>
							</Border>
						</controls:TemplatedButton>
					</FlexLayout>

					<!-- More: selling or offering to buy, and the actions that are used less often. "Send to contact" is always
						 there, so the rows above it have their divider below, and the rows after it above. -->
					<Border Style="{DynamicResource ListCardBorder}"
							Margin="0,8,0,0"
							IsVisible="False"
							controls:Reveal.IsShown="{Binding IsMoreVisible}">
						<VerticalStackLayout>
							<!-- A row shaped like "Offer to sell" while the templates for selling and buying are looked up -->
							<VerticalStackLayout IsVisible="{Binding IsLoadingTradeActions}"
												 AutomationProperties.IsInAccessibleTree="False">
								<Grid ColumnDefinitions="*,Auto"
									  Padding="16,0"
									  HeightRequest="52">
									<Grid ColumnDefinitions="40*,60*"
										  VerticalOptions="Center">
										<BoxView Style="{DynamicResource ListCardPlaceholderTitle}" />
									</Grid>
								</Grid>
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
							</VerticalStackLayout>
							<VerticalStackLayout IsVisible="{Binding CanOfferToSell}">
								<controls:TemplatedButton Command="{Binding OfferToSellCommand}"
														  SemanticProperties.Description="{l:Localize OfferToSell}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize OfferToSell}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
							</VerticalStackLayout>
							<VerticalStackLayout IsVisible="{Binding CanConsign}">
								<controls:TemplatedButton Command="{Binding PublishMarketplaceCommand}"
														  SemanticProperties.Description="{l:Localize ConsignToAuction}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize ConsignToAuction}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
							</VerticalStackLayout>
							<VerticalStackLayout IsVisible="{Binding CanOfferToBuy}">
								<controls:TemplatedButton Command="{Binding OfferToBuyCommand}"
														  SemanticProperties.Description="{l:Localize OfferToBuy}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize OfferToBuy}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
							</VerticalStackLayout>
							<controls:TemplatedButton Command="{Binding SendToContactCommand}"
													  SemanticProperties.Description="{l:Localize SendToContact}">
								<Grid ColumnDefinitions="*,Auto"
									  ColumnSpacing="12"
									  Padding="16,0"
									  MinimumHeightRequest="52">
									<Label Text="{l:Localize SendToContact}"
										   Style="{DynamicResource ListCardRowTitleLabel}" />
									<controls:SvgView Grid.Column="1"
													  Source="arrow_forward_ios.svg"
													  WidthRequest="14"
													  HeightRequest="14"
													  VerticalOptions="Center"
													  TintColor="{DynamicResource ContentSecondaryWL}"
													  AutomationProperties.IsInAccessibleTree="False" />
								</Grid>
							</controls:TemplatedButton>
							<VerticalStackLayout IsVisible="{Binding HasWebUrl}">
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
								<controls:TemplatedButton Command="{Binding OpenOnWebCommand}"
														  SemanticProperties.Description="{l:Localize OpenOnWeb}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize OpenOnWeb}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
								<controls:TemplatedButton Command="{Binding ShareLinkCommand}"
														  SemanticProperties.Description="{l:Localize ShareLink}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize ShareLink}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
							</VerticalStackLayout>
							<VerticalStackLayout IsVisible="{Binding IsVerified}">
								<BoxView Style="{DynamicResource ListCardRowDivider}" />
								<controls:TemplatedButton Command="{Binding ViewDefinitionCommand}"
														  SemanticProperties.Description="{l:Localize ViewDefinition}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize ViewDefinition}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>

					<Label Text="{Binding TransferBlockedText}"
						   IsVisible="{Binding HasTransferBlockedText}"
						   Style="{DynamicResource IdentityFlowCaptionLabel}"
						   Margin="8,12,8,0" />

					<!-- State, Actions and Reports -->
					<views:TokenStateMachineView IsVisible="{Binding HasStateMachine}" />

					<!-- Description -->
					<VerticalStackLayout IsVisible="{Binding HasDescription}">
						<Label Text="{l:Localize Description}"
							   Style="{DynamicResource ListCardSectionLabel}" />
						<Border Style="{DynamicResource IdentityFlowCard}">
							<controls:TaskView Task="{Binding DescriptionTask}">
								<controls:TaskView.RunningView>
									<!-- Lines shaped like text while the description loads -->
									<VerticalStackLayout Spacing="10"
														 AutomationProperties.IsInAccessibleTree="False">
										<Grid ColumnDefinitions="92*,8*">
											<BoxView Style="{DynamicResource ListCardPlaceholderSubtitle}" />
										</Grid>
										<Grid ColumnDefinitions="78*,22*">
											<BoxView Style="{DynamicResource ListCardPlaceholderSubtitle}" />
										</Grid>
										<Grid ColumnDefinitions="54*,46*">
											<BoxView Style="{DynamicResource ListCardPlaceholderSubtitle}" />
										</Grid>
									</VerticalStackLayout>
								</controls:TaskView.RunningView>
								<controls:TaskView.ErrorView>
									<controls:TextButton LabelData="{l:Localize TryAgain}"
														 Command="{Binding DescriptionTask.ReloadCommand}"
														 Style="{DynamicResource OutlinedTextButton}"
														 HorizontalOptions="Start" />
								</controls:TaskView.ErrorView>
								<controls:TaskView.SucceededView>
									<ContentView Content="{Binding Description}"
												 VerticalOptions="Start" />
								</controls:TaskView.SucceededView>
							</controls:TaskView>
						</Border>
					</VerticalStackLayout>

					<!-- Ownership and dates -->
					<Label Text="{l:Localize OwnershipAndDates}"
						   Style="{DynamicResource ListCardSectionLabel}" />
					<VerticalStackLayout controls:ListCard.IsEnabled="True"
										 BindableLayout.ItemsSource="{Binding OwnershipProperties}"
										 BindableLayout.ItemTemplate="{StaticResource PropertyRowTemplate}" />

					<!-- Tags -->
					<VerticalStackLayout IsVisible="{Binding HasTags}">
						<Label Text="{l:Localize Tags}"
							   Style="{DynamicResource ListCardSectionLabel}" />
						<VerticalStackLayout controls:ListCard.IsEnabled="True"
											 BindableLayout.ItemsSource="{Binding Tags}"
											 BindableLayout.ItemTemplate="{StaticResource PropertyRowTemplate}" />
					</VerticalStackLayout>

					<!-- Technical details, collapsed until asked for -->
					<Border Style="{DynamicResource ListCardBorder}"
							Margin="0,20,0,0">
						<controls:TemplatedButton Command="{Binding ToggleTechnicalDetailsCommand}"
												  SemanticProperties.Description="{l:Localize TechnicalDetails}">
							<Grid ColumnDefinitions="*,Auto"
								  ColumnSpacing="12"
								  Padding="16,0"
								  MinimumHeightRequest="56">
								<Label Grid.Column="0"
									   Text="{l:Localize TechnicalDetails}"
									   Style="{DynamicResource ListCardRowTitleLabel}"
									   SemanticProperties.HeadingLevel="Level2" />
								<Path Grid.Column="1"
									  Data="{x:Static ui:Geometries.DropDownArrowPath}"
									  Fill="{DynamicResource ContentSecondaryWL}"
									  VerticalOptions="Center"
									  AutomationProperties.IsInAccessibleTree="False">
									<Path.Triggers>
										<DataTrigger TargetType="Path"
													 Binding="{Binding IsTechnicalDetailsExpanded}"
													 Value="True">
											<Setter Property="Rotation"
													Value="180" />
										</DataTrigger>
									</Path.Triggers>
								</Path>
							</Grid>
						</controls:TemplatedButton>
					</Border>

					<VerticalStackLayout IsVisible="False"
										 controls:Reveal.IsShown="{Binding IsTechnicalDetailsExpanded}">
						<VerticalStackLayout Margin="0,8,0,0"
											 controls:ListCard.IsEnabled="True"
											 BindableLayout.ItemsSource="{Binding TechnicalProperties}"
											 BindableLayout.ItemTemplate="{StaticResource PropertyRowTemplate}" />

						<!-- Profiling and the embedded layout, for those who build tokens -->
						<Border IsVisible="{Binding HasTechnicalLinks}"
								Style="{DynamicResource ListCardBorder}"
								Margin="0,8,0,0">
							<VerticalStackLayout>
								<controls:TemplatedButton Command="{Binding ProfilingReportCommand}"
														  IsVisible="{Binding HasStateMachine}"
														  SemanticProperties.Description="{l:Localize Profiling}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="16,0"
										  MinimumHeightRequest="52">
										<Label Text="{l:Localize Profiling}"
											   Style="{DynamicResource ListCardRowTitleLabel}" />
										<controls:SvgView Grid.Column="1"
														  Source="arrow_forward_ios.svg"
														  WidthRequest="14"
														  HeightRequest="14"
														  VerticalOptions="Center"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
								<VerticalStackLayout IsVisible="{Binding HasEmbeddedLayout}">
									<BoxView Style="{DynamicResource ListCardRowDivider}"
											 IsVisible="{Binding HasStateMachine}" />
									<controls:TemplatedButton Command="{Binding PresentEmbeddedLayoutCommand}"
															  SemanticProperties.Description="{l:Localize ViewEmbeddedLayout}">
										<Grid ColumnDefinitions="*,Auto"
											  ColumnSpacing="12"
											  Padding="16,0"
											  MinimumHeightRequest="52">
											<Label Text="{l:Localize ViewEmbeddedLayout}"
												   Style="{DynamicResource ListCardRowTitleLabel}" />
											<controls:SvgView Grid.Column="1"
															  Source="arrow_forward_ios.svg"
															  WidthRequest="14"
															  HeightRequest="14"
															  VerticalOptions="Center"
															  TintColor="{DynamicResource ContentSecondaryWL}"
															  AutomationProperties.IsInAccessibleTree="False" />
										</Grid>
									</controls:TemplatedButton>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>

					<!-- Destroying can't be undone, so it is kept apart from the other actions, at the end -->
					<controls:TemplatedButton Command="{Binding DestroyCommand}"
											  IsVisible="{Binding CanDestroy}"
											  Margin="0,20,0,0"
											  SemanticProperties.Description="{l:Localize DestroyToken}">
						<Border HeightRequest="48"
								BackgroundColor="Transparent"
								Stroke="{DynamicResource ButtonDangerPrimarybgWL}"
								StrokeThickness="1.5"
								StrokeShape="RoundRectangle 8">
							<Label Text="{l:Localize DestroyToken}"
								   FontFamily="SpaceGroteskBold"
								   FontSize="{StaticResource FontSizeLg}"
								   TextColor="{DynamicResource ButtonDangerPrimarybgWL}"
								   HorizontalOptions="Center"
								   VerticalOptions="Center" />
						</Border>
					</controls:TemplatedButton>
				</VerticalStackLayout>
			</ScrollView>
		</controls:IdentityFlowShell.BodyContent>
	</controls:IdentityFlowShell>
</base:BaseContentPage>
