<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
							 x:Class="NeuroAccessMaui.UI.Pages.Wallet.MachineReport.MachineReportPage"
							 x:DataType="viewmodel:MachineReportViewModel"
							 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							 xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
							 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
							 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
							 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							 xmlns:md="clr-namespace:NeuroAccessMaui.UI.Controls.Markdown"
							 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
							 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MachineReport">
	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}" RowDefinitions="auto, *">

		<controls:Background Grid.RowSpan="2"/>

		<controls:TaskView x:Name="Body" Grid.Row="1" Task="{Binding ReportTask}">
			<controls:TaskView.RunningView>
				<ActivityIndicator IsRunning="True" Color="{DynamicResource PrimaryWL}" HorizontalOptions="Center" VerticalOptions="Center"/>
			</controls:TaskView.RunningView>
			<controls:TaskView.ErrorView>
				<VerticalStackLayout Padding="16" Spacing="{DynamicResource MediumSpacing}" VerticalOptions="Center">
					<Label Text="{l:Localize SomethingWentWrong}" Style="{DynamicResource SectionTitleLabel}" HorizontalTextAlignment="Center"/>
					<controls:TextButton LabelData="{l:Localize TryAgain}" Command="{Binding ReportTask.ReloadCommand}"
										 Style="{DynamicResource FilledTextButton}" HorizontalOptions="Center"/>
				</VerticalStackLayout>
			</controls:TaskView.ErrorView>
			<controls:TaskView.SucceededView>
				<Grid>
					<!-- A report that is one image opens where it can be zoomed and moved straight away -->
					<controls:ZoomImageView x:Name="ZoomView"
											Source="{Binding ReportImage}"
											ImageDescription="{Binding Title}"
											IsVisible="{Binding IsImageReport}"
											Margin="12,0,12,20" />
					<!-- The text scrolls inside the card. A refreshed report keeps the reader where they were. -->
					<Border Style="{DynamicResource BorderSet}" Padding="0" IsVisible="{Binding IsTextReport}">
						<md:MarkdownView Model="{Binding Report}" Mode="Document" KeepsPositionOnUpdate="True" TextPadding="16" />
					</Border>
				</Grid>
			</controls:TaskView.SucceededView>
		</controls:TaskView>

		<!-- Close, the title with where the report is from, and share when the report is one image. In landscape it lies
			 over the image, and its empty space lets touches through to the image. -->
		<Grid x:Name="Header"
			  ColumnDefinitions="auto, *, auto"
			  ColumnSpacing="12"
			  Margin="16,8,16,8"
			  VerticalOptions="Start"
			  InputTransparent="True"
			  CascadeInputTransparent="False">
			<controls:SvgButton SemanticProperties.Description="{l:Localize Close}" HorizontalOptions="Start" Command="{Binding GoBackCommand}"
								Style="{DynamicResource IconButton}" SvgSource="close.svg" />

			<Border x:Name="TitleBox"
					Grid.Column="1"
					VerticalOptions="Center"
					HorizontalOptions="Start"
					Padding="0"
					StrokeThickness="0"
					StrokeShape="RoundRectangle 20"
					BackgroundColor="Transparent">
				<VerticalStackLayout VerticalOptions="Center">
					<Label Text="{Binding Title}"
						   FontFamily="SpaceGroteskSemiBold"
						   FontSize="17"
						   TextColor="{DynamicResource ContentPrimaryWL}"
						   LineBreakMode="TailTruncation"
						   MaxLines="1" />
					<Label Text="{Binding SourceText}"
						   FontSize="12"
						   TextColor="{DynamicResource ContentSecondaryWL}"
						   IsVisible="{Binding IsImageReport}" />
				</VerticalStackLayout>
			</Border>

			<controls:SvgButton Grid.Column="2" Command="{Binding ShareCommand}"
								Style="{DynamicResource IconButton}" SvgSource="share.svg"
								SemanticProperties.Description="{l:Localize Share}"
								IsVisible="{Binding CanShare}" />
		</Grid>
	</Grid>
</base:BaseContentPage>
