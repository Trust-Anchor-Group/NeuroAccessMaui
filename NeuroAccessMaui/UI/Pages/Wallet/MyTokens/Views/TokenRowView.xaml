<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="NeuroAccessMaui.UI.Pages.Wallet.MyTokens.Views.TokenRowView"
			 x:DataType="objectmodel:TokenItem"
			 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
			 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
			 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
			 xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyWallet.ObjectModels">
	<controls:TemplatedButton Command="{Binding ClickedCommand}"
							  SemanticProperties.Description="{Binding AccessibleDescription}">
		<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
			<Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="12">
				<!-- Glyph, with the unread badge on its corner -->
				<Grid Grid.Column="0" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
					<Image Source="{Binding GlyphImage}"
						   IsVisible="{Binding HasGlyphImage}"
						   WidthRequest="{Binding GlyphWidth}"
						   HeightRequest="{Binding GlyphHeight}"
						   Aspect="AspectFit"
						   HorizontalOptions="Center"
						   VerticalOptions="Center"
						   SemanticProperties.Description="{Binding FriendlyName}" />
					<Path Data="{x:Static ui:Geometries.TokenPath}"
						  IsVisible="{Binding ShowGlyphPlaceholder}"
						  Fill="{DynamicResource ContentSecondaryWL}"
						  Aspect="Uniform"
						  WidthRequest="{Binding GlyphWidth}"
						  HeightRequest="{Binding GlyphHeight}"
						  HorizontalOptions="Center"
						  VerticalOptions="Center"
						  AutomationProperties.IsInAccessibleTree="False" />
					<controls:Badge Text="{Binding UnreadCount}"
									IsVisible="{Binding HasUnread}"
									BackgroundColor="{DynamicResource TnPDangerFigureWL}"
									TextColor="{DynamicResource TnPNeutralv750ContentWL}"
									FontFamily="HaasGroteskRegular"
									FontSize="{StaticResource FontSizeSm}"
									TextMargin="4,2"
									Stroke="{DynamicResource SurfaceElevation1WL}"
									InputTransparent="True"
									HorizontalOptions="End"
									VerticalOptions="Start"
									TranslationX="8"
									TranslationY="-8"
									SemanticProperties.Description="{Binding UnreadText}" />
				</Grid>

				<!-- Name, category and expiry -->
				<VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
					<Label Text="{Binding FriendlyName}"
						   Style="{DynamicResource BoldItemTitleLabel}"
						   HorizontalOptions="Fill"
						   HorizontalTextAlignment="Start"
						   LineBreakMode="TailTruncation"
						   MaxLines="2" />
					<Label Text="{Binding Category}"
						   IsVisible="{Binding HasCategory}"
						   Style="{DynamicResource ItemDescriptionLabel}"
						   TextColor="{DynamicResource ContentSecondaryWL}"
						   LineBreakMode="TailTruncation"
						   MaxLines="1" />
					<Border IsVisible="{Binding HasExpiryText}"
							StrokeShape="RoundRectangle 12"
							StrokeThickness="0"
							Padding="8,2"
							HorizontalOptions="Start"
							BackgroundColor="{DynamicResource TnPWarningbgWL}">
						<Border.Triggers>
							<DataTrigger TargetType="Border" Binding="{Binding IsExpired}" Value="True">
								<Setter Property="BackgroundColor" Value="{DynamicResource TnPDangerbgWL}" />
							</DataTrigger>
						</Border.Triggers>
						<Label Text="{Binding ExpiryText}"
							   FontSize="{StaticResource FontSizeSm}"
							   TextColor="{DynamicResource TnPWarningContentWL}">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding IsExpired}" Value="True">
									<Setter Property="TextColor" Value="{DynamicResource TnPDangerContentWL}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</Border>
				</VerticalStackLayout>

				<!-- Value and currency -->
				<VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">
					<Label Text="{Binding Value, Converter={converters:MoneyToString}}"
						   Style="{DynamicResource BoldItemTitleLabel}"
						   HorizontalOptions="End"
						   HorizontalTextAlignment="End"
						   LineBreakMode="NoWrap" />
					<Label Text="{Binding Currency}"
						   Style="{DynamicResource ItemDescriptionLabel}"
						   TextColor="{DynamicResource ContentSecondaryWL}"
						   HorizontalOptions="End"
						   HorizontalTextAlignment="End"
						   LineBreakMode="NoWrap" />
				</VerticalStackLayout>
			</Grid>
		</Border>
	</controls:TemplatedButton>
</ContentView>
