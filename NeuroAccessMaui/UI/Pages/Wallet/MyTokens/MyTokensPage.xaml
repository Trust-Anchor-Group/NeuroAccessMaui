<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
							 x:Class="NeuroAccessMaui.UI.Pages.Wallet.MyTokens.MyTokensPage"
							 x:DataType="viewmodel:MyTokensViewModel"
							 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
							 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							 xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyWallet.ObjectModels"
							 xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens.Views"
							 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens">
	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}" RowDefinitions="auto,*">
		<!-- Top Bar -->
		<Grid ColumnDefinitions="auto,*" Margin="16,8,16,8" RowSpacing="0" ColumnSpacing="8">
			<controls:SvgButton Grid.Column="0"
								HorizontalOptions="Start"
								Command="{Binding GoBackCommand}"
								Style="{DynamicResource IconButton}"
								SvgSource="close.svg"
								SemanticProperties.Description="{l:Localize Close}" />
			<Label Grid.Column="1" Text="{Binding PageTitle}" Style="{DynamicResource PageTitleLabel}" HorizontalOptions="End" />
		</Grid>

		<!-- Content -->
		<controls:TaskView Grid.Row="1" Task="{Binding LoadTask}">
			<controls:TaskView.RunningView>
				<ActivityIndicator IsRunning="True"
								   Color="{DynamicResource PrimaryWL}"
								   HorizontalOptions="Center"
								   VerticalOptions="Center" />
			</controls:TaskView.RunningView>

			<controls:TaskView.ErrorView>
				<VerticalStackLayout Padding="32" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
					<Label Text="{Binding LoadErrorText}" Style="{DynamicResource InfoLabel}" HorizontalTextAlignment="Center" />
					<controls:TextButton LabelData="{l:Localize TryAgain}"
										 Command="{Binding LoadTask.ReloadCommand}"
										 Style="{DynamicResource OutlinedTextButton}"
										 HorizontalOptions="Center" />
				</VerticalStackLayout>
			</controls:TaskView.ErrorView>

			<controls:TaskView.SucceededView>
				<Grid RowDefinitions="auto,auto,auto,*" Padding="16,0,16,0">
					<!-- Search -->
					<controls:CompositeEntry Grid.Row="0"
											 Style="{DynamicResource RegularCompositeEntry}"
											 Placeholder="{l:Localize SearchTokens}"
											 EntryData="{Binding SearchText}"
											 IsVisible="{Binding HasTokens}"
											 Margin="0,0,0,8">
						<controls:CompositeEntry.LeftView>
							<controls:SvgView Source="search.svg"
											  WidthRequest="20"
											  HeightRequest="20"
											  TintColor="{DynamicResource ContentSecondaryWL}"
											  AutomationProperties.IsInAccessibleTree="False" />
						</controls:CompositeEntry.LeftView>
					</controls:CompositeEntry>

					<!-- Category filter -->
					<ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasCategories}">
						<HorizontalStackLayout Spacing="8" Padding="0,0,0,8" BindableLayout.ItemsSource="{Binding Categories}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="viewmodel:TokenCategoryChip">
									<controls:TemplatedButton Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyTokensViewModel}}, x:DataType=viewmodel:MyTokensViewModel}"
															  CommandParameter="{Binding .}"
															  SemanticProperties.Description="{Binding Name}">
										<Border StrokeShape="RoundRectangle 24" StrokeThickness="1" Padding="12,6"
												Stroke="Transparent"
												Background="{DynamicResource TnPSuccessbgWL}">
											<Border.Triggers>
												<DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
													<Setter Property="Stroke" Value="{DynamicResource TnPSuccessContentWL}" />
												</DataTrigger>
											</Border.Triggers>
											<Label Text="{Binding Name}"
												   Style="{DynamicResource Brand2LabelS}"
												   TextColor="{DynamicResource TnPSuccessContentWL}"
												   FontSize="{StaticResource FontSizeSm}" />
										</Border>
									</controls:TemplatedButton>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</HorizontalStackLayout>
					</ScrollView>

					<!-- Search progress, and the search limit -->
					<VerticalStackLayout Grid.Row="2" Spacing="4">
						<HorizontalStackLayout Spacing="8" IsVisible="{Binding IsLoadingAll}" Padding="0,0,0,8">
							<ActivityIndicator IsRunning="{Binding IsLoadingAll}"
											   Color="{DynamicResource PrimaryWL}"
											   WidthRequest="16"
											   HeightRequest="16"
											   VerticalOptions="Center" />
							<Label Text="{l:Localize TokenSearchLoading}" Style="{DynamicResource ItemDescriptionLabel}"
								   TextColor="{DynamicResource ContentSecondaryWL}" VerticalOptions="Center" />
						</HorizontalStackLayout>
						<Label Text="{Binding SearchLimitedText}" IsVisible="{Binding IsSearchLimited}"
							   Style="{DynamicResource ItemDescriptionLabel}" TextColor="{DynamicResource ContentSecondaryWL}"
							   Margin="0,0,0,8" />
					</VerticalStackLayout>

					<!-- Tokens -->
					<RefreshView Grid.Row="3"
								 IsRefreshing="{Binding IsRefreshing}"
								 Command="{Binding RefreshTokensCommand}">
						<Grid>
							<controls:LoadingCollectionView ItemsSource="{Binding Tokens}"
															SelectionMode="None"
															ItemSizingStrategy="MeasureAllItems"
															RemainingItemsThreshold="3"
															LoadMoreCommand="{Binding LoadMoreTokensCommand}">
								<CollectionView.ItemsLayout>
									<LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
								</CollectionView.ItemsLayout>
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="objectmodel:TokenItem">
										<views:TokenRowView />
									</DataTemplate>
								</CollectionView.ItemTemplate>
								<CollectionView.Footer>
									<BoxView HeightRequest="16" Color="Transparent" AutomationProperties.IsInAccessibleTree="False" />
								</CollectionView.Footer>
							</controls:LoadingCollectionView>

							<!-- An empty wallet -->
							<VerticalStackLayout IsVisible="{Binding ShowNoTokens}" Padding="32" Spacing="12"
												 HorizontalOptions="Center" VerticalOptions="Start" InputTransparent="True">
								<controls:SvgView Source="wallet.svg" HeightRequest="64" WidthRequest="64"
												  TintColor="{DynamicResource ContentSecondaryWL}"
												  AutomationProperties.IsInAccessibleTree="False" />
								<Label Text="{l:Localize NoTokensYet}" Style="{DynamicResource InfoLabel}" HorizontalTextAlignment="Center" />
							</VerticalStackLayout>

							<!-- A search or filter that matched nothing -->
							<Label IsVisible="{Binding ShowNoMatches}" Text="{l:Localize NoMatchingTokens}"
								   Style="{DynamicResource InfoLabel}" HorizontalTextAlignment="Center"
								   VerticalOptions="Start" Margin="0,24,0,0" InputTransparent="True" />
						</Grid>
					</RefreshView>
				</Grid>
			</controls:TaskView.SucceededView>
		</controls:TaskView>
	</Grid>
</base:BaseContentPage>
