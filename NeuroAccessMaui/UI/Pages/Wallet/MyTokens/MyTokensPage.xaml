<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Wallet.MyTokens.MyTokensPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens.ObjectModels"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens"
	x:DataType="viewmodel:MyTokensViewModel">

	<Grid
		BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		RowDefinitions="Auto,*">

		<Grid
			Margin="16,8,16,12"
			ColumnDefinitions="Auto,*"
			ColumnSpacing="12">
			<controls:SvgButton
				Grid.Column="0"
				Command="{Binding GoBackCommand}"
				HorizontalOptions="Start"
				SemanticProperties.Description="{l:Localize Close}"
				Style="{DynamicResource IconButton}"
				SvgSource="close.svg"
				VerticalOptions="Center" />

			<VerticalStackLayout
				Grid.Column="1"
				Spacing="2"
				VerticalOptions="Center">
				<Label
					Style="{DynamicResource PageTitleLabel}"
					Text="{l:Localize MyTokens}" />
				<Label
					LineBreakMode="TailTruncation"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding CollectionSubtitle}"
					TextColor="{DynamicResource ContentSecondaryWL}" />
			</VerticalStackLayout>
		</Grid>

		<Grid
			Grid.Row="1"
			Margin="16,0,16,16"
			MaximumWidthRequest="960"
			RowDefinitions="Auto,Auto,*"
			HorizontalOptions="Fill">

			<Grid
				Grid.Row="0"
				ColumnDefinitions="*,Auto,Auto"
				ColumnSpacing="8">
				<SearchBar
					Grid.Column="0"
					Placeholder="{l:Localize Search}"
					SemanticProperties.Description="{l:Localize TokenSearchPlaceholder}"
					Text="{Binding SearchText}" />
				<controls:SvgButton
					Grid.Column="1"
					Command="{Binding ToggleFilterPanelCommand}"
					SemanticProperties.Description="{l:Localize FilterTokens}"
					Style="{DynamicResource IconButtonOnBackground}"
					SvgSource="filter.svg"
					VerticalOptions="Center" />
				<controls:StatusPill
					Grid.Column="2"
					IsVisible="{Binding HasActiveFilters}"
					Text="{Binding ActiveFilterCount}"
					Tone="Information"
					VerticalOptions="Center" />
			</Grid>

			<Border
				Grid.Row="1"
				Margin="0,8,0,4"
				Padding="12,8"
				BackgroundColor="{DynamicResource TnPWarningbgWL}"
				IsVisible="{Binding ShowPartialState}"
				StrokeThickness="0"
				StrokeShape="RoundRectangle 8">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<Label
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{Binding PartialMessage}"
						TextColor="{DynamicResource TnPWarningContentWL}"
						VerticalTextAlignment="Center" />
					<controls:TextButton
						Grid.Column="1"
						Command="{Binding RefreshTokensCommand}"
						LabelData="{l:Localize Retry}"
						Style="{DynamicResource TransparentTextButton}" />
				</Grid>
			</Border>

			<Grid Grid.Row="2">
				<RefreshView
					Command="{Binding RefreshTokensCommand}"
					IsRefreshing="{Binding IsRefreshing}"
					IsVisible="{Binding ShowContent}">
					<CollectionView
						ItemsSource="{Binding Tokens}"
						ItemSizingStrategy="MeasureFirstItem"
						RemainingItemsThreshold="5"
						RemainingItemsThresholdReachedCommand="{Binding LoadMoreTokensCommand}"
						SelectionMode="None">
						<CollectionView.ItemsLayout>
							<LinearItemsLayout
								ItemSpacing="8"
								Orientation="Vertical" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="objectmodel:TokenSummaryItem">
								<Border Margin="0,4" Padding="0" Style="{DynamicResource BorderSet}">
									<Grid>
										<controls:TemplatedButton Command="{Binding ActivateCommand}" Padding="0" SemanticProperties.Description="{Binding DisplayName}">
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
												<Border Grid.RowSpan="3" BackgroundColor="{DynamicResource SurfaceElevation2WL}" HeightRequest="40" Padding="6" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10" VerticalOptions="Start" WidthRequest="40">
													<Grid>
														<Image Aspect="AspectFit" IsVisible="{Binding HasGlyphImage}" Source="{Binding GlyphImage}" />
														<Label FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" Text="{Binding FallbackGlyphText}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center">
															<Label.Triggers>
																<DataTrigger Binding="{Binding HasGlyphImage}" TargetType="Label" Value="True">
																	<Setter Property="IsVisible" Value="False" />
																</DataTrigger>
															</Label.Triggers>
														</Label>
													</Grid>
												</Border>

												<Label Grid.Column="1" FontAttributes="Bold" FontSize="18" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding DisplayName}" TextColor="{DynamicResource ContentPrimaryWL}" />
												<Label Grid.Column="2" FontAttributes="Bold" IsVisible="{Binding HasValue}" LineBreakMode="NoWrap" Text="{Binding ValueText}" TextColor="{DynamicResource ContentPrimaryWL}" />

												<Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding HasDescription}" LineBreakMode="TailTruncation" MaxLines="1" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding Description}" TextColor="{DynamicResource ContentSecondaryWL}" />

												<FlexLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" AlignItems="Center" Direction="Row" Wrap="Wrap">
													<controls:StatusPill Margin="0,0,8,2" Text="{Binding AttentionText}" Tone="{Binding StatusTone}" />
													<controls:StatusPill IsVisible="{Binding HasCategory}" Margin="0,0,8,2" Text="{Binding Category}" Tone="Neutral" />
													<Label IsVisible="{Binding HasOwnership}" Margin="0,0,12,2" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding OwnershipText}" TextColor="{DynamicResource ContentSecondaryWL}" />
													<Label IsVisible="{Binding HasExpiry}" Margin="0,0,12,2" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding ExpiryText}" TextColor="{DynamicResource ContentSecondaryWL}">
														<Label.Triggers>
															<DataTrigger Binding="{Binding IsExpiringSoon}" TargetType="Label" Value="True">
																<Setter Property="IsVisible" Value="False" />
															</DataTrigger>
														</Label.Triggers>
													</Label>
													<controls:StatusPill IconSource="notifications.svg" IsVisible="{Binding HasUnreadEvents}" Margin="0,0,8,2" Text="{Binding UnreadCount}" Tone="Information" />
												</FlexLayout>
											</Grid>
										</controls:TemplatedButton>

										<Border BackgroundColor="{DynamicResource SurfaceElevation1WL}" IsVisible="{Binding ActivateCommand.IsRunning}" Opacity="0.96" Padding="12" SemanticProperties.Description="{l:Localize Opening}" StrokeThickness="0">
											<HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
												<ActivityIndicator Color="{DynamicResource ContentPrimaryWL}" IsRunning="{Binding ActivateCommand.IsRunning}" />
												<Label FontAttributes="Bold" Text="{l:Localize Opening}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center" />
											</HorizontalStackLayout>
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
						<CollectionView.Footer>
							<VerticalStackLayout
								Padding="8,16"
								Spacing="8">
								<HorizontalStackLayout
									HorizontalOptions="Center"
									IsVisible="{Binding IsLoadingMore}"
									Spacing="8">
									<ActivityIndicator IsRunning="{Binding IsLoadingMore}" />
									<Label
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{l:Localize LoadingMoreTokens}"
										VerticalTextAlignment="Center" />
								</HorizontalStackLayout>
								<HorizontalStackLayout
									HorizontalOptions="Center"
									IsVisible="{Binding IsScanning}"
									Spacing="8">
									<ActivityIndicator IsRunning="{Binding IsScanning}" />
									<Label
										Style="{DynamicResource ItemDescriptionLabel}"
										Text="{l:Localize LoadingTokens}"
										VerticalTextAlignment="Center" />
								</HorizontalStackLayout>
							</VerticalStackLayout>
						</CollectionView.Footer>
					</CollectionView>
				</RefreshView>

				<VerticalStackLayout
					HorizontalOptions="Center"
					IsVisible="{Binding ShowInitialLoading}"
					Spacing="12"
					VerticalOptions="Center">
					<ActivityIndicator
						HorizontalOptions="Center"
						IsRunning="{Binding ShowInitialLoading}" />
					<Label
						HorizontalTextAlignment="Center"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize LoadingTokens}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					HorizontalOptions="Center"
					IsVisible="{Binding ShowEmptyState}"
					MaximumWidthRequest="440"
					Padding="24"
					Spacing="8"
					VerticalOptions="Center">
					<Label
						FontAttributes="Bold"
						FontSize="20"
						HorizontalTextAlignment="Center"
						Text="{l:Localize NoTokensFoundTitle}" />
					<Label
						HorizontalTextAlignment="Center"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize NoTokensFoundDescription}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					HorizontalOptions="Center"
					IsVisible="{Binding ShowNoResultsState}"
					MaximumWidthRequest="440"
					Padding="24"
					Spacing="12"
					VerticalOptions="Center">
					<Label
						FontAttributes="Bold"
						FontSize="20"
						HorizontalTextAlignment="Center"
						Text="{l:Localize NoMatchingTokensTitle}" />
					<Label
						HorizontalTextAlignment="Center"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize NoMatchingTokensDescription}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
					<controls:TextButton
						Command="{Binding ClearFiltersCommand}"
						LabelData="{l:Localize ClearFilters}"
						Style="{DynamicResource OutlinedTextButton}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					HorizontalOptions="Center"
					IsVisible="{Binding ShowErrorState}"
					MaximumWidthRequest="440"
					Padding="24"
					Spacing="12"
					VerticalOptions="Center">
					<Label
						FontAttributes="Bold"
						FontSize="20"
						HorizontalTextAlignment="Center"
						Text="{l:Localize Unavailable}" />
					<Label
						HorizontalTextAlignment="Center"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{Binding ErrorMessage}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
					<controls:TextButton
						Command="{Binding RefreshTokensCommand}"
						LabelData="{l:Localize Retry}"
						Style="{DynamicResource FilledTextButton}" />
				</VerticalStackLayout>
			</Grid>
		</Grid>

		<Grid
			Grid.RowSpan="2"
			BackgroundColor="{DynamicResource SurfaceSpecialScrim}"
			IsVisible="{Binding IsFilterPanelVisible}"
			ZIndex="10">
			<controls:TemplatedButton
				Command="{Binding CloseFilterPanelCommand}"
				HorizontalOptions="Fill"
				VerticalOptions="Fill">
				<Grid />
			</controls:TemplatedButton>

			<Border
				BackgroundColor="{DynamicResource SurfaceElevation1WL}"
				HorizontalOptions="Center"
				Margin="16"
				MaximumWidthRequest="560"
				Padding="20"
				Stroke="{DynamicResource SurfaceStrokeWL}"
				StrokeShape="RoundRectangle 16"
				VerticalOptions="End">
				<ScrollView MaximumHeightRequest="660">
					<VerticalStackLayout Spacing="12">
						<Grid ColumnDefinitions="*,Auto">
							<Label
								FontAttributes="Bold"
								FontSize="20"
								Text="{l:Localize FilterTokens}"
								VerticalTextAlignment="Center" />
							<controls:SvgButton
								Grid.Column="1"
								Command="{Binding CloseFilterPanelCommand}"
								SemanticProperties.Description="{l:Localize Close}"
								Style="{DynamicResource IconButton}"
								SvgSource="close.svg" />
						</Grid>

						<Label
							FontAttributes="Bold"
							Text="{l:Localize Status}" />
						<Picker
							ItemsSource="{Binding LifecycleOptions}"
							SelectedIndex="{Binding SelectedLifecycleIndex}" />

						<Label
							FontAttributes="Bold"
							Text="{l:Localize FilterNeedsAttention}" />
						<Picker
							ItemsSource="{Binding AttentionOptions}"
							SelectedIndex="{Binding SelectedAttentionIndex}" />

						<Label
							FontAttributes="Bold"
							Text="{l:Localize Category}" />
						<Picker
							ItemsSource="{Binding CategoryOptions}"
							SelectedIndex="{Binding SelectedCategoryIndex}" />

						<Label
							FontAttributes="Bold"
							Text="{l:Localize Owner}" />
						<Picker
							ItemsSource="{Binding OwnershipOptions}"
							SelectedIndex="{Binding SelectedOwnershipIndex}" />

						<Label
							FontAttributes="Bold"
							Text="{l:Localize SortBy}" />
						<Picker
							ItemsSource="{Binding SortOptions}"
							SelectedIndex="{Binding SelectedSortIndex}" />

						<Grid
							Margin="0,8,0,0"
							ColumnDefinitions="*,*"
							ColumnSpacing="8">
							<controls:TextButton
								Command="{Binding ClearFiltersCommand}"
								LabelData="{l:Localize ClearFilters}"
								Style="{DynamicResource OutlinedTextButton}" />
							<controls:TextButton
								Grid.Column="1"
								Command="{Binding CloseFilterPanelCommand}"
								LabelData="{l:Localize Close}"
								Style="{DynamicResource FilledTextButton}" />
						</Grid>
					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>
	</Grid>
</base:BaseContentPage>
