<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
							 x:Class="NeuroAccessMaui.UI.Pages.Wallet.MyTokens.MyTokensPage"
							 x:DataType="viewmodel:MyTokensViewModel"
							 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
							 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
							 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
							 xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyWallet.ObjectModels"
							 xmlns:tokenmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens.ObjectModels"
							 xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens.Views"
							 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens">

	<VisualElement.Resources>
		<!-- A token -->
		<DataTemplate x:Key="TokenRowTemplate"
					  x:DataType="objectmodel:TokenItem">
			<views:TokenListRowView />
		</DataTemplate>

		<!-- Tokens of the same kind, folded into one row -->
		<DataTemplate x:Key="FamilyRowTemplate"
					  x:DataType="tokenmodel:TokenFamilyItem">
			<views:TokenFamilyRowView />
		</DataTemplate>

		<!-- One token under an unfolded row, told apart by its number in its batch and when it was created -->
		<DataTemplate x:Key="MemberRowTemplate"
					  x:DataType="tokenmodel:TokenFamilyMemberItem">
			<Grid>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}" />
				<controls:TemplatedButton Command="{Binding Token.ClickedCommand}"
										  SemanticProperties.Description="{Binding Token.AccessibleDescription}">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
						  ColumnSpacing="10"
						  Padding="74,0,18,0"
						  MinimumHeightRequest="52">
						<Grid Grid.Column="0"
							  ColumnDefinitions="Auto,*"
							  ColumnSpacing="10"
							  VerticalOptions="Center">
							<Label Grid.Column="0"
								   VerticalOptions="Center"
								   FontSize="{StaticResource FontSizeMd}"
								   LineBreakMode="NoWrap"
								   Text="{Binding Title}"
								   TextColor="{DynamicResource ContentPrimaryWL}" />
							<Label Grid.Column="1"
								   VerticalOptions="Center"
								   Style="{DynamicResource ListCardRowDetailLabel}"
								   Text="{Binding Detail}" />
						</Grid>
						<Border Grid.Column="1"
								IsVisible="{Binding ShowsExpiry}"
								Style="{DynamicResource ListCardPillBorder}"
								BackgroundColor="{DynamicResource TnPWarningbgWL}">
							<Label Style="{DynamicResource ListCardPillLabel}"
								   Text="{Binding Token.ExpiryText}"
								   TextColor="{DynamicResource TnPWarningContentWL}" />
						</Border>
						<Label Grid.Column="2"
							   VerticalOptions="Center"
							   IsVisible="{Binding ShowsValue}"
							   LineBreakMode="NoWrap"
							   Style="{DynamicResource ListCardRowDetailLabel}">
							<Label.FormattedText>
								<FormattedString>
									<Span Text="{Binding Token.Value, Converter={converters:MoneyToString}}" />
									<Span Text=" " />
									<Span Text="{Binding Token.Currency}" />
								</FormattedString>
							</Label.FormattedText>
						</Label>
						<!-- Unread notifications about the token -->
						<Ellipse Grid.Column="3"
								 VerticalOptions="Center"
								 HeightRequest="8"
								 WidthRequest="8"
								 IsVisible="{Binding Token.HasUnread}"
								 Fill="{DynamicResource TnPDangerFigureWL}" />
						<controls:SvgView Grid.Column="4"
										  VerticalOptions="Center"
										  HeightRequest="12"
										  WidthRequest="12"
										  AutomationProperties.IsInAccessibleTree="False"
										  Source="arrow_forward_ios.svg"
										  TintColor="{DynamicResource ContentSecondaryWL}" />
					</Grid>
				</controls:TemplatedButton>
			</Grid>
		</DataTemplate>

		<!-- At the end of an unfolded row, when the server may have more tokens of its kind -->
		<DataTemplate x:Key="MoreRowTemplate"
					  x:DataType="tokenmodel:TokenFamilyMoreItem">
			<Grid>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}" />
				<controls:TemplatedButton Command="{Binding ShowMoreInFamilyCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyTokensViewModel}}, x:DataType=viewmodel:MyTokensViewModel}"
										  CommandParameter="{Binding .}"
										  IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
										  SemanticProperties.Description="{l:Localize ShowMore}">
					<Grid Padding="74,0,18,0"
						  MinimumHeightRequest="48">
						<Label VerticalOptions="Center"
							   Style="{DynamicResource ListCardRowLinkLabel}"
							   Text="{l:Localize ShowMore}"
							   IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
						<Label VerticalOptions="Center"
							   Style="{DynamicResource ListCardRowDetailLabel}"
							   Text="{l:Localize TokensLoadingMore}"
							   IsVisible="{Binding IsLoading}" />
					</Grid>
				</controls:TemplatedButton>
			</Grid>
		</DataTemplate>

		<viewmodel:TokenListItemTemplateSelector x:Key="TokenListItemTemplateSelector"
												 TokenTemplate="{StaticResource TokenRowTemplate}"
												 FamilyTemplate="{StaticResource FamilyRowTemplate}"
												 MemberTemplate="{StaticResource MemberRowTemplate}"
												 MoreTemplate="{StaticResource MoreRowTemplate}" />
	</VisualElement.Resources>

	<!-- Built like the identity flow: the search, category chips, one card with the tokens, and a sticky footer. -->
	<controls:IdentityFlowShell Title="{Binding PageTitle}"
								ShowLeadingAction="True"
								LeadingActionCommand="{Binding GoBackCommand}"
								LeadingActionDescription="{l:Localize Close}"
								ShowStickyFooter="{Binding CanCreateToken}">
		<controls:IdentityFlowShell.BodyContent>
			<Grid RowDefinitions="Auto,Auto,Auto,*">
				<!-- Search. Shown while loading so the page keeps its shape, but usable once the tokens are in. -->
				<controls:CompositeEntry Grid.Row="0"
										 Margin="16,12,16,0"
										 Style="{DynamicResource RegularCompositeEntry}"
										 Placeholder="{l:Localize SearchTokens}"
										 EntryData="{Binding SearchText}"
										 IsVisible="{Binding ShowSearch}"
										 IsEnabled="{Binding IsLoaded}">
					<controls:CompositeEntry.LeftView>
						<controls:SvgView Source="search.svg"
										  WidthRequest="20"
										  HeightRequest="20"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  AutomationProperties.IsInAccessibleTree="False" />
					</controls:CompositeEntry.LeftView>
				</controls:CompositeEntry>

				<!-- Category filter. "All" removes the filter. -->
				<ScrollView Grid.Row="1"
							Margin="0,12,0,0"
							Orientation="Horizontal"
							HorizontalScrollBarVisibility="Never"
							IsVisible="{Binding HasCategories}">
					<HorizontalStackLayout Spacing="8"
										   Padding="16,0">
						<controls:TemplatedButton Command="{Binding SelectAllCategoriesCommand}"
												  SemanticProperties.Description="{l:Localize All}">
							<Border Style="{DynamicResource ListCardChipBorder}">
								<Border.Triggers>
									<DataTrigger TargetType="Border"
												 Binding="{Binding IsAllCategoriesSelected}"
												 Value="True">
										<Setter Property="BackgroundColor"
												Value="{DynamicResource ContentPrimaryWL}" />
										<Setter Property="Stroke"
												Value="{DynamicResource ContentPrimaryWL}" />
									</DataTrigger>
								</Border.Triggers>
								<Label Text="{l:Localize All}"
									   Style="{DynamicResource ListCardChipLabel}">
									<Label.Triggers>
										<DataTrigger TargetType="Label"
													 Binding="{Binding IsAllCategoriesSelected}"
													 Value="True">
											<Setter Property="TextColor"
													Value="{DynamicResource ContentPrimaryInverted}" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
							</Border>
						</controls:TemplatedButton>

						<HorizontalStackLayout Spacing="8"
											   BindableLayout.ItemsSource="{Binding Categories}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="viewmodel:TokenCategoryChip">
									<controls:TemplatedButton Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyTokensViewModel}}, x:DataType=viewmodel:MyTokensViewModel}"
															  CommandParameter="{Binding .}"
															  SemanticProperties.Description="{Binding Name}">
										<Border Style="{DynamicResource ListCardChipBorder}">
											<Border.Triggers>
												<DataTrigger TargetType="Border"
															 Binding="{Binding IsSelected}"
															 Value="True">
													<Setter Property="BackgroundColor"
															Value="{DynamicResource ContentPrimaryWL}" />
													<Setter Property="Stroke"
															Value="{DynamicResource ContentPrimaryWL}" />
												</DataTrigger>
											</Border.Triggers>
											<Label Text="{Binding Name}"
												   Style="{DynamicResource ListCardChipLabel}">
												<Label.Triggers>
													<DataTrigger TargetType="Label"
																 Binding="{Binding IsSelected}"
																 Value="True">
														<Setter Property="TextColor"
																Value="{DynamicResource ContentPrimaryInverted}" />
													</DataTrigger>
												</Label.Triggers>
											</Label>
										</Border>
									</controls:TemplatedButton>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</HorizontalStackLayout>
					</HorizontalStackLayout>
				</ScrollView>

				<!-- What the list is doing: loading, searching all tokens, or how many tokens a search covers -->
				<Label controls:ScreenReader.AnnouncesChanges="True" Grid.Row="2"
					   Margin="20,16,20,0"
					   Style="{DynamicResource ListCardStatusLabel}"
					   Text="{Binding TokenStatusText}"
					   IsVisible="{Binding ShowTokenStatus}" />

				<Grid Grid.Row="3">
					<!-- Rows shaped like tokens while the first page loads -->
					<controls:ListCardPlaceholder Margin="16,12,16,0"
												  VerticalOptions="Start"
												  ShowsValue="True"
												  IsVisible="{Binding IsLoadingTokens}" />

					<!-- The tokens couldn't be loaded -->
					<VerticalStackLayout Padding="32"
										 Spacing="16"
										 HorizontalOptions="Center"
										 VerticalOptions="Center"
										 IsVisible="{Binding ShowLoadError}">
						<Label Text="{Binding LoadErrorText}"
							   Style="{DynamicResource InfoLabel}"
							   HorizontalTextAlignment="Center" />
						<controls:TextButton LabelData="{l:Localize TryAgain}"
											 Command="{Binding LoadTask.ReloadCommand}"
											 Style="{DynamicResource OutlinedTextButton}"
											 HorizontalOptions="Center" />
					</VerticalStackLayout>

					<RefreshView IsVisible="{Binding IsLoaded}"
								 IsRefreshing="{Binding IsRefreshing}"
								 Command="{Binding RefreshTokensCommand}">
						<Grid>
							<controls:LoadingCollectionView Margin="16,12,16,0"
															IsVisible="False"
															controls:Reveal.IsShown="{Binding ShowTokenList}"
															controls:ListCard.IsEnabled="True"
															ItemsSource="{Binding Rows}"
															ItemTemplate="{StaticResource TokenListItemTemplateSelector}"
															SelectionMode="None"
															ItemSizingStrategy="MeasureAllItems"
															RemainingItemsThreshold="3"
															LoadMoreCommand="{Binding LoadMoreTokensCommand}">
								<CollectionView.ItemsLayout>
									<LinearItemsLayout Orientation="Vertical"
													   ItemSpacing="0" />
								</CollectionView.ItemsLayout>
								<!-- More tokens load while scrolling. The button is for when folding keeps the list too short to scroll. -->
								<CollectionView.Footer>
									<Grid Padding="0,8,0,16"
										  MinimumHeightRequest="16">
										<controls:TextButton HorizontalOptions="Center"
															 Style="{DynamicResource TransparentTextButton}"
															 LabelData="{l:Localize LoadMore}"
															 Command="{Binding LoadMoreTokensCommand}"
															 IsVisible="{Binding ShowLoadMore}" />
										<Label controls:ScreenReader.AnnouncesChanges="True" HorizontalOptions="Center"
											   VerticalOptions="Center"
											   Style="{DynamicResource ListCardStatusLabel}"
											   Text="{l:Localize TokensLoadingMore}"
											   IsVisible="{Binding IsLoadingMore}" />
									</Grid>
								</CollectionView.Footer>
							</controls:LoadingCollectionView>

							<!-- Runs along the top edge of the card while the whole wallet loads for a search -->
							<controls:IndeterminateProgressLine Margin="16,12,16,0"
																IsRunning="{Binding IsLoadingAll}"
																IsVisible="{Binding IsLoadingAll}"
																Color="{DynamicResource ContentAccessWL}" />

							<!-- An empty wallet. It takes no taps, so the list can still be pulled to refresh. -->
							<VerticalStackLayout VerticalOptions="Start"
												 IsVisible="{Binding ShowNoTokens}"
												 InputTransparent="True">
								<VerticalStackLayout Padding="24,12,24,0"
													 Spacing="6">
									<Label Style="{DynamicResource IdentityFlowTitleLabel}"
										   Text="{l:Localize TokensEmptyHeading}" />
									<Label Style="{DynamicResource IdentityFlowBodySecondaryLabel}"
										   Text="{l:Localize TokensEmptyDescription}" />
								</VerticalStackLayout>
								<Border Style="{DynamicResource ListCardEmptyBorder}"
										Margin="16,24,16,0">
									<Grid ColumnDefinitions="44,*"
										  ColumnSpacing="14">
										<Border Grid.Column="0"
												Style="{DynamicResource ListCardEmptyTileBorder}"
												AutomationProperties.IsInAccessibleTree="False">
											<Path Data="{x:Static ui:Geometries.TokenPath}"
												  Fill="{DynamicResource InputFieldsSurfaceStrokeInactive}"
												  Aspect="Uniform"
												  WidthRequest="22"
												  HeightRequest="22"
												  HorizontalOptions="Center"
												  VerticalOptions="Center" />
										</Border>
										<Label Grid.Column="1"
											   Style="{DynamicResource IdentityFlowCaptionLabel}"
											   VerticalOptions="Center"
											   Text="{l:Localize TokensEmptyHint}" />
									</Grid>
								</Border>
							</VerticalStackLayout>

							<!-- A search or filter that matched nothing -->
							<Label controls:ScreenReader.AnnouncesChanges="True" Margin="20,16,20,0"
								   VerticalOptions="Start"
								   Style="{DynamicResource IdentityFlowBodySecondaryLabel}"
								   Text="{l:Localize NoMatchingTokens}"
								   IsVisible="{Binding ShowNoMatches}"
								   InputTransparent="True" />
						</Grid>
					</RefreshView>
				</Grid>
			</Grid>
		</controls:IdentityFlowShell.BodyContent>

		<controls:IdentityFlowShell.StickyFooterContent>
			<controls:TextButton Style="{DynamicResource FilledTextButton}"
								 MaximumWidthRequest="560"
								 HorizontalOptions="Fill"
								 LabelData="{l:Localize CreateToken}"
								 Command="{Binding CreateTokenCommand}" />
		</controls:IdentityFlowShell.StickyFooterContent>
	</controls:IdentityFlowShell>
</base:BaseContentPage>
