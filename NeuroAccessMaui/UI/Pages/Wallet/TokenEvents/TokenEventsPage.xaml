<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
							 x:Class="NeuroAccessMaui.UI.Pages.Wallet.TokenEvents.TokenEventsPage"
							 x:DataType="viewmodel:TokenEventsViewModel"
							 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
							 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
							 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenEvents"
							 xmlns:events="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.TokenEvents.Events">
	<VisualElement.Resources>
		<!-- Event card parts -->
		<Style x:Key="EventTitleLabel" TargetType="Label">
			<Setter Property="FontFamily" Value="SpaceGroteskBold" />
			<Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
			<Setter Property="TextColor" Value="{DynamicResource ContentPrimaryWL}" />
			<Setter Property="VerticalOptions" Value="Center" />
			<Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
		</Style>
		<Style x:Key="EventTimeLabel" TargetType="Label">
			<Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
			<Setter Property="TextColor" Value="{DynamicResource ContentSecondaryWL}" />
			<Setter Property="VerticalOptions" Value="Center" />
			<Setter Property="HorizontalTextAlignment" Value="End" />
		</Style>
		<Style x:Key="EventKeyLabel" TargetType="Label">
			<Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
			<Setter Property="TextColor" Value="{DynamicResource ContentSecondaryWL}" />
			<Setter Property="VerticalOptions" Value="Center" />
		</Style>
		<Style x:Key="EventValueLabel" TargetType="Label">
			<Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
			<Setter Property="TextColor" Value="{DynamicResource ContentPrimaryWL}" />
			<Setter Property="VerticalOptions" Value="Center" />
		</Style>
		<Style x:Key="EventChipBorder" TargetType="Border">
			<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			<Setter Property="StrokeThickness" Value="0" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="HorizontalOptions" Value="Start" />
			<Setter Property="BackgroundColor" Value="{DynamicResource TnPInfobgWL}" />
		</Style>
		<Style x:Key="EventChipLabel" TargetType="Label">
			<Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
			<Setter Property="TextColor" Value="{DynamicResource TnPInfoContentWL}" />
			<Setter Property="LineBreakMode" Value="MiddleTruncation" />
			<Setter Property="MaxLines" Value="1" />
		</Style>
		<Style x:Key="PersonalChipBorder" TargetType="Border">
			<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="Stroke" Value="{DynamicResource ContentSecondaryWL}" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="HorizontalOptions" Value="Start" />
			<Setter Property="BackgroundColor" Value="Transparent" />
		</Style>

		<DataTemplate x:Key="CreatedEvent" x:DataType="events:CreatedItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize Created}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Creator}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Creator}"
												  SemanticProperties.Description="{Binding CreatorFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding CreatorFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Owner}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Owner}"
												  SemanticProperties.Description="{Binding OwnerFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnerFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize OwnershipContract}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewContractCommand}" CommandParameter="{Binding OwnershipContract}"
												  SemanticProperties.Description="{l:Localize OwnershipContract}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnershipContract}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Value}" Style="{StaticResource EventKeyLabel}" />
						<Label Grid.Column="1" Style="{StaticResource EventValueLabel}">
							<Label.FormattedText>
								<FormattedString>
									<Span Text="{Binding Value, Converter={converters:MoneyToString}}"/>
									<Span Text=" "/>
									<Span Text="{Binding Currency}"/>
								</FormattedString>
							</Label.FormattedText>
						</Label>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="DestroyedEvent" x:DataType="events:DestroyedItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize Destroyed}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Owner}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Owner}"
												  SemanticProperties.Description="{Binding OwnerFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnerFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize OwnershipContract}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewContractCommand}" CommandParameter="{Binding OwnershipContract}"
												  SemanticProperties.Description="{l:Localize OwnershipContract}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnershipContract}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Value}" Style="{StaticResource EventKeyLabel}" />
						<Label Grid.Column="1" Style="{StaticResource EventValueLabel}">
							<Label.FormattedText>
								<FormattedString>
									<Span Text="{Binding Value, Converter={converters:MoneyToString}}"/>
									<Span Text=" "/>
									<Span Text="{Binding Currency}"/>
								</FormattedString>
							</Label.FormattedText>
						</Label>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="TransferredEvent" x:DataType="events:TransferredItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize Transferred}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Seller}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Seller}"
												  SemanticProperties.Description="{Binding SellerFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding SellerFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Owner}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Owner}"
												  SemanticProperties.Description="{Binding OwnerFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnerFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize OwnershipContract}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewContractCommand}" CommandParameter="{Binding OwnershipContract}"
												  SemanticProperties.Description="{l:Localize OwnershipContract}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnershipContract}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Value}" Style="{StaticResource EventKeyLabel}" />
						<Label Grid.Column="1" Style="{StaticResource EventValueLabel}">
							<Label.FormattedText>
								<FormattedString>
									<Span Text="{Binding Value, Converter={converters:MoneyToString}}"/>
									<Span Text=" "/>
									<Span Text="{Binding Currency}"/>
								</FormattedString>
							</Label.FormattedText>
						</Label>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="DonatedEvent" x:DataType="events:DonatedItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize Donated}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Donor}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Donor}"
												  SemanticProperties.Description="{Binding DonorFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding DonorFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize Owner}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding Owner}"
												  SemanticProperties.Description="{Binding OwnerFriendlyName}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnerFriendlyName}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize OwnershipContract}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewContractCommand}" CommandParameter="{Binding OwnershipContract}"
												  SemanticProperties.Description="{l:Localize OwnershipContract}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding OwnershipContract}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="NoteText" x:DataType="events:NoteTextItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize TextNote}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Border IsVisible="{Binding Personal}" Style="{StaticResource PersonalChipBorder}">
						<Label Text="{l:Localize NoteIsPersonal}" Style="{StaticResource EventKeyLabel}" />
					</Border>
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{Binding Note}" Style="{StaticResource EventValueLabel}" />
						<controls:SvgButton Grid.Column="1"
											SvgSource="content_copy.svg"
											Style="{DynamicResource IconButtonOnBackground}"
											Command="{Binding CopyToClipboardCommand}"
											CommandParameter="{Binding Note}"
											VerticalOptions="Start"
											SemanticProperties.Description="{l:Localize CopyToClipboard}" />
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="NoteXml" x:DataType="events:NoteXmlItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize XmlNote}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Border IsVisible="{Binding Personal}" Style="{StaticResource PersonalChipBorder}">
						<Label Text="{l:Localize NoteIsPersonal}" Style="{StaticResource EventKeyLabel}" />
					</Border>
					<controls:TextButton LabelData="{l:Localize ViewXml}"
										 Command="{Binding ViewXmlCommand}"
										 CommandParameter="{Binding Note}"
										 Style="{DynamicResource TransparentTextButton}"
										 HorizontalOptions="Start" />
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="ExternalNoteText" x:DataType="events:ExternalNoteTextItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize TextNote}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize From}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewSourceCommand}" CommandParameter="{Binding Source}"
												  SemanticProperties.Description="{Binding Source}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding Source}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Border IsVisible="{Binding Personal}" Style="{StaticResource PersonalChipBorder}">
						<Label Text="{l:Localize NoteIsPersonal}" Style="{StaticResource EventKeyLabel}" />
					</Border>
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{Binding Note}" Style="{StaticResource EventValueLabel}" />
						<controls:SvgButton Grid.Column="1"
											SvgSource="content_copy.svg"
											Style="{DynamicResource IconButtonOnBackground}"
											Command="{Binding CopyToClipboardCommand}"
											CommandParameter="{Binding Note}"
											VerticalOptions="Start"
											SemanticProperties.Description="{l:Localize CopyToClipboard}" />
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="ExternalNoteXml" x:DataType="events:ExternalNoteXmlItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize XmlNote}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize From}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewSourceCommand}" CommandParameter="{Binding Source}"
												  SemanticProperties.Description="{Binding Source}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding Source}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
					<Border IsVisible="{Binding Personal}" Style="{StaticResource PersonalChipBorder}">
						<Label Text="{l:Localize NoteIsPersonal}" Style="{StaticResource EventKeyLabel}" />
					</Border>
					<controls:TextButton LabelData="{l:Localize ViewXml}"
										 Command="{Binding ViewXmlCommand}"
										 CommandParameter="{Binding Note}"
										 Style="{DynamicResource TransparentTextButton}"
										 HorizontalOptions="Start" />
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="Killed" x:DataType="events:KilledItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
						<Label Text="{l:Localize Killed}" Style="{StaticResource EventTitleLabel}" />
						<Label Grid.Column="1" Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize KillerUser}" Style="{StaticResource EventKeyLabel}" />
						<Label Grid.Column="1" Text="{Binding User}" Style="{StaticResource EventValueLabel}" LineBreakMode="MiddleTruncation" />
					</Grid>
					<Grid ColumnDefinitions="auto,*" ColumnSpacing="8">
						<Label Text="{l:Localize KillerId}" Style="{StaticResource EventKeyLabel}" />
						<controls:TemplatedButton Grid.Column="1" HorizontalOptions="Start"
												  Command="{Binding ViewIdCommand}" CommandParameter="{Binding LegalId}"
												  SemanticProperties.Description="{l:Localize KillerId}">
							<Border Style="{StaticResource EventChipBorder}">
								<Label Text="{Binding LegalId}" Style="{StaticResource EventChipLabel}" />
							</Border>
						</controls:TemplatedButton>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="OtherEvents" x:DataType="viewmodel:EventItem">
			<Border Style="{DynamicResource BorderSet}" Margin="0" Padding="12">
				<VerticalStackLayout Spacing="8">
					<Label Text="{Binding Timestamp, Converter={converters:DateTimeToString}}" Style="{StaticResource EventTimeLabel}" HorizontalTextAlignment="Start" />
					<Label Text="{l:Localize UnrecognizedEventType}" Style="{StaticResource EventValueLabel}" />
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<viewmodel:EventTypeTemplateSelector x:Key="EventStyleSelector"
											 CreatedTemplate="{StaticResource CreatedEvent}"
											 DestroyedTemplate="{StaticResource DestroyedEvent}"
											 TransferredTemplate="{StaticResource TransferredEvent}"
											 DonatedTemplate="{StaticResource DonatedEvent}"
											 NoteTextTemplate="{StaticResource NoteText}"
											 NoteXmlTemplate="{StaticResource NoteXml}"
											 ExternalNoteTextTemplate="{StaticResource ExternalNoteText}"
											 ExternalNoteXmlTemplate="{StaticResource ExternalNoteXml}"
											 KilledTemplate="{StaticResource Killed}"
											 DefaultTemplate="{StaticResource OtherEvents}"/>
	</VisualElement.Resources>

	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}" RowDefinitions="auto,*,auto">
		<controls:Background Grid.RowSpan="3"/>

		<!-- Top bar -->
		<Grid ColumnDefinitions="auto,*" ColumnSpacing="8" Margin="16,8,16,8">
			<controls:SvgButton Grid.Column="0"
								HorizontalOptions="Start"
								Command="{Binding GoBackCommand}"
								Style="{DynamicResource IconButton}"
								SvgSource="close.svg"
								SemanticProperties.Description="{l:Localize Close}" />
			<Label Grid.Column="1"
				   Text="{l:Localize TokenEvents}"
				   Style="{DynamicResource PageTitleLabel}"
				   HorizontalOptions="End"
				   SemanticProperties.HeadingLevel="Level1" />
		</Grid>

		<!-- Timeline -->
		<controls:TaskView Grid.Row="1" Task="{Binding LoadTask}">
			<controls:TaskView.RunningView>
				<ActivityIndicator IsRunning="True"
								   Color="{DynamicResource PrimaryWL}"
								   HorizontalOptions="Center"
								   VerticalOptions="Center" />
			</controls:TaskView.RunningView>

			<controls:TaskView.ErrorView>
				<VerticalStackLayout Padding="32" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
					<Label Text="{Binding LoadErrorText}" Style="{DynamicResource InfoLabel}" HorizontalTextAlignment="Center" />
					<controls:TextButton LabelData="{l:Localize TryAgain}"
										 Command="{Binding LoadTask.ReloadCommand}"
										 Style="{DynamicResource OutlinedTextButton}"
										 HorizontalOptions="Center" />
				</VerticalStackLayout>
			</controls:TaskView.ErrorView>

			<controls:TaskView.SucceededView>
				<RefreshView IsRefreshing="{Binding IsRefreshing}"
							 Command="{Binding RefreshEventsCommand}">
					<Grid>
						<controls:LoadingCollectionView ItemsSource="{Binding Events}"
														ItemTemplate="{StaticResource EventStyleSelector}"
														SelectionMode="None"
														ItemSizingStrategy="MeasureAllItems"
														RemainingItemsThreshold="3"
														LoadMoreCommand="{Binding LoadMoreEventsCommand}"
														Margin="16,0,16,0">
							<CollectionView.ItemsLayout>
								<LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
							</CollectionView.ItemsLayout>
							<CollectionView.Header>
								<Label Text="{l:Localize TokenEventsDescription}"
									   Style="{DynamicResource ItemDescriptionLabel}"
									   TextColor="{DynamicResource ContentSecondaryWL}"
									   Margin="0,0,0,8" />
							</CollectionView.Header>
							<CollectionView.Footer>
								<Grid Padding="0,8,0,16">
									<ActivityIndicator IsRunning="{Binding IsLoadingMore}"
													   IsVisible="{Binding IsLoadingMore}"
													   Color="{DynamicResource PrimaryWL}"
													   HorizontalOptions="Center" />
								</Grid>
							</CollectionView.Footer>
						</controls:LoadingCollectionView>

						<Label IsVisible="{Binding ShowNoEvents}"
							   Text="{l:Localize NoEventsYet}"
							   Style="{DynamicResource InfoLabel}"
							   HorizontalTextAlignment="Center"
							   VerticalOptions="Start"
							   Margin="32,64,32,0"
							   InputTransparent="True" />
					</Grid>
				</RefreshView>
			</controls:TaskView.SucceededView>
		</controls:TaskView>

		<!-- Add a note -->
		<controls:TextButton Grid.Row="2"
							 LabelData="{l:Localize AddNote}"
							 Command="{Binding AddNoteCommand}"
							 IsVisible="{Binding IsMyToken}"
							 Style="{DynamicResource FilledTextButton}"
							 Margin="16,8,16,16" />
	</Grid>
</base:BaseContentPage>
