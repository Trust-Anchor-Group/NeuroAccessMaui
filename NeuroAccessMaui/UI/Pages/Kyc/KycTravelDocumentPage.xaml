<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycTravelDocumentPage"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  x:DataType="viewmodel:KycTravelDocumentViewModel"
					  ui:KeyboardInsets.Mode="Automatic"
					  ui:SafeArea.Mode="TopAndBottom">
	<VisualElement.Resources>
		<Style x:Key="MessageTitle"
			   TargetType="Label">
			<Setter Property="FontFamily"
					Value="SpaceGroteskBold" />
			<Setter Property="FontSize"
					Value="28" />
			<Setter Property="HorizontalTextAlignment"
					Value="Center" />
			<Setter Property="LineBreakMode"
					Value="WordWrap" />
			<Setter Property="SemanticProperties.HeadingLevel"
					Value="Level1" />
		</Style>
		<Style x:Key="MessageBody"
			   TargetType="Label"
			   BasedOn="{StaticResource InfoLabel}">
			<Setter Property="HorizontalTextAlignment"
					Value="Center" />
			<Setter Property="LineBreakMode"
					Value="WordWrap" />
		</Style>
		<Style x:Key="MessagePanel"
			   TargetType="Border">
			<Setter Property="StrokeThickness"
					Value="1" />
			<Setter Property="StrokeShape"
					Value="RoundRectangle 12" />
			<Setter Property="Padding"
					Value="14,12" />
		</Style>
	</VisualElement.Resources>

	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		  RowDefinitions="Auto,Auto,*,Auto">
		<controls:Background Grid.RowSpan="4" />

		<Grid Padding="16,8"
			  ColumnDefinitions="44,*"
			  ColumnSpacing="12">
			<controls:SvgButton Command="{Binding GoBackCommand}"
								SvgSource="close.svg"
								Style="{DynamicResource IconButton}"
								WidthRequest="44"
								HeightRequest="44"
								HorizontalOptions="Start"
								VerticalOptions="Center"
								SemanticProperties.Description="{l:Localize Close}" />

			<Label Grid.Column="1"
				   Style="{DynamicResource PageTitleLabel}"
				   Text="{l:Localize KycTravelDocumentTitle}"
				   FontSize="21"
				   HorizontalOptions="End"
				   VerticalOptions="Center"
				   LineBreakMode="TailTruncation" />
		</Grid>

		<controls:GuideStepper Grid.Row="1"
							   CurrentStep="{Binding CurrentGuideStep}"
							   Margin="24,4,24,0"
							   MaximumWidthRequest="420"
							   HorizontalOptions="Fill">
			<controls:GuideStepper.Steps>
				<controls:GuideStep Text="{l:Localize KycTravelDocumentStepScan}" />
				<controls:GuideStep Text="{l:Localize KycTravelDocumentStepChip}" />
				<controls:GuideStep Text="{l:Localize KycTravelDocumentProgressDone}" />
			</controls:GuideStepper.Steps>
		</controls:GuideStepper>

		<ScrollView Grid.Row="2"
					VerticalScrollBarVisibility="Never">
			<VerticalStackLayout Padding="24,12,24,16"
								 Spacing="20"
								 MaximumWidthRequest="560"
								 HorizontalOptions="Fill"
								 VerticalOptions="Center">
				<controls:NfcScanVisual x:Name="ScanVisual"
										HeightRequest="250"
										HorizontalOptions="Fill"
										State="{Binding ScanVisualState}"
										Progress="{Binding ChipReadProgress}"
										IsPassport="{Binding IsPassportDocument}"
										AntennaPlacement="{OnPlatform Default=BackCenter, iOS=TopEdge}"
										SuccessRevealDelay="{OnPlatform Default=0, iOS=900}"
										AccentColor="{DynamicResource ContentAccessWL}"
										OnAccentColor="{DynamicResource ContentPrimaryInverted}"
										ContentColor="{DynamicResource ContentPrimaryWL}"
										TrackColor="{DynamicResource TnPNeutralv300bgWL}"
										SurfaceColor="{DynamicResource SurfaceElevation1WL}"
										WarningColor="{DynamicResource TnPWarningContentWL}" />

				<VerticalStackLayout x:Name="MessageBlock"
									 Spacing="14">
					<VerticalStackLayout Spacing="8"
										 IsVisible="{Binding ShowIntro}">
						<Label Style="{StaticResource MessageTitle}"
							   Text="{l:Localize KycTravelDocumentHeroTitle}" />
						<Label Style="{StaticResource MessageBody}"
							   Text="{l:Localize KycTravelDocumentEligibilityChipSymbol}" />
						<Label Style="{StaticResource MessageBody}"
							   Text="{l:Localize KycTravelDocumentHeroDescription}"
							   TextColor="{DynamicResource ContentSecondaryWL}" />
					</VerticalStackLayout>

					<VerticalStackLayout Spacing="8"
										 IsVisible="{Binding ShowNfcMessage}">
						<Label Style="{StaticResource MessageTitle}"
							   Text="{Binding NfcHeadlineText}" />
						<Label Style="{StaticResource MessageBody}"
							   Text="{Binding StatusText}"
							   IsVisible="{Binding HasStatusText}" />
					</VerticalStackLayout>

					<Border Style="{StaticResource MessagePanel}"
							BackgroundColor="{DynamicResource SurfaceElevation1WL}"
							Stroke="{DynamicResource TnPNeutralv300bgWL}"
							HorizontalOptions="Center"
							IsVisible="{Binding ShowPlacementTip}">
						<Grid ColumnDefinitions="Auto,*"
							  ColumnSpacing="10">
							<Path Data="{x:Static ui:Geometries.InfoCirclePath}"
								  Fill="{DynamicResource ContentAccessWL}"
								  WidthRequest="18"
								  HeightRequest="18"
								  Aspect="Uniform"
								  VerticalOptions="Start"
								  Margin="0,2,0,0"
								  AutomationProperties.IsInAccessibleTree="False" />
							<Label Grid.Column="1"
								   Text="{Binding PlacementTipText}"
								   Style="{DynamicResource InfoLabel}"
								   FontSize="14"
								   LineBreakMode="WordWrap"
								   VerticalOptions="Center" />
						</Grid>
					</Border>

					<Border Style="{StaticResource MessagePanel}"
							BackgroundColor="{DynamicResource TnPWarningbgWL}"
							Stroke="{DynamicResource TnPWarningContentWL}"
							IsVisible="{Binding ShowIntroError}">
						<Grid ColumnDefinitions="Auto,*"
							  ColumnSpacing="10">
							<Path Data="{x:Static ui:Geometries.ErrorPath}"
								  Fill="{DynamicResource TnPWarningContentWL}"
								  WidthRequest="20"
								  HeightRequest="20"
								  Aspect="Uniform"
								  VerticalOptions="Start"
								  Margin="0,1,0,0"
								  AutomationProperties.IsInAccessibleTree="False" />
							<Label Grid.Column="1"
								   Text="{Binding StatusText}"
								   Style="{DynamicResource InfoLabel}"
								   FontSize="14"
								   LineBreakMode="WordWrap"
								   VerticalOptions="Center" />
						</Grid>
					</Border>
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<Border Grid.Row="3"
				StrokeThickness="0"
				Padding="24,8,24,16"
				BackgroundColor="{DynamicResource SurfaceBackgroundWL}">
			<VerticalStackLayout Spacing="8"
								 MaximumWidthRequest="560"
								 HorizontalOptions="Fill">
				<Label Text="{l:Localize KycTravelDocumentEligibilityTitle}"
					   Style="{DynamicResource SectionTitleLabel}"
					   HorizontalTextAlignment="Center"
					   LineBreakMode="WordWrap"
					   Margin="0,0,0,4"
					   IsVisible="{Binding ShowIntro}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentPrimaryScanButton}"
									 Command="{Binding ScanMrzCommand}"
									 IsVisible="{Binding ShowIntro}" />
				<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
									 LabelData="{l:Localize KycTravelDocumentUnsureButton}"
									 Command="{Binding ReturnToApplicationCommand}"
									 IsVisible="{Binding ShowIntro}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentContinueButton}"
									 Command="{Binding ReturnToApplicationCommand}"
									 IsVisible="{Binding ShowSuccess}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentReadChipButton}"
									 Command="{Binding StartNfcReadoutCommand}"
									 IsVisible="{Binding ShowStartNfcAction}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentRetryNfcButton}"
									 Command="{Binding StartNfcReadoutCommand}"
									 IsVisible="{Binding ShowNfcRetryAction}" />
				<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
									 LabelData="{l:Localize KycTravelDocumentRescanButton}"
									 Command="{Binding ScanMrzCommand}"
									 IsVisible="{Binding ShowRescanAction}" />
				<controls:TextButton Style="{DynamicResource TransparentTextButton}"
									 LabelData="{l:Localize KycTravelDocumentManualFallbackButton}"
									 Command="{Binding ReturnToApplicationCommand}"
									 IsVisible="{Binding ShowManualFallback}" />
			</VerticalStackLayout>
		</Border>
	</Grid>
</base:BaseContentPage>
