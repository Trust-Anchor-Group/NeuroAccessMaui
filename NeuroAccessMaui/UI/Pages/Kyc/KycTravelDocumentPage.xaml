<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycTravelDocumentPage"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  x:DataType="viewmodel:KycTravelDocumentViewModel"
					  ui:KeyboardInsets.Mode="Automatic"
					  ui:SafeArea.Mode="TopAndBottom">
	<!-- The step guide, body, and footer stay hidden until the view model has resolved its state, so a saved state never
		 appears after the default one. The footer also stays hidden while it has no action, such as during a chip read -->
	<controls:IdentityFlowShell Title="{l:Localize KycTravelDocumentTitle}"
								ShowLeadingAction="True"
								LeadingActionCommand="{Binding GoBackCommand}"
								LeadingActionDescription="{l:Localize Close}"
								ShowStickyFooter="{Binding HasFooterActions}">
		<controls:IdentityFlowShell.BodyContent>
			<Grid RowDefinitions="Auto,*">
				<controls:GuideStepper CurrentStep="{Binding CurrentGuideStep}"
									   Margin="24,4,24,0"
									   MaximumWidthRequest="420"
									   HorizontalOptions="Fill"
									   IsVisible="{Binding ShowGuideStepper}">
					<controls:GuideStepper.Steps>
						<controls:GuideStep Text="{l:Localize KycTravelDocumentStepScan}" />
						<controls:GuideStep Text="{l:Localize KycTravelDocumentStepChip}" />
						<controls:GuideStep Text="{l:Localize KycTravelDocumentProgressDone}" />
					</controls:GuideStepper.Steps>
				</controls:GuideStepper>

				<ScrollView x:Name="BodyScroll"
							Grid.Row="1"
							VerticalScrollBarVisibility="Never"
							IsVisible="{Binding IsStateResolved}">
					<VerticalStackLayout Padding="24,12,24,16"
										 Spacing="20"
										 MaximumWidthRequest="560"
										 HorizontalOptions="Fill"
										 VerticalOptions="Center">
						<controls:NfcScanVisual x:Name="ScanVisual"
												HeightRequest="250"
												HorizontalOptions="Fill"
												State="{Binding ScanVisualState}"
												Progress="{Binding ChipReadProgress}"
												IsPassport="{Binding IsPassportDocument}"
												AntennaPlacement="{OnPlatform Default=BackCenter, iOS=TopEdge}"
												SuccessRevealDelay="{OnPlatform Default=0, iOS=900}"
												AccentColor="{DynamicResource ContentAccessWL}"
												OnAccentColor="{DynamicResource ContentPrimaryInverted}"
												ContentColor="{DynamicResource ContentPrimaryWL}"
												TrackColor="{DynamicResource TnPNeutralv300bgWL}"
												SurfaceColor="{DynamicResource SurfaceElevation1WL}"
												WarningColor="{DynamicResource TnPWarningContentWL}" />

						<VerticalStackLayout x:Name="MessageBlock"
											 Spacing="14">
							<VerticalStackLayout Spacing="8"
												 IsVisible="{Binding ShowIntro}">
								<Label Style="{DynamicResource IdentityFlowTitleLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{l:Localize KycTravelDocumentHeroTitle}" />
								<Label Style="{DynamicResource IdentityFlowBodyLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{l:Localize KycTravelDocumentEligibilityChipSymbol}" />
								<Label Style="{DynamicResource IdentityFlowBodySecondaryLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{l:Localize KycTravelDocumentHeroDescription}" />
							</VerticalStackLayout>

							<!-- Says where the machine-readable lines are before the camera opens, and why the last scan stopped -->
							<VerticalStackLayout Spacing="8"
												 IsVisible="{Binding ShowMrzGuide}">
								<Label Style="{DynamicResource IdentityFlowTitleLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{Binding MrzGuideTitleText}" />
								<Label Style="{DynamicResource IdentityFlowBodyLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{Binding StatusText}"
									   IsVisible="{Binding ShowMrzGuideNotice}" />
								<Label Style="{DynamicResource IdentityFlowBodyLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{l:Localize KycTravelDocumentMrzGuideDescription}" />
							</VerticalStackLayout>

							<VerticalStackLayout Spacing="8"
												 IsVisible="{Binding ShowNfcMessage}">
								<Label Style="{DynamicResource IdentityFlowTitleLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{Binding NfcHeadlineText}" />
								<Label Style="{DynamicResource IdentityFlowBodyLabel}"
									   HorizontalTextAlignment="Center"
									   Text="{Binding StatusText}"
									   IsVisible="{Binding HasStatusText}" />
							</VerticalStackLayout>

							<Border Style="{DynamicResource IdentityFlowCard}"
									Padding="14,12"
									HorizontalOptions="Center"
									IsVisible="{Binding ShowPlacementTip}">
								<Grid ColumnDefinitions="Auto,*"
									  ColumnSpacing="10">
									<Path Data="{x:Static ui:Geometries.InfoCirclePath}"
										  Fill="{DynamicResource ContentAccessWL}"
										  WidthRequest="18"
										  HeightRequest="18"
										  Aspect="Uniform"
										  VerticalOptions="Start"
										  Margin="0,2,0,0"
										  AutomationProperties.IsInAccessibleTree="False" />
									<Label Grid.Column="1"
										   Text="{Binding PlacementTipText}"
										   Style="{DynamicResource IdentityFlowBodyLabel}"
										   FontSize="{StaticResource FontSizeSm}"
										   VerticalOptions="Center" />
								</Grid>
							</Border>

							<Border Style="{DynamicResource IdentityFlowWarningCard}"
									Padding="14,12"
									IsVisible="{Binding ShowMrzGuideError}">
								<Grid ColumnDefinitions="Auto,*"
									  ColumnSpacing="10">
									<Path Data="{x:Static ui:Geometries.ErrorPath}"
										  Fill="{DynamicResource TnPWarningContentWL}"
										  WidthRequest="20"
										  HeightRequest="20"
										  Aspect="Uniform"
										  VerticalOptions="Start"
										  Margin="0,1,0,0"
										  AutomationProperties.IsInAccessibleTree="False" />
									<Label Grid.Column="1"
										   Text="{Binding StatusText}"
										   Style="{DynamicResource IdentityFlowBodyLabel}"
										   FontSize="{StaticResource FontSizeSm}"
										   VerticalOptions="Center" />
								</Grid>
							</Border>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</ScrollView>
			</Grid>
		</controls:IdentityFlowShell.BodyContent>

		<controls:IdentityFlowShell.StickyFooterContent>
			<VerticalStackLayout Spacing="8"
								 MaximumWidthRequest="560"
								 HorizontalOptions="Fill">
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentPrimaryScanButton}"
									 Command="{Binding OpenMrzGuideCommand}"
									 IsVisible="{Binding ShowIntro}" />
				<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
									 LabelData="{l:Localize KycTravelDocumentUnsureButton}"
									 Command="{Binding ReturnToApplicationCommand}"
									 IsVisible="{Binding ShowIntro}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentMrzGuideStartButton}"
									 Command="{Binding ScanMrzCommand}"
									 IsVisible="{Binding ShowMrzGuideAction}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentContinueButton}"
									 Command="{Binding ReturnToApplicationCommand}"
									 IsVisible="{Binding ShowSuccess}" />
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize KycTravelDocumentReadChipButton}"
									 Command="{Binding StartNfcReadoutCommand}"
									 IsVisible="{Binding ShowStartNfcAction}" />
				<!-- Recovery actions follow the failure: try again, scan the details again, use another document, or close -->
				<controls:TextButton Style="{DynamicResource FilledTextButton}"
									 LabelData="{Binding PrimaryRecoveryText}"
									 Command="{Binding RunPrimaryRecoveryCommand}"
									 IsVisible="{Binding ShowPrimaryRecoveryAction}" />
				<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
									 LabelData="{Binding SecondaryRecoveryText}"
									 Command="{Binding RunSecondaryRecoveryCommand}"
									 IsVisible="{Binding ShowSecondaryRecoveryAction}" />
				<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
									 LabelData="{l:Localize KycTravelDocumentRescanButton}"
									 Command="{Binding ScanMrzCommand}"
									 IsVisible="{Binding ShowRescanAction}" />
				<controls:TextButton Style="{DynamicResource TransparentTextButton}"
									 LabelData="{l:Localize KycTravelDocumentManualFallbackButton}"
									 Command="{Binding ReturnToApplicationCommand}"
									 IsVisible="{Binding ShowManualFallback}" />
			</VerticalStackLayout>
		</controls:IdentityFlowShell.StickyFooterContent>
	</controls:IdentityFlowShell>
</base:BaseContentPage>
