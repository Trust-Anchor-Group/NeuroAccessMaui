<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycTravelDocumentPage"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  x:DataType="viewmodel:KycTravelDocumentViewModel"
					  ui:KeyboardInsets.Mode="Automatic"
					  ui:SafeArea.Mode="TopAndBottom">
	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		  Margin="16,8,16,0"
		  RowDefinitions="Auto,*">
		<controls:Background />

		<Grid ColumnDefinitions="Auto,*,Auto">
			<controls:SvgButton Command="{Binding ReturnToApplicationCommand}"
								SvgSource="close.svg"
								Style="{DynamicResource IconButton}"
								HorizontalOptions="Start"
								Grid.Column="0" />

			<Label Grid.Column="2"
				   Style="{DynamicResource PageTitleLabel}"
				   Text="{l:Localize KycTravelDocumentTitle}"
				   HorizontalOptions="End" />
		</Grid>

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Spacing="16"
								 Padding="0,16,0,16">
				<Border Style="{DynamicResource BorderSet}"
						Padding="16"
						Margin="0">
					<VerticalStackLayout Spacing="14">
						<Label Text="{l:Localize KycTravelDocumentSummaryTitle}"
							   Style="{DynamicResource PageTitleLabel}"
							   FontSize="28"
							   LineBreakMode="WordWrap" />
						<Label Text="{l:Localize KycTravelDocumentDescription}"
							   Style="{DynamicResource InfoLabel}"
							   LineBreakMode="WordWrap" />
					</VerticalStackLayout>
				</Border>

				<Border Style="{DynamicResource BorderSet}"
						Padding="16"
						Margin="0"
						IsVisible="{Binding HasStatusText}">
					<Label Text="{Binding StatusText}"
						   Style="{DynamicResource InfoLabel}"
						   LineBreakMode="WordWrap" />
				</Border>

				<Border Style="{DynamicResource BorderSet}"
						Padding="16"
						Margin="0">
					<VerticalStackLayout Spacing="10">
						<Label Text="{l:Localize KycTravelDocumentMrzLabel}"
							   Style="{DynamicResource FieldTitleLabel}" />
						<Editor Text="{Binding MrzText, Mode=TwoWay}"
								Placeholder="{l:Localize KycTravelDocumentMrzPlaceholder}"
								AutoSize="TextChanges"
								MinimumHeightRequest="120"
								Keyboard="Plain"
								TextColor="{DynamicResource InputFieldsContentPrimary}"
								BackgroundColor="{DynamicResource SurfaceBackgroundWL}" />
					</VerticalStackLayout>
				</Border>

				<VerticalStackLayout Spacing="8">
					<controls:TextButton Style="{DynamicResource FilledTextButton}"
										 LabelData="{l:Localize KycTravelDocumentSaveButton}"
										 Command="{Binding SaveMrzCommand}" />
					<controls:TextButton Style="{DynamicResource FilledTextButton}"
										 LabelData="{l:Localize KycTravelDocumentStartNfcButton}"
										 Command="{Binding StartNfcReadoutCommand}" />
					<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
										 LabelData="{l:Localize Kyc_Return}"
										 Command="{Binding ReturnToApplicationCommand}" />
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</base:BaseContentPage>
