<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycProfilePhotoCameraPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:camera="clr-namespace:NeuroAccessMaui.Camera;assembly=NeuroAccessMaui.Camera"
	xmlns:ext="clr-namespace:NeuroAccessMaui.MarkupExtensions"
	xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
	x:DataType="viewmodel:KycProfilePhotoCameraViewModel"
	BackgroundColor="Black"
	ui:SafeArea.Mode="Ignore">
	<Grid RowDefinitions="Auto,*,Auto"
		  BackgroundColor="Black">
		<camera:CameraView x:Name="CameraView"
						   Grid.RowSpan="3"
						   IsVisible="{Binding ShowCameraPreview}"
						   HorizontalOptions="Fill"
						   VerticalOptions="Fill" />

		<Image Grid.RowSpan="3"
			   Source="{Binding CapturedPhotoSource}"
			   IsVisible="{Binding HasCapturedPhoto}"
			   Aspect="AspectFill"
			   HorizontalOptions="Fill"
			   VerticalOptions="Fill" />

		<Grid Grid.Row="0"
			  Margin="{ext:SafeInsets Type=Top}"
			  Padding="16,12,16,0"
			  ColumnDefinitions="96,*,96"
			  ColumnSpacing="8"
			  MinimumHeightRequest="44">
			<Border Grid.Column="0"
					Padding="14,8"
					BackgroundColor="#66000000"
					Stroke="#55FFFFFF"
					StrokeThickness="1"
					StrokeShape="RoundRectangle 18"
					MinimumHeightRequest="40"
					MinimumWidthRequest="72"
					HorizontalOptions="Start"
					VerticalOptions="Center">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding CancelCommand}" />
				</Border.GestureRecognizers>
				<Label Text="{Binding CancelText}"
					   FontFamily="SpaceGroteskBold"
					   FontSize="14"
					   TextColor="White"
					   MaxLines="1"
					   LineBreakMode="TailTruncation"
					   VerticalTextAlignment="Center" />
			</Border>

			<Label Grid.Column="1"
				   Text="{Binding TitleText}"
				   HorizontalTextAlignment="Center"
				   VerticalTextAlignment="Center"
				   FontSize="20"
				   FontFamily="SpaceGroteskBold"
				   TextColor="White"
				   MaxLines="1"
				   LineBreakMode="TailTruncation" />
		</Grid>

		<Border Grid.Row="2"
				Margin="16,0,16,64"
				Padding="18,16"
				BackgroundColor="#CC1E1712"
				Stroke="#55FFFFFF"
				StrokeThickness="1"
				StrokeShape="RoundRectangle 18">
			<VerticalStackLayout Spacing="14">
				<Label Text="{Binding GuidanceText}"
					   FontSize="15"
					   TextColor="#FFF7ED"
					   HorizontalTextAlignment="Center"
					   LineBreakMode="WordWrap"
					   IsVisible="{Binding ShowCameraPreview}" />

				<Button Text="{Binding CaptureText}"
						Command="{Binding CaptureCommand}"
						IsVisible="{Binding ShowCameraPreview}"
						BackgroundColor="#0F806A"
						TextColor="White"
						FontFamily="SpaceGroteskBold"
						CornerRadius="24"
						HeightRequest="56" />

				<Grid ColumnDefinitions="*,*"
					  ColumnSpacing="10"
					  IsVisible="{Binding HasCapturedPhoto}">
					<Button Text="{Binding RetakeText}"
							Command="{Binding RetakeCommand}"
							BackgroundColor="Transparent"
							BorderColor="#99FFFFFF"
							BorderWidth="1"
							TextColor="White"
							FontFamily="SpaceGroteskBold"
							CornerRadius="18"
							HeightRequest="52" />
					<Button Grid.Column="1"
							Text="{Binding UsePhotoText}"
							Command="{Binding UsePhotoCommand}"
							BackgroundColor="#0F806A"
							TextColor="White"
							FontFamily="SpaceGroteskBold"
							CornerRadius="18"
							HeightRequest="52" />
				</Grid>
			</VerticalStackLayout>
		</Border>
	</Grid>
</base:BaseContentPage>
