<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycProfilePhotoCameraPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:camera="clr-namespace:NeuroAccessMaui.Camera;assembly=NeuroAccessMaui.Camera"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:ext="clr-namespace:NeuroAccessMaui.MarkupExtensions"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
	x:DataType="viewmodel:KycProfilePhotoCameraViewModel"
	BackgroundColor="Black"
	ui:SafeArea.Mode="Ignore"
	ui:KeyboardInsets.Mode="Ignore">
	<Grid BackgroundColor="Black">
		<camera:CameraView x:Name="CameraView"
						   HorizontalOptions="Fill"
						   VerticalOptions="Fill" />

		<!-- Dims the preview around the face oval or the document frame -->
		<GraphicsView x:Name="CaptureGuide"
					  InputTransparent="True"
					  IsVisible="{Binding ShowCameraPreview}"
					  HorizontalOptions="Fill"
					  VerticalOptions="Fill"
					  AutomationProperties.IsInAccessibleTree="False" />

		<!-- The photo covers the live preview while it is reviewed, so the camera keeps running for a retake -->
		<Grid BackgroundColor="Black"
			  IsVisible="{Binding HasCapturedPhoto}">
			<Image Source="{Binding CapturedPhotoSource}"
				   Aspect="{Binding ReviewAspect}"
				   HorizontalOptions="Fill"
				   VerticalOptions="Fill" />
		</Grid>

		<!-- Shutter flash -->
		<BoxView x:Name="Flash"
				 Color="White"
				 Opacity="0"
				 InputTransparent="True"
				 HorizontalOptions="Fill"
				 VerticalOptions="Fill" />

		<!-- Keeps the white header readable over bright scenes -->
		<BoxView HeightRequest="160"
				 VerticalOptions="Start"
				 InputTransparent="True">
			<BoxView.Background>
				<LinearGradientBrush StartPoint="0,0"
									 EndPoint="0,1">
					<GradientStop Color="#99000000"
								  Offset="0" />
					<GradientStop Color="#00000000"
								  Offset="1" />
				</LinearGradientBrush>
			</BoxView.Background>
		</BoxView>

		<!-- Header -->
		<Grid Margin="{ext:SafeInsets Type=Top}"
			  Padding="16,12,16,0"
			  ColumnDefinitions="Auto,*,Auto,Auto"
			  ColumnSpacing="12"
			  VerticalOptions="Start">
			<controls:ImageButton Command="{Binding CancelCommand}"
								  Style="{DynamicResource FilledImageButton}"
								  PathData="{x:Static ui:Geometries.BackButtonPath}"
								  IsEnabled="{Binding IsCapturing, Converter={mct:InvertedBoolConverter}}"
								  SemanticProperties.Description="{Binding CancelText}" />

			<Label Grid.Column="1"
				   Text="{Binding TitleText}"
				   FontFamily="SpaceGroteskBold"
				   FontSize="{StaticResource FontSize2xl}"
				   TextColor="White"
				   MaxLines="2"
				   LineBreakMode="WordWrap"
				   VerticalOptions="Center"
				   SemanticProperties.HeadingLevel="Level1" />

			<controls:ImageButton Grid.Column="2"
								  Command="{Binding ToggleTorchCommand}"
								  Style="{DynamicResource FilledImageButton}"
								  PathData="{x:Static ui:Geometries.CameraTorchButtonPath}"
								  IsVisible="{Binding CanUseTorch}"
								  IsEnabled="{Binding CanCapture}"
								  SemanticProperties.Description="{Binding TorchDescription}" />

			<controls:ImageButton Grid.Column="3"
								  Command="{Binding SwitchCameraCommand}"
								  Style="{DynamicResource FilledImageButton}"
								  PathData="{x:Static ui:Geometries.CameraSwitchButtonPath}"
								  IsVisible="{Binding CanSwitchCamera}"
								  IsEnabled="{Binding CanCapture}"
								  SemanticProperties.Description="{Binding SwitchCameraText}" />
		</Grid>

		<!-- Capture -->
		<VerticalStackLayout Margin="{ext:SafeInsets Type=Bottom}"
							 Padding="16,0,16,28"
							 Spacing="22"
							 VerticalOptions="End"
							 IsVisible="{Binding ShowCameraPreview}">
			<Border Padding="16,12"
					MaximumWidthRequest="560"
					BackgroundColor="{x:Static ui:ScannerColors.CardBackground}"
					StrokeThickness="0"
					StrokeShape="RoundRectangle 16">
				<Grid ColumnDefinitions="*,Auto"
					  ColumnSpacing="12">
					<VerticalStackLayout Spacing="4"
										 VerticalOptions="Center">
						<Label Text="{Binding GuidanceText}"
							   FontFamily="SpaceGroteskBold"
							   FontSize="{StaticResource FontSizeLg}"
							   TextColor="White"
							   LineBreakMode="WordWrap" />
						<Label Text="{Binding GuideDetail}"
							   FontSize="{StaticResource FontSizeSm}"
							   TextColor="#D9FFFFFF"
							   LineBreakMode="WordWrap"
							   IsVisible="{Binding HasGuideDetail}" />
					</VerticalStackLayout>
					<controls:SvgView Grid.Column="1"
									  Source="{Binding GuideIllustration}"
									  WidthRequest="64"
									  HeightRequest="44"
									  VerticalOptions="Center"
									  TintColor="White"
									  IsVisible="{Binding HasGuideIllustration}"
									  AutomationProperties.IsInAccessibleTree="False" />
				</Grid>
			</Border>

			<Grid WidthRequest="78"
				  HeightRequest="78"
				  HorizontalOptions="Center">
				<controls:TemplatedButton Command="{Binding CaptureCommand}"
										  IsEnabled="{Binding CanCapture}"
										  SemanticProperties.Description="{Binding CaptureText}">
					<Grid WidthRequest="78"
						  HeightRequest="78">
						<Ellipse Stroke="White"
								 StrokeThickness="4"
								 WidthRequest="78"
								 HeightRequest="78" />
						<Ellipse Fill="White"
								 WidthRequest="60"
								 HeightRequest="60"
								 HorizontalOptions="Center"
								 VerticalOptions="Center"
								 IsVisible="{Binding IsCapturing, Converter={mct:InvertedBoolConverter}}" />
					</Grid>
				</controls:TemplatedButton>
				<ActivityIndicator IsRunning="{Binding IsCapturing}"
								   IsVisible="{Binding IsCapturing}"
								   Color="White"
								   WidthRequest="32"
								   HeightRequest="32"
								   HorizontalOptions="Center"
								   VerticalOptions="Center"
								   InputTransparent="True" />
			</Grid>
		</VerticalStackLayout>

		<!-- Review -->
		<Border x:Name="ReviewSheet"
				VerticalOptions="End"
				Padding="24,22,24,0"
				BackgroundColor="{DynamicResource SurfaceElevation1WL}"
				StrokeThickness="0"
				StrokeShape="RoundRectangle 24,24,0,0"
				IsVisible="{Binding HasCapturedPhoto}">
			<VerticalStackLayout Spacing="16"
								 MaximumWidthRequest="560"
								 Margin="{ext:SafeInsets Type=Bottom}"
								 Padding="0,0,0,20">
				<Label Text="{Binding ReviewHintText}"
					   Style="{DynamicResource IdentityFlowBodyLabel}"
					   HorizontalTextAlignment="Center" />
				<Grid ColumnDefinitions="*,*"
					  ColumnSpacing="10">
					<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
										 LabelData="{Binding RetakeText}"
										 Command="{Binding RetakeCommand}" />
					<controls:TextButton Grid.Column="1"
										 Style="{DynamicResource FilledTextButton}"
										 LabelData="{Binding UsePhotoText}"
										 Command="{Binding UsePhotoCommand}" />
				</Grid>
			</VerticalStackLayout>
		</Border>
	</Grid>
</base:BaseContentPage>
