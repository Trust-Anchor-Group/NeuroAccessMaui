<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycApplicationStatusPage"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  x:DataType="viewmodel:KycApplicationStatusViewModel"
					  ui:SafeArea.Mode="TopAndBottom">
	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		  RowDefinitions="Auto,*,Auto">
		<controls:Background Grid.RowSpan="3" />

		<!-- Header -->
		<Grid Padding="16,8"
			  ColumnDefinitions="44,*"
			  ColumnSpacing="12">
			<controls:SvgButton Command="{Binding GoBackCommand}"
								SvgSource="close.svg"
								Style="{DynamicResource IconButton}"
								WidthRequest="44"
								HeightRequest="44"
								HorizontalOptions="Start"
								VerticalOptions="Center"
								SemanticProperties.Description="{l:Localize Close}" />
			<Label Grid.Column="1"
				   Style="{DynamicResource PageTitleLabel}"
				   Text="{l:Localize IdentityApplication}"
				   FontSize="21"
				   HorizontalOptions="End"
				   VerticalOptions="Center"
				   LineBreakMode="TailTruncation" />
		</Grid>

		<RefreshView Grid.Row="1"
					 Command="{Binding RefreshCommand}"
					 IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
					 RefreshColor="{DynamicResource ContentAccessWL}">
			<ScrollView VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Padding="24,8,24,24"
									 Spacing="14"
									 MaximumWidthRequest="560"
									 HorizontalOptions="Fill">
					<controls:StatusVisual x:Name="Visual"
										   Kind="{Binding VisualKind}"
										   HeightRequest="168"
										   HorizontalOptions="Fill"
										   AccentColor="{DynamicResource ContentAccessWL}"
										   OnAccentColor="{DynamicResource ContentPrimaryInverted}"
										   WarningColor="{DynamicResource TnPWarningContentWL}" />

					<!-- Status pill -->
					<Border Padding="12,6"
							HorizontalOptions="Center"
							StrokeThickness="0"
							StrokeShape="RoundRectangle 14"
							BackgroundColor="{DynamicResource TnPInfobgWL}">
						<Border.Triggers>
							<DataTrigger TargetType="Border"
										 Binding="{Binding IsFinalizing}"
										 Value="True">
								<Setter Property="BackgroundColor"
										Value="{DynamicResource TnPSuccessbgWL}" />
							</DataTrigger>
							<DataTrigger TargetType="Border"
										 Binding="{Binding IsApproved}"
										 Value="True">
								<Setter Property="BackgroundColor"
										Value="{DynamicResource TnPSuccessbgWL}" />
							</DataTrigger>
							<DataTrigger TargetType="Border"
										 Binding="{Binding IsRejected}"
										 Value="True">
								<Setter Property="BackgroundColor"
										Value="{DynamicResource TnPDangerbgWL}" />
							</DataTrigger>
						</Border.Triggers>
						<Label Text="{Binding StageText}"
							   FontSize="14"
							   FontFamily="SpaceGroteskBold"
							   TextColor="{DynamicResource TnPInfoContentWL}">
							<Label.Triggers>
								<DataTrigger TargetType="Label"
											 Binding="{Binding IsFinalizing}"
											 Value="True">
									<Setter Property="TextColor"
											Value="{DynamicResource TnPSuccessContentWL}" />
								</DataTrigger>
								<DataTrigger TargetType="Label"
											 Binding="{Binding IsApproved}"
											 Value="True">
									<Setter Property="TextColor"
											Value="{DynamicResource TnPSuccessContentWL}" />
								</DataTrigger>
								<DataTrigger TargetType="Label"
											 Binding="{Binding IsRejected}"
											 Value="True">
									<Setter Property="TextColor"
											Value="{DynamicResource TnPDangerContentWL}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</Border>

					<VerticalStackLayout Spacing="8">
						<Label Text="{Binding TitleText}"
							   FontFamily="SpaceGroteskBold"
							   FontSize="28"
							   HorizontalTextAlignment="Center"
							   LineBreakMode="WordWrap"
							   TextColor="{DynamicResource ContentPrimaryWL}"
							   SemanticProperties.HeadingLevel="Level1" />
						<Label Text="{Binding DescriptionText}"
							   Style="{DynamicResource InfoLabel}"
							   HorizontalTextAlignment="Center"
							   LineBreakMode="WordWrap"
							   TextColor="{DynamicResource ContentSecondaryWL}" />
						<Label Text="{Binding UpdatedText}"
							   FontSize="13"
							   HorizontalTextAlignment="Center"
							   TextColor="{DynamicResource ContentSecondaryWL}"
							   IsVisible="{Binding HasUpdatedText}" />
					</VerticalStackLayout>

					<controls:GuideStepper CurrentStep="{Binding TimelineStep}"
										   IsVisible="{Binding ShowTimeline}"
										   Margin="8,10,8,0"
										   MaximumWidthRequest="420"
										   HorizontalOptions="Fill">
						<controls:GuideStepper.Steps>
							<controls:GuideStep Text="{l:Localize KycStepDetails}" />
							<controls:GuideStep Text="{l:Localize KycStepReview}" />
							<controls:GuideStep Text="{l:Localize KycStepIdReady}" />
						</controls:GuideStepper.Steps>
					</controls:GuideStepper>

					<!-- What the reviewer asked the user to fix -->
					<Border Margin="0,10,0,0"
							Padding="16"
							StrokeThickness="0"
							StrokeShape="RoundRectangle 16"
							BackgroundColor="{DynamicResource SurfaceElevation1WL}"
							IsVisible="{Binding HasAttentionDetails}">
						<Border.Shadow>
							<Shadow Brush="{DynamicResource SurfaceShadowColorWL}"
									Offset="0,4"
									Radius="12" />
						</Border.Shadow>
						<VerticalStackLayout Spacing="10">
							<Label Text="{l:Localize KycStatusAttentionTitle}"
								   FontFamily="SpaceGroteskBold"
								   FontSize="17"
								   TextColor="{DynamicResource ContentPrimaryWL}"
								   SemanticProperties.HeadingLevel="Level2" />
							<Label Text="{Binding ReviewMessage}"
								   FontSize="15"
								   LineBreakMode="WordWrap"
								   TextColor="{DynamicResource ContentPrimaryWL}"
								   IsVisible="{Binding HasReviewMessage}" />
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttentionItems}"
												 Spacing="8"
												 IsVisible="{Binding HasAttentionItems}">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Grid ColumnDefinitions="Auto,*"
											  ColumnSpacing="10">
											<Ellipse WidthRequest="6"
													 HeightRequest="6"
													 Margin="0,8,0,0"
													 VerticalOptions="Start"
													 Fill="{DynamicResource TnPDangerContentWL}" />
											<Label Grid.Column="1"
												   Text="{Binding}"
												   FontSize="15"
												   FontFamily="SpaceGroteskSemiBold"
												   LineBreakMode="WordWrap"
												   TextColor="{DynamicResource ContentPrimaryWL}" />
										</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>

		<VerticalStackLayout Grid.Row="2"
							 Padding="24,8,24,16"
							 Spacing="8"
							 MaximumWidthRequest="560"
							 HorizontalOptions="Fill">
			<controls:TextButton Style="{DynamicResource FilledTextButton}"
								 LabelData="{Binding PrimaryActionText}"
								 Command="{Binding PrimaryActionCommand}" />
			<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
								 LabelData="{Binding SecondaryActionText}"
								 Command="{Binding SecondaryActionCommand}" />
		</VerticalStackLayout>
	</Grid>
</base:BaseContentPage>
