<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycDocumentMrzScannerPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:camera="clr-namespace:NeuroAccessMaui.Camera;assembly=NeuroAccessMaui.Camera"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:ext="clr-namespace:NeuroAccessMaui.MarkupExtensions"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
	x:DataType="viewmodel:KycDocumentMrzScannerViewModel"
	BackgroundColor="Black"
	ui:SafeArea.Mode="Ignore">
	<Grid BackgroundColor="Black">
		<camera:CameraView x:Name="CameraView"
						   HorizontalOptions="Fill"
						   VerticalOptions="Fill" />

		<GraphicsView x:Name="DocumentOutlineView"
					  InputTransparent="True"
					  HorizontalOptions="Fill"
					  VerticalOptions="Fill" />

		<Grid Margin="{ext:SafeInsets Type=Top}"
			  Padding="16,12,16,0"
			  ColumnDefinitions="Auto,*,Auto"
			  ColumnSpacing="12"
			  VerticalOptions="Start">
			<controls:ImageButton Command="{Binding CancelCommand}"
								  Style="{DynamicResource FilledImageButton}"
								  PathData="{x:Static ui:Geometries.BackButtonPath}"
								  SemanticProperties.Description="{l:Localize Back}" />

			<Label Grid.Column="1"
				   Text="{Binding ScannerTitleText}"
				   Style="{DynamicResource PageTitleLabel}"
				   FontSize="22"
				   TextColor="White"
				   VerticalOptions="Center"
				   MaxLines="2"
				   LineBreakMode="WordWrap"
				   SemanticProperties.HeadingLevel="Level1" />

			<controls:ImageButton Grid.Column="2"
								  Command="{Binding ToggleTorchCommand}"
								  Style="{DynamicResource FilledImageButton}"
								  PathData="{x:Static ui:Geometries.CameraTorchButtonPath}"
								  IsVisible="{Binding CanUseTorch}"
								  SemanticProperties.Description="{Binding TorchDescription}" />
		</Grid>

		<VerticalStackLayout Margin="0,140,16,0"
							 Spacing="8"
							 HorizontalOptions="End"
							 VerticalOptions="Start"
							 IsVisible="{Binding IsDebugArtifactShareVisible}">
			<Border Padding="12"
					BackgroundColor="{x:Static ui:ScannerColors.CardBackground}"
					StrokeThickness="0"
					StrokeShape="RoundRectangle 12">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SharePreviewDiagnosticsCommand}" />
				</Border.GestureRecognizers>
				<Label Text="PREV"
					   FontFamily="SpaceGroteskBold"
					   FontSize="11"
					   TextColor="White" />
			</Border>
			<Border Padding="12"
					BackgroundColor="{x:Static ui:ScannerColors.CardBackground}"
					StrokeThickness="0"
					StrokeShape="RoundRectangle 12">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding ShareDebugArtifactsCommand}" />
				</Border.GestureRecognizers>
				<Label Text="ZIP"
					   FontFamily="SpaceGroteskBold"
					   FontSize="11"
					   TextColor="White" />
			</Border>
		</VerticalStackLayout>

		<Grid Margin="{ext:SafeInsets Type=Bottom}"
			  VerticalOptions="End">
			<Border Margin="16,0,16,24"
					Padding="16,14"
					MaximumWidthRequest="560"
					BackgroundColor="{x:Static ui:ScannerColors.CardBackground}"
					StrokeThickness="0"
					StrokeShape="RoundRectangle 16">
				<Grid ColumnDefinitions="Auto,*"
					  ColumnSpacing="14">
					<Grid WidthRequest="28"
						  HeightRequest="28"
						  VerticalOptions="Center">
						<Path Data="{Binding HintIcon}"
							  Fill="{Binding HintAccentColor}"
							  Aspect="Uniform"
							  WidthRequest="26"
							  HeightRequest="26"
							  HorizontalOptions="Center"
							  VerticalOptions="Center"
							  IsVisible="{Binding IsHintIconVisible}"
							  AutomationProperties.IsInAccessibleTree="False" />
						<ActivityIndicator Color="{Binding HintAccentColor}"
										   IsRunning="{Binding IsHintProgressVisible}"
										   IsVisible="{Binding IsHintProgressVisible}"
										   WidthRequest="24"
										   HeightRequest="24"
										   HorizontalOptions="Center"
										   VerticalOptions="Center" />
					</Grid>
					<VerticalStackLayout Grid.Column="1"
										 Spacing="4"
										 VerticalOptions="Center">
						<Label Text="{Binding StatusText}"
							   FontFamily="SpaceGroteskBold"
							   FontSize="18"
							   TextColor="White"
							   LineBreakMode="WordWrap"
							   SemanticProperties.HeadingLevel="Level2" />
						<Label Text="{Binding DetailText}"
							   FontSize="14"
							   TextColor="#D9FFFFFF"
							   LineBreakMode="WordWrap" />
					</VerticalStackLayout>
				</Grid>
			</Border>
		</Grid>

		<Grid BackgroundColor="#99000000"
			  IsVisible="{Binding IsValidationOverlayVisible}">
			<Border VerticalOptions="End"
					Padding="24,24,24,0"
					BackgroundColor="{DynamicResource SurfaceElevation1WL}"
					StrokeThickness="0"
					StrokeShape="RoundRectangle 24,24,0,0">
				<VerticalStackLayout Spacing="14"
									 MaximumWidthRequest="560"
									 Margin="{ext:SafeInsets Type=Bottom}"
									 Padding="0,0,0,24">
					<Path Data="{x:Static ui:Geometries.ErrorPath}"
						  Fill="{DynamicResource TnPWarningContentWL}"
						  Aspect="Uniform"
						  WidthRequest="40"
						  HeightRequest="40"
						  HorizontalOptions="Center"
						  AutomationProperties.IsInAccessibleTree="False" />
					<Label Text="{Binding ValidationOverlayTitle}"
						   Style="{DynamicResource PageTitleLabel}"
						   FontSize="24"
						   HorizontalTextAlignment="Center"
						   LineBreakMode="WordWrap"
						   SemanticProperties.HeadingLevel="Level1" />
					<Label Text="{Binding ValidationOverlayDetail}"
						   Style="{DynamicResource InfoLabel}"
						   HorizontalTextAlignment="Center"
						   LineBreakMode="WordWrap" />
					<controls:TextButton Style="{DynamicResource FilledTextButton}"
										 LabelData="{Binding ValidationOverlayPrimaryActionText}"
										 Command="{Binding DismissValidationOverlayCommand}"
										 Margin="0,8,0,0" />
					<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
										 LabelData="{Binding ValidationOverlaySecondaryActionText}"
										 Command="{Binding CancelCommand}" />
				</VerticalStackLayout>
			</Border>
		</Grid>
	</Grid>
</base:BaseContentPage>
