<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycProcessPage"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
					  xmlns:local="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc.Views"
					  xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
					  xmlns:models="clr-namespace:NeuroAccessMaui.Services.Kyc.Models"
					  xmlns:fields="clr-namespace:NeuroAccessMaui.Services.Kyc.ViewModels"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  x:DataType="viewmodel:KycProcessViewModel"
					  xmlns:IDSF="clr-namespace:NeuroAccessMaui.Services.Identity"
					  ui:KeyboardInsets.Mode="Automatic">

	<base:BaseContentPage.Resources>
		<ResourceDictionary>
			<Style x:Key="FileIconBorder"
				   TargetType="Border">
				<Setter Property="Background"
						Value="{DynamicResource BrandColorsNeuroAccessv500WL}" />
				<Setter Property="StrokeShape"
						Value="RoundRectangle 8" />
				<Setter Property="Stroke"
						Value="Transparent" />
				<Setter Property="WidthRequest"
						Value="40" />
				<Setter Property="HeightRequest"
						Value="40" />
			</Style>

			<!-- Text field template -->
			<DataTemplate x:Key="TextFieldTemplate"
						  x:DataType="fields:ObservableGenericField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositeEntry EntryData="{Binding StringValue, Mode=TwoWay}"
											 LabelText="{Binding Label.Text}"
											 HintText="{Binding Hint.Text}"
											 Placeholder="{Binding Placeholder.Text}"
											 Style="{DynamicResource RegularCompositeEntry}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}" />
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Date field template -->
			<DataTemplate x:Key="DateFieldTemplate"
						  x:DataType="fields:ObservableDateField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositeDatePicker LabelText="{Binding Label.Text}"
												  HintText="{Binding Hint.Text}"
												  NullableDate="{Binding DateValue, Mode=TwoWay}"
												  Placeholder="{Binding Placeholder.Text}"
												  Style="{DynamicResource RegularCompositeDatePicker}"
												  Required="{Binding Required}"
												  IsValid="{Binding IsValid}"
												  ValidationText="{Binding ValidationText}">
						<controls:CompositeDatePicker.RightView>
							<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
								  Fill="{DynamicResource InputFieldsContentSecondary}"
								  VerticalOptions="Center" />
						</controls:CompositeDatePicker.RightView>
					</controls:CompositeDatePicker>
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Integer field template -->
			<DataTemplate x:Key="IntegerFieldTemplate"
						  x:DataType="fields:ObservableIntegerField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositeEntry EntryData="{Binding IntValue, Mode=TwoWay}"
											 LabelText="{Binding Label.Text}"
											 HintText="{Binding Hint.Text}"
											 Placeholder="{Binding Placeholder.Text}"
											 Keyboard="Numeric"
											 Style="{DynamicResource RegularCompositeEntry}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}" />
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Decimal field template -->
			<DataTemplate x:Key="DecimalFieldTemplate"
						  x:DataType="fields:ObservableDecimalField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositeEntry EntryData="{Binding DecimalValue, Mode=TwoWay}"
											 LabelText="{Binding Label.Text}"
											 HintText="{Binding Hint.Text}"
											 Placeholder="{Binding Placeholder.Text}"
											 Keyboard="Numeric"
											 Style="{DynamicResource RegularCompositeEntry}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}" />
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Picker field template -->
			<DataTemplate x:Key="PickerFieldTemplate"
						  x:DataType="fields:ObservablePickerField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositePicker ItemsSource="{Binding Options}"
											  LabelText="{Binding Label.Text}"
											  HintText="{Binding Hint.Text}"
											  Placeholder="{Binding Placeholder.Text}"
											  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
											  Style="{DynamicResource RegularCompositePicker}"
											  Required="{Binding Required}"
											  IsValid="{Binding IsValid}"
											  ValidationText="{Binding ValidationText}">
						<controls:CompositePicker.RightView>
							<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
								  Fill="{DynamicResource InputFieldsContentSecondary}"
								  VerticalOptions="Center" />
						</controls:CompositePicker.RightView>
						<controls:CompositePicker.ItemDisplayBinding>
							<Binding Path="Label.Text"
									 x:DataType="models:KycOption" />
						</controls:CompositePicker.ItemDisplayBinding>
					</controls:CompositePicker>
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Radio field template -->
			<DataTemplate x:Key="RadioFieldTemplate"
						  x:DataType="fields:ObservableRadioField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositePicker ItemsSource="{Binding Options}"
											  LabelText="{Binding Label.Text}"
											  HintText="{Binding Hint.Text}"
											  Placeholder="{Binding Placeholder.Text}"
											  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
											  Style="{DynamicResource RegularCompositePicker}"
											  Required="{Binding Required}"
											  IsValid="{Binding IsValid}"
											  ValidationText="{Binding ValidationText}">
						<controls:CompositePicker.ItemDisplayBinding>
							<Binding Path="Label.Text"
									 x:DataType="models:KycOption" />
						</controls:CompositePicker.ItemDisplayBinding>
					</controls:CompositePicker>
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Country field template -->
			<DataTemplate x:Key="CountryFieldTemplate"
						  x:DataType="fields:ObservableCountryField">
				<VerticalStackLayout Spacing="2"
									 IsEnabled="{Binding IsEditable}">
					<controls:CompositePicker ItemsSource="{Binding Options}"
											  LabelText="{Binding Label.Text}"
											  HintText="{Binding Hint.Text}"
											  Placeholder="{Binding Placeholder.Text}"
											  SelectedItem="{Binding CountryCode, Mode=TwoWay}"
											  Style="{DynamicResource RegularCompositePicker}"
											  Required="{Binding Required}"
											  IsValid="{Binding IsValid}"
											  ValidationText="{Binding ValidationText}">
						<controls:CompositePicker.RightView>
							<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
								  Fill="{DynamicResource InputFieldsContentSecondary}"
								  VerticalOptions="Center" />
						</controls:CompositePicker.RightView>
						<controls:CompositePicker.ItemDisplayBinding>
							<Binding Path="Label.Text"
									 x:DataType="models:KycOption" />
						</controls:CompositePicker.ItemDisplayBinding>
					</controls:CompositePicker>
				</VerticalStackLayout>
			</DataTemplate>
			<!-- Checkbox field template using TemplatedSelector -->
			<DataTemplate x:Key="CheckboxFieldTemplate"
						  x:DataType="fields:ObservableCheckboxField">
				<controls:CompositeInputView LabelText="{Binding Label.Text}"
											 HintText="{Binding Hint.Text}"
											 IsEnabled="{Binding IsEditable}"
											 Style="{DynamicResource BaseCompositeInputView}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}"
											 BorderBackground="Transparent">
					<controls:CompositeInputView.CenterView>
						<controls:TemplatedSelector ItemsSource="{Binding Options}"
													SelectedItems="{Binding SelectedOptions, Mode=TwoWay}"
													SelectionMode="Multiple">
							<controls:TemplatedSelector.ItemTemplate>
								<DataTemplate x:DataType="controls:SelectableKycOption">
									<Grid ColumnDefinitions="auto,*"
										  ColumnSpacing="8"
										  Padding="8">
										<controls:AnimatedCheckbox Grid.Column="0"
																   StrokeColor="{DynamicResource ContentAccessWL}"
																   FillColor="Transparent"
																   StrokeWidth="2"
																   IsChecked="{Binding IsSelected, Mode=TwoWay}" />
										<Label Text="{Binding Item.Label.Text}"
											   Grid.Column="1"
											   VerticalTextAlignment="Center" />
									</Grid>
								</DataTemplate>
							</controls:TemplatedSelector.ItemTemplate>
						</controls:TemplatedSelector>
					</controls:CompositeInputView.CenterView>
				</controls:CompositeInputView>
			</DataTemplate>
			<!-- Boolean (switch) field template -->
			<DataTemplate x:Key="BooleanFieldTemplate"
						  x:DataType="fields:ObservableBooleanField">
				<controls:CompositeInputView LabelText="{Binding Label.Text}"
											 IsEnabled="{Binding IsEditable}"
											 Style="{DynamicResource BaseCompositeInputView}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}">
					<controls:CompositeInputView.CenterView>
						<Grid ColumnDefinitions="auto,*"
							  Margin="8">
							<Switch IsToggled="{Binding BoolValue, Mode=TwoWay}"
									Grid.Column="0" />
							<Label Grid.Column="1"
								   Text="{Binding Hint.Text}"
								   Style="{DynamicResource IdentityFlowCaptionLabel}"
								   VerticalOptions="Center" />
						</Grid>
					</controls:CompositeInputView.CenterView>
				</controls:CompositeInputView>
			</DataTemplate>
			<!-- File upload field template -->
			<DataTemplate x:Key="FileUploadFieldTemplate"
						  x:DataType="fields:ObservableFileField">
				<Grid ColumnDefinitions="*,auto,auto,*"
					  IsEnabled="{Binding IsEditable}"
					  ColumnSpacing="{DynamicResource SmallSpacing}"
					  RowDefinitions="auto,auto,auto,*"
					  RowSpacing="{DynamicResource SmallSpacing}">
					<Border Grid.Row="0"
							Grid.RowSpan="4"
							Grid.Column="1"
							Margin="0"
							Padding="0"
							BackgroundColor="{DynamicResource TnPDangerbgWL}"
							HeightRequest="200"
							Style="{DynamicResource OutlinedImageButtonBorder}"
							VerticalOptions="Start"
							WidthRequest="200">
						<Image Aspect="AspectFill"
							   Source="photo_placeholder">
						</Image>
					</Border>
					<controls:ImageButton Grid.Row="0"
										  Grid.Column="2"
										  PathData="{x:Static ui:Geometries.CameraPhotoButtonPath}"
										  Style="{DynamicResource OutlinedImageButton}" />
					<controls:ImageButton Grid.Row="1"
										  Grid.Column="2"
										  PathData="{x:Static ui:Geometries.CameraImageButtonPath}"
										  Style="{DynamicResource OutlinedImageButton}" />
					<controls:ImageButton Grid.Row="2"
										  Grid.Column="2"
										  PathData="{x:Static ui:Geometries.TrashCanButtonPath}"
										  Style="{DynamicResource OutlinedImageButton}" />
				</Grid>
			</DataTemplate>
			<!-- Image field template: a photo card with an illustration, preview, and capture actions -->
			<DataTemplate x:Key="ImageUploadTemplate"
						  x:DataType="fields:ObservableImageField">
				<views:KycImageFieldView />
			</DataTemplate>

			<!-- Label field template -->
			<DataTemplate x:Key="LabelFieldTemplate"
						  x:DataType="fields:ObservableLabelField">
				<Label Text="{Binding Label.Text}"
					   Style="{DynamicResource IdentityFlowSectionTitleLabel}"
					   Margin="0,4,0,0" />
			</DataTemplate>

			<!-- Info field template: a callout -->
			<DataTemplate x:Key="InfoFieldTemplate"
						  x:DataType="fields:ObservableInfoField">
				<Border Style="{DynamicResource IdentityFlowInfoCard}">
					<Grid ColumnDefinitions="Auto,*"
						  ColumnSpacing="12">
						<Path Data="{x:Static ui:Geometries.InfoCirclePath}"
							  Fill="{DynamicResource TnPInfoContentWL}"
							  VerticalOptions="Start"
							  AutomationProperties.IsInAccessibleTree="False" />
						<VerticalStackLayout Grid.Column="1"
											 Spacing="4">
							<Label Text="{Binding Label.Text}"
								   Style="{DynamicResource IdentityFlowSectionTitleLabel}"
								   FontSize="{StaticResource FontSizeLg}" />
							<Label Text="{Binding Description.Text}"
								   Style="{DynamicResource IdentityFlowBodyLabel}"
								   FontSize="{StaticResource FontSizeSm}" />
						</VerticalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

			<local:KycFieldTemplateSelector x:Key="KycFieldTemplateSelector"
											BooleanFieldTemplate="{StaticResource BooleanFieldTemplate}"
											DateFieldTemplate="{StaticResource DateFieldTemplate}"
											PickerFieldTemplate="{StaticResource PickerFieldTemplate}"
											IntegerFieldTemplate="{StaticResource IntegerFieldTemplate}"
											DecimalFieldTemplate="{StaticResource DecimalFieldTemplate}"
											RadioFieldTemplate="{StaticResource RadioFieldTemplate}"
											CountryFieldTemplate="{StaticResource CountryFieldTemplate}"
											CheckboxFieldTemplate="{StaticResource CheckboxFieldTemplate}"
											TextFieldTemplate="{StaticResource TextFieldTemplate}"
											FileUploadFieldTemplate="{StaticResource FileUploadFieldTemplate}"
											ImageUploadFieldTemplate="{StaticResource ImageUploadTemplate}"
											LabelFieldTemplate="{StaticResource LabelFieldTemplate}"
											InfoFieldTemplate="{StaticResource InfoFieldTemplate}" />

			<!-- Summary detail row: label, value, and an edit affordance while the detail can be changed -->
			<DataTemplate x:Key="SummaryDisplayTemplate"
						  x:DataType="IDSF:DisplayQuad">
				<controls:TemplatedButton Command="{Binding GoToPageWithMappingCommand, Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel}"
										  CommandParameter="{Binding Mapping}"
										  IsEnabled="{Binding CanEdit}">
					<controls:TemplatedButton.Triggers>
						<DataTrigger TargetType="controls:TemplatedButton"
									 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
									 Value="True">
							<Setter Property="IsEnabled"
									Value="False" />
							<Setter Property="InputTransparent"
									Value="True" />
						</DataTrigger>
					</controls:TemplatedButton.Triggers>
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="12"
						  Padding="0,6">
						<VerticalStackLayout Spacing="2">
							<Label Text="{Binding Label}"
								   Style="{DynamicResource IdentityFlowKeyLabel}" />
							<Label Text="{Binding Value}"
								   Style="{DynamicResource IdentityFlowValueLabel}">
								<Label.Triggers>
									<DataTrigger TargetType="Label"
												 Binding="{Binding IsInvalid}"
												 Value="True">
										<Setter Property="TextColor"
												Value="{DynamicResource TnPDangerContentWL}" />
									</DataTrigger>
								</Label.Triggers>
							</Label>
						</VerticalStackLayout>
						<controls:SvgView Grid.Column="1"
										  Source="sign.svg"
										  HeightRequest="20"
										  WidthRequest="20"
										  VerticalOptions="Center"
										  IsVisible="{Binding CanEdit}"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  AutomationProperties.IsInAccessibleTree="False">
							<controls:SvgView.Triggers>
								<DataTrigger TargetType="controls:SvgView"
											 Binding="{Binding IsInvalid}"
											 Value="True">
									<Setter Property="TintColor"
											Value="{DynamicResource TnPDangerContentWL}" />
								</DataTrigger>
								<DataTrigger TargetType="controls:SvgView"
											 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
											 Value="True">
									<Setter Property="IsVisible"
											Value="False" />
								</DataTrigger>
							</controls:SvgView.Triggers>
						</controls:SvgView>
					</Grid>
				</controls:TemplatedButton>
			</DataTemplate>

			<!-- An optional detail with a switch that decides whether the finished ID shows it -->
			<DataTemplate x:Key="KeepChoiceTemplate"
						  x:DataType="local:KycKeepChoiceItem">
				<Grid ColumnDefinitions="*,Auto"
					  ColumnSpacing="12"
					  Padding="0,6">
					<VerticalStackLayout Spacing="2">
						<Label Text="{Binding Label}"
							   Style="{DynamicResource IdentityFlowKeyLabel}" />
						<Label Text="{Binding Value}"
							   Style="{DynamicResource IdentityFlowValueLabel}" />
					</VerticalStackLayout>
					<Switch Grid.Column="1"
							VerticalOptions="Center"
							IsToggled="{Binding IsKept, Mode=TwoWay}"
							AutomationProperties.Name="{Binding Label}" />
				</Grid>
			</DataTemplate>

			<!-- A detail the reviewer asked to fix; tapping it opens the field -->
			<DataTemplate x:Key="ReviewIssueTemplate"
						  x:DataType="viewmodel:KycReviewIssueItem">
				<controls:TemplatedButton Command="{Binding GoToPageWithMappingCommand, Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel}"
										  CommandParameter="{Binding Mapping}"
										  IsEnabled="{Binding CanOpen}">
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="10"
						  Padding="0,6">
						<Ellipse WidthRequest="6"
								 HeightRequest="6"
								 Margin="0,8,0,0"
								 VerticalOptions="Start"
								 Fill="{DynamicResource TnPDangerContentWL}" />
						<VerticalStackLayout Grid.Column="1"
											 Spacing="2">
							<Label Text="{Binding Title}"
								   Style="{DynamicResource IdentityFlowValueLabel}"
								   FontFamily="SpaceGroteskBold" />
							<Label Text="{Binding Description}"
								   Style="{DynamicResource IdentityFlowCaptionLabel}"
								   IsVisible="{Binding HasDescription}" />
						</VerticalStackLayout>
						<controls:SvgView Grid.Column="2"
										  Source="sign.svg"
										  WidthRequest="20"
										  HeightRequest="20"
										  VerticalOptions="Center"
										  TintColor="{DynamicResource TnPDangerContentWL}"
										  IsVisible="{Binding CanOpen}"
										  AutomationProperties.IsInAccessibleTree="False" />
					</Grid>
				</controls:TemplatedButton>
			</DataTemplate>
		</ResourceDictionary>
	</base:BaseContentPage.Resources>

	<controls:IdentityFlowShell ShowLeadingAction="True"
								LeadingActionCommand="{Binding ExitCommand}"
								LeadingActionDescription="{l:Localize Close}"
								ShowStickyFooter="{Binding ShowBottomBar}">
		<controls:IdentityFlowShell.HeaderContent>
			<controls:UriImage Aspect="AspectFit"
							   ErrorPlaceholder="neuro_b"
							   Source="{Binding BannerUri}"
							   WidthRequest="100"
							   HeightRequest="24"
							   AutomationProperties.IsInAccessibleTree="False" />
		</controls:IdentityFlowShell.HeaderContent>

		<controls:IdentityFlowShell.BodyContent>
			<Grid RowDefinitions="Auto,*">
				<!-- Where the user is in the form -->
				<VerticalStackLayout Padding="16,0,16,8"
									 Spacing="8"
									 IsVisible="{Binding ShowStepProgress}">
					<Label Text="{Binding ProgressStepText}"
						   Style="{DynamicResource IdentityFlowCaptionLabel}"
						   FontFamily="SpaceGroteskMedium"
						   AutomationProperties.IsInAccessibleTree="False" />
					<controls:StepProgressBar SegmentCount="{Binding DisplayedStepTotal}"
											  Value="{Binding DisplayedStepIndex}"
											  HeightRequest="6"
											  HorizontalOptions="Fill"
											  FillColor="{DynamicResource ContentAccessWL}"
											  TrackColor="{DynamicResource TnPNeutralv300bgWL}"
											  SemanticProperties.Description="{Binding ProgressStepText}" />
				</VerticalStackLayout>

				<!-- Loading -->
				<VerticalStackLayout Grid.Row="1"
									 Spacing="12"
									 HorizontalOptions="Center"
									 VerticalOptions="Center"
									 IsVisible="{Binding IsLoading}">
					<ActivityIndicator IsRunning="{Binding IsLoading}"
									   Color="{DynamicResource BrandColorsNeuroAccessv500WL}" />
					<Label Text="{l:Localize KycLoadingApplication}"
						   Style="{DynamicResource IdentityFlowCaptionLabel}"
						   HorizontalTextAlignment="Center" />
				</VerticalStackLayout>

				<!-- Form -->
				<ScrollView x:Name="FormScroll"
							Grid.Row="1"
							IsVisible="{Binding ShowForm}">
					<VerticalStackLayout x:Name="FormContent"
										 Padding="16,12,16,24"
										 Spacing="20">
						<VerticalStackLayout Spacing="8">
							<Label Style="{DynamicResource IdentityFlowTitleLabel}"
								   Text="{Binding CurrentPageTitle}" />
							<Label IsVisible="{Binding HasCurrentPageDescription}"
								   Text="{Binding CurrentPageDescription}"
								   Style="{DynamicResource IdentityFlowBodySecondaryLabel}" />
						</VerticalStackLayout>

						<!-- Page action, such as reading the document chip -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasCurrentPageAction}">
							<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
								<Label Text="{Binding CurrentPageActionTitle}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}"
									   IsVisible="{Binding HasCurrentPageActionTitle}" />
								<Label Text="{Binding CurrentPageActionDescription}"
									   Style="{DynamicResource IdentityFlowBodyLabel}"
									   IsVisible="{Binding HasCurrentPageActionDescription}" />
								<Label Text="{Binding CurrentPageActionStatusText}"
									   Style="{DynamicResource IdentityFlowBodyLabel}"
									   IsVisible="{Binding HasCurrentPageActionStatusText}" />
								<Label Text="{Binding CurrentPageActionWarningText}"
									   Style="{DynamicResource IdentityFlowBodyLabel}"
									   TextColor="{DynamicResource TnPWarningContentWL}"
									   IsVisible="{Binding HasCurrentPageActionWarningText}" />
								<Label Text="{Binding CurrentPageActionErrorText}"
									   Style="{DynamicResource IdentityFlowErrorLabel}"
									   FontSize="{StaticResource FontSizeLg}"
									   IsVisible="{Binding HasCurrentPageActionErrorText}" />
								<controls:TextButton Style="{DynamicResource TransparentTextButton}"
													 LabelData="{Binding CurrentPageActionPrimaryText}"
													 Command="{Binding ExecuteCurrentPageActionCommand}"
													 IsEnabled="{Binding CurrentPageActionIsEnabled}"
													 IsVisible="{Binding HasCurrentPageActionPrimaryText}" />
							</VerticalStackLayout>
						</Border>

						<!-- Direct fields -->
						<VerticalStackLayout IsVisible="{Binding CurrentPage.VisibleFields.Count, Converter={converters:GreaterThanZero}}"
											 BindableLayout.ItemsSource="{Binding CurrentPage.VisibleFields}"
											 BindableLayout.ItemTemplateSelector="{StaticResource KycFieldTemplateSelector}"
											 Spacing="16" />

						<!-- Sections -->
						<VerticalStackLayout Spacing="24"
											 BindableLayout.ItemsSource="{Binding CurrentPage.VisibleSections}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="models:KycSection">
									<VerticalStackLayout Spacing="16">
										<VerticalStackLayout Spacing="4"
															 IsVisible="{Binding Label, Converter={mct:IsNotNullConverter}}">
											<Label Style="{DynamicResource IdentityFlowSectionTitleLabel}"
												   FontSize="{StaticResource FontSize3xl}"
												   Text="{Binding Label.Text}" />
											<Label Style="{DynamicResource IdentityFlowCaptionLabel}"
												   Text="{Binding Description.Text}"
												   IsVisible="{Binding Description, Converter={mct:IsNotNullConverter}}" />
										</VerticalStackLayout>
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleFields}"
															 BindableLayout.ItemTemplateSelector="{StaticResource KycFieldTemplateSelector}"
															 Spacing="16" />
									</VerticalStackLayout>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</ScrollView>

				<!-- Optional details the finished ID includes -->
				<ScrollView x:Name="IdContentsScroll"
							Grid.Row="1"
							IsVisible="{Binding ShowIdContents}">
					<VerticalStackLayout x:Name="IdContentsContent"
										 Padding="16,12,16,24"
										 Spacing="20">
						<VerticalStackLayout Spacing="8">
							<Label Style="{DynamicResource IdentityFlowTitleLabel}"
								   Text="{l:Localize KycIdContentsTitle}" />
							<Label Text="{l:Localize KycIdContentsDescription}"
								   Style="{DynamicResource IdentityFlowBodySecondaryLabel}" />
						</VerticalStackLayout>
						<Border Style="{DynamicResource IdentityFlowCard}">
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding KeepChoices}"
												 BindableLayout.ItemTemplate="{StaticResource KeepChoiceTemplate}" />
						</Border>
					</VerticalStackLayout>
				</ScrollView>

				<!-- Summary -->
				<ScrollView x:Name="SummaryScroll"
							Grid.Row="1"
							IsVisible="{Binding ShowSummary}">
					<VerticalStackLayout x:Name="SummaryContent"
										 Padding="16,8,16,24"
										 Spacing="16">
						<VerticalStackLayout Spacing="8">
							<Label Style="{DynamicResource IdentityFlowTitleLabel}"
								   Text="{l:Localize Summary}" />
							<Label Text="{l:Localize BeforeFinalizingSummary}"
								   Style="{DynamicResource IdentityFlowBodySecondaryLabel}"
								   IsVisible="{Binding ApplicationSentPublic, Converter={mct:InvertedBoolConverter}}" />
						</VerticalStackLayout>

						<!-- Post-submission panel: application sent + peer review actions -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding ApplicationSentPublic}">
							<VerticalStackLayout Spacing="{DynamicResource MediumSpacing}">
								<Label Style="{DynamicResource IdentityFlowSectionTitleLabel}"
									   Text="{l:Localize Application}" />
								<Label Style="{DynamicResource IdentityFlowBodyLabel}"
									   Text="{l:Localize IdApplicationSentDescription}" />

								<!-- Peer review supported -->
								<controls:ConditionView Condition="{Binding PeerReview}">
									<controls:ConditionView.True>
										<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
											<Label Style="{DynamicResource IdentityFlowBodyLabel}"
												   Text="{l:Localize PeerReviewDescription}" />
											<Label Style="{DynamicResource IdentityFlowBodyLabel}">
												<Label.FormattedText>
													<FormattedString>
														<Span Text="{l:Localize NrPeerReviews}" />
														<Span Text=" " />
														<Span FontAttributes="Bold"
															  Text="{Binding NrReviews}" />
														<Span Text=" / " />
														<Span Text="{Binding NrReviewers}" />
													</FormattedString>
												</Label.FormattedText>
											</Label>

											<Grid RowSpacing="8"
												  RowDefinitions="auto,auto">
												<controls:TextButton Style="{DynamicResource TransparentTextButton}"
																	 LabelData="{l:Localize QrScanCode}"
																	 Command="{Binding ScanQrCodeCommand}"
																	 Grid.Row="0" />
												<controls:TextButton Style="{DynamicResource TransparentTextButton}"
																	 LabelData="{l:Localize FeaturedReviewers}"
																	 Command="{Binding RequestReviewCommand}"
																	 IsVisible="{Binding FeaturedPeerReviewers}"
																	 Grid.Row="1" />
											</Grid>
										</VerticalStackLayout>
									</controls:ConditionView.True>
								</controls:ConditionView>

								<controls:TextButton Style="{DynamicResource FilledTextButton}"
													 LabelData="{l:Localize RevokeApplication}"
													 Command="{Binding RevokeApplicationCommand}" />
							</VerticalStackLayout>
						</Border>

						<!-- What the reviewer asked the user to fix -->
						<Border Style="{DynamicResource IdentityFlowErrorCard}"
								IsVisible="{Binding ShouldShowRejectionBanner}">
							<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
								<Grid ColumnSpacing="{DynamicResource SmallSpacing}"
									  ColumnDefinitions="Auto,*">
									<Path Grid.Column="0"
										  Data="{x:Static ui:Geometries.InfoCirclePath}"
										  Fill="{DynamicResource TnPDangerContentWL}"
										  VerticalOptions="Center"
										  AutomationProperties.IsInAccessibleTree="False" />
									<Label Grid.Column="1"
										   Text="{l:Localize KycRejectedHeader}"
										   Style="{DynamicResource IdentityFlowSectionTitleLabel}"
										   TextColor="{DynamicResource TnPDangerContentWL}"
										   VerticalOptions="Center" />
								</Grid>
								<Label Text="{l:Localize KycRejectedDescription}"
									   Style="{DynamicResource IdentityFlowBodyLabel}" />
								<Label Text="{Binding ErrorDescription}"
									   Style="{DynamicResource IdentityFlowBodyLabel}"
									   FontFamily="SpaceGroteskBold"
									   IsVisible="{Binding HasErrorDescription}" />
								<Label Text="{l:Localize KycRejectedInvalidationHint}"
									   Style="{DynamicResource IdentityFlowCaptionLabel}"
									   IsVisible="{Binding HasReviewIssues}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding ReviewIssues}"
													 BindableLayout.ItemTemplate="{StaticResource ReviewIssueTemplate}"
													 IsVisible="{Binding HasReviewIssues}" />
							</VerticalStackLayout>
						</Border>

						<!-- Details that are still waiting for manual validation -->
						<Border Style="{DynamicResource IdentityFlowWarningCard}"
								IsVisible="{Binding ShouldShowUnvalidatedBanner}">
							<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
								<Grid ColumnSpacing="{DynamicResource SmallSpacing}"
									  ColumnDefinitions="Auto,*">
									<Path Grid.Column="0"
										  Data="{x:Static ui:Geometries.InfoCirclePath}"
										  Fill="{DynamicResource TnPWarningContentWL}"
										  VerticalOptions="Center"
										  AutomationProperties.IsInAccessibleTree="False" />
									<Label Grid.Column="1"
										   Text="{l:Localize KycUnvalidatedWarningTitle}"
										   Style="{DynamicResource IdentityFlowSectionTitleLabel}"
										   TextColor="{DynamicResource TnPWarningContentWL}"
										   VerticalOptions="Center" />
								</Grid>
								<mct:Expander IsExpanded="False">
									<mct:Expander.Header>
										<Label Text="{Binding UnvalidatedSummaryText}"
											   Style="{DynamicResource IdentityFlowBodyLabel}"
											   TextColor="{DynamicResource TnPWarningContentWL}" />
									</mct:Expander.Header>
									<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding UnvalidatedItems}"
															 Spacing="{DynamicResource SmallSpacing}"
															 Margin="8">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="x:String">
													<Label Text="{Binding}"
														   TextColor="{DynamicResource TnPWarningContentWL}"
														   Style="{DynamicResource IdentityFlowBodyLabel}" />
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
										<controls:TextButton Style="{DynamicResource RedButton}"
															 LabelData="{l:Localize KycRemovePendingAndReapplyButton}"
															 Command="{Binding RemovePendingAndResubmitCommand}" />
									</VerticalStackLayout>
								</mct:Expander>
							</VerticalStackLayout>
						</Border>

						<!-- Personal Details -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasPersonalInformation}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize PersonalDetails}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding PersonalInformationSummary}"
													 BindableLayout.ItemTemplate="{StaticResource SummaryDisplayTemplate}" />
							</VerticalStackLayout>
						</Border>

						<!-- Address Details -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasAddressInformation}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize AddressDetails}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding AddressInformationSummary}"
													 BindableLayout.ItemTemplate="{StaticResource SummaryDisplayTemplate}" />
							</VerticalStackLayout>
						</Border>

						<!-- Company Information -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasCompanyInformation}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize CompanyInformation}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding CompanyInformationSummary}"
													 BindableLayout.ItemTemplate="{StaticResource SummaryDisplayTemplate}" />
							</VerticalStackLayout>
						</Border>

						<!-- Company Address Information -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasCompanyAddress}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize CompanyAddress}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding CompanyAddressSummary}"
													 BindableLayout.ItemTemplate="{StaticResource SummaryDisplayTemplate}" />
							</VerticalStackLayout>
						</Border>

						<!-- Company Representative -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasCompanyRepresentative}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize CompanyRepresentative}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding CompanyRepresentativeSummary}"
													 BindableLayout.ItemTemplate="{StaticResource SummaryDisplayTemplate}" />
							</VerticalStackLayout>
						</Border>

						<!-- Attachments -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasAttachments}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize DocumentDetails}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachmentInformationSummary}"
													 BindableLayout.ItemTemplate="{StaticResource SummaryDisplayTemplate}" />
							</VerticalStackLayout>
						</Border>

						<!-- Optional details the finished ID includes; tapping returns to the step where they are chosen -->
						<Border Style="{DynamicResource IdentityFlowCard}"
								IsVisible="{Binding HasKeepChoices}">
							<VerticalStackLayout Spacing="4">
								<Label Text="{l:Localize KycIdContentsTitle}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<controls:TemplatedButton Command="{Binding EnterIdContentsFromSummaryCommand}"
														  IsEnabled="{Binding CanChangeKeepChoices}">
									<Grid ColumnDefinitions="*,Auto"
										  ColumnSpacing="12"
										  Padding="0,6">
										<VerticalStackLayout Spacing="2">
											<Label Text="{l:Localize KycIdContentsIncluded}"
												   Style="{DynamicResource IdentityFlowKeyLabel}" />
											<Label Text="{Binding KeptDetailsText}"
												   Style="{DynamicResource IdentityFlowValueLabel}" />
										</VerticalStackLayout>
										<controls:SvgView Grid.Column="1"
														  Source="sign.svg"
														  HeightRequest="20"
														  WidthRequest="20"
														  VerticalOptions="Center"
														  IsVisible="{Binding CanChangeKeepChoices}"
														  TintColor="{DynamicResource ContentSecondaryWL}"
														  AutomationProperties.IsInAccessibleTree="False" />
									</Grid>
								</controls:TemplatedButton>
							</VerticalStackLayout>
						</Border>

						<!-- Travel document chip status -->
						<Border Style="{DynamicResource IdentityFlowInfoCard}"
								IsVisible="{Binding ShowTravelDocumentSummary}">
							<Border.Triggers>
								<DataTrigger TargetType="Border"
											 Binding="{Binding HasNfcReadout}"
											 Value="True">
									<Setter Property="BackgroundColor"
											Value="{DynamicResource TnPSuccessbgWL}" />
								</DataTrigger>
							</Border.Triggers>
							<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
								<Label Text="{l:Localize KycTravelDocumentSummaryTitle}"
									   Style="{DynamicResource IdentityFlowSectionTitleLabel}" />
								<Label Text="{Binding NfcEvidenceStatusText}"
									   Style="{DynamicResource IdentityFlowBodyLabel}" />
								<controls:TextButton Style="{DynamicResource TransparentTextButton}"
													 LabelData="{l:Localize KycTravelDocumentOpenButton}"
													 Command="{Binding OpenTravelDocumentCommand}"
													 IsVisible="{Binding CanOpenTravelDocumentFromSummary}" />
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>
				</ScrollView>
			</Grid>
		</controls:IdentityFlowShell.BodyContent>

		<controls:IdentityFlowShell.StickyFooterContent>
			<VerticalStackLayout Spacing="8">
				<!-- Sending state -->
				<Grid HeightRequest="52"
					  ColumnDefinitions="Auto,Auto"
					  ColumnSpacing="10"
					  HorizontalOptions="Center"
					  IsVisible="{Binding IsSubmitting}">
					<ActivityIndicator IsRunning="{Binding IsSubmitting}"
									   Color="{DynamicResource BrandColorsNeuroAccessv500WL}"
									   WidthRequest="22"
									   HeightRequest="22"
									   VerticalOptions="Center" />
					<Label Grid.Column="1"
						   Text="{l:Localize KycSendingApplication}"
						   Style="{DynamicResource IdentityFlowBodyLabel}"
						   VerticalOptions="Center" />
				</Grid>

				<controls:ConditionView Condition="{Binding IsEditingFromSummary}"
										IsVisible="{Binding IsSubmitting, Converter={mct:InvertedBoolConverter}}">
					<controls:ConditionView.True>
						<controls:TextButton LabelData="{Binding NextButtonText}"
											 Style="{DynamicResource FilledTextButton}"
											 Command="{Binding GoToSummaryCommand}" />
					</controls:ConditionView.True>
					<controls:ConditionView.False>
						<Grid ColumnDefinitions="*, *"
							  ColumnSpacing="{DynamicResource SmallSpacing}">
							<controls:TextButton LabelData="{l:Localize Back}"
												 Style="{DynamicResource SecondaryButton}"
												 Command="{Binding GoBackCommand}" />
							<controls:TextButton LabelData="{Binding NextButtonText}"
												 Style="{DynamicResource PrimaryButton}"
												 Command="{Binding NextCommand}"
												 Grid.Column="1" />
						</Grid>
					</controls:ConditionView.False>
				</controls:ConditionView>
			</VerticalStackLayout>
		</controls:IdentityFlowShell.StickyFooterContent>
	</controls:IdentityFlowShell>
</base:BaseContentPage>
