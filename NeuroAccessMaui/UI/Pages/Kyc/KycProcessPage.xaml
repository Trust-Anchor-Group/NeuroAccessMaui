<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Class="NeuroAccessMaui.UI.Pages.Kyc.KycProcessPage"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
					  xmlns:local="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  xmlns:kycviews="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc.Views"
					  xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
					  xmlns:models="clr-namespace:NeuroAccessMaui.Services.Kyc.Models"
					  xmlns:fields="clr-namespace:NeuroAccessMaui.Services.Kyc.ViewModels"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Kyc"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:IDSF="clr-namespace:NeuroAccessMaui.Services.Identity"
					  x:DataType="viewmodel:KycProcessViewModel"
					  ui:KeyboardInsets.Mode="Automatic">

	<base:BaseContentPage.Resources>
		<ResourceDictionary>
			<mct:BoolToObjectConverter x:Key="RequiredMarkerConverter"
									   TrueObject=" *"
									   FalseObject="" />

			<!-- Typography -->
			<Style x:Key="KycPageTitle"
				   TargetType="Label">
				<Setter Property="FontFamily"
						Value="SpaceGroteskBold" />
				<Setter Property="FontSize"
						Value="28" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentPrimaryWL}" />
				<Setter Property="SemanticProperties.HeadingLevel"
						Value="Level1" />
			</Style>
			<Style x:Key="KycPageDescription"
				   TargetType="Label">
				<Setter Property="FontSize"
						Value="16" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>
			<Style x:Key="KycSectionTitle"
				   TargetType="Label">
				<Setter Property="FontFamily"
						Value="SpaceGroteskBold" />
				<Setter Property="FontSize"
						Value="18" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentPrimaryWL}" />
				<Setter Property="SemanticProperties.HeadingLevel"
						Value="Level2" />
			</Style>
			<Style x:Key="KycCardTitle"
				   TargetType="Label">
				<Setter Property="FontFamily"
						Value="SpaceGroteskBold" />
				<Setter Property="FontSize"
						Value="17" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentPrimaryWL}" />
			</Style>
			<Style x:Key="KycBodySmall"
				   TargetType="Label">
				<Setter Property="FontSize"
						Value="14" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>
			<Style x:Key="KycSummaryKey"
				   TargetType="Label">
				<Setter Property="FontSize"
						Value="13" />
				<Setter Property="FontFamily"
						Value="SpaceGroteskRegular" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>
			<Style x:Key="KycSummaryValue"
				   TargetType="Label">
				<Setter Property="FontSize"
						Value="16" />
				<Setter Property="FontFamily"
						Value="SpaceGroteskSemiBold" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentPrimaryWL}" />
			</Style>

			<!-- Surfaces -->
			<Style x:Key="KycCard"
				   TargetType="Border">
				<Setter Property="BackgroundColor"
						Value="{DynamicResource SurfaceElevation1WL}" />
				<Setter Property="StrokeThickness"
						Value="0" />
				<Setter Property="StrokeShape"
						Value="RoundRectangle 16" />
				<Setter Property="Padding"
						Value="16" />
				<Setter Property="Shadow">
					<Setter.Value>
						<Shadow Brush="{DynamicResource SurfaceShadowColorWL}"
								Offset="0,4"
								Radius="12" />
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="KycCallout"
				   TargetType="Border">
				<Setter Property="StrokeThickness"
						Value="0" />
				<Setter Property="StrokeShape"
						Value="RoundRectangle 14" />
				<Setter Property="Padding"
						Value="16,14" />
			</Style>
			<Style x:Key="KycIconBubble"
				   TargetType="Border">
				<Setter Property="WidthRequest"
						Value="40" />
				<Setter Property="HeightRequest"
						Value="40" />
				<Setter Property="Padding"
						Value="9" />
				<Setter Property="StrokeThickness"
						Value="0" />
				<Setter Property="StrokeShape"
						Value="Ellipse" />
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="BackgroundColor"
						Value="{DynamicResource BrandColorsNeuroAccessa20WL}" />
				<Setter Property="AutomationProperties.IsInAccessibleTree"
						Value="False" />
			</Style>
			<Style x:Key="KycIcon"
				   TargetType="controls:SvgView">
				<Setter Property="Aspect"
						Value="AspectFit" />
				<Setter Property="TintColor"
						Value="{DynamicResource ContentAccessWL}" />
			</Style>
			<Style x:Key="KycHintLabel"
				   TargetType="Label">
				<Setter Property="FontSize"
						Value="14" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>

			<!-- Text field template -->
			<DataTemplate x:Key="TextFieldTemplate"
						  x:DataType="fields:ObservableGenericField">
				<controls:CompositeEntry EntryData="{Binding StringValue, Mode=TwoWay}"
										 IsEnabled="{Binding IsEditable}"
										 LabelText="{Binding Label.Text}"
										 HintText="{Binding Hint.Text}"
										 Placeholder="{Binding Placeholder.Text}"
										 Style="{DynamicResource RegularCompositeEntry}"
										 Required="{Binding Required}"
										 IsValid="{Binding IsValid}"
										 ValidationText="{Binding ValidationText}" />
			</DataTemplate>
			<!-- Date field template -->
			<DataTemplate x:Key="DateFieldTemplate"
						  x:DataType="fields:ObservableDateField">
				<controls:CompositeDatePicker IsEnabled="{Binding IsEditable}"
											  LabelText="{Binding Label.Text}"
											  HintText="{Binding Hint.Text}"
											  NullableDate="{Binding DateValue, Mode=TwoWay}"
											  Placeholder="{Binding Placeholder.Text}"
											  Style="{DynamicResource RegularCompositeDatePicker}"
											  Required="{Binding Required}"
											  IsValid="{Binding IsValid}"
											  ValidationText="{Binding ValidationText}">
					<controls:CompositeDatePicker.RightView>
						<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
							  Fill="{DynamicResource InputFieldsContentSecondary}"
							  VerticalOptions="Center" />
					</controls:CompositeDatePicker.RightView>
				</controls:CompositeDatePicker>
			</DataTemplate>
			<!-- Integer field template -->
			<DataTemplate x:Key="IntegerFieldTemplate"
						  x:DataType="fields:ObservableIntegerField">
				<controls:CompositeEntry EntryData="{Binding IntValue, Mode=TwoWay}"
										 IsEnabled="{Binding IsEditable}"
										 LabelText="{Binding Label.Text}"
										 HintText="{Binding Hint.Text}"
										 Placeholder="{Binding Placeholder.Text}"
										 Keyboard="Numeric"
										 Style="{DynamicResource RegularCompositeEntry}"
										 Required="{Binding Required}"
										 IsValid="{Binding IsValid}"
										 ValidationText="{Binding ValidationText}" />
			</DataTemplate>
			<!-- Decimal field template -->
			<DataTemplate x:Key="DecimalFieldTemplate"
						  x:DataType="fields:ObservableDecimalField">
				<controls:CompositeEntry EntryData="{Binding DecimalValue, Mode=TwoWay}"
										 IsEnabled="{Binding IsEditable}"
										 LabelText="{Binding Label.Text}"
										 HintText="{Binding Hint.Text}"
										 Placeholder="{Binding Placeholder.Text}"
										 Keyboard="Numeric"
										 Style="{DynamicResource RegularCompositeEntry}"
										 Required="{Binding Required}"
										 IsValid="{Binding IsValid}"
										 ValidationText="{Binding ValidationText}" />
			</DataTemplate>
			<!-- Picker field template -->
			<DataTemplate x:Key="PickerFieldTemplate"
						  x:DataType="fields:ObservablePickerField">
				<controls:CompositePicker IsEnabled="{Binding IsEditable}"
										  ItemsSource="{Binding Options}"
										  LabelText="{Binding Label.Text}"
										  HintText="{Binding Hint.Text}"
										  Placeholder="{Binding Placeholder.Text}"
										  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
										  Style="{DynamicResource RegularCompositePicker}"
										  Required="{Binding Required}"
										  IsValid="{Binding IsValid}"
										  ValidationText="{Binding ValidationText}">
					<controls:CompositePicker.RightView>
						<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
							  Fill="{DynamicResource InputFieldsContentSecondary}"
							  VerticalOptions="Center" />
					</controls:CompositePicker.RightView>
					<controls:CompositePicker.ItemDisplayBinding>
						<Binding Path="Label.Text"
								 x:DataType="models:KycOption" />
					</controls:CompositePicker.ItemDisplayBinding>
				</controls:CompositePicker>
			</DataTemplate>
			<!-- Radio field template -->
			<DataTemplate x:Key="RadioFieldTemplate"
						  x:DataType="fields:ObservableRadioField">
				<controls:CompositePicker IsEnabled="{Binding IsEditable}"
										  ItemsSource="{Binding Options}"
										  LabelText="{Binding Label.Text}"
										  HintText="{Binding Hint.Text}"
										  Placeholder="{Binding Placeholder.Text}"
										  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
										  Style="{DynamicResource RegularCompositePicker}"
										  Required="{Binding Required}"
										  IsValid="{Binding IsValid}"
										  ValidationText="{Binding ValidationText}">
					<controls:CompositePicker.RightView>
						<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
							  Fill="{DynamicResource InputFieldsContentSecondary}"
							  VerticalOptions="Center" />
					</controls:CompositePicker.RightView>
					<controls:CompositePicker.ItemDisplayBinding>
						<Binding Path="Label.Text" />
					</controls:CompositePicker.ItemDisplayBinding>
				</controls:CompositePicker>
			</DataTemplate>
			<!-- Country field template -->
			<DataTemplate x:Key="CountryFieldTemplate"
						  x:DataType="fields:ObservableCountryField">
				<controls:CompositePicker IsEnabled="{Binding IsEditable}"
										  ItemsSource="{Binding Options}"
										  LabelText="{Binding Label.Text}"
										  HintText="{Binding Hint.Text}"
										  Placeholder="{Binding Placeholder.Text}"
										  SelectedItem="{Binding CountryCode, Mode=TwoWay}"
										  Style="{DynamicResource RegularCompositePicker}"
										  Required="{Binding Required}"
										  IsValid="{Binding IsValid}"
										  ValidationText="{Binding ValidationText}">
					<controls:CompositePicker.RightView>
						<Path Data="{x:Static ui:Geometries.DropDownArrowPath}"
							  Fill="{DynamicResource InputFieldsContentSecondary}"
							  VerticalOptions="Center" />
					</controls:CompositePicker.RightView>
					<controls:CompositePicker.ItemDisplayBinding>
						<Binding Path="Label.Text" />
					</controls:CompositePicker.ItemDisplayBinding>
				</controls:CompositePicker>
			</DataTemplate>
			<!-- Checkbox field template -->
			<DataTemplate x:Key="CheckboxFieldTemplate"
						  x:DataType="fields:ObservableCheckboxField">
				<controls:CompositeInputView LabelText="{Binding Label.Text}"
											 HintText="{Binding Hint.Text}"
											 IsEnabled="{Binding IsEditable}"
											 Style="{DynamicResource BaseCompositeInputView}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}"
											 BorderPadding="4">
					<controls:CompositeInputView.CenterView>
						<controls:TemplatedSelector ItemsSource="{Binding Options}"
													SelectedItems="{Binding SelectedOptions, Mode=TwoWay}"
													SelectionMode="Multiple">
							<controls:TemplatedSelector.ItemTemplate>
								<DataTemplate x:DataType="controls:SelectableKycOption">
									<Grid ColumnDefinitions="auto,*"
										  ColumnSpacing="12"
										  Padding="10,12">
										<controls:AnimatedCheckbox Grid.Column="0"
																   StrokeColor="{DynamicResource ContentAccessWL}"
																   FillColor="Transparent"
																   StrokeWidth="2"
																   VerticalOptions="Center"
																   IsChecked="{Binding IsSelected, Mode=TwoWay}" />
										<Label Text="{Binding Item.Label.Text}"
											   Grid.Column="1"
											   FontSize="16"
											   LineBreakMode="WordWrap"
											   VerticalTextAlignment="Center" />
									</Grid>
								</DataTemplate>
							</controls:TemplatedSelector.ItemTemplate>
						</controls:TemplatedSelector>
					</controls:CompositeInputView.CenterView>
				</controls:CompositeInputView>
			</DataTemplate>
			<!-- Boolean (switch) field template -->
			<DataTemplate x:Key="BooleanFieldTemplate"
						  x:DataType="fields:ObservableBooleanField">
				<controls:CompositeInputView IsEnabled="{Binding IsEditable}"
											 Style="{DynamicResource BaseCompositeInputView}"
											 Required="{Binding Required}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}"
											 BorderPadding="16,12">
					<controls:CompositeInputView.CenterView>
						<Grid ColumnDefinitions="*,Auto"
							  ColumnSpacing="12">
							<VerticalStackLayout Spacing="2"
												 VerticalOptions="Center">
								<Label Style="{DynamicResource RegularCompositeInputViewLabel}"
									   LineBreakMode="WordWrap">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding Label.Text}" />
											<Span Text="{Binding Required, Converter={StaticResource RequiredMarkerConverter}}"
												  TextColor="{DynamicResource TnPDangerContentWL}" />
										</FormattedString>
									</Label.FormattedText>
								</Label>
								<Label Text="{Binding Hint.Text}"
									   Style="{StaticResource KycHintLabel}"
									   IsVisible="{Binding Hint.Text, Converter={mct:IsStringNotNullOrEmptyConverter}}" />
							</VerticalStackLayout>
							<Switch Grid.Column="1"
									VerticalOptions="Center"
									IsToggled="{Binding BoolValue, Mode=TwoWay}" />
						</Grid>
					</controls:CompositeInputView.CenterView>
				</controls:CompositeInputView>
			</DataTemplate>
			<!-- File upload field template -->
			<DataTemplate x:Key="FileUploadFieldTemplate"
						  x:DataType="fields:ObservableFileField">
				<Grid ColumnDefinitions="*,auto,auto,*"
					  IsEnabled="{Binding IsEditable}"
					  ColumnSpacing="{DynamicResource SmallSpacing}"
					  RowDefinitions="auto,auto,auto,*"
					  RowSpacing="{DynamicResource SmallSpacing}">
					<Border Grid.Row="0"
							Grid.RowSpan="4"
							Grid.Column="1"
							Margin="0"
							Padding="0"
							BackgroundColor="{DynamicResource TnPDangerbgWL}"
							HeightRequest="200"
							Style="{DynamicResource OutlinedImageButtonBorder}"
							VerticalOptions="Start"
							WidthRequest="200">
						<Image Aspect="AspectFill"
							   Source="photo_placeholder">
						</Image>
					</Border>
					<controls:ImageButton Grid.Row="0"
										  Grid.Column="2"
										  PathData="{x:Static ui:Geometries.CameraPhotoButtonPath}"
										  Style="{DynamicResource OutlinedImageButton}" />
					<controls:ImageButton Grid.Row="1"
										  Grid.Column="2"
										  PathData="{x:Static ui:Geometries.CameraImageButtonPath}"
										  Style="{DynamicResource OutlinedImageButton}" />
					<controls:ImageButton Grid.Row="2"
										  Grid.Column="2"
										  PathData="{x:Static ui:Geometries.TrashCanButtonPath}"
										  Style="{DynamicResource OutlinedImageButton}" />
				</Grid>
			</DataTemplate>
			<!-- Image field template -->
			<DataTemplate x:Key="ImageUploadTemplate"
						  x:DataType="fields:ObservableImageField">
				<kycviews:KycImageFieldView />
			</DataTemplate>
			<!-- Label field template -->
			<DataTemplate x:Key="LabelFieldTemplate"
						  x:DataType="fields:ObservableLabelField">
				<Label Text="{Binding Label.Text}"
					   Style="{StaticResource KycSectionTitle}"
					   FontSize="17" />
			</DataTemplate>
			<!-- Info field template -->
			<DataTemplate x:Key="InfoFieldTemplate"
						  x:DataType="fields:ObservableInfoField">
				<Border Style="{StaticResource KycCallout}"
						BackgroundColor="{DynamicResource TnPInfobgWL}">
					<Grid ColumnDefinitions="Auto,*"
						  ColumnSpacing="12">
						<Path Data="{x:Static ui:Geometries.InfoCirclePath}"
							  Fill="{DynamicResource TnPInfoContentWL}"
							  VerticalOptions="Start"
							  Margin="0,2,0,0"
							  AutomationProperties.IsInAccessibleTree="False" />
						<VerticalStackLayout Grid.Column="1"
											 Spacing="4">
							<Label Text="{Binding Label.Text}"
								   FontFamily="SpaceGroteskBold"
								   FontSize="15"
								   LineBreakMode="WordWrap"
								   TextColor="{DynamicResource TnPInfoContentWL}"
								   IsVisible="{Binding Label.Text, Converter={mct:IsStringNotNullOrEmptyConverter}}" />
							<Label Text="{Binding Description.Text}"
								   FontSize="15"
								   LineBreakMode="WordWrap"
								   TextColor="{DynamicResource ContentPrimaryWL}"
								   IsVisible="{Binding Description.Text, Converter={mct:IsStringNotNullOrEmptyConverter}}" />
						</VerticalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

			<local:KycFieldTemplateSelector x:Key="KycFieldTemplateSelector"
											BooleanFieldTemplate="{StaticResource BooleanFieldTemplate}"
											DateFieldTemplate="{StaticResource DateFieldTemplate}"
											PickerFieldTemplate="{StaticResource PickerFieldTemplate}"
											IntegerFieldTemplate="{StaticResource IntegerFieldTemplate}"
											DecimalFieldTemplate="{StaticResource DecimalFieldTemplate}"
											RadioFieldTemplate="{StaticResource RadioFieldTemplate}"
											CountryFieldTemplate="{StaticResource CountryFieldTemplate}"
											CheckboxFieldTemplate="{StaticResource CheckboxFieldTemplate}"
											TextFieldTemplate="{StaticResource TextFieldTemplate}"
											FileUploadFieldTemplate="{StaticResource FileUploadFieldTemplate}"
											ImageUploadFieldTemplate="{StaticResource ImageUploadTemplate}"
											LabelFieldTemplate="{StaticResource LabelFieldTemplate}"
											InfoFieldTemplate="{StaticResource InfoFieldTemplate}" />

			<!-- Form section -->
			<DataTemplate x:Key="SectionTemplate"
						  x:DataType="models:KycSection">
				<VerticalStackLayout Spacing="16">
					<VerticalStackLayout Spacing="4">
						<Label Text="{Binding Label.Text}"
							   Style="{StaticResource KycSectionTitle}"
							   IsVisible="{Binding Label.Text, Converter={mct:IsStringNotNullOrEmptyConverter}}" />
						<Label Text="{Binding Description.Text}"
							   Style="{StaticResource KycBodySmall}"
							   IsVisible="{Binding Description.Text, Converter={mct:IsStringNotNullOrEmptyConverter}}" />
					</VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleFields}"
										 BindableLayout.ItemTemplateSelector="{StaticResource KycFieldTemplateSelector}"
										 Spacing="20" />
				</VerticalStackLayout>
			</DataTemplate>

			<!-- Summary detail row: label, value, and an edit affordance -->
			<DataTemplate x:Key="SummaryRowTemplate"
						  x:DataType="IDSF:DisplayQuad">
				<controls:TemplatedButton Command="{Binding GoToPageWithMappingCommand, Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel}"
										  CommandParameter="{Binding Mapping}"
										  IsEnabled="{Binding CanEdit}">
					<controls:TemplatedButton.Triggers>
						<DataTrigger TargetType="controls:TemplatedButton"
									 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
									 Value="True">
							<Setter Property="IsEnabled"
									Value="False" />
							<Setter Property="InputTransparent"
									Value="True" />
						</DataTrigger>
					</controls:TemplatedButton.Triggers>
					<Grid ColumnDefinitions="*,Auto"
						  ColumnSpacing="12"
						  Padding="0,9">
						<VerticalStackLayout Spacing="2">
							<Label Text="{Binding Label}"
								   Style="{StaticResource KycSummaryKey}" />
							<Label Text="{Binding Value}"
								   Style="{StaticResource KycSummaryValue}">
								<Label.Triggers>
									<DataTrigger TargetType="Label"
												 Binding="{Binding IsInvalid}"
												 Value="True">
										<Setter Property="TextColor"
												Value="{DynamicResource TnPDangerContentWL}" />
									</DataTrigger>
								</Label.Triggers>
							</Label>
						</VerticalStackLayout>
						<controls:SvgView Grid.Column="1"
										  Source="kyc_edit.svg"
										  WidthRequest="18"
										  HeightRequest="18"
										  VerticalOptions="Center"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  IsVisible="{Binding CanEdit}"
										  AutomationProperties.IsInAccessibleTree="False">
							<controls:SvgView.Triggers>
								<DataTrigger TargetType="controls:SvgView"
											 Binding="{Binding IsInvalid}"
											 Value="True">
									<Setter Property="TintColor"
											Value="{DynamicResource TnPDangerContentWL}" />
								</DataTrigger>
								<DataTrigger TargetType="controls:SvgView"
											 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
											 Value="True">
									<Setter Property="IsVisible"
											Value="False" />
								</DataTrigger>
							</controls:SvgView.Triggers>
						</controls:SvgView>
					</Grid>
				</controls:TemplatedButton>
			</DataTemplate>

			<!-- Summary document row: document name with an added check or edit affordance -->
			<DataTemplate x:Key="SummaryDocumentTemplate"
						  x:DataType="IDSF:DisplayQuad">
				<controls:TemplatedButton Command="{Binding GoToPageWithMappingCommand, Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel}"
										  CommandParameter="{Binding Mapping}"
										  IsEnabled="{Binding CanEdit}">
					<controls:TemplatedButton.Triggers>
						<DataTrigger TargetType="controls:TemplatedButton"
									 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
									 Value="True">
							<Setter Property="IsEnabled"
									Value="False" />
							<Setter Property="InputTransparent"
									Value="True" />
						</DataTrigger>
					</controls:TemplatedButton.Triggers>
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="12"
						  Padding="0,10">
						<controls:SvgView Source="kyc_documents.svg"
										  WidthRequest="20"
										  HeightRequest="20"
										  VerticalOptions="Center"
										  TintColor="{DynamicResource ContentSecondaryWL}"
										  AutomationProperties.IsInAccessibleTree="False" />
						<Label Grid.Column="1"
							   Text="{Binding Value}"
							   Style="{StaticResource KycSummaryValue}"
							   VerticalOptions="Center">
							<Label.Triggers>
								<DataTrigger TargetType="Label"
											 Binding="{Binding IsInvalid}"
											 Value="True">
									<Setter Property="TextColor"
											Value="{DynamicResource TnPDangerContentWL}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
						<Grid Grid.Column="2"
							  VerticalOptions="Center"
							  AutomationProperties.IsInAccessibleTree="False">
							<controls:SvgView Source="kyc_check_circle.svg"
											  WidthRequest="20"
											  HeightRequest="20"
											  TintColor="{DynamicResource ContentAccessWL}"
											  IsVisible="{Binding CanEdit, Converter={mct:InvertedBoolConverter}}">
								<controls:SvgView.Triggers>
									<DataTrigger TargetType="controls:SvgView"
												 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
												 Value="True">
										<Setter Property="IsVisible"
												Value="True" />
									</DataTrigger>
								</controls:SvgView.Triggers>
							</controls:SvgView>
							<controls:SvgView Source="kyc_edit.svg"
											  WidthRequest="18"
											  HeightRequest="18"
											  TintColor="{DynamicResource ContentSecondaryWL}"
											  IsVisible="{Binding CanEdit}">
								<controls:SvgView.Triggers>
									<DataTrigger TargetType="controls:SvgView"
												 Binding="{Binding IsInvalid}"
												 Value="True">
										<Setter Property="TintColor"
												Value="{DynamicResource TnPDangerContentWL}" />
									</DataTrigger>
									<DataTrigger TargetType="controls:SvgView"
												 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:KycProcessViewModel}}, x:DataType=viewmodel:KycProcessViewModel, Path=ApplicationSentPublic}"
												 Value="True">
										<Setter Property="IsVisible"
												Value="False" />
									</DataTrigger>
								</controls:SvgView.Triggers>
							</controls:SvgView>
						</Grid>
					</Grid>
				</controls:TemplatedButton>
			</DataTemplate>

			<!-- Bullet item used by callouts -->
			<DataTemplate x:Key="DangerBulletTemplate"
						  x:DataType="x:String">
				<Grid ColumnDefinitions="Auto,*"
					  ColumnSpacing="10">
					<Ellipse WidthRequest="6"
							 HeightRequest="6"
							 Margin="0,8,0,0"
							 VerticalOptions="Start"
							 Fill="{DynamicResource TnPDangerContentWL}" />
					<Label Grid.Column="1"
						   Text="{Binding}"
						   FontSize="15"
						   FontFamily="SpaceGroteskSemiBold"
						   LineBreakMode="WordWrap"
						   TextColor="{DynamicResource ContentPrimaryWL}" />
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="WarningBulletTemplate"
						  x:DataType="x:String">
				<Grid ColumnDefinitions="Auto,*"
					  ColumnSpacing="10">
					<Ellipse WidthRequest="6"
							 HeightRequest="6"
							 Margin="0,8,0,0"
							 VerticalOptions="Start"
							 Fill="{DynamicResource TnPWarningContentWL}" />
					<Label Grid.Column="1"
						   Text="{Binding}"
						   FontSize="15"
						   LineBreakMode="WordWrap"
						   TextColor="{DynamicResource ContentPrimaryWL}" />
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</base:BaseContentPage.Resources>

	<controls:ConditionView Condition="{Binding IsLoading}">
		<controls:ConditionView.True>
			<Grid RowDefinitions="Auto,*"
				  BackgroundColor="{DynamicResource SurfaceBackgroundWL}">
				<Grid Padding="16,8,16,0"
					  ColumnDefinitions="48,*,48">
					<controls:SvgButton Command="{Binding ExitCommand}"
										Style="{DynamicResource IconButton}"
										SvgSource="close.svg"
										HeightRequest="48"
										WidthRequest="48"
										HorizontalOptions="Start"
										SemanticProperties.Description="{l:Localize Close}" />
					<controls:UriImage Grid.Column="1"
									   Aspect="AspectFit"
									   ErrorPlaceholder="neuro_b"
									   HorizontalOptions="Center"
									   VerticalOptions="Center"
									   Source="{Binding BannerUri}"
									   WidthRequest="100"
									   HeightRequest="24" />
				</Grid>
				<VerticalStackLayout Grid.Row="1"
									 Spacing="14"
									 HorizontalOptions="Center"
									 VerticalOptions="Center">
					<ActivityIndicator IsRunning="True"
									   HorizontalOptions="Center"
									   Color="{DynamicResource ContentAccessWL}" />
					<Label Text="{l:Localize KycLoadingApplication}"
						   Style="{StaticResource KycBodySmall}"
						   HorizontalTextAlignment="Center" />
				</VerticalStackLayout>
			</Grid>
		</controls:ConditionView.True>
		<controls:ConditionView.False>

			<Grid RowDefinitions="Auto,Auto,*,Auto"
				  BackgroundColor="{DynamicResource SurfaceBackgroundWL}">

				<!-- Header -->
				<Grid Padding="16,8,16,0"
					  ColumnDefinitions="48,*,48">
					<controls:SvgButton Command="{Binding ExitCommand}"
										Style="{DynamicResource IconButton}"
										SvgSource="close.svg"
										HeightRequest="48"
										WidthRequest="48"
										HorizontalOptions="Start"
										SemanticProperties.Description="{l:Localize Close}" />
					<controls:UriImage Grid.Column="1"
									   Aspect="AspectFit"
									   ErrorPlaceholder="neuro_b"
									   HorizontalOptions="Center"
									   VerticalOptions="Center"
									   Source="{Binding BannerUri}"
									   WidthRequest="100"
									   HeightRequest="24" />
				</Grid>

				<!-- Step progress -->
				<VerticalStackLayout Grid.Row="1"
									 Padding="20,14,20,6"
									 Spacing="8"
									 IsVisible="{Binding ApplicationSentPublic, Converter={mct:InvertedBoolConverter}}">
					<Label Text="{Binding StepCaption}"
						   FontFamily="SpaceGroteskBold"
						   FontSize="13"
						   TextColor="{DynamicResource ContentSecondaryWL}"
						   AutomationProperties.IsInAccessibleTree="False" />
					<controls:StepProgressBar HeightRequest="6"
											  SegmentCount="{Binding StepCount}"
											  Value="{Binding StepValue}"
											  TrackColor="{DynamicResource TnPNeutralv300bgWL}"
											  FillColor="{DynamicResource ContentAccessWL}"
											  SemanticProperties.Description="{Binding StepCaption}" />
				</VerticalStackLayout>

				<Grid Grid.Row="2">
					<!-- Form -->
					<ScrollView x:Name="FormScroll"
								IsVisible="{Binding IsInSummary, Converter={mct:InvertedBoolConverter}}">
						<VerticalStackLayout x:Name="FormContent"
											 Padding="20,16,20,32"
											 Spacing="24"
											 MaximumWidthRequest="640">
							<VerticalStackLayout Spacing="8">
								<Label Style="{StaticResource KycPageTitle}"
									   Text="{Binding CurrentPageTitle}" />
								<Label Style="{StaticResource KycPageDescription}"
									   Text="{Binding CurrentPageDescription}"
									   IsVisible="{Binding HasCurrentPageDescription}" />
							</VerticalStackLayout>

							<!-- Built-in page action, such as reading the document chip -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasCurrentPageAction}">
								<VerticalStackLayout Spacing="12">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="14">
										<Border Style="{StaticResource KycIconBubble}"
												WidthRequest="48"
												HeightRequest="48"
												Padding="10">
											<controls:SvgView Source="kyc_chip.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<VerticalStackLayout Grid.Column="1"
															 Spacing="4"
															 VerticalOptions="Center">
											<Label Text="{Binding CurrentPageActionTitle}"
												   Style="{StaticResource KycCardTitle}"
												   IsVisible="{Binding HasCurrentPageActionTitle}" />
											<Label Text="{Binding CurrentPageActionDescription}"
												   Style="{StaticResource KycBodySmall}"
												   IsVisible="{Binding HasCurrentPageActionDescription}" />
										</VerticalStackLayout>
									</Grid>
									<Border Style="{StaticResource KycCallout}"
											Padding="12,8"
											HorizontalOptions="Start"
											BackgroundColor="{DynamicResource TnPInfobgWL}"
											IsVisible="{Binding HasCurrentPageActionStatusText}">
										<Label Text="{Binding CurrentPageActionStatusText}"
											   FontSize="14"
											   FontFamily="SpaceGroteskSemiBold"
											   LineBreakMode="WordWrap"
											   TextColor="{DynamicResource TnPInfoContentWL}" />
									</Border>
									<Label Text="{Binding CurrentPageActionWarningText}"
										   Style="{StaticResource KycBodySmall}"
										   TextColor="{DynamicResource TnPWarningContentWL}"
										   IsVisible="{Binding HasCurrentPageActionWarningText}" />
									<Label Text="{Binding CurrentPageActionErrorText}"
										   Style="{StaticResource KycBodySmall}"
										   TextColor="{DynamicResource TnPDangerContentWL}"
										   IsVisible="{Binding HasCurrentPageActionErrorText}" />
									<controls:TextButton Style="{DynamicResource FilledTextButton}"
														 LabelData="{Binding CurrentPageActionPrimaryText}"
														 Command="{Binding ExecuteCurrentPageActionCommand}"
														 IsEnabled="{Binding CurrentPageActionIsEnabled}"
														 IsVisible="{Binding HasCurrentPageActionPrimaryText}" />
								</VerticalStackLayout>
							</Border>

							<!-- Fields placed directly on the page -->
							<VerticalStackLayout IsVisible="{Binding CurrentPage.VisibleFields.Count, Converter={converters:GreaterThanZero}}"
												 BindableLayout.ItemsSource="{Binding CurrentPage.VisibleFields}"
												 BindableLayout.ItemTemplateSelector="{StaticResource KycFieldTemplateSelector}"
												 Spacing="20" />

							<!-- Sections -->
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentPage.VisibleSections}"
												 BindableLayout.ItemTemplate="{StaticResource SectionTemplate}"
												 Spacing="32" />
						</VerticalStackLayout>
					</ScrollView>

					<!-- Summary -->
					<ScrollView x:Name="SummaryScroll"
								IsVisible="{Binding IsInSummary}">
						<VerticalStackLayout x:Name="SummaryContent"
											 Padding="20,16,20,32"
											 Spacing="16"
											 MaximumWidthRequest="640">

							<!-- Sent -->
							<VerticalStackLayout x:Name="SentPanel"
												 Spacing="14"
												 IsVisible="{Binding ApplicationSentPublic}">
								<controls:StatusVisual x:Name="SentVisual"
													   Kind="Success"
													   HeightRequest="150"
													   HorizontalOptions="Fill"
													   AccentColor="{DynamicResource ContentAccessWL}"
													   OnAccentColor="{DynamicResource ContentPrimaryInverted}"
													   WarningColor="{DynamicResource TnPWarningContentWL}" />
								<Label Text="{l:Localize KycSentTitle}"
									   Style="{StaticResource KycPageTitle}"
									   HorizontalTextAlignment="Center" />
								<Label Text="{l:Localize KycSentDescription}"
									   Style="{StaticResource KycPageDescription}"
									   HorizontalTextAlignment="Center" />
								<controls:GuideStepper CurrentStep="1"
													   Margin="8,6,8,4"
													   MaximumWidthRequest="420"
													   HorizontalOptions="Fill">
									<controls:GuideStepper.Steps>
										<controls:GuideStep Text="{l:Localize KycStepDetails}" />
										<controls:GuideStep Text="{l:Localize KycStepReview}" />
										<controls:GuideStep Text="{l:Localize KycStepIdReady}" />
									</controls:GuideStepper.Steps>
								</controls:GuideStepper>

								<!-- Peer review -->
								<Border Style="{StaticResource KycCard}"
										Margin="0,6,0,0"
										IsVisible="{Binding PeerReview}">
									<VerticalStackLayout Spacing="12">
										<Grid ColumnDefinitions="Auto,*"
											  ColumnSpacing="12">
											<Border Style="{StaticResource KycIconBubble}">
												<controls:SvgView Source="kyc_peers.svg"
																  Style="{StaticResource KycIcon}" />
											</Border>
											<Label Grid.Column="1"
												   Text="{l:Localize KycPeerReviewTitle}"
												   Style="{StaticResource KycCardTitle}" />
										</Grid>
										<Label Text="{l:Localize PeerReviewDescription}"
											   Style="{StaticResource KycBodySmall}" />
										<VerticalStackLayout Spacing="8"
															 IsVisible="{Binding HasPeerReviewTarget}">
											<Label Text="{Binding PeerReviewProgressText}"
												   FontFamily="SpaceGroteskBold"
												   FontSize="14"
												   TextColor="{DynamicResource ContentPrimaryWL}" />
											<controls:StepProgressBar HeightRequest="6"
																	  SegmentCount="{Binding NrReviewers}"
																	  Value="{Binding NrReviews}"
																	  TrackColor="{DynamicResource TnPNeutralv300bgWL}"
																	  FillColor="{DynamicResource ContentAccessWL}"
																	  AutomationProperties.IsInAccessibleTree="False" />
										</VerticalStackLayout>
										<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
															 LabelData="{l:Localize QrScanCode}"
															 Command="{Binding ScanQrCodeCommand}" />
										<controls:TextButton Style="{DynamicResource OutlinedTextButton}"
															 LabelData="{l:Localize FeaturedReviewers}"
															 Command="{Binding RequestReviewCommand}"
															 IsVisible="{Binding FeaturedPeerReviewers}" />
									</VerticalStackLayout>
								</Border>

								<controls:TextButton Style="{DynamicResource FilledTextButton}"
													 LabelData="{l:Localize KycDoneButton}"
													 Command="{Binding ExitCommand}"
													 Margin="0,6,0,0" />
								<controls:TemplatedButton Command="{Binding RevokeApplicationCommand}"
														  HorizontalOptions="Center"
														  SemanticProperties.Description="{l:Localize KycRevokeApplicationButton}">
									<Label Text="{l:Localize KycRevokeApplicationButton}"
										   Padding="16,10"
										   FontFamily="SpaceGroteskBold"
										   FontSize="15"
										   TextColor="{DynamicResource TnPDangerContentWL}" />
								</controls:TemplatedButton>

								<Label Text="{l:Localize KycYourDetailsTitle}"
									   Style="{StaticResource KycSectionTitle}"
									   Margin="0,12,0,0" />
							</VerticalStackLayout>

							<!-- Review intro -->
							<VerticalStackLayout Spacing="8"
												 IsVisible="{Binding ApplicationSentPublic, Converter={mct:InvertedBoolConverter}}">
								<Label Text="{l:Localize KycSummaryTitle}"
									   Style="{StaticResource KycPageTitle}" />
								<Label Text="{l:Localize KycSummaryDescription}"
									   Style="{StaticResource KycPageDescription}" />
							</VerticalStackLayout>

							<!-- Rejected -->
							<Border Style="{StaticResource KycCallout}"
									BackgroundColor="{DynamicResource TnPDangerbgWL}"
									IsVisible="{Binding ShouldShowRejectionBanner}">
								<Grid ColumnDefinitions="Auto,*"
									  ColumnSpacing="12">
									<Path Data="{x:Static ui:Geometries.ErrorPath}"
										  Fill="{DynamicResource TnPDangerContentWL}"
										  VerticalOptions="Start"
										  Margin="0,2,0,0"
										  AutomationProperties.IsInAccessibleTree="False" />
									<VerticalStackLayout Grid.Column="1"
														 Spacing="8">
										<Label Text="{l:Localize KycRejectedHeader}"
											   FontFamily="SpaceGroteskBold"
											   FontSize="17"
											   TextColor="{DynamicResource TnPDangerContentWL}"
											   SemanticProperties.HeadingLevel="Level2" />
										<Label Text="{Binding ErrorDescription}"
											   FontSize="15"
											   LineBreakMode="WordWrap"
											   TextColor="{DynamicResource ContentPrimaryWL}"
											   IsVisible="{Binding HasErrorDescription}" />
										<Label Text="{l:Localize KycRejectedInvalidationHint}"
											   Style="{StaticResource KycBodySmall}"
											   IsVisible="{Binding HasInvalidatedItems}" />
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding InvalidatedItems}"
															 BindableLayout.ItemTemplate="{StaticResource DangerBulletTemplate}"
															 Spacing="6" />
									</VerticalStackLayout>
								</Grid>
							</Border>

							<!-- Details that need manual review -->
							<Border Style="{StaticResource KycCallout}"
									BackgroundColor="{DynamicResource TnPWarningbgWL}"
									IsVisible="{Binding ShouldShowUnvalidatedBanner}">
								<Grid ColumnDefinitions="Auto,*"
									  ColumnSpacing="12">
									<Path Data="{x:Static ui:Geometries.InfoCirclePath}"
										  Fill="{DynamicResource TnPWarningContentWL}"
										  VerticalOptions="Start"
										  Margin="0,2,0,0"
										  AutomationProperties.IsInAccessibleTree="False" />
									<VerticalStackLayout Grid.Column="1"
														 Spacing="8">
										<Label Text="{l:Localize KycUnvalidatedWarningTitle}"
											   FontFamily="SpaceGroteskBold"
											   FontSize="17"
											   LineBreakMode="WordWrap"
											   TextColor="{DynamicResource TnPWarningContentWL}"
											   SemanticProperties.HeadingLevel="Level2" />
										<mct:Expander IsExpanded="False">
											<mct:Expander.Header>
												<Label Text="{Binding UnvalidatedSummaryText}"
													   FontSize="15"
													   LineBreakMode="WordWrap"
													   TextColor="{DynamicResource ContentPrimaryWL}" />
											</mct:Expander.Header>
											<VerticalStackLayout Spacing="12"
																 Padding="0,12,0,0">
												<VerticalStackLayout BindableLayout.ItemsSource="{Binding UnvalidatedItems}"
																	 BindableLayout.ItemTemplate="{StaticResource WarningBulletTemplate}"
																	 Spacing="6" />
												<Label Text="{l:Localize KycUnvalidatedActionHint}"
													   Style="{StaticResource KycBodySmall}" />
												<controls:TextButton Style="{DynamicResource RedButton}"
																	 LabelData="{l:Localize KycRemovePendingAndReapplyButton}"
																	 Command="{Binding RemovePendingAndResubmitCommand}" />
											</VerticalStackLayout>
										</mct:Expander>
									</VerticalStackLayout>
								</Grid>
							</Border>

							<!-- Document chip -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding ShowTravelDocumentSummary}">
								<VerticalStackLayout Spacing="12">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="kyc_chip.svg"
															  Style="{StaticResource KycIcon}">
												<controls:SvgView.Triggers>
													<DataTrigger TargetType="controls:SvgView"
																 Binding="{Binding HasNfcReadout}"
																 Value="True">
														<Setter Property="Source"
																Value="kyc_verified.svg" />
													</DataTrigger>
												</controls:SvgView.Triggers>
											</controls:SvgView>
										</Border>
										<VerticalStackLayout Grid.Column="1"
															 Spacing="2"
															 VerticalOptions="Center">
											<Label Text="{l:Localize KycTravelDocumentSummaryTitle}"
												   Style="{StaticResource KycCardTitle}">
												<Label.Triggers>
													<DataTrigger TargetType="Label"
																 Binding="{Binding HasNfcReadout}"
																 Value="True">
														<Setter Property="Text"
																Value="{l:Localize KycChipVerifiedTitle}" />
													</DataTrigger>
												</Label.Triggers>
											</Label>
											<Label Text="{Binding NfcEvidenceStatusText}"
												   Style="{StaticResource KycBodySmall}" />
										</VerticalStackLayout>
									</Grid>
									<controls:TextButton Style="{DynamicResource FilledTextButton}"
														 LabelData="{l:Localize KycTravelDocumentOpenButton}"
														 Command="{Binding OpenTravelDocumentCommand}"
														 IsVisible="{Binding CanOpenTravelDocumentFromSummary}" />
								</VerticalStackLayout>
							</Border>

							<!-- Personal details -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasPersonalInformation}">
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="person.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<Label Grid.Column="1"
											   Text="{l:Localize PersonalDetails}"
											   Style="{StaticResource KycCardTitle}"
											   SemanticProperties.HeadingLevel="Level2" />
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding PersonalInformationSummary}"
														 BindableLayout.ItemTemplate="{StaticResource SummaryRowTemplate}" />
								</VerticalStackLayout>
							</Border>

							<!-- Address -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasAddressInformation}">
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="kyc_location.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<Label Grid.Column="1"
											   Text="{l:Localize AddressDetails}"
											   Style="{StaticResource KycCardTitle}"
											   SemanticProperties.HeadingLevel="Level2" />
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding AddressInformationSummary}"
														 BindableLayout.ItemTemplate="{StaticResource SummaryRowTemplate}" />
								</VerticalStackLayout>
							</Border>

							<!-- Company -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasCompanyInformation}">
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="kyc_business.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<Label Grid.Column="1"
											   Text="{l:Localize CompanyInformation}"
											   Style="{StaticResource KycCardTitle}"
											   SemanticProperties.HeadingLevel="Level2" />
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding CompanyInformationSummary}"
														 BindableLayout.ItemTemplate="{StaticResource SummaryRowTemplate}" />
								</VerticalStackLayout>
							</Border>

							<!-- Company address -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasCompanyAddress}">
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="kyc_location.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<Label Grid.Column="1"
											   Text="{l:Localize CompanyAddress}"
											   Style="{StaticResource KycCardTitle}"
											   SemanticProperties.HeadingLevel="Level2" />
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding CompanyAddressSummary}"
														 BindableLayout.ItemTemplate="{StaticResource SummaryRowTemplate}" />
								</VerticalStackLayout>
							</Border>

							<!-- Company representative -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasCompanyRepresentative}">
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="kyc_representative.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<Label Grid.Column="1"
											   Text="{l:Localize CompanyRepresentative}"
											   Style="{StaticResource KycCardTitle}"
											   SemanticProperties.HeadingLevel="Level2" />
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding CompanyRepresentativeSummary}"
														 BindableLayout.ItemTemplate="{StaticResource SummaryRowTemplate}" />
								</VerticalStackLayout>
							</Border>

							<!-- Documents -->
							<Border Style="{StaticResource KycCard}"
									IsVisible="{Binding HasAttachments}">
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*"
										  ColumnSpacing="12">
										<Border Style="{StaticResource KycIconBubble}">
											<controls:SvgView Source="kyc_documents.svg"
															  Style="{StaticResource KycIcon}" />
										</Border>
										<Label Grid.Column="1"
											   Text="{l:Localize DocumentDetails}"
											   Style="{StaticResource KycCardTitle}"
											   SemanticProperties.HeadingLevel="Level2" />
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachmentInformationSummary}"
														 BindableLayout.ItemTemplate="{StaticResource SummaryDocumentTemplate}" />
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>
					</ScrollView>
				</Grid>

				<!-- Bottom bar (hidden once the application is sent or while typing) -->
				<Border Grid.Row="3"
						Style="{DynamicResource BottomBarBorder2}"
						IsVisible="{Binding ShowBottomBar}"
						Padding="16,12,16,16">
					<Grid MaximumWidthRequest="640">
						<controls:TextButton LabelData="{l:Localize Kyc_Return}"
											 Style="{DynamicResource FilledTextButton}"
											 Command="{Binding GoToSummaryCommand}"
											 IsVisible="{Binding IsEditingFromSummary}" />
						<Grid IsVisible="{Binding IsEditingFromSummary, Converter={mct:InvertedBoolConverter}}">
							<Grid ColumnDefinitions="*,2*"
								  ColumnSpacing="8"
								  IsVisible="{Binding IsSubmitting, Converter={mct:InvertedBoolConverter}}">
								<controls:TextButton LabelData="{l:Localize Back}"
													 Style="{DynamicResource SecondaryButton}"
													 Command="{Binding GoBackCommand}" />
								<controls:TextButton Grid.Column="1"
													 LabelData="{Binding NextButtonText}"
													 Style="{DynamicResource PrimaryButton}"
													 Command="{Binding NextCommand}" />
							</Grid>
							<Border Style="{DynamicResource FilledTextButtonBorder}"
									IsVisible="{Binding IsSubmitting}">
								<HorizontalStackLayout Spacing="10"
													   HorizontalOptions="Center">
									<ActivityIndicator IsRunning="{Binding IsSubmitting}"
													   WidthRequest="20"
													   HeightRequest="20"
													   VerticalOptions="Center"
													   Color="{DynamicResource ButtonAccessPrimaryContentWL}" />
									<Label Text="{l:Localize KycSendingApplication}"
										   Style="{DynamicResource FilledTextButtonLabel}"
										   VerticalOptions="Center" />
								</HorizontalStackLayout>
							</Border>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</controls:ConditionView.False>
	</controls:ConditionView>
</base:BaseContentPage>
