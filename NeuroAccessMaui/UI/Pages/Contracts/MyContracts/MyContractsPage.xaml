<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.MyContracts.MyContractsPage"
	x:DataType="viewmodel:MyContractsViewModel"
	x:Name="ThisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts.ObjectModels"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts">
	<base:BaseContentPage.Resources>
		<Style x:Key="ContractStateRailStyle" TargetType="BoxView">
			<Setter Property="BackgroundColor" Value="{DynamicResource ContentSecondaryWL}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding StateTone}" TargetType="BoxView" Value="{x:Static controls:StatusPillTone.Information}">
					<Setter Property="BackgroundColor" Value="{DynamicResource TnPInfoFigureWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="BoxView" Value="{x:Static controls:StatusPillTone.Success}">
					<Setter Property="BackgroundColor" Value="{DynamicResource TnPSuccessFigureWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="BoxView" Value="{x:Static controls:StatusPillTone.Warning}">
					<Setter Property="BackgroundColor" Value="{DynamicResource TnPWarningFigureWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="BoxView" Value="{x:Static controls:StatusPillTone.Danger}">
					<Setter Property="BackgroundColor" Value="{DynamicResource TnPDangerFigureWL}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="ContractStateIconStyle" TargetType="controls:SvgView">
			<Setter Property="HeightRequest" Value="18" />
			<Setter Property="InputTransparent" Value="True" />
			<Setter Property="TintColor" Value="{DynamicResource ContentSecondaryWL}" />
			<Setter Property="WidthRequest" Value="18" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding StateTone}" TargetType="controls:SvgView" Value="{x:Static controls:StatusPillTone.Information}">
					<Setter Property="TintColor" Value="{DynamicResource TnPInfoContentWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="controls:SvgView" Value="{x:Static controls:StatusPillTone.Success}">
					<Setter Property="TintColor" Value="{DynamicResource TnPSuccessContentWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="controls:SvgView" Value="{x:Static controls:StatusPillTone.Warning}">
					<Setter Property="TintColor" Value="{DynamicResource TnPWarningContentWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="controls:SvgView" Value="{x:Static controls:StatusPillTone.Danger}">
					<Setter Property="TintColor" Value="{DynamicResource TnPDangerContentWL}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="ContractStateTextStyle" TargetType="Label">
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="{DynamicResource ContentSecondaryWL}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding StateTone}" TargetType="Label" Value="{x:Static controls:StatusPillTone.Information}">
					<Setter Property="TextColor" Value="{DynamicResource TnPInfoContentWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="Label" Value="{x:Static controls:StatusPillTone.Success}">
					<Setter Property="TextColor" Value="{DynamicResource TnPSuccessContentWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="Label" Value="{x:Static controls:StatusPillTone.Warning}">
					<Setter Property="TextColor" Value="{DynamicResource TnPWarningContentWL}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding StateTone}" TargetType="Label" Value="{x:Static controls:StatusPillTone.Danger}">
					<Setter Property="TextColor" Value="{DynamicResource TnPDangerContentWL}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</base:BaseContentPage.Resources>

	<Grid
		BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		RowDefinitions="Auto,*">
		<controls:Background Grid.RowSpan="2" />

		<Grid
			Grid.Row="0"
			ColumnDefinitions="48,*"
			ColumnSpacing="8"
			Margin="12,0,12,8"
			MaximumWidthRequest="960"
			HorizontalOptions="Fill">
			<controls:SvgButton
				Command="{Binding GoBackCommand}"
				HorizontalOptions="Center"
				MinimumHeightRequest="48"
				MinimumWidthRequest="48"
				SemanticProperties.Description="{l:Localize Close}"
				Style="{DynamicResource IconButtonSmall}"
				SvgSource="close.svg"
				VerticalOptions="Center" />
			<VerticalStackLayout
				Grid.Column="1"
				Spacing="2"
				VerticalOptions="Center">
				<Label
					FontSize="24"
					LineBreakMode="TailTruncation"
					MaxLines="1"
					SemanticProperties.HeadingLevel="Level1"
					Style="{DynamicResource PageTitleLabelSmall}"
					Text="{Binding Title}" />
				<Label
					LineBreakMode="TailTruncation"
					MaxLines="1"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding Description}"
					TextColor="{DynamicResource ContentSecondaryWL}" />
			</VerticalStackLayout>
		</Grid>

		<Grid
			Grid.Row="1"
			HorizontalOptions="Fill"
			Margin="16,0,16,16"
			MaximumWidthRequest="960"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="10">
			<Grid
				Grid.Row="0"
				ColumnDefinitions="*,48,Auto"
				ColumnSpacing="8">
				<SearchBar
					Placeholder="{l:Localize Search}"
					SemanticProperties.Description="{l:Localize Search}"
					Text="{Binding SearchText}" />
				<controls:SvgButton
					Grid.Column="1"
					Command="{Binding OpenFilterPopupCommand}"
					HorizontalOptions="Center"
					MinimumHeightRequest="48"
					MinimumWidthRequest="48"
					SemanticProperties.Description="{l:Localize SelectFilter}"
					Style="{DynamicResource IconButtonSmall}"
					SvgSource="filter.svg" />
				<Label
					Grid.Column="2"
					FontAttributes="Bold"
					IsVisible="{Binding HasActiveFilter}"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding ActiveFilterCount}"
					TextColor="{DynamicResource ContentPrimaryWL}"
					VerticalOptions="Center" />
			</Grid>

			<Border
				Grid.Row="1"
				BackgroundColor="{DynamicResource TnPWarningbgWL}"
				IsVisible="{Binding HasAttentionContracts}"
				Padding="12,10"
				Stroke="{DynamicResource TnPWarningContentWL}"
				StrokeShape="RoundRectangle 10">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
					<controls:SvgView
						HeightRequest="20"
						InputTransparent="True"
						Source="notifications.svg"
						TintColor="{DynamicResource TnPWarningContentWL}"
						VerticalOptions="Center"
						WidthRequest="20" />
					<Label
						Grid.Column="1"
						FontAttributes="Bold"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize ContractNeedsAttention}"
						TextColor="{DynamicResource TnPWarningContentWL}"
						VerticalTextAlignment="Center" />
					<Label
						Grid.Column="2"
						FontAttributes="Bold"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{Binding AttentionContractsCount}"
						TextColor="{DynamicResource TnPWarningContentWL}"
						VerticalOptions="Center" />
				</Grid>
			</Border>

			<Grid Grid.Row="2">
				<VerticalStackLayout
					HorizontalOptions="Center"
					IsVisible="{Binding IsInitialLoading}"
					SemanticProperties.Description="{l:Localize LoadingContracts}"
					Spacing="12"
					VerticalOptions="Center">
					<ActivityIndicator
						Color="{DynamicResource TnPInfoContentWL}"
						IsRunning="{Binding IsInitialLoading}" />
					<Label
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize LoadingContracts}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
				</VerticalStackLayout>

				<Border
					IsVisible="{Binding HasLoadError}"
					MaximumWidthRequest="560"
					Padding="24"
					Style="{DynamicResource BorderSet}"
					VerticalOptions="Center">
					<VerticalStackLayout Spacing="12">
						<controls:StatusPill
							Text="{l:Localize Unavailable}"
							Tone="Danger" />
						<Label
							SemanticProperties.HeadingLevel="Level2"
							Style="{DynamicResource SectionTitleLabel}"
							Text="{l:Localize SomethingWentWrong}" />
						<Label
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{Binding LoadErrorMessage}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<controls:TextButton
							Command="{Binding RetryCommand}"
							HorizontalOptions="Start"
							LabelData="{l:Localize Retry}"
							Style="{DynamicResource SecondaryButton}" />
					</VerticalStackLayout>
				</Border>

				<Border
					IsVisible="{Binding ShowEmptyState}"
					MaximumWidthRequest="560"
					Padding="24"
					Style="{DynamicResource BorderSet}"
					VerticalOptions="Center">
					<VerticalStackLayout
						HorizontalOptions="Center"
						Spacing="12">
						<Border
							BackgroundColor="{DynamicResource SurfaceElevation2WL}"
							HeightRequest="64"
							Padding="14"
							Stroke="{DynamicResource SurfaceStrokeWL}"
							StrokeShape="RoundRectangle 18"
							WidthRequest="64">
							<controls:SvgView
								InputTransparent="True"
								Source="contract.svg"
								TintColor="{DynamicResource ContentPrimaryWL}" />
						</Border>
						<Label
							HorizontalTextAlignment="Center"
							SemanticProperties.HeadingLevel="Level2"
							Style="{DynamicResource SectionTitleLabel}"
							Text="{l:Localize NoMatchingContractsTitle}" />
						<Label
							HorizontalTextAlignment="Center"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize NoMatchingContractsDescription}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<Label
							HorizontalTextAlignment="Center"
							IsVisible="{Binding CanRecoverContracts}"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize RecoverContractsDescription}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<controls:TextButton
							Command="{Binding RecoverContractsCommand}"
							HorizontalOptions="Center"
							IsVisible="{Binding CanRecoverContracts}"
							LabelData="{l:Localize RecoverContracts}"
							Style="{DynamicResource SecondaryButton}" />
						<HorizontalStackLayout
							HorizontalOptions="Center"
							IsVisible="{Binding IsRecoveringContracts}"
							Spacing="8">
							<ActivityIndicator
								Color="{DynamicResource TnPInfoContentWL}"
								IsRunning="{Binding IsRecoveringContracts}" />
							<Label
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{l:Localize LoadingContracts}"
								VerticalTextAlignment="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Border>

				<CollectionView
					x:Name="Contracts"
					IsVisible="{Binding HasContracts}"
					ItemSizingStrategy="MeasureAllItems"
					ItemsSource="{Binding Contracts}"
					RemainingItemsThreshold="{Binding HasMore}"
					RemainingItemsThresholdReachedCommand="{Binding LoadMoreContractsCommand}"
					SelectionMode="None">
					<CollectionView.ItemsLayout>
						<LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
					</CollectionView.ItemsLayout>
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="objectmodel:ContractModel">
							<Border
								Margin="0,2"
								Padding="0"
								Style="{DynamicResource BorderSet}">
								<Border.Triggers>
									<DataTrigger Binding="{Binding IsNeedsAttention}" TargetType="Border" Value="True">
										<Setter Property="Stroke" Value="{DynamicResource TnPWarningContentWL}" />
										<Setter Property="StrokeThickness" Value="2" />
									</DataTrigger>
								</Border.Triggers>
								<Grid ColumnDefinitions="4,*">
									<BoxView Style="{StaticResource ContractStateRailStyle}" />
									<Grid Grid.Column="1">
										<controls:TemplatedButton
										Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										CommandParameter="{Binding .}"
										IsEnabled="{Binding CanOpen}"
										Padding="0"
										SemanticProperties.Description="{Binding Title}">
										<VerticalStackLayout Padding="14" Spacing="6">
											<VerticalStackLayout Margin="0,0,44,0" Spacing="1">
												<Label
													FontAttributes="Bold"
													FontSize="18"
													LineBreakMode="TailTruncation"
													MaxLines="2"
													Text="{Binding Title}"
													TextColor="{DynamicResource ContentPrimaryWL}" />
												<Label
													IsVisible="{Binding HasCounterparty}"
													LineBreakMode="TailTruncation"
													MaxLines="1"
													Style="{DynamicResource ItemDescriptionLabel}"
													Text="{Binding CounterpartyText}"
													TextColor="{DynamicResource ContentSecondaryWL}" />
											</VerticalStackLayout>

											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
												<controls:SvgView
													Source="{Binding StateIconSource}"
													Style="{StaticResource ContractStateIconStyle}"
													VerticalOptions="Center" />
												<Label
													Grid.Column="1"
													LineBreakMode="WordWrap"
													Style="{StaticResource ContractStateTextStyle}"
													Text="{Binding StateText}"
													VerticalTextAlignment="Center" />
												<HorizontalStackLayout Grid.Column="2" IsVisible="{Binding HasEvents}" SemanticProperties.Description="{l:Localize Notifications}" Spacing="4" VerticalOptions="Center">
													<controls:SvgView HeightRequest="16" InputTransparent="True" Source="notifications.svg" TintColor="{DynamicResource ContentSecondaryWL}" WidthRequest="16" />
													<Label FontAttributes="Bold" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding NrEvents}" TextColor="{DynamicResource ContentSecondaryWL}" />
												</HorizontalStackLayout>
											</Grid>
											<Label IsVisible="{Binding HasTemplateKind}" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding TemplateKindText}" TextColor="{DynamicResource ContentSecondaryWL}" />

											<VerticalStackLayout Spacing="2">
												<Label IsVisible="{Binding HasRole}" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding RoleText}" TextColor="{DynamicResource ContentSecondaryWL}" />
												<Label IsVisible="{Binding HasSignatureProgress}" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding SignatureProgressText}" TextColor="{DynamicResource ContentSecondaryWL}" />
											</VerticalStackLayout>

											<VerticalStackLayout Spacing="4">
												<Label IsVisible="{Binding NeedsDetailsDownload}" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding RecoveryText}" TextColor="{DynamicResource ContentSecondaryWL}" />
												<Border BackgroundColor="{DynamicResource TnPWarningbgWL}" IsVisible="{Binding HasRecoveryWarning}" Padding="8,6" Stroke="{DynamicResource TnPWarningContentWL}" StrokeShape="RoundRectangle 8">
													<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding RecoveryText}" TextColor="{DynamicResource TnPWarningContentWL}" />
												</Border>
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
													<Label IsVisible="{Binding HasTimeContext}" LineBreakMode="TailTruncation" MaxLines="1" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding TimeContextText}" TextColor="{DynamicResource ContentSecondaryWL}" VerticalTextAlignment="Center" />
													<Label Grid.Column="1" FontAttributes="Bold" IsVisible="{Binding HasNextAction}" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding NextActionText}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center" />
												</Grid>
											</VerticalStackLayout>
										</VerticalStackLayout>
										</controls:TemplatedButton>

										<controls:SvgButton
										Command="{Binding ShareTemplateQRCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										CommandParameter="{Binding .}"
										HorizontalOptions="End"
										IsVisible="{Binding CanShareTemplate, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										Margin="0,4,4,0"
										MinimumHeightRequest="48"
										MinimumWidthRequest="48"
										SemanticProperties.Description="{l:Localize Share}"
										Style="{DynamicResource IconButtonSmall}"
										SvgSource="share.svg"
										VerticalOptions="Start" />

										<Border
										BackgroundColor="{DynamicResource SurfaceElevation1WL}"
										IsVisible="{Binding IsOpening}"
										Opacity="0.96"
										Padding="12"
										SemanticProperties.Description="{l:Localize Opening}"
										StrokeThickness="0">
										<HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
											<ActivityIndicator Color="{DynamicResource ContentPrimaryWL}" IsRunning="{Binding IsOpening}" />
											<Label FontAttributes="Bold" Text="{l:Localize Opening}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center" />
										</HorizontalStackLayout>
										</Border>
									</Grid>
								</Grid>
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>
					<CollectionView.Footer>
						<HorizontalStackLayout
							HorizontalOptions="Center"
							IsVisible="{Binding IsLoadingMore}"
							Padding="8,16"
							Spacing="8">
							<ActivityIndicator IsRunning="{Binding IsLoadingMore}" />
							<Label
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{l:Localize LoadingMoreContracts}"
								VerticalTextAlignment="Center" />
						</HorizontalStackLayout>
					</CollectionView.Footer>
				</CollectionView>
			</Grid>
		</Grid>
	</Grid>
</base:BaseContentPage>
