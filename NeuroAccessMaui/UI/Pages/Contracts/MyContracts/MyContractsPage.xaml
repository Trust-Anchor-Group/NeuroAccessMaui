<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.MyContracts.MyContractsPage"
	x:DataType="viewmodel:MyContractsViewModel"
	x:Name="ThisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts.ObjectModels"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts">

	<Grid
		BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		RowDefinitions="Auto,*">
		<controls:Background Grid.RowSpan="2" />

		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			ColumnSpacing="12"
			Margin="16,8,16,12"
			MaximumWidthRequest="960"
			HorizontalOptions="Fill">
			<controls:SvgButton
				Command="{Binding GoBackCommand}"
				HorizontalOptions="Start"
				SemanticProperties.Description="{l:Localize Close}"
				Style="{DynamicResource IconButton}"
				SvgSource="close.svg"
				VerticalOptions="Center" />
			<VerticalStackLayout
				Grid.Column="1"
				Spacing="2"
				VerticalOptions="Center">
				<Label
					SemanticProperties.HeadingLevel="Level1"
					Style="{DynamicResource PageTitleLabel}"
					Text="{Binding Title}" />
				<Label
					MaxLines="2"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding Description}"
					TextColor="{DynamicResource ContentSecondaryWL}" />
			</VerticalStackLayout>
		</Grid>

		<Grid
			Grid.Row="1"
			HorizontalOptions="Fill"
			Margin="16,0,16,16"
			MaximumWidthRequest="960"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="10">
			<Grid
				Grid.Row="0"
				ColumnDefinitions="*,Auto,Auto"
				ColumnSpacing="8">
				<SearchBar
					Placeholder="{l:Localize Search}"
					SemanticProperties.Description="{l:Localize Search}"
					Text="{Binding SearchText}" />
				<controls:SvgButton
					Grid.Column="1"
					Command="{Binding OpenFilterPopupCommand}"
					SemanticProperties.Description="{l:Localize SelectFilter}"
					Style="{DynamicResource IconButtonOnBackground}"
					SvgSource="filter.svg" />
				<controls:StatusPill
					Grid.Column="2"
					IsVisible="{Binding HasActiveFilter}"
					Text="{Binding ActiveFilterCount}"
					Tone="Information"
					VerticalOptions="Center" />
			</Grid>

			<Border
				Grid.Row="1"
				BackgroundColor="{DynamicResource TnPWarningbgWL}"
				IsVisible="{Binding HasAttentionContracts}"
				Padding="12,10"
				Stroke="{DynamicResource TnPWarningContentWL}"
				StrokeShape="RoundRectangle 10">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
					<controls:SvgView
						HeightRequest="20"
						InputTransparent="True"
						Source="notifications.svg"
						TintColor="{DynamicResource TnPWarningContentWL}"
						VerticalOptions="Center"
						WidthRequest="20" />
					<Label
						Grid.Column="1"
						FontAttributes="Bold"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize ContractNeedsAttention}"
						TextColor="{DynamicResource TnPWarningContentWL}"
						VerticalTextAlignment="Center" />
					<controls:StatusPill
						Grid.Column="2"
						Text="{Binding AttentionContractsCount}"
						Tone="Warning" />
				</Grid>
			</Border>

			<Grid Grid.Row="2">
				<VerticalStackLayout
					HorizontalOptions="Center"
					IsVisible="{Binding IsInitialLoading}"
					SemanticProperties.Description="{l:Localize LoadingContracts}"
					Spacing="12"
					VerticalOptions="Center">
					<ActivityIndicator
						Color="{DynamicResource TnPInfoContentWL}"
						IsRunning="{Binding IsInitialLoading}" />
					<Label
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize LoadingContracts}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
				</VerticalStackLayout>

				<Border
					IsVisible="{Binding HasLoadError}"
					MaximumWidthRequest="560"
					Padding="24"
					Style="{DynamicResource BorderSet}"
					VerticalOptions="Center">
					<VerticalStackLayout Spacing="12">
						<controls:StatusPill
							Text="{l:Localize Unavailable}"
							Tone="Danger" />
						<Label
							SemanticProperties.HeadingLevel="Level2"
							Style="{DynamicResource SectionTitleLabel}"
							Text="{l:Localize SomethingWentWrong}" />
						<Label
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{Binding LoadErrorMessage}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<controls:TextButton
							Command="{Binding RetryCommand}"
							HorizontalOptions="Start"
							LabelData="{l:Localize Retry}"
							Style="{DynamicResource SecondaryButton}" />
					</VerticalStackLayout>
				</Border>

				<Border
					IsVisible="{Binding ShowEmptyState}"
					MaximumWidthRequest="560"
					Padding="24"
					Style="{DynamicResource BorderSet}"
					VerticalOptions="Center">
					<VerticalStackLayout
						HorizontalOptions="Center"
						Spacing="12">
						<Border
							BackgroundColor="{DynamicResource SurfaceElevation2WL}"
							HeightRequest="64"
							Padding="14"
							Stroke="{DynamicResource SurfaceStrokeWL}"
							StrokeShape="RoundRectangle 18"
							WidthRequest="64">
							<controls:SvgView
								InputTransparent="True"
								Source="contract.svg"
								TintColor="{DynamicResource ContentPrimaryWL}" />
						</Border>
						<Label
							HorizontalTextAlignment="Center"
							SemanticProperties.HeadingLevel="Level2"
							Style="{DynamicResource SectionTitleLabel}"
							Text="{l:Localize NoMatchingContractsTitle}" />
						<Label
							HorizontalTextAlignment="Center"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize NoMatchingContractsDescription}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<Label
							HorizontalTextAlignment="Center"
							IsVisible="{Binding CanRecoverContracts}"
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize RecoverContractsDescription}"
							TextColor="{DynamicResource ContentSecondaryWL}" />
						<controls:TextButton
							Command="{Binding RecoverContractsCommand}"
							HorizontalOptions="Center"
							IsVisible="{Binding CanRecoverContracts}"
							LabelData="{l:Localize RecoverContracts}"
							Style="{DynamicResource SecondaryButton}" />
						<HorizontalStackLayout
							HorizontalOptions="Center"
							IsVisible="{Binding IsRecoveringContracts}"
							Spacing="8">
							<ActivityIndicator
								Color="{DynamicResource TnPInfoContentWL}"
								IsRunning="{Binding IsRecoveringContracts}" />
							<Label
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{l:Localize LoadingContracts}"
								VerticalTextAlignment="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Border>

				<CollectionView
					x:Name="Contracts"
					IsVisible="{Binding HasContracts}"
					ItemSizingStrategy="MeasureFirstItem"
					ItemsSource="{Binding Contracts}"
					RemainingItemsThreshold="{Binding HasMore}"
					RemainingItemsThresholdReachedCommand="{Binding LoadMoreContractsCommand}"
					SelectionMode="None">
					<CollectionView.ItemsLayout>
						<LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
					</CollectionView.ItemsLayout>
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="objectmodel:ContractModel">
							<Border
								Margin="0,4"
								Padding="0"
								Style="{DynamicResource BorderSet}">
								<Border.Triggers>
									<DataTrigger Binding="{Binding IsNeedsAttention}" TargetType="Border" Value="True">
										<Setter Property="Stroke" Value="{DynamicResource TnPWarningContentWL}" />
										<Setter Property="StrokeThickness" Value="2" />
									</DataTrigger>
								</Border.Triggers>
								<Grid>
									<controls:TemplatedButton
										Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										CommandParameter="{Binding .}"
										IsEnabled="{Binding CanOpen}"
										Padding="0"
										SemanticProperties.Description="{Binding Title}">
										<Grid
											ColumnDefinitions="Auto,*"
											ColumnSpacing="12"
											Padding="12"
											RowDefinitions="Auto,Auto,Auto,Auto"
											RowSpacing="6">
											<Border
												Grid.RowSpan="4"
												BackgroundColor="{DynamicResource SurfaceElevation2WL}"
												HeightRequest="40"
												Padding="9"
												Stroke="{DynamicResource SurfaceStrokeWL}"
												StrokeShape="RoundRectangle 10"
												VerticalOptions="Start"
												WidthRequest="40">
												<controls:SvgView InputTransparent="True" Source="contract.svg" TintColor="{DynamicResource ContentPrimaryWL}" />
											</Border>

											<VerticalStackLayout Grid.Column="1" Margin="0,0,44,0" Spacing="1">
												<Label
													FontAttributes="Bold"
													FontSize="18"
													IsVisible="{Binding HasCategory}"
													LineBreakMode="TailTruncation"
													MaxLines="1"
													Text="{Binding Category}"
													TextColor="{DynamicResource ContentPrimaryWL}" />
												<Label
													FontAttributes="Bold"
													FontSize="18"
													LineBreakMode="TailTruncation"
													MaxLines="1"
													Text="{Binding Title}"
													TextColor="{DynamicResource ContentPrimaryWL}">
													<Label.Triggers>
														<DataTrigger Binding="{Binding HasCategory}" TargetType="Label" Value="True">
															<Setter Property="FontAttributes" Value="None" />
															<Setter Property="FontSize" Value="14" />
															<Setter Property="TextColor" Value="{DynamicResource ContentSecondaryWL}" />
														</DataTrigger>
													</Label.Triggers>
												</Label>
											</VerticalStackLayout>

											<FlexLayout Grid.Row="1" Grid.Column="1" AlignItems="Center" Direction="Row" Wrap="Wrap">
												<controls:StatusPill Margin="0,0,8,2" Text="{Binding StateText}" Tone="{Binding StateTone}" />
												<controls:StatusPill IsVisible="{Binding IsNeedsAttention}" Margin="0,0,8,2" Text="{l:Localize ContractNeedsAttention}" Tone="Warning" />
												<controls:StatusPill IsVisible="{Binding HasTemplateKind}" Margin="0,0,8,2" Text="{Binding TemplateKindText}" Tone="Neutral" />
												<controls:StatusPill IconSource="notifications.svg" IsVisible="{Binding HasEvents}" Margin="0,0,8,2" Text="{Binding NrEvents}" Tone="Information" />
											</FlexLayout>

											<FlexLayout Grid.Row="2" Grid.Column="1" AlignItems="Center" Direction="Row" Wrap="Wrap">
												<Label IsVisible="{Binding HasRole}" Margin="0,0,14,2" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding RoleText}" TextColor="{DynamicResource ContentPrimaryWL}" />
												<Label IsVisible="{Binding HasSignatureProgress}" Margin="0,0,14,2" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding SignatureProgressText}" TextColor="{DynamicResource ContentSecondaryWL}" />
												<Label IsVisible="{Binding HasParties}" Margin="0,0,14,2" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding PartiesText}" TextColor="{DynamicResource ContentSecondaryWL}">
													<Label.Triggers>
														<DataTrigger Binding="{Binding HasSignatureProgress}" TargetType="Label" Value="True">
															<Setter Property="IsVisible" Value="False" />
														</DataTrigger>
													</Label.Triggers>
												</Label>
											</FlexLayout>

											<VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
												<Label IsVisible="{Binding NeedsDetailsDownload}" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding RecoveryText}" TextColor="{DynamicResource ContentSecondaryWL}" />
												<Border BackgroundColor="{DynamicResource TnPWarningbgWL}" IsVisible="{Binding HasRecoveryWarning}" Padding="8,6" Stroke="{DynamicResource TnPWarningContentWL}" StrokeShape="RoundRectangle 8">
													<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding RecoveryText}" TextColor="{DynamicResource TnPWarningContentWL}" />
												</Border>
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
													<Label IsVisible="{Binding HasTimeContext}" LineBreakMode="TailTruncation" MaxLines="1" Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding TimeContextText}" TextColor="{DynamicResource ContentSecondaryWL}" VerticalTextAlignment="Center" />
													<Label Grid.Column="1" FontAttributes="Bold" IsVisible="{Binding IsNeedsAttention}" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding NextActionText}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center" />
												</Grid>
											</VerticalStackLayout>
										</Grid>
									</controls:TemplatedButton>

									<controls:SvgButton
										Command="{Binding ShareTemplateQRCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										CommandParameter="{Binding .}"
										HorizontalOptions="End"
										IsVisible="{Binding CanShareTemplate, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										Margin="0,8,8,0"
										SemanticProperties.Description="{l:Localize Share}"
										Style="{DynamicResource IconButtonOnBackground}"
										SvgSource="share.svg"
										VerticalOptions="Start" />

									<Border
										BackgroundColor="{DynamicResource SurfaceElevation1WL}"
										IsVisible="{Binding IsOpening}"
										Opacity="0.96"
										Padding="12"
										SemanticProperties.Description="{l:Localize Opening}"
										StrokeThickness="0">
										<HorizontalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
											<ActivityIndicator Color="{DynamicResource ContentPrimaryWL}" IsRunning="{Binding IsOpening}" />
											<Label FontAttributes="Bold" Text="{l:Localize Opening}" TextColor="{DynamicResource ContentPrimaryWL}" VerticalTextAlignment="Center" />
										</HorizontalStackLayout>
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>
					<CollectionView.Footer>
						<HorizontalStackLayout
							HorizontalOptions="Center"
							IsVisible="{Binding IsLoadingMore}"
							Padding="8,16"
							Spacing="8">
							<ActivityIndicator IsRunning="{Binding IsLoadingMore}" />
							<Label
								Style="{DynamicResource ItemDescriptionLabel}"
								Text="{l:Localize LoadingMoreContracts}"
								VerticalTextAlignment="Center" />
						</HorizontalStackLayout>
					</CollectionView.Footer>
				</CollectionView>
			</Grid>
		</Grid>
	</Grid>
</base:BaseContentPage>
