<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
					  x:Class="NeuroAccessMaui.UI.Pages.Contracts.MyContracts.MyContractsPage"
					  x:DataType="viewmodel:MyContractsViewModel"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
					  xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts"
					  xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts.ObjectModels"
					  xmlns:contracts="clr-namespace:NeuroAccessMaui.Services.Contracts">

	<VisualElement.Resources>
		<!-- A template in a list of contracts: its first letter on a tile, its name, and share -->
		<DataTemplate x:Key="TemplateRowTemplate"
					  x:DataType="objectmodel:ContractModel">
			<Grid>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}" />
				<Grid ColumnDefinitions="44,*,44"
					  ColumnSpacing="14"
					  Padding="16,14,6,14"
					  MinimumHeightRequest="76"
					  SemanticProperties.Description="{Binding DisplayName}">
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
											  CommandParameter="{Binding .}" />
					</Grid.GestureRecognizers>
					<Border Grid.Column="0"
							Style="{DynamicResource ListCardTileBorder}"
							InputTransparent="True">
						<Label Style="{DynamicResource ListCardMonogramLabel}"
							   Text="{Binding Monogram}" />
					</Border>
					<VerticalStackLayout Grid.Column="1"
										 VerticalOptions="Center"
										 Spacing="4"
										 InputTransparent="True">
						<Label Style="{DynamicResource ListCardRowTitleLabel}"
							   Text="{Binding NameOrCategory}" />
						<Label Style="{DynamicResource ListCardRowDetailLabel}"
							   Text="{Binding LastChangedText}" />
					</VerticalStackLayout>
					<controls:SvgButton Grid.Column="2"
										VerticalOptions="Center"
										HeightRequest="44"
										WidthRequest="44"
										IsVisible="{Binding CanShareTemplate, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										Command="{Binding ShareTemplateQRCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										CommandParameter="{Binding .}"
										Style="{DynamicResource IconButtonSmall}"
										SvgSource="share.svg" />
				</Grid>
			</Grid>
		</DataTemplate>

		<!-- A contract: a tile coloured by its group, its name, what the user must do, who else is in it, and when it changed -->
		<DataTemplate x:Key="ContractRowTemplate"
					  x:DataType="objectmodel:ContractModel">
			<Grid>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}" />
				<controls:TemplatedButton Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										  CommandParameter="{Binding .}"
										  SemanticProperties.Description="{Binding DisplayName}">
					<Grid ColumnDefinitions="44,*,Auto"
						  ColumnSpacing="14"
						  Padding="16,14"
						  MinimumHeightRequest="76">
						<Grid Grid.Column="0"
							  VerticalOptions="Center"
							  HeightRequest="44"
							  WidthRequest="44">
							<Border Style="{DynamicResource ListCardTileBorder}">
								<Border.Triggers>
									<DataTrigger Binding="{Binding Group}"
												 TargetType="Border"
												 Value="{x:Static contracts:ContractListGroup.NeedsAction}">
										<Setter Property="BackgroundColor" Value="{DynamicResource TnPWarningbgWL}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding Group}"
												 TargetType="Border"
												 Value="{x:Static contracts:ContractListGroup.InProgress}">
										<Setter Property="BackgroundColor" Value="{DynamicResource TnPInfobgWL}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding Group}"
												 TargetType="Border"
												 Value="{x:Static contracts:ContractListGroup.Ended}">
										<Setter Property="BackgroundColor" Value="{DynamicResource SurfaceElevation2WL}" />
									</DataTrigger>
								</Border.Triggers>
								<Path HorizontalOptions="Center"
									  VerticalOptions="Center"
									  HeightRequest="22"
									  WidthRequest="22"
									  Aspect="Uniform"
									  Data="{x:Static ui:Geometries.ContractPath}"
									  Fill="{DynamicResource ContentAccessWL}">
									<Path.Triggers>
										<DataTrigger Binding="{Binding Group}"
													 TargetType="Path"
													 Value="{x:Static contracts:ContractListGroup.NeedsAction}">
											<Setter Property="Fill" Value="{DynamicResource TnPWarningContentWL}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Group}"
													 TargetType="Path"
													 Value="{x:Static contracts:ContractListGroup.InProgress}">
											<Setter Property="Fill" Value="{DynamicResource TnPInfoContentWL}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Group}"
													 TargetType="Path"
													 Value="{x:Static contracts:ContractListGroup.Ended}">
											<Setter Property="Fill" Value="{DynamicResource ContentSecondaryWL}" />
										</DataTrigger>
									</Path.Triggers>
								</Path>
							</Border>
							<!-- Changed since the user last opened it -->
							<Ellipse HorizontalOptions="End"
									 VerticalOptions="Start"
									 HeightRequest="12"
									 WidthRequest="12"
									 TranslationX="4"
									 TranslationY="-4"
									 IsVisible="{Binding IsUnread}"
									 Fill="{DynamicResource TnPInfoContentWL}"
									 Stroke="{DynamicResource SurfaceElevation1WL}"
									 StrokeThickness="2" />
						</Grid>

						<VerticalStackLayout Grid.Column="1"
											 VerticalOptions="Center"
											 Spacing="4">
							<Label Style="{DynamicResource ListCardRowTitleLabel}"
								   Text="{Binding DisplayName}" />
							<Grid ColumnDefinitions="Auto,*">
								<Border Grid.Column="0"
										Margin="0,0,8,0"
										IsVisible="{Binding HasPill}"
										Style="{DynamicResource ListCardPillBorder}"
										BackgroundColor="{DynamicResource SurfaceElevation2WL}">
									<Border.Triggers>
										<DataTrigger Binding="{Binding HasMarker}"
													 TargetType="Border"
													 Value="True">
											<Setter Property="BackgroundColor" Value="{DynamicResource TnPWarningbgWL}" />
										</DataTrigger>
									</Border.Triggers>
									<Label Style="{DynamicResource ListCardPillLabel}"
										   Text="{Binding PillText}"
										   TextColor="{DynamicResource ContentSecondaryWL}">
										<Label.Triggers>
											<DataTrigger Binding="{Binding HasMarker}"
														 TargetType="Label"
														 Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPWarningContentWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>
								<Label Grid.Column="1"
									   Style="{DynamicResource ListCardRowDetailLabel}"
									   Text="{Binding DetailText}" />
							</Grid>
						</VerticalStackLayout>

						<Label Grid.Column="2"
							   VerticalOptions="Start"
							   Margin="0,2,0,0"
							   Style="{DynamicResource ListCardRowDetailLabel}"
							   Text="{Binding LastChangedText}" />
					</Grid>
				</controls:TemplatedButton>
			</Grid>
		</DataTemplate>

		<!-- A request to see the user's ID for a contract -->
		<DataTemplate x:Key="PetitionRowTemplate"
					  x:DataType="objectmodel:ContractPetitionModel">
			<Grid>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}" />
				<controls:TemplatedButton Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										  CommandParameter="{Binding .}"
										  SemanticProperties.Description="{Binding Title}">
					<Grid ColumnDefinitions="44,*,Auto"
						  ColumnSpacing="14"
						  Padding="16,14"
						  MinimumHeightRequest="76">
						<Border Grid.Column="0"
								VerticalOptions="Center"
								Style="{DynamicResource ListCardTileBorder}"
								BackgroundColor="{DynamicResource TnPWarningbgWL}">
							<Path HorizontalOptions="Center"
								  VerticalOptions="Center"
								  HeightRequest="22"
								  WidthRequest="22"
								  Aspect="Uniform"
								  Data="{x:Static ui:Geometries.ShowIdIconPath}"
								  Fill="{DynamicResource TnPWarningContentWL}" />
						</Border>
						<VerticalStackLayout Grid.Column="1"
											 VerticalOptions="Center"
											 Spacing="4">
							<Label Style="{DynamicResource ListCardRowTitleLabel}"
								   Text="{Binding Title}" />
							<Grid ColumnDefinitions="Auto,*">
								<Border Grid.Column="0"
										Margin="0,0,8,0"
										Style="{DynamicResource ListCardPillBorder}"
										BackgroundColor="{DynamicResource TnPWarningbgWL}">
									<Label Style="{DynamicResource ListCardPillLabel}"
										   Text="{l:Localize ContractMarkerRequest}"
										   TextColor="{DynamicResource TnPWarningContentWL}" />
								</Border>
								<Label Grid.Column="1"
									   IsVisible="{Binding HasPurpose}"
									   Style="{DynamicResource ListCardRowDetailLabel}"
									   Text="{Binding Purpose}" />
							</Grid>
						</VerticalStackLayout>
						<Label Grid.Column="2"
							   VerticalOptions="Start"
							   Margin="0,2,0,0"
							   Style="{DynamicResource ListCardRowDetailLabel}"
							   Text="{Binding ReceivedText}" />
					</Grid>
				</controls:TemplatedButton>
			</Grid>
		</DataTemplate>

		<!-- Contracts with the same name, folded into one row. A tap unfolds them, and each one opens on its own. -->
		<DataTemplate x:Key="FamilyRowTemplate"
					  x:DataType="objectmodel:ContractFamilyModel">
			<Grid>
				<controls:ListCardSegment Position="{Binding CardPosition}"
										  FillColor="{DynamicResource SurfaceElevation1WL}"
										  StrokeColor="{DynamicResource SurfaceDividerWL}" />
				<VerticalStackLayout>
					<controls:TemplatedButton Command="{Binding ToggleFamilyCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
											  CommandParameter="{Binding .}"
											  SemanticProperties.Description="{Binding AccessibleDescription}">
						<Grid ColumnDefinitions="44,*,Auto"
							  ColumnSpacing="14"
							  Padding="16,14"
							  MinimumHeightRequest="76">
							<Grid Grid.Column="0"
								  VerticalOptions="Center"
								  HeightRequest="44"
								  WidthRequest="44">
								<Border Style="{DynamicResource ListCardTileBorder}">
									<Border.Triggers>
										<DataTrigger Binding="{Binding Group}"
													 TargetType="Border"
													 Value="{x:Static contracts:ContractListGroup.Ended}">
											<Setter Property="BackgroundColor" Value="{DynamicResource SurfaceElevation2WL}" />
										</DataTrigger>
									</Border.Triggers>
									<Path HorizontalOptions="Center"
										  VerticalOptions="Center"
										  HeightRequest="22"
										  WidthRequest="22"
										  Aspect="Uniform"
										  Data="{x:Static ui:Geometries.ContractPath}"
										  Fill="{DynamicResource ContentAccessWL}">
										<Path.Triggers>
											<DataTrigger Binding="{Binding Group}"
														 TargetType="Path"
														 Value="{x:Static contracts:ContractListGroup.Ended}">
												<Setter Property="Fill" Value="{DynamicResource ContentSecondaryWL}" />
											</DataTrigger>
										</Path.Triggers>
									</Path>
								</Border>
								<Ellipse HorizontalOptions="End"
										 VerticalOptions="Start"
										 HeightRequest="12"
										 WidthRequest="12"
										 TranslationX="4"
										 TranslationY="-4"
										 IsVisible="{Binding IsUnread}"
										 Fill="{DynamicResource TnPInfoContentWL}"
										 Stroke="{DynamicResource SurfaceElevation1WL}"
										 StrokeThickness="2" />
							</Grid>

							<VerticalStackLayout Grid.Column="1"
												 VerticalOptions="Center"
												 Spacing="4">
								<Label Style="{DynamicResource ListCardRowTitleLabel}"
									   Text="{Binding Title}" />
								<!-- How many, with an arrow that turns when unfolded -->
								<Border HorizontalOptions="Start"
										Padding="9,0,6,0"
										HeightRequest="22"
										Style="{DynamicResource ListCardPillBorder}"
										BackgroundColor="{DynamicResource TnPInfobgWL}">
									<Border.Triggers>
										<DataTrigger Binding="{Binding IsExpanded}"
													 TargetType="Border"
													 Value="True">
											<Setter Property="BackgroundColor" Value="{DynamicResource ContentPrimaryWL}" />
										</DataTrigger>
									</Border.Triggers>
									<HorizontalStackLayout Spacing="4">
										<Label Style="{DynamicResource ListCardPillLabel}"
											   Text="{Binding CountText}"
											   TextColor="{DynamicResource ContentPrimaryWL}">
											<Label.Triggers>
												<DataTrigger Binding="{Binding IsExpanded}"
															 TargetType="Label"
															 Value="True">
													<Setter Property="TextColor" Value="{DynamicResource ContentPrimaryInverted}" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
										<controls:SvgView VerticalOptions="Center"
														  HeightRequest="10"
														  WidthRequest="10"
														  Rotation="90"
														  AutomationProperties.IsInAccessibleTree="False"
														  Source="arrow_forward_ios.svg"
														  TintColor="{DynamicResource ContentPrimaryWL}">
											<controls:SvgView.Triggers>
												<DataTrigger Binding="{Binding IsExpanded}"
															 TargetType="controls:SvgView"
															 Value="True">
													<Setter Property="Rotation" Value="-90" />
													<Setter Property="TintColor" Value="{DynamicResource ContentPrimaryInverted}" />
												</DataTrigger>
											</controls:SvgView.Triggers>
										</controls:SvgView>
									</HorizontalStackLayout>
								</Border>
							</VerticalStackLayout>

							<Label Grid.Column="2"
								   VerticalOptions="Start"
								   Margin="0,2,0,0"
								   Style="{DynamicResource ListCardRowDetailLabel}"
								   Text="{Binding LastChangedText}" />
						</Grid>
					</controls:TemplatedButton>

					<!-- The contracts, newest change first, each told apart by when it was created -->
					<VerticalStackLayout Padding="0,0,0,6"
										 IsVisible="{Binding IsExpanded}"
										 BindableLayout.ItemsSource="{Binding Members}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="objectmodel:ContractModel">
								<Grid RowDefinitions="Auto,Auto">
									<BoxView Grid.Row="0"
											 Margin="74,0,1,0"
											 HeightRequest="1"
											 Color="{DynamicResource SurfaceDividerWL}" />
									<controls:TemplatedButton Grid.Row="1"
															  Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
															  CommandParameter="{Binding .}"
															  SemanticProperties.Description="{Binding CreatedText}">
										<Grid ColumnDefinitions="*,Auto,Auto"
											  ColumnSpacing="10"
											  Padding="74,0,18,0"
											  MinimumHeightRequest="48">
											<Label Grid.Column="0"
												   VerticalOptions="Center"
												   FontSize="{StaticResource FontSizeMd}"
												   LineBreakMode="TailTruncation"
												   MaxLines="1"
												   Text="{Binding CreatedText}"
												   TextColor="{DynamicResource ContentPrimaryWL}" />
											<Border Grid.Column="1"
													IsVisible="{Binding HasPill}"
													Style="{DynamicResource ListCardPillBorder}"
													BackgroundColor="{DynamicResource SurfaceElevation2WL}">
												<Label Style="{DynamicResource ListCardPillLabel}"
													   Text="{Binding PillText}"
													   TextColor="{DynamicResource ContentSecondaryWL}" />
											</Border>
											<controls:SvgView Grid.Column="2"
															  VerticalOptions="Center"
															  HeightRequest="12"
															  WidthRequest="12"
															  AutomationProperties.IsInAccessibleTree="False"
															  Source="arrow_forward_ios.svg"
															  TintColor="{DynamicResource ContentSecondaryWL}" />
										</Grid>
									</controls:TemplatedButton>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>

		<viewmodel:ContractListItemTemplateSelector x:Key="ContractListItemTemplateSelector"
													ContractTemplate="{StaticResource ContractRowTemplate}"
													FamilyTemplate="{StaticResource FamilyRowTemplate}"
													PetitionTemplate="{StaticResource PetitionRowTemplate}"
													TemplateRowTemplate="{StaticResource TemplateRowTemplate}" />
	</VisualElement.Resources>

	<!-- Built like the template picker: a title bar, the search, and the contracts as list cards -->
	<controls:IdentityFlowShell Title="{Binding Title}"
								ShowLeadingAction="True"
								LeadingActionCommand="{Binding GoBackCommand}"
								LeadingActionDescription="{l:Localize Close}">
		<controls:IdentityFlowShell.BodyContent>
			<Grid RowDefinitions="Auto,Auto,*">
				<!-- Search, while there are contracts -->
				<controls:CompositeEntry Grid.Row="0"
										 Margin="16,12,16,0"
										 IsVisible="{Binding Path=ShowContractsMissing, Converter={mct:InvertedBoolConverter}}"
										 Style="{DynamicResource RegularCompositeEntry}"
										 Placeholder="{l:Localize Search}"
										 TextChanged="ContractsSearchChanged">
					<controls:CompositeEntry.LeftView>
						<controls:SvgView HeightRequest="20"
										  WidthRequest="20"
										  AutomationProperties.IsInAccessibleTree="False"
										  Source="search.svg"
										  TintColor="{DynamicResource ContentSecondaryWL}" />
					</controls:CompositeEntry.LeftView>
				</controls:CompositeEntry>

				<!-- No contracts: what shows up here or can be picked, and how to get one -->
				<VerticalStackLayout Grid.Row="1"
									 IsVisible="{Binding ShowContractsMissing}"
									 InputTransparent="True">
					<VerticalStackLayout Padding="24,12,24,0"
										 Spacing="6">
						<Label Style="{DynamicResource IdentityFlowTitleLabel}"
							   Text="{Binding EmptyText}" />
						<Label IsVisible="{Binding HasEmptyDescription}"
							   Style="{DynamicResource IdentityFlowBodySecondaryLabel}"
							   Text="{Binding EmptyDescription}" />
					</VerticalStackLayout>
					<Border Margin="16,24,16,0"
							IsVisible="{Binding HasEmptyHint}"
							Style="{DynamicResource ListCardEmptyBorder}">
						<Grid ColumnDefinitions="44,*"
							  ColumnSpacing="14">
							<Border Grid.Column="0"
									Style="{DynamicResource ListCardEmptyTileBorder}"
									AutomationProperties.IsInAccessibleTree="False">
								<Path HorizontalOptions="Center"
									  VerticalOptions="Center"
									  HeightRequest="22"
									  WidthRequest="22"
									  Aspect="Uniform"
									  Data="{x:Static ui:Geometries.ContractPath}"
									  Fill="{DynamicResource InputFieldsSurfaceStrokeInactive}" />
							</Border>
							<Label Grid.Column="1"
								   VerticalOptions="Center"
								   Style="{DynamicResource IdentityFlowCaptionLabel}"
								   Text="{Binding EmptyHint}" />
						</Grid>
					</Border>
				</VerticalStackLayout>

				<ActivityIndicator x:Name="Loading"
								   Grid.Row="2"
								   VerticalOptions="Start"
								   HorizontalOptions="Center"
								   Margin="0,32,0,32"
								   IsVisible="{Binding Path=IsBusy}"
								   IsRunning="{Binding Path=IsBusy}"
								   Color="{DynamicResource TnPInfoContentWL}" />

				<RefreshView Grid.Row="2"
							 Margin="0,8,0,0"
							 IsVisible="{Binding Path=IsBusy, Converter={mct:InvertedBoolConverter}}"
							 Command="{Binding RefreshContractsCommand}"
							 IsRefreshing="{Binding IsRefreshing}">
					<Grid>
						<!-- A search that found nothing -->
						<Label VerticalOptions="Start"
							   Margin="24,16,24,0"
							   IsVisible="{Binding ShowNoMatches}"
							   Style="{DynamicResource IdentityFlowBodySecondaryLabel}"
							   Text="{l:Localize NoContractsFound}" />

						<!-- Contracts to pick from, as one card -->
						<CollectionView x:Name="Contracts"
										VerticalOptions="Start"
										Margin="16,4,16,16"
										IsVisible="{Binding IsFlatList}"
										controls:ListCard.IsEnabled="True"
										ItemSizingStrategy="MeasureAllItems"
										ItemTemplate="{StaticResource ContractListItemTemplateSelector}"
										ItemsSource="{Binding Path=Contracts}"
										RemainingItemsThreshold="{Binding HasMore}"
										RemainingItemsThresholdReachedCommand="{Binding LoadMoreContractsCommand}"
										SelectionMode="None">
							<CollectionView.ItemsLayout>
								<LinearItemsLayout ItemSpacing="0"
												   Orientation="Vertical" />
							</CollectionView.ItemsLayout>
						</CollectionView>

						<!-- The contracts inbox: one card for each group, by what the contracts need -->
						<CollectionView x:Name="ContractGroups"
										VerticalOptions="Start"
										Margin="16,0,16,16"
										IsVisible="{Binding IsInbox}"
										IsGrouped="True"
										ItemSizingStrategy="MeasureAllItems"
										ItemTemplate="{StaticResource ContractListItemTemplateSelector}"
										ItemsSource="{Binding Path=Groups}"
										SelectionMode="None">
							<CollectionView.ItemsLayout>
								<LinearItemsLayout ItemSpacing="0"
												   Orientation="Vertical" />
							</CollectionView.ItemsLayout>
							<CollectionView.GroupHeaderTemplate>
								<DataTemplate x:DataType="objectmodel:ContractGroupModel">
									<Label Margin="8,16,8,8"
										   Style="{DynamicResource ListCardSectionLabel}"
										   Text="{Binding HeaderText}" />
								</DataTemplate>
							</CollectionView.GroupHeaderTemplate>
							<CollectionView.GroupFooterTemplate>
								<DataTemplate x:DataType="objectmodel:ContractGroupModel">
									<controls:TextButton HorizontalOptions="Center"
														 IsVisible="{Binding HasMore}"
														 Command="{Binding LoadMoreInGroupCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
														 CommandParameter="{Binding .}"
														 Style="{DynamicResource TransparentTextButton}"
														 LabelData="{l:Localize LoadMore}" />
								</DataTemplate>
							</CollectionView.GroupFooterTemplate>
						</CollectionView>
					</Grid>
				</RefreshView>
			</Grid>
		</controls:IdentityFlowShell.BodyContent>
	</controls:IdentityFlowShell>
</base:BaseContentPage>
