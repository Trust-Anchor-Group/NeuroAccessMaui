<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
					 x:Class="NeuroAccessMaui.UI.Pages.Contracts.MyContracts.MyContractsPage"
					 x:DataType="viewmodel:MyContractsViewModel"
					 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					 xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
					 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
					 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts"
					 xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts.ObjectModels"
					 xmlns:contracts="clr-namespace:NeuroAccessMaui.Services.Contracts">
	
	<VisualElement.Resources>
		<DataTemplate x:Key="TemplateRowTemplate" x:DataType="objectmodel:ContractModel">
			<Border Style="{DynamicResource BorderSet}">
				<controls:TemplatedButton Padding="0"
								 Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
								 CommandParameter="{Binding .}">
					<Grid ColumnDefinitions="auto,*,auto" RowDefinitions="auto,auto">
						<Label Grid.Column="0" Grid.Row="0" LineBreakMode="NoWrap" Padding="5,0,5,0"
								Text="{Binding Path=Timestamp, Converter={converters:DateToString}}"
								HorizontalOptions="Center" VerticalOptions="Center"/>
						<Label Grid.Column="0" Grid.Row="1" LineBreakMode="NoWrap" Padding="5,0,5,0"
								Text="{Binding Path=Timestamp, Converter={converters:TimeToString}}"
								HorizontalOptions="Center" VerticalOptions="Center"/>
						<Label Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" LineBreakMode="CharacterWrap" TextType="Text"
								HorizontalTextAlignment="Start" VerticalTextAlignment="Center" Padding="5,0,5,0" Margin="0"
								Text="{Binding Path=NameOrCategory}" Style="{DynamicResource ClickableValueLabel}" VerticalOptions="Center"/>
						<!-- Share Template QR button -->
						<controls:SvgButton Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
											SvgSource="share.svg"
											Style="{DynamicResource IconButtonOnBackground}"
											HorizontalOptions="End"
											VerticalOptions="Center"
											Command="{Binding ShareTemplateQRCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
											CommandParameter="{Binding .}"
											IsVisible="{Binding CanShareTemplate, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}" />
					</Grid>
				</controls:TemplatedButton>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="ContractRowTemplate" x:DataType="objectmodel:ContractModel">
			<Border Style="{DynamicResource BorderSet}">
				<controls:TemplatedButton Padding="0"
								 Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
								 CommandParameter="{Binding .}">
					<Grid ColumnDefinitions="auto,*,auto" RowDefinitions="auto,auto,auto" ColumnSpacing="8" RowSpacing="4">
						<!-- Unread dot -->
						<Ellipse Grid.Column="0" Grid.Row="0" WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
								 Fill="{DynamicResource TnPInfoContentWL}" IsVisible="{Binding IsUnread}"/>

						<Label Grid.Column="1" Grid.Row="0" Text="{Binding DisplayName}" Style="{DynamicResource BoldItemTitleLabel}"
							   LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Center"/>

						<Label Grid.Column="2" Grid.Row="0" Text="{Binding LastChangedText}" Style="{DynamicResource ItemDescriptionLabel}"
							   LineBreakMode="NoWrap" VerticalOptions="Center"/>

						<Label Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding PartyNames}" IsVisible="{Binding HasPartyNames}"
							   Style="{DynamicResource ItemDescriptionLabel}" LineBreakMode="TailTruncation" MaxLines="1"/>

						<Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" ColumnDefinitions="auto,auto,*" ColumnSpacing="6">
							<!-- State chip, colored by group -->
							<Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,2"
									BackgroundColor="{DynamicResource TnPInfobgWL}" IsVisible="{Binding HasStateText}" VerticalOptions="Center">
										<Border.Triggers>
											<DataTrigger TargetType="Border" Binding="{Binding Group}" Value="{x:Static contracts:ContractListGroup.NeedsAction}">
												<Setter Property="BackgroundColor" Value="{DynamicResource TnPWarningbgWL}"/>
											</DataTrigger>
											<DataTrigger TargetType="Border" Binding="{Binding Group}" Value="{x:Static contracts:ContractListGroup.Signed}">
												<Setter Property="BackgroundColor" Value="{DynamicResource TnPSuccessbgWL}"/>
											</DataTrigger>
											<DataTrigger TargetType="Border" Binding="{Binding Group}" Value="{x:Static contracts:ContractListGroup.Ended}">
												<Setter Property="BackgroundColor" Value="{DynamicResource TnPDangerbgWL}"/>
											</DataTrigger>
										</Border.Triggers>
										<Label Text="{Binding StateText}" FontSize="{StaticResource FontSizeSm}" TextColor="{DynamicResource TnPInfoContentWL}">
											<Label.Triggers>
												<DataTrigger TargetType="Label" Binding="{Binding Group}" Value="{x:Static contracts:ContractListGroup.NeedsAction}">
													<Setter Property="TextColor" Value="{DynamicResource TnPWarningContentWL}"/>
												</DataTrigger>
												<DataTrigger TargetType="Label" Binding="{Binding Group}" Value="{x:Static contracts:ContractListGroup.Signed}">
													<Setter Property="TextColor" Value="{DynamicResource TnPSuccessContentWL}"/>
												</DataTrigger>
												<DataTrigger TargetType="Label" Binding="{Binding Group}" Value="{x:Static contracts:ContractListGroup.Ended}">
													<Setter Property="TextColor" Value="{DynamicResource TnPDangerContentWL}"/>
												</DataTrigger>
											</Label.Triggers>
										</Label>
							</Border>

							<!-- What the user needs to do -->
							<Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,2"
									BackgroundColor="{DynamicResource TnPWarningbgWL}" IsVisible="{Binding HasMarker}" VerticalOptions="Center">
								<Label Text="{Binding MarkerText}" FontSize="{StaticResource FontSizeSm}" TextColor="{DynamicResource TnPWarningContentWL}"/>
							</Border>

							<Label Grid.Column="2" Text="{Binding MyRoleText}" IsVisible="{Binding HasMyRole}" Style="{DynamicResource ItemDescriptionLabel}"
								   LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" HorizontalOptions="End"/>
						</Grid>
					</Grid>
				</controls:TemplatedButton>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="PetitionRowTemplate" x:DataType="objectmodel:ContractPetitionModel">
			<Border Style="{DynamicResource BorderSet}">
				<controls:TemplatedButton Padding="0"
								 Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
								 CommandParameter="{Binding .}">
					<Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto" ColumnSpacing="8" RowSpacing="4">
						<Label Grid.Column="0" Grid.Row="0" Text="{Binding Title}" Style="{DynamicResource BoldItemTitleLabel}"
							   LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Center"/>

						<Label Grid.Column="1" Grid.Row="0" Text="{Binding ReceivedText}" Style="{DynamicResource ItemDescriptionLabel}"
							   LineBreakMode="NoWrap" VerticalOptions="Center"/>

						<Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding Purpose}" IsVisible="{Binding HasPurpose}"
							   Style="{DynamicResource ItemDescriptionLabel}" LineBreakMode="TailTruncation" MaxLines="2"/>

						<Border Grid.Column="0" Grid.Row="2" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,2"
								BackgroundColor="{DynamicResource TnPWarningbgWL}" HorizontalOptions="Start">
							<Label Text="{l:Localize ContractMarkerRequest}" FontSize="{StaticResource FontSizeSm}" TextColor="{DynamicResource TnPWarningContentWL}"/>
						</Border>
					</Grid>
				</controls:TemplatedButton>
			</Border>
		</DataTemplate>

		<viewmodel:ContractListItemTemplateSelector x:Key="ContractListItemTemplateSelector"
													ContractTemplate="{StaticResource ContractRowTemplate}"
													TemplateRowTemplate="{StaticResource TemplateRowTemplate}"
													PetitionTemplate="{StaticResource PetitionRowTemplate}"/>
	</VisualElement.Resources>
	
	<Grid BackgroundColor="{DynamicResource SurfaceBackgroundWL}" RowDefinitions="auto, auto, *">

		<controls:Background Grid.RowSpan="3"/>

		<Grid ColumnDefinitions="auto, *, auto" Margin="16,0,16,0">
			<controls:SvgButton
				Command="{Binding GoBackCommand}"
				SvgSource="close.svg"
				Style="{DynamicResource IconButton}"
				HorizontalOptions="Start"/>

			<Label Text="{Binding Path=Title}"
				   Style="{DynamicResource PageTitleLabel}"
				   Margin="{DynamicResource SmallLeftMargins}"
				   Grid.Column="2" HorizontalOptions="End"/>
		</Grid>

		<Border Style="{DynamicResource BorderSet}" Grid.Row="1" Padding="16,16,16,0" Margin="16,16,16,0">
			<VerticalStackLayout>
				<Label Style="{DynamicResource AlertLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center"
					   VerticalOptions="Center" IsVisible="{Binding Path=ShowContractsMissing}" Text="{Binding EmptyText}" Margin="0,40,0,0"/>

				<controls:CompositeEntry
					Style="{DynamicResource RegularCompositeEntry}"
					Placeholder="{l:Localize Search}"
					TextChanged="ContractsSearchChanged"
					Margin="0,0,0,16"
					IsVisible="{Binding Path=ShowContractsMissing, Converter={mct:InvertedBoolConverter}}">
				</controls:CompositeEntry>
			</VerticalStackLayout>
		</Border>

		<ActivityIndicator x:Name="Loading" IsVisible="{Binding Path=IsBusy}" IsRunning="{Binding Path=IsBusy}"
						   Color="{DynamicResource TnPInfoContentWL}"
						   HorizontalOptions="Center"
						   VerticalOptions="Center"
						   Margin="0,32,0,32"
						   Grid.Row="2"/>

		<RefreshView Grid.Row="2" IsVisible="{Binding Path=IsBusy, Converter={mct:InvertedBoolConverter}}"
					 IsRefreshing="{Binding IsRefreshing}"
					 Command="{Binding RefreshContractsCommand}">
			<Grid>
				<!-- A search that found nothing -->
				<Label Style="{DynamicResource AlertLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center" VerticalOptions="Start"
					   IsVisible="{Binding ShowNoMatches}" Text="{l:Localize NoContractsFound}" Margin="0,24,0,0"/>

				<!-- Templates, and contracts to pick from -->
				<CollectionView x:Name="Contracts" VerticalOptions="Start"
								Margin="8"
								SelectionMode="None"
								ItemSizingStrategy="MeasureAllItems"
								IsVisible="{Binding IsFlatList}"
								ItemsSource="{Binding Path=Contracts}"
								ItemTemplate="{StaticResource ContractListItemTemplateSelector}"
								RemainingItemsThreshold="{Binding HasMore}"
								RemainingItemsThresholdReachedCommand="{Binding LoadMoreContractsCommand}">
					<CollectionView.ItemsLayout>
						<LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
					</CollectionView.ItemsLayout>
				</CollectionView>

				<!-- The contracts inbox, grouped by what the contracts need -->
				<CollectionView x:Name="ContractGroups" VerticalOptions="Start"
								Margin="8"
								SelectionMode="None"
								ItemSizingStrategy="MeasureAllItems"
								IsGrouped="True"
								IsVisible="{Binding IsInbox}"
								ItemsSource="{Binding Path=Groups}"
								ItemTemplate="{StaticResource ContractListItemTemplateSelector}">
					<CollectionView.ItemsLayout>
						<LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
					</CollectionView.ItemsLayout>
					<CollectionView.GroupHeaderTemplate>
						<DataTemplate x:DataType="objectmodel:ContractGroupModel">
							<Label Text="{Binding Title}" Style="{DynamicResource SectionTitleLabel}" Margin="4,16,4,0"/>
						</DataTemplate>
					</CollectionView.GroupHeaderTemplate>
					<CollectionView.GroupFooterTemplate>
						<DataTemplate x:DataType="objectmodel:ContractGroupModel">
							<controls:TextButton LabelData="{l:Localize LoadMore}"
												 Style="{DynamicResource TransparentTextButton}"
												 HorizontalOptions="Center"
												 IsVisible="{Binding HasMore}"
												 Command="{Binding LoadMoreInGroupCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
												 CommandParameter="{Binding .}"/>
						</DataTemplate>
					</CollectionView.GroupFooterTemplate>
				</CollectionView>
			</Grid>
		</RefreshView>

	</Grid>
</base:BaseContentPage>
