<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.MyContracts.MyContractsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts.ObjectModels"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.MyContracts"
	x:DataType="viewmodel:MyContractsViewModel"
	x:Name="ThisPage">

	<Grid
		BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		RowDefinitions="Auto,Auto,*">

		<controls:Background Grid.RowSpan="3" />

		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			Margin="{DynamicResource MediumMargins}">
			<controls:SvgButton
				Command="{Binding GoBackCommand}"
				HorizontalOptions="Start"
				SemanticProperties.Description="{l:Localize Close}"
				Style="{DynamicResource IconButton}"
				SvgSource="close.svg" />
			<VerticalStackLayout
				Grid.Column="1"
				Margin="{DynamicResource SmallLeftMargins}"
				Spacing="2"
				VerticalOptions="Center">
				<Label
					LineBreakMode="TailTruncation"
					Style="{DynamicResource PageTitleLabel}"
					Text="{Binding Title}" />
				<Label
					MaxLines="2"
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{Binding Description}"
					TextColor="{DynamicResource ContentSecondaryWL}" />
			</VerticalStackLayout>
		</Grid>

		<VerticalStackLayout
			Grid.Row="1"
			Margin="{DynamicResource MediumLeftRightMargins}"
			Spacing="{DynamicResource SmallSpacing}">
			<Grid
				ColumnDefinitions="*,Auto"
				ColumnSpacing="{DynamicResource SmallSpacing}">
				<controls:CompositeEntry
					EntryData="{Binding SearchText, Mode=TwoWay}"
					Placeholder="{l:Localize Search}"
					Style="{DynamicResource RegularCompositeEntry}" />
				<controls:SvgButton
					Grid.Column="1"
					BorderStyle="{DynamicResource IconButtonBorderStroke}"
					Command="{Binding OpenFilterPopupCommand}"
					HeightRequest="46"
					HorizontalOptions="End"
					SemanticProperties.Description="{l:Localize SelectFilter}"
					Style="{DynamicResource IconButton}"
					SvgSource="filter.svg"
					VerticalOptions="Center"
					WidthRequest="46" />
			</Grid>

			<ScrollView
				x:Name="FilterTagsScroll"
				HorizontalScrollBarVisibility="Never"
				Orientation="Horizontal">
				<HorizontalStackLayout
					x:Name="FilterTagsLayout"
					BindableLayout.ItemsSource="{Binding FilterTags}"
					Spacing="{DynamicResource SmallSpacing}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="viewmodel:MyContractsViewModel+SelectableTag">
							<controls:TemplatedButton
								Command="{Binding FilterChangedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
								CommandParameter="{Binding .}"
								Padding="0">
								<Border
									BackgroundColor="{DynamicResource TnPNeutralv300bgWL}"
									Padding="12,7"
									Stroke="{DynamicResource SurfaceStrokeWL}"
									StrokeShape="RoundRectangle 20">
									<Label
										FontSize="14"
										Text="{Binding Category}"
										TextColor="{DynamicResource TnPNeutralv300ContentWL}" />
									<Border.Triggers>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Border"
											Value="True">
											<Setter
												Property="BackgroundColor"
												Value="{DynamicResource TnPInfobgWL}" />
											<Setter
												Property="Stroke"
												Value="{DynamicResource TnPInfoContentWL}" />
										</DataTrigger>
									</Border.Triggers>
								</Border>
							</controls:TemplatedButton>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>
			</ScrollView>
		</VerticalStackLayout>

		<Grid Grid.Row="2">
			<VerticalStackLayout
				HorizontalOptions="Center"
				IsVisible="{Binding IsInitialLoading}"
				Spacing="{DynamicResource SmallSpacing}"
				VerticalOptions="Center">
				<ActivityIndicator
					Color="{DynamicResource TnPInfoContentWL}"
					IsRunning="{Binding IsInitialLoading}" />
				<Label
					Style="{DynamicResource ItemDescriptionLabel}"
					Text="{l:Localize LoadingContracts}" />
			</VerticalStackLayout>

			<Border
				IsVisible="{Binding HasLoadError}"
				Margin="{DynamicResource MediumMargins}"
				Padding="{DynamicResource MediumMargins}"
				Style="{DynamicResource BorderSet}"
				VerticalOptions="Center">
				<VerticalStackLayout
					Spacing="{DynamicResource SmallSpacing}">
					<controls:StatusPill
						Text="{l:Localize Unavailable}"
						Tone="Danger" />
					<Label
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{Binding LoadErrorMessage}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
					<Button
						Command="{Binding RetryCommand}"
						HorizontalOptions="Start"
						Style="{DynamicResource SecondaryButton}"
						Text="{l:Localize Retry}" />
				</VerticalStackLayout>
			</Border>

			<Border
				IsVisible="{Binding ShowEmptyState}"
				Margin="{DynamicResource MediumMargins}"
				Padding="{DynamicResource MediumMargins}"
				Style="{DynamicResource BorderSet}"
				VerticalOptions="Center">
				<VerticalStackLayout
					HorizontalOptions="Center"
					Spacing="{DynamicResource SmallSpacing}">
					<Label
						HorizontalTextAlignment="Center"
						Style="{DynamicResource SectionTitleLabel}"
						Text="{l:Localize NoMatchingContractsTitle}" />
					<Label
						HorizontalTextAlignment="Center"
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize NoMatchingContractsDescription}"
						TextColor="{DynamicResource ContentSecondaryWL}" />
				</VerticalStackLayout>
			</Border>

			<CollectionView
				x:Name="Contracts"
				IsVisible="{Binding HasContracts}"
				ItemSizingStrategy="MeasureAllItems"
				ItemsSource="{Binding Contracts}"
				Margin="8,8,8,0"
				RemainingItemsThreshold="{Binding HasMore}"
				RemainingItemsThresholdReachedCommand="{Binding LoadMoreContractsCommand}"
				SelectionMode="None">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout
						ItemSpacing="4"
						Orientation="Vertical" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="objectmodel:ContractModel">
						<Border
							Margin="4,2"
							Padding="0"
							Style="{DynamicResource BorderSet}">
							<Border.Triggers>
								<DataTrigger
									Binding="{Binding IsNeedsAttention}"
									TargetType="Border"
									Value="True">
									<Setter
										Property="Stroke"
										Value="{DynamicResource TnPWarningContentWL}" />
								</DataTrigger>
							</Border.Triggers>
							<controls:TemplatedButton
								Command="{Binding ContractSelectedCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
								CommandParameter="{Binding .}"
								IsEnabled="{Binding CanOpen}"
								Padding="0">
								<Grid
									ColumnDefinitions="*,Auto"
									Padding="{DynamicResource MediumMargins}"
									RowDefinitions="Auto,Auto,Auto,Auto,Auto"
									RowSpacing="{DynamicResource SmallSpacing}">
									<VerticalStackLayout
										Spacing="2">
										<Label
											FontAttributes="Bold"
											FontSize="18"
											LineBreakMode="TailTruncation"
											Text="{Binding Title}"
											TextColor="{DynamicResource ContentPrimaryWL}" />
										<Label
											IsVisible="{Binding HasCategory}"
											LineBreakMode="TailTruncation"
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding Category}"
											TextColor="{DynamicResource ContentSecondaryWL}" />
									</VerticalStackLayout>

									<controls:SvgButton
										Grid.Column="1"
										Command="{Binding ShareTemplateQRCommand, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										CommandParameter="{Binding .}"
										HorizontalOptions="End"
										IsVisible="{Binding CanShareTemplate, Source={RelativeSource AncestorType={x:Type viewmodel:MyContractsViewModel}}, x:DataType=viewmodel:MyContractsViewModel}"
										SemanticProperties.Description="{l:Localize Share}"
										Style="{DynamicResource IconButtonOnBackground}"
										SvgSource="share.svg"
										VerticalOptions="Start" />

									<FlexLayout
										Grid.Row="1"
										Grid.ColumnSpan="2"
										AlignItems="Center"
										Direction="Row"
										Wrap="Wrap">
										<controls:StatusPill
											IsVisible="{Binding IsNeedsAttention}"
											Margin="0,0,8,4"
											Text="{l:Localize ContractNeedsAttention}"
											Tone="Warning" />
										<controls:StatusPill
											Margin="0,0,8,4"
											Text="{Binding StateText}"
											Tone="{Binding StateTone}" />
										<controls:StatusPill
											IsVisible="{Binding HasTemplateKind}"
											Margin="0,0,8,4"
											Text="{Binding TemplateKindText}"
											Tone="Neutral" />
										<controls:StatusPill
											IsVisible="{Binding HasEvents}"
											Margin="0,0,8,4"
											Text="{Binding NrEvents}"
											Tone="Information" />
									</FlexLayout>

									<FlexLayout
										Grid.Row="2"
										Grid.ColumnSpan="2"
										AlignItems="Center"
										Direction="Row"
										Wrap="Wrap">
										<Label
											IsVisible="{Binding HasRole}"
											Margin="0,0,16,4"
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding RoleText}"
											TextColor="{DynamicResource ContentPrimaryWL}" />
										<Label
											IsVisible="{Binding HasParties}"
											Margin="0,0,16,4"
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding PartiesText}"
											TextColor="{DynamicResource ContentSecondaryWL}" />
										<Label
											IsVisible="{Binding HasSignatureProgress}"
											Margin="0,0,16,4"
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding SignatureProgressText}"
											TextColor="{DynamicResource ContentSecondaryWL}" />
									</FlexLayout>

									<Border
										Grid.Row="3"
										Grid.ColumnSpan="2"
										BackgroundColor="{DynamicResource TnPWarningbgWL}"
										IsVisible="{Binding HasRecoveryText}"
										Padding="10,8"
										Stroke="{DynamicResource TnPWarningContentWL}"
										StrokeShape="RoundRectangle 8">
										<Label
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding RecoveryText}"
											TextColor="{DynamicResource TnPWarningContentWL}" />
									</Border>

									<Grid
										Grid.Row="4"
										Grid.ColumnSpan="2"
										ColumnDefinitions="*,Auto"
										ColumnSpacing="{DynamicResource SmallSpacing}">
										<Label
											IsVisible="{Binding HasTimeContext}"
											LineBreakMode="TailTruncation"
											Style="{DynamicResource ItemDescriptionLabel}"
											Text="{Binding TimeContextText}"
											TextColor="{DynamicResource ContentSecondaryWL}"
											VerticalTextAlignment="Center" />
										<Label
											Grid.Column="1"
											FontAttributes="Bold"
											IsVisible="{Binding HasNextAction}"
											LineBreakMode="TailTruncation"
											Text="{Binding NextActionText}"
											TextColor="{DynamicResource ContentPrimaryWL}"
											VerticalTextAlignment="Center" />
									</Grid>
								</Grid>
							</controls:TemplatedButton>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
				<CollectionView.Header>
					<Border
						BackgroundColor="{DynamicResource TnPWarningbgWL}"
						IsVisible="{Binding HasAttentionContracts}"
						Margin="4,2,4,8"
						Padding="12,10"
						Stroke="{DynamicResource TnPWarningContentWL}"
						StrokeShape="RoundRectangle 10">
						<Grid ColumnDefinitions="*,Auto">
							<Label
								FontAttributes="Bold"
								Text="{l:Localize ContractNeedsAttention}"
								TextColor="{DynamicResource TnPWarningContentWL}"
								VerticalTextAlignment="Center" />
							<controls:StatusPill
								Grid.Column="1"
								Text="{Binding AttentionContractsCount}"
								Tone="Warning" />
						</Grid>
					</Border>
				</CollectionView.Header>
				<CollectionView.Footer>
					<HorizontalStackLayout
						HorizontalOptions="Center"
						IsVisible="{Binding IsLoadingMore}"
						Padding="8,16"
						Spacing="{DynamicResource SmallSpacing}">
						<ActivityIndicator IsRunning="{Binding IsLoadingMore}" />
						<Label
							Style="{DynamicResource ItemDescriptionLabel}"
							Text="{l:Localize LoadingMoreContracts}"
							VerticalTextAlignment="Center" />
					</HorizontalStackLayout>
				</CollectionView.Footer>
			</CollectionView>
		</Grid>
	</Grid>
</base:BaseContentPage>
