<?xml version="1.0" encoding="utf-8"?>

<views:BaseNewContractView x:Name="ThisPage"
                           x:Class="NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views.ParametersView"
                           x:DataType="base:NewContractViewModel"
                           xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                           xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views"
                           xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract"
                           xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
                           xmlns:contracts="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts"
									xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
									xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
                           xmlns:ui="clr-namespace:NeuroAccessMaui.UI" >
	<ContentView.Resources>
		<objectModel:ParameterTemplateSelector x:Key="ParameterTemplateSelector"
			BooleanTemplate="{StaticResource BooleanParameterTemplate}"
			DateTemplate="{StaticResource DateParameterTemplate}"
			DateTimeTemplate="{StaticResource DateTimeParameterTemplate}"
			NumericalTemplate="{StaticResource NumericalParameterTemplate}"
			StringTemplate="{StaticResource StringParameterTemplate}"
			TimeTemplate="{StaticResource TimeParameterTemplate}"
			DurationTemplate="{StaticResource DurationParameterTemplate}"
			ContractReferenceTemplate="{StaticResource ContractReferenceParameterTemplate}"
			GeoTemplate="{StaticResource GeoParameterTemplate}"
			AttachmentTemplate="{StaticResource AttachmentParameterTemplate}"
			DefaultTemplate="{StaticResource DefaultParameterTemplate}" />
	</ContentView.Resources>

	<!-- Parameters -->
	<Grid RowDefinitions="Auto,*">
		<!-- How many values need a fix, after the user tapped Next -->
		<Border Grid.Row="0"
				Style="{DynamicResource RoundedBorder}"
				BackgroundColor="{DynamicResource TnPDangerbgWL}"
				Stroke="Transparent"
				Padding="12,8"
				Margin="16,0,16,8"
				IsVisible="{Binding HasParameterFixes}">
			<Grid ColumnDefinitions="*,Auto"
				  ColumnSpacing="{DynamicResource SmallSpacing}">
				<Label Grid.Column="0"
					   Text="{Binding ParameterFixText}"
					   TextColor="{DynamicResource TnPDangerContentWL}"
					   FontSize="{StaticResource FontSizeMd}"
					   VerticalOptions="Center" />
				<Label Grid.Column="1"
					   Text="{l:Localize ParameterFixShow}"
					   TextColor="{DynamicResource TnPDangerContentWL}"
					   FontFamily="SpaceGroteskSemiBold"
					   FontSize="{StaticResource FontSizeMd}"
					   TextDecorations="Underline"
					   VerticalOptions="Center">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="ShowFirstFix_Tapped" />
					</Label.GestureRecognizers>
				</Label>
			</Grid>
		</Border>

		<CollectionView x:Name="ParametersList"
						Grid.Row="1"
						HorizontalOptions="Center"
						ItemsSource="{Binding InputParameters}"
						ItemTemplate="{StaticResource ParameterTemplateSelector}"
						SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
			<CollectionView.ItemsLayout>
				<LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
			</CollectionView.ItemsLayout>
			<!-- What this step is for -->
			<CollectionView.Header>
				<Label Margin="20,0,20,16"
					   FontSize="{StaticResource FontSizeMd}"
					   LineBreakMode="WordWrap"
					   Text="{l:Localize ContractFillHint}"
					   TextColor="{DynamicResource ContentSecondaryWL}" />
			</CollectionView.Header>
			<CollectionView.EmptyView>
				<Label Text="{l:Localize SomethingWentWrong}" />
			</CollectionView.EmptyView>
			<CollectionView.Footer>
				<VerticalStackLayout Spacing="16"
									 Padding="0,16,0,16">
					<!-- Values taken from people's IDs when they sign, one card for each role -->
					<VerticalStackLayout Spacing="16"
										 BindableLayout.ItemsSource="{Binding IdParameterGroups}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="contracts:ParameterGroup">
								<Border Style="{DynamicResource BorderSet}"
										Margin="{DynamicResource MediumLeftRightMargins}">
									<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
										<Grid ColumnDefinitions="*,Auto"
											  ColumnSpacing="8">
											<Label Grid.Column="0"
												   Text="{Binding Title}"
												   Style="{DynamicResource ParameterItemTitleLabel}" />
											<Border Grid.Column="1"
													StrokeShape="RoundRectangle 6"
													StrokeThickness="0"
													Padding="7,2"
													BackgroundColor="{DynamicResource TnPInfobgWL}"
													VerticalOptions="Center">
												<Label Text="{l:Localize ParameterAddedOnSigningTag}"
													   FontFamily="HaasGroteskMedium"
													   FontSize="11"
													   TextColor="{DynamicResource TnPInfoContentWL}" />
											</Border>
										</Grid>
										<VerticalStackLayout Spacing="6"
															 BindableLayout.ItemsSource="{Binding Items}">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="objectModel:ObservableParameter">
													<Grid ColumnDefinitions="*,Auto"
														  ColumnSpacing="12">
														<Label Grid.Column="0"
															   Text="{Binding Label}"
															   FontSize="{StaticResource FontSizeMd}"
															   TextColor="{DynamicResource ContentPrimaryWL}" />
														<Label Grid.Column="1"
															   Text="{Binding RowValue}"
															   FontSize="{StaticResource FontSizeMd}"
															   TextColor="{DynamicResource ContentPrimaryWL}"
															   HorizontalTextAlignment="End">
															<Label.Triggers>
																<DataTrigger TargetType="Label"
																			 Binding="{Binding RowIsMuted}"
																			 Value="True">
																	<Setter Property="TextColor"
																			Value="{DynamicResource ContentSecondaryWL}" />
																</DataTrigger>
															</Label.Triggers>
														</Label>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>

					<!-- The calculated values, worked out as the user fills in -->
					<Border StrokeShape="RoundRectangle 16"
							StrokeThickness="0"
							Padding="14,12"
							BackgroundColor="{DynamicResource TnPSuccessbgWL}"
							Margin="{DynamicResource MediumLeftRightMargins}"
							IsVisible="{Binding HasCalculatedParameters}">
						<VerticalStackLayout Spacing="6">
							<HorizontalStackLayout Spacing="6">
								<Path Data="{x:Static ui:Geometries.CalculatorPath}"
									  Fill="{DynamicResource TnPSuccessContentWL}"
									  Aspect="Uniform"
									  WidthRequest="14"
									  HeightRequest="14"
									  VerticalOptions="Center" />
								<Label Text="{l:Localize ParameterCalculated}"
									   FontFamily="HaasGroteskMedium"
									   FontSize="{StaticResource FontSizeXs}"
									   TextColor="{DynamicResource TnPSuccessContentWL}"
									   VerticalOptions="Center" />
							</HorizontalStackLayout>
							<VerticalStackLayout Spacing="4"
												 BindableLayout.ItemsSource="{Binding CalculatedParameters}">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="objectModel:ObservableParameter">
										<Grid ColumnDefinitions="*,Auto"
											  ColumnSpacing="12">
											<Label Grid.Column="0"
												   Text="{Binding Label}"
												   FontSize="{StaticResource FontSizeSm}"
												   TextColor="{DynamicResource ContentPrimaryWL}"
												   VerticalOptions="Center" />
											<Label Grid.Column="1"
												   Text="{Binding RowValue}"
												   FontFamily="SpaceGroteskSemiBold"
												   FontSize="{StaticResource FontSizeLg}"
												   TextColor="{DynamicResource ContentPrimaryWL}"
												   HorizontalTextAlignment="End"
												   VerticalOptions="Center">
												<Label.Triggers>
													<DataTrigger TargetType="Label"
																 Binding="{Binding RowIsMuted}"
																 Value="True">
														<Setter Property="FontFamily"
																Value="HaasGroteskRegular" />
														<Setter Property="FontSize"
																Value="{StaticResource FontSizeSm}" />
														<Setter Property="TextColor"
																Value="{DynamicResource ContentSecondaryWL}" />
													</DataTrigger>
												</Label.Triggers>
											</Label>
										</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>
			</CollectionView.Footer>
		</CollectionView>
	</Grid>

</views:BaseNewContractView>
