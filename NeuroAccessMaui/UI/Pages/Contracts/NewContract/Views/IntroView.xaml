<?xml version="1.0" encoding="utf-8" ?>
<views:BaseNewContractView
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views.IntroView"
	x:DataType="base:NewContractViewModel"
	x:Name="ThisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views">
	<ScrollView>
		<VerticalStackLayout
			Padding="16,4,16,24"
			Spacing="20">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
				<Border
					BackgroundColor="{DynamicResource SurfaceElevation2WL}"
					HeightRequest="56"
					Padding="12"
					Stroke="{DynamicResource SurfaceStrokeWL}"
					StrokeShape="RoundRectangle 16"
					WidthRequest="56">
					<controls:SvgView InputTransparent="True" Source="contract.svg" TintColor="{DynamicResource ContentPrimaryWL}" />
				</Border>
				<VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
					<Label
						Style="{DynamicResource KeyLabel}"
						Text="{l:Localize ContractWizardContractLabel}" />
					<Label
						SemanticProperties.HeadingLevel="Level2"
						Style="{DynamicResource SectionTitleLabel}"
						Text="{Binding Contract.Category}" />
					<Label
						Style="{DynamicResource ItemDescriptionLabel}"
						Text="{l:Localize ContractCreationDetailsAndParties}" />
				</VerticalStackLayout>
			</Grid>

			<VerticalStackLayout Spacing="10">
				<VerticalStackLayout Spacing="3">
					<Label
						SemanticProperties.HeadingLevel="Level2"
						Style="{DynamicResource SectionTitleLabel}"
						Text="{l:Localize ContractWizardSettings}" />
					<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{l:Localize ContractWizardVisibilityPlaceholder}" />
				</VerticalStackLayout>
				<Border Margin="0" Padding="16" Style="{DynamicResource BorderSet}">
					<controls:CompositePicker
						ItemsSource="{Binding ContractVisibilityItems}"
						LabelText="{l:Localize Visibility}"
						Placeholder="{l:Localize ContractWizardVisibilityPlaceholder}"
						SelectedItem="{Binding SelectedContractVisibilityItem}"
						Style="{DynamicResource RegularCompositePicker}" />
				</Border>
			</VerticalStackLayout>

			<VerticalStackLayout Spacing="8">
					<Label
						SemanticProperties.HeadingLevel="Level2"
						Style="{DynamicResource SectionTitleLabel}"
						Text="{l:Localize NextStep}" />
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
					<controls:StatusPill Text="1" Tone="Information" />
					<Label Grid.Column="1" Style="{DynamicResource ItemDescriptionLabel}" Text="{l:Localize SetParametersDescription}" VerticalTextAlignment="Center" />
					<controls:StatusPill Grid.Row="1" Text="2" Tone="Information" />
					<Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource ItemDescriptionLabel}" Text="{l:Localize SelectRolesDescription}" VerticalTextAlignment="Center" />
				</Grid>
			</VerticalStackLayout>

			<controls:TextButton
				Command="{Binding ShowPreviewFromIntroCommand}"
				HorizontalOptions="Start"
				LabelData="{l:Localize ContractWizardReviewHumanReadable}"
				Style="{DynamicResource OutlinedTextButton}" />
		</VerticalStackLayout>
	</ScrollView>
</views:BaseNewContractView>
