<?xml version="1.0" encoding="utf-8"?>

<views:BaseNewContractView x:Name="ThisPage"
                           x:Class="NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views.RolesView"
                           xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Registration.Views"
                           xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract"
                           x:DataType="base:NewContractViewModel"
                           xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                           xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
                           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                           xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
                           xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
                           xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views"
                           xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
                           xmlns:xmpp="clr-namespace:Waher.Networking.XMPP.Contracts;assembly=Waher.Networking.XMPP.Contracts">

	<ContentView.Resources>
		<Style x:Key="RoleTitleLabel" TargetType="Label" BaseResourceKey="BoldItemTitleLabel">
			<Setter Property="FontSize" Value="{StaticResource FontSizeXl}"/>
			<Setter Property="HorizontalTextAlignment" Value="Start"/>
		</Style>
		<Style x:Key="RoleDescriptionLabel" TargetType="Label" BasedOn="{StaticResource ItemDescriptionLabel}">
			<Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
			<Setter Property="Margin" Value="0" />
			<Setter Property="HorizontalTextAlignment" Value="Start"/>
			<Setter Property="FontFamily" Value="SpaceGroteskMedium" />
		</Style>
	</ContentView.Resources>

	<!-- Roles. A stack instead of a CollectionView, since a CollectionView cell doesn't shrink when the add buttons are hidden. -->
	<ScrollView>
		<VerticalStackLayout Margin="{DynamicResource SmallLeftRightMargins}">
			<Border Style="{DynamicResource BorderSet}">
				<VerticalStackLayout>
					<Label Text="{l:Localize SelectRolesYouWillSignAsOptional}" Style="{DynamicResource RoleTitleLabel}"/>
				</VerticalStackLayout>
			</Border>
			<VerticalStackLayout BindableLayout.ItemsSource="{Binding Contract.Roles}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="objectModel:ObservableRole">
						<Grid>
							<Border Style="{DynamicResource BorderSet}">
								<VerticalStackLayout>
									<Grid ColumnDefinitions="*, auto" RowDefinitions="auto">
										<Label Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource RoleTitleLabel}"/>
										<HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
											<CheckBox IsVisible="{Binding CanSelectMe}" Color="{DynamicResource ContentAccessWL}"
													 IsChecked="{Binding IsSelectedByMe, Mode=TwoWay}"/>
											<Label IsVisible="{Binding CanSelectMe}" Text="{l:Localize SignAs}" VerticalTextAlignment="Center" Style="{DynamicResource RoleDescriptionLabel}"/>
										</HorizontalStackLayout>
									</Grid>
									<Label Text="{Binding Description}" Style="{DynamicResource RoleDescriptionLabel}" />
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="0">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="objectModel:ObservablePart">
												<Border Style="{DynamicResource BorderSet}" Stroke="{DynamicResource InputFieldsSurfaceStroke}">
													<Grid ColumnDefinitions="*, auto" RowDefinitions="auto,auto">
														<controls:TemplatedButton Grid.Column="0" Grid.Row="0" Command="{Binding OpenIdentityCommand}">
															<Label Text="{Binding FriendlyName}"
																	Style="{DynamicResource RoleDescriptionLabel}"
																	VerticalOptions="Center"
																	HorizontalOptions="Center"
																	TextColor="{DynamicResource ButtonAccessTertiaryContentWL}"/>
															</controls:TemplatedButton>
															<VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="4">
																<Border HorizontalOptions="Center"
																		Padding="{DynamicResource SmallLeftRightMargins}"
																		Style="{DynamicResource RoundedBorder}"
																		BackgroundColor="{DynamicResource TnPWarningbgWL}"
																		IsVisible="{Binding HasSentPetition}">
																	<Label Style="{DynamicResource RoleDescriptionLabel}" Text="{l:Localize IDRequestSent}" TextColor="{DynamicResource TnPWarningContentWL}" VerticalOptions="Center"/>
																</Border>
																<Label Style="{DynamicResource RoleDescriptionLabel}" Text="{l:Localize IdentityDeclined}" TextColor="{DynamicResource TnPDangerContentWL}"
																	   HorizontalOptions="Center" IsVisible="{Binding IsIdentityDeclined}"/>
																<!-- Without the identity, the app has no address to send the invitation to. -->
																<VerticalStackLayout Spacing="4" IsVisible="{Binding CanRequestIdentityToInvite}">
																	<Label Style="{DynamicResource RoleDescriptionLabel}" Text="{l:Localize InviteRequestIdentityHint}"
																		   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
																	<controls:TextButton LabelData="{l:Localize RequestIdentity}" Style="{DynamicResource TransparentTextButton}"
																						 HorizontalOptions="Center" Command="{Binding RequestIdentityCommand}"/>
																</VerticalStackLayout>
															</VerticalStackLayout>
															<controls:TemplatedButton Grid.Column="1" Grid.RowSpan="2"
																	  IsVisible="{Binding ShowRemoveAsMe}"
																	  Command="{Binding Source={RelativeSource AncestorType={x:Type objectModel:ObservableRole}}, Path=RemovePartCommand}"
																	  CommandParameter="{Binding .}">
																		<Border WidthRequest="48" HeightRequest="48"  Style="{DynamicResource TransparentTemplateButtonBorder}" Padding="{DynamicResource SmallMargins}" Margin="0" Background="{DynamicResource ButtonDangerSecondarybgWL}" >
																			<Path WidthRequest="24" HeightRequest="24"
																			  Fill="{DynamicResource ButtonAccessSecondaryContentWL}"				  
																			  Data="{x:Static ui:Geometries.CancelPath}"
																			  VerticalOptions="Center" HorizontalOptions="Center"/>
																		</Border>

																	</controls:TemplatedButton>

																<controls:TemplatedButton Grid.Column="1" Grid.RowSpan="2"
																	  IsVisible="{Binding ShowRemoveAsThirdParty}"
																							  Command="{Binding Source={RelativeSource AncestorType={x:Type objectModel:ObservableRole}}, Path=RemovePartCommand}"
																						 CommandParameter="{Binding .}">
																		<Border WidthRequest="48" HeightRequest="48"  Style="{DynamicResource TransparentTemplateButtonBorder}" Padding="{DynamicResource SmallMargins}" Margin="0" Background="{DynamicResource ButtonDangerSecondarybgWL}" >
																			<Path WidthRequest="24" HeightRequest="24"
																			  Fill="{DynamicResource ButtonAccessSecondaryContentWL}"				  
																			  Data="{x:Static ui:Geometries.CancelPath}"
																			  VerticalOptions="Center" HorizontalOptions="Center"/>
																		</Border>

																	</controls:TemplatedButton>

														</Grid>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>

									<!-- In an open contract, nobody is named: anyone who can see it may sign. A stack layout, since a ContentView keeps the size of hidden content. -->
									<VerticalStackLayout IsVisible="{Binding IsNamedParts, Source={RelativeSource AncestorType={x:Type base:NewContractViewModel}}, x:DataType=base:NewContractViewModel}">
										<Border Style="{DynamicResource BorderSet}"
												IsVisible="{Binding Path=HasReachedMaxCount, Converter={StaticResource InvertedBoolConverter}}"
												Stroke="{DynamicResource InputFieldsSurfaceStroke}">
											<Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource SmallSpacing}">
												<controls:TextButton Grid.Column="0" LabelData="{l:Localize AddContact}" Style="{DynamicResource TransparentTextButton}"
																		Command="{Binding AddPartFromContactsCommand}"/>
												<controls:TextButton Grid.Column="1" LabelData="{l:Localize ScanQRShort}" Style="{DynamicResource TransparentTextButton}"
																		Command="{Binding AddPartFromQrCommand}"/>
											</Grid>
										</Border>
									</VerticalStackLayout>
								</VerticalStackLayout>
							</Border>
						</Grid>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>

</views:BaseNewContractView>
