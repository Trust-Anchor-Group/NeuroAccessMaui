<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.NewContract.NewContractPage"
	x:DataType="viewmodel:NewContractViewModel"
	x:Name="ThisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract"
	xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.NewContract.Views">

	<base:BaseContentPage.Resources>
		<converters:StringNotEqualsConverter x:Key="StringNotEqualsConverter" />
		<mct:IsStringNotNullOrEmptyConverter x:Key="IsNotEmptyString" />
	</base:BaseContentPage.Resources>

	<Grid
		BackgroundColor="{DynamicResource SurfaceBackgroundWL}"
		RowDefinitions="Auto,Auto,*,Auto">
		<controls:Background Grid.Row="0" Grid.RowSpan="4" />

		<Grid
			Grid.Row="0"
			ColumnDefinitions="Auto,*"
			ColumnSpacing="{DynamicResource SmallSpacing}"
			Margin="{DynamicResource MediumLeftRightBottomMargins}">
			<controls:SvgButton
				Command="{Binding BackCommand}"
				SemanticProperties.Description="{l:Localize Close}"
				Style="{DynamicResource IconButton}"
				SvgSource="close.svg" />
			<Label
				Grid.Column="1"
				HorizontalTextAlignment="End"
				Style="{DynamicResource PageTitleLabel}"
				Text="{l:Localize NewContract}" />
		</Grid>

		<VerticalStackLayout
			Grid.Row="1"
			IsVisible="{Binding CurrentState, Converter={StaticResource StringNotEqualsConverter}, ConverterParameter=Loading}"
			Margin="{DynamicResource MediumLeftRightBottomMargins}"
			Spacing="{DynamicResource SmallSpacing}">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SmallSpacing}">
				<Label
					Style="{DynamicResource SectionTitleLabel}"
					Text="{Binding CurrentStepTitle}" />
				<Label
					Grid.Column="1"
					Style="{DynamicResource InfoLabel}"
					Text="{Binding ProgressText}"
					VerticalOptions="Center" />
			</Grid>

			<CollectionView
				HeightRequest="56"
				HorizontalScrollBarVisibility="Never"
				ItemSizingStrategy="MeasureAllItems"
				ItemsSource="{Binding Steps}"
				SelectionMode="None">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="viewmodel:StepDescriptor">
						<controls:TemplatedButton
							Command="{Binding GoToStepDescriptorCommand, Source={RelativeSource AncestorType={x:Type viewmodel:NewContractViewModel}}, x:DataType=viewmodel:NewContractViewModel}"
							CommandParameter="{Binding .}"
							HorizontalOptions="Start"
							Padding="0"
							SemanticProperties.Description="{Binding Title}"
							VerticalOptions="Center">
							<Border
								BackgroundColor="{DynamicResource SurfaceElevation1WL}"
								InputTransparent="True"
								MinimumHeightRequest="44"
								Padding="12,8"
								Stroke="{DynamicResource SurfaceStrokeWL}"
								VerticalOptions="Center"
								Style="{DynamicResource RoundedBorder}">
								<HorizontalStackLayout
									Spacing="{DynamicResource SmallSpacing}"
									VerticalOptions="Center">
									<Label
										Style="{DynamicResource KeyLabel}"
										Text="{Binding DisplayNumber}"
										VerticalTextAlignment="Center" />
									<Label
										LineBreakMode="NoWrap"
										MaxLines="1"
										Style="{DynamicResource ValueLabel}"
										Text="{Binding Title}"
										VerticalTextAlignment="Center" />
								</HorizontalStackLayout>
								<Border.Triggers>
									<DataTrigger
										Binding="{Binding IsCurrent}"
										TargetType="Border"
										Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource SurfaceElevation2WL}" />
										<Setter Property="Stroke" Value="{DynamicResource ContentPrimaryWL}" />
									</DataTrigger>
								</Border.Triggers>
							</Border>
						</controls:TemplatedButton>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</VerticalStackLayout>

		<Grid
			x:Name="StateGrid"
			Grid.Row="2"
			mct:StateContainer.CanStateChange="{Binding CanStateChange, Mode=OneWayToSource}"
			mct:StateContainer.CurrentState="{Binding CurrentState, Mode=OneWayToSource}">
			<mct:StateContainer.StateViews>
				<views:LoadingView mct:StateView.StateKey="Loading" />
				<views:IntroView mct:StateView.StateKey="Intro" />
				<views:ParametersView mct:StateView.StateKey="Parameters" />
				<views:RolesView mct:StateView.StateKey="Roles" />
				<views:PreviewView mct:StateView.StateKey="Preview" />
			</mct:StateContainer.StateViews>

			<Label
				HorizontalTextAlignment="Center"
				Text="{l:Localize SomethingWentWrong}"
				VerticalTextAlignment="Center" />
		</Grid>

		<Border
			Grid.Row="3"
			IsVisible="{Binding CurrentState, Converter={StaticResource StringNotEqualsConverter}, ConverterParameter=Loading}"
			Margin="0"
			Padding="0"
			Style="{DynamicResource BottomBarBorder2}">
			<Grid
				ColumnDefinitions="Auto,*,Auto"
				ColumnSpacing="{DynamicResource MediumSpacing}"
				Padding="16,8"
				RowDefinitions="Auto,Auto,Auto,Auto"
				RowSpacing="{DynamicResource SmallSpacing}">
				<Grid
					Grid.ColumnSpan="3"
					ColumnDefinitions="Auto,*"
					ColumnSpacing="{DynamicResource SmallSpacing}"
					IsVisible="{Binding IsOnPreviewStep}"
					Padding="{DynamicResource SmallTopMargins}">
					<CheckBox
						Color="{DynamicResource ContentPrimaryWL}"
						IsChecked="{Binding IsContractOk}" />
					<Label
						Grid.Column="1"
						Style="{DynamicResource BottomBarLabel}"
						Text="{l:Localize IHaveReadAndUnderstoodTheContract}" />
				</Grid>

				<Border
					Grid.Row="1"
					Grid.ColumnSpan="3"
					BackgroundColor="{DynamicResource TnPWarningbgWL}"
					IsVisible="{Binding ShowNoRolesWarning}"
					Padding="{DynamicResource SmallMargins}"
					Stroke="{DynamicResource TnPWarningFigureWL}"
					Style="{DynamicResource RoundedBorder}">
					<VerticalStackLayout Spacing="2">
						<Label
							Style="{DynamicResource BottomBarLabel}"
							Text="{Binding RolesValidationMessage}"
							TextColor="{DynamicResource TnPWarningContentWL}" />
						<Label
							IsVisible="{Binding RolesValidationContext, Converter={StaticResource IsNotEmptyString}}"
							Style="{DynamicResource InfoLabel}"
							Text="{Binding RolesValidationContext}"
							TextColor="{DynamicResource TnPWarningContentWL}" />
					</VerticalStackLayout>
				</Border>

				<Border
					Grid.Row="2"
					Grid.ColumnSpan="3"
					BackgroundColor="{DynamicResource TnPWarningbgWL}"
					IsVisible="{Binding IsCreationOutcomeUncertain}"
					Padding="{DynamicResource SmallMargins}"
					Stroke="{DynamicResource TnPWarningFigureWL}"
					Style="{DynamicResource RoundedBorder}">
					<Label
						Style="{DynamicResource BottomBarLabel}"
						Text="{l:Localize ContractCreationOutcomeUncertain}"
						TextColor="{DynamicResource TnPWarningContentWL}" />
				</Border>

				<controls:TextButton
					Grid.Row="3"
					Command="{Binding GoPreviousStepCommand}"
					IsEnabled="{Binding CanGoBack}"
					LabelData="{l:Localize Back}"
					Style="{DynamicResource SecondaryButton}" />
				<ActivityIndicator
					Grid.Row="3"
					Grid.Column="1"
					Color="{DynamicResource ContentPrimaryWL}"
					HorizontalOptions="Center"
					IsRunning="{Binding IsValidatingParameters}"
					IsVisible="{Binding IsValidatingParameters}" />
				<controls:TextButton
					Grid.Row="3"
					Grid.Column="2"
					Command="{Binding GoNextStepCommand}"
					IsEnabled="{Binding CanAdvanceCurrentStep}"
					LabelData="{Binding PrimaryActionText}"
					Style="{DynamicResource PrimaryButton}" />
			</Grid>
		</Border>
	</Grid>
</base:BaseContentPage>
