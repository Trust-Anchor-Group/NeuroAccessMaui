    <controls:Background/>

    <ScrollView>
        <VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Parameters}"
                            ItemTemplate="{StaticResource ParameterTemplateSelector}"
                            VerticalOptions="Fill"
