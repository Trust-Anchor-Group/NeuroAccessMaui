<?xml version="1.0" encoding="utf-8" ?>
<views:BaseViewContractView x:Name="ThisPage"
                           x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.PreviewView"
                           x:DataType="base:ViewContractViewModel"
                           xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                           xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
                           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                           xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
                           xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Registration.Views"
                           xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
                           xmlns:md="clr-namespace:NeuroAccessMaui.UI.Controls.Markdown"
                           xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views"
                           xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract">
	<Grid RowDefinitions="auto, *, auto">
		<!-- The step's title, with Contents when the text has headings to jump to -->
		<Grid Grid.Row="0"
			  ColumnDefinitions="*, auto"
			  Padding="20,0,16,0"
			  ColumnSpacing="12">
			<Label Grid.Column="0"
				   VerticalOptions="Center"
				   FontFamily="SpaceGroteskSemiBold"
				   FontSize="20"
				   LineBreakMode="WordWrap"
				   SemanticProperties.HeadingLevel="Level1"
				   Text="{l:Localize ContractTextTitle}"
				   TextColor="{DynamicResource ContentPrimaryWL}" />
			<controls:TemplatedButton Grid.Column="1"
									  VerticalOptions="Center"
									  IsVisible="{Binding HasContents, Source={x:Reference ContractText}, x:DataType=md:MarkdownView}"
									  Command="{Binding ShowContentsCommand, Source={x:Reference ContractText}, x:DataType=md:MarkdownView}"
									  SemanticProperties.Description="{l:Localize MarkdownContents}">
				<Border VerticalOptions="Center"
						Style="{DynamicResource ListCardChipBorder}">
					<HorizontalStackLayout VerticalOptions="Center"
										   Spacing="8">
						<Path VerticalOptions="Center"
							  HeightRequest="14"
							  WidthRequest="14"
							  Aspect="Uniform"
							  Data="{x:Static ui:Geometries.HamburgerIconPath}"
							  Fill="{DynamicResource ContentPrimaryWL}" />
						<Label Style="{DynamicResource ListCardChipLabel}"
							   Text="{l:Localize MarkdownContents}" />
					</HorizontalStackLayout>
				</Border>
			</controls:TemplatedButton>
		</Grid>

		<!-- The text sits on the page and scrolls by itself. Missing values show on a warning tint. -->
		<md:MarkdownView x:Name="ContractText"
						 Grid.Row="1"
						 Mode="Document"
						 Model="{Binding HumanReadableText}"
						 ShowsContentsButton="False"
						 TextPadding="20,12,20,24" />

		<!-- While signing, the full text is read from the sign sheet, and leads back to it -->
		<Border Grid.Row="2"
				IsVisible="{Binding IsSigningFlow}"
				Style="{DynamicResource BottomBarBorder}">
			<controls:TextButton Margin="{DynamicResource SmallMargins}"
								 Command="{Binding GoToSigningRoleCommand}"
								 Style="{DynamicResource FilledTextButton}"
								 LabelData="{Binding SignTitle}" />
		</Border>
	</Grid>
</views:BaseViewContractView>
