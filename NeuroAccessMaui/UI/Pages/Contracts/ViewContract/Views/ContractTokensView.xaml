<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentView x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.ContractTokensView"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:objectmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyWallet.ObjectModels"
					  xmlns:tokenviews="clr-namespace:NeuroAccessMaui.UI.Pages.Wallet.MyTokens.Views"
					  IsVisible="False">
	<VerticalStackLayout Spacing="8">
		<Label Text="{l:Localize TokensCreatedByContract}"
			   Style="{DynamicResource SectionTitleLabel}"
			   SemanticProperties.HeadingLevel="Level2" />
		<!-- The tokens are set from code, once they have loaded -->
		<VerticalStackLayout x:Name="TokenList"
							 Spacing="8">
			<BindableLayout.ItemTemplate>
				<DataTemplate x:DataType="objectmodel:TokenItem">
					<tokenviews:TokenRowView />
				</DataTemplate>
			</BindableLayout.ItemTemplate>
		</VerticalStackLayout>
	</VerticalStackLayout>
</base:BaseContentView>
