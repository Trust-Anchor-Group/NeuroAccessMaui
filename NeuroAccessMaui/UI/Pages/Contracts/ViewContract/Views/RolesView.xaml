<?xml version="1.0" encoding="utf-8" ?>
<views:BaseViewContractView
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.RolesView"
	x:DataType="base:ViewContractViewModel"
	x:Name="ThisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
	xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views">

	<CollectionView ItemsSource="{Binding Contract.Roles}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems" Margin="16,4,16,20">
		<CollectionView.Header>
			<VerticalStackLayout Spacing="4" Margin="0,0,0,16">
				<Label SemanticProperties.HeadingLevel="Level2" Style="{DynamicResource SectionTitleLabel}" Text="{l:Localize PeopleAndSignatures}" />
				<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding SignatureProgressText}" TextColor="{DynamicResource ContentSecondaryWL}" />
			</VerticalStackLayout>
		</CollectionView.Header>
		<CollectionView.ItemsLayout>
			<LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
		</CollectionView.ItemsLayout>
		<CollectionView.ItemTemplate>
			<DataTemplate x:DataType="objectModel:ObservableRole">
				<Border Margin="0" Padding="16" Style="{DynamicResource BorderSet}">
					<VerticalStackLayout Spacing="12">
						<VerticalStackLayout Spacing="2">
							<Label FontAttributes="Bold" FontSize="18" Text="{Binding Name}" TextColor="{DynamicResource ContentPrimaryWL}" />
							<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding Description}" TextColor="{DynamicResource ContentSecondaryWL}" />
						</VerticalStackLayout>

						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="8">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="objectModel:ObservablePart">
									<Border BackgroundColor="{DynamicResource SurfaceElevation2WL}" Padding="12" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
											<Border Grid.RowSpan="2" BackgroundColor="{DynamicResource SurfaceElevation1WL}" HeightRequest="40" Padding="9" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10" VerticalOptions="Center" WidthRequest="40">
												<controls:SvgView InputTransparent="True" Source="person.svg" TintColor="{DynamicResource ContentPrimaryWL}" />
											</Border>
											<controls:TemplatedButton Grid.Column="1" Command="{Binding OpenIdentityCommand}" HorizontalOptions="Start" Padding="0">
												<Label FontAttributes="Bold" Text="{Binding FriendlyName}" TextColor="{DynamicResource ButtonAccessTertiaryContentWL}" />
											</controls:TemplatedButton>
											<FlexLayout Grid.Row="1" Grid.Column="1" Direction="Row" Wrap="Wrap">
												<controls:StatusPill IsVisible="{Binding HasSentPetition}" Margin="0,0,6,2" Text="{l:Localize IDRequestSent}" Tone="Warning" />
												<controls:StatusPill IsVisible="{Binding HasSigned, Converter={StaticResource InvertedBoolConverter}}" Margin="0,0,6,2" Text="{l:Localize PendingSignature}" Tone="Warning" />
												<controls:StatusPill IsVisible="{Binding HasSigned}" Margin="0,0,6,2" Text="{l:Localize Signed}" Tone="Success" />
											</FlexLayout>
											<HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
												<controls:TextButton Command="{Binding SendProposalToPartCommand, Source={RelativeSource AncestorType={x:Type base:ViewContractViewModel}}, x:DataType=base:ViewContractViewModel}" CommandParameter="{Binding .}" IsVisible="{Binding CanSendProposal}" LabelData="{l:Localize SendProposal}" Style="{DynamicResource OutlinedTextButton}" />
												<controls:TextButton Command="{Binding OpenSignatureCommand}" IsVisible="{Binding HasSigned}" LabelData="{l:Localize ViewSignature}" Style="{DynamicResource OutlinedTextButton}" />
											</HorizontalStackLayout>
										</Grid>
									</Border>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>

						<Border BackgroundColor="{DynamicResource SurfaceElevation2WL}" IsVisible="{Binding HasReachedMaxCount, Converter={StaticResource InvertedBoolConverter}}" Padding="12" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
							<Label HorizontalTextAlignment="Center" Style="{DynamicResource ItemDescriptionLabel}" Text="{l:Localize None}" TextColor="{DynamicResource ContentSecondaryWL}" />
						</Border>
					</VerticalStackLayout>
				</Border>
			</DataTemplate>
		</CollectionView.ItemTemplate>
	</CollectionView>
</views:BaseViewContractView>
