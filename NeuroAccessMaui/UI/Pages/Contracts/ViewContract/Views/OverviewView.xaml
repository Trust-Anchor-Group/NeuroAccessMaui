<?xml version="1.0" encoding="utf-8"?>
<views:BaseViewContractView x:Name="ThisPage"
							x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.OverviewView"
							x:DataType="base:ViewContractViewModel"
							xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
							xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
							xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract"
							xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views"
							xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel">

	<ContentView.Resources>
		<ResourceDictionary>
			<!-- A row of a card: what it is on the left, the value on the right -->
			<Style x:Key="RowGrid"
				   TargetType="Grid">
				<Setter Property="Padding"
						Value="16,12" />
				<Setter Property="ColumnSpacing"
						Value="12" />
				<Setter Property="MinimumHeightRequest"
						Value="48" />
				<Setter Property="BackgroundColor"
						Value="{DynamicResource SurfaceElevation1WL}" />
			</Style>

			<Style x:Key="RowKeyLabel"
				   TargetType="Label">
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="FontSize"
						Value="{StaticResource FontSizeSm}" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>

			<Style x:Key="RowValueLabel"
				   TargetType="Label">
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="HorizontalTextAlignment"
						Value="End" />
				<Setter Property="FontFamily"
						Value="SpaceGroteskSemiBold" />
				<Setter Property="FontSize"
						Value="{StaticResource FontSizeSm}" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentPrimaryWL}" />
			</Style>

			<!-- A row that does something, such as "All 9 details" or "Withdraw" -->
			<Style x:Key="RowActionLabel"
				   TargetType="Label">
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="FontFamily"
						Value="SpaceGroteskSemiBold" />
				<Setter Property="FontSize"
						Value="{StaticResource FontSizeMd}" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentAccessWL}" />
			</Style>

			<Style x:Key="RowChevronLabel"
				   TargetType="Label">
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="FontFamily"
						Value="SpaceGroteskSemiBold" />
				<Setter Property="FontSize"
						Value="{StaticResource FontSizeXl}" />
				<Setter Property="Text"
						Value="›" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>

			<!-- The round mark in front of a person: their initials, or "You" -->
			<Style x:Key="AvatarBorder"
				   TargetType="Border">
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="Padding"
						Value="0" />
				<Setter Property="HeightRequest"
						Value="40" />
				<Setter Property="WidthRequest"
						Value="40" />
				<Setter Property="BackgroundColor"
						Value="{DynamicResource TnPSuccessbgWL}" />
				<Setter Property="StrokeShape"
						Value="RoundRectangle 20" />
				<Setter Property="StrokeThickness"
						Value="0" />
			</Style>

			<Style x:Key="AvatarLabel"
				   TargetType="Label">
				<Setter Property="VerticalOptions"
						Value="Center" />
				<Setter Property="HorizontalOptions"
						Value="Center" />
				<Setter Property="FontFamily"
						Value="SpaceGroteskBold" />
				<Setter Property="FontSize"
						Value="{StaticResource FontSizeXs}" />
				<Setter Property="LineBreakMode"
						Value="NoWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentAccessWL}" />
			</Style>

			<Style x:Key="PersonNameLabel"
				   TargetType="Label">
				<Setter Property="FontFamily"
						Value="SpaceGroteskSemiBold" />
				<Setter Property="FontSize"
						Value="{StaticResource FontSizeMd}" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentPrimaryWL}" />
			</Style>

			<Style x:Key="PersonDetailLabel"
				   TargetType="Label">
				<Setter Property="FontSize"
						Value="13" />
				<Setter Property="LineBreakMode"
						Value="WordWrap" />
				<Setter Property="TextColor"
						Value="{DynamicResource ContentSecondaryWL}" />
			</Style>

			<!-- The 1 px gaps between the rows of a card show the divider colour as lines -->
			<Style x:Key="RowsLayout"
				   TargetType="VerticalStackLayout">
				<Setter Property="Spacing"
						Value="1" />
				<Setter Property="BackgroundColor"
						Value="{DynamicResource SurfaceDividerWL}" />
			</Style>
		</ResourceDictionary>
	</ContentView.Resources>

	<Grid RowDefinitions="*, auto">
		<RefreshView Command="{Binding RefreshContractCommand}"
					 IsRefreshing="{Binding IsRefreshing}">
			<ScrollView>
				<VerticalStackLayout Padding="16,0,16,24"
									 Spacing="8">

					<!-- Deleted on the server, or no access: the saved copy is shown -->
					<Border Padding="{DynamicResource SmallMargins}"
							IsVisible="{Binding HasStatusBanner}"
							Style="{DynamicResource AccentInfoBorder}"
							BackgroundColor="{DynamicResource TnPDangerbgWL}">
						<Grid ColumnDefinitions="auto, *"
							  RowDefinitions="auto, auto, auto, auto"
							  RowSpacing="{DynamicResource SmallSpacing}">
							<Path Grid.Column="0"
								  Grid.Row="0"
								  VerticalOptions="Start"
								  HorizontalOptions="Center"
								  HeightRequest="16"
								  WidthRequest="16"
								  Aspect="Uniform"
								  Data="{x:Static ui:Geometries.InfoCirclePath}"
								  Fill="{DynamicResource TnPDangerContentWL}" />
							<Label Grid.Column="1"
								   Grid.Row="0"
								   Margin="{DynamicResource SmallLeftMargins}"
								   IsVisible="{Binding IsDeletedOnServer}"
								   Style="{DynamicResource AccentInfoLabel}"
								   Text="{l:Localize ContractDeletedBanner}"
								   TextColor="{DynamicResource TnPDangerContentWL}" />
							<Label Grid.Column="1"
								   Grid.Row="1"
								   Margin="{DynamicResource SmallLeftMargins}"
								   IsVisible="{Binding IsAccessDenied}"
								   Style="{DynamicResource AccentInfoLabel}"
								   Text="{l:Localize ContractAccessDeniedBanner}"
								   TextColor="{DynamicResource TnPDangerContentWL}" />
							<Label Grid.Column="1"
								   Grid.Row="2"
								   Margin="{DynamicResource SmallLeftMargins}"
								   IsVisible="{Binding ShowAskSenderHint}"
								   Style="{DynamicResource AccentInfoLabel}"
								   Text="{l:Localize ContractAccessAskSender}"
								   TextColor="{DynamicResource TnPDangerContentWL}" />
							<controls:TextButton Grid.Row="3"
												 Grid.Column="0"
												 Grid.ColumnSpan="2"
												 IsVisible="{Binding ShowRequestAccess}"
												 Command="{Binding RequestAccessCommand}"
												 Style="{DynamicResource OutlinedTextButton}"
												 LabelData="{l:Localize AskForAccess}" />
						</Grid>
					</Border>

					<!-- Who invited the user, and their message -->
					<Border Padding="16,12"
							IsVisible="{Binding HasInvitation}"
							Style="{DynamicResource ListCardBorder}">
						<VerticalStackLayout Spacing="4">
							<Label IsVisible="{Binding HasProposalFriendlyName}"
								   FontFamily="HaasGroteskMedium"
								   FontSize="{StaticResource FontSizeSm}"
								   Text="{Binding InvitedByText}"
								   TextColor="{DynamicResource ContentSecondaryWL}" />
							<Label IsVisible="{Binding HasProposalMessage}"
								   FontSize="{StaticResource FontSizeMd}"
								   LineBreakMode="WordWrap"
								   Text="{Binding ProposalMessage}"
								   TextColor="{DynamicResource ContentPrimaryWL}" />
						</VerticalStackLayout>
					</Border>

					<!-- Where the contract stands for the user, what it is, and how far signing has come -->
					<Border Padding="18"
							Style="{DynamicResource ListCardBorder}">
						<VerticalStackLayout Spacing="10">
							<Border HorizontalOptions="Start"
									Padding="12,6"
									BackgroundColor="{DynamicResource TnPInfobgWL}"
									StrokeShape="RoundRectangle 14"
									StrokeThickness="0">
								<Border.Triggers>
									<DataTrigger Binding="{Binding IsStateWarning}"
												 TargetType="Border"
												 Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource TnPWarningbgWL}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsStateSuccess}"
												 TargetType="Border"
												 Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource TnPSuccessbgWL}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsStateDanger}"
												 TargetType="Border"
												 Value="True">
										<Setter Property="BackgroundColor" Value="{DynamicResource TnPDangerbgWL}" />
									</DataTrigger>
								</Border.Triggers>
								<HorizontalStackLayout Spacing="6">
									<BoxView VerticalOptions="Center"
											 HeightRequest="7"
											 WidthRequest="7"
											 Color="{DynamicResource TnPInfoContentWL}"
											 CornerRadius="4">
										<BoxView.Triggers>
											<DataTrigger Binding="{Binding IsStateWarning}"
														 TargetType="BoxView"
														 Value="True">
												<Setter Property="Color" Value="{DynamicResource TnPWarningContentWL}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsStateSuccess}"
														 TargetType="BoxView"
														 Value="True">
												<Setter Property="Color" Value="{DynamicResource TnPSuccessContentWL}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsStateDanger}"
														 TargetType="BoxView"
														 Value="True">
												<Setter Property="Color" Value="{DynamicResource TnPDangerContentWL}" />
											</DataTrigger>
										</BoxView.Triggers>
									</BoxView>
									<Label VerticalOptions="Center"
										   FontFamily="HaasGroteskMedium"
										   FontSize="{StaticResource FontSizeXs}"
										   Text="{Binding StatusText}"
										   TextColor="{DynamicResource TnPInfoContentWL}">
										<Label.Triggers>
											<DataTrigger Binding="{Binding IsStateWarning}"
														 TargetType="Label"
														 Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPWarningContentWL}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsStateSuccess}"
														 TargetType="Label"
														 Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPSuccessContentWL}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsStateDanger}"
														 TargetType="Label"
														 Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPDangerContentWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</HorizontalStackLayout>
							</Border>

							<Label FontFamily="SpaceGroteskBold"
								   FontSize="{StaticResource FontSize4xl}"
								   LineBreakMode="WordWrap"
								   SemanticProperties.HeadingLevel="Level1"
								   Text="{Binding ContractName}"
								   TextColor="{DynamicResource ContentPrimaryWL}" />

							<Label IsVisible="{Binding HasSummary}"
								   FontSize="{StaticResource FontSizeMd}"
								   LineBreakMode="WordWrap"
								   Text="{Binding SummaryText}"
								   TextColor="{DynamicResource ContentSecondaryWL}" />

							<Label IsVisible="{Binding HasStatusDetail}"
								   FontSize="{StaticResource FontSizeSm}"
								   LineBreakMode="WordWrap"
								   Text="{Binding StatusDetailText}"
								   TextColor="{DynamicResource ContentPrimaryWL}" />

							<Grid ColumnDefinitions="*, auto"
								  ColumnSpacing="10"
								  IsVisible="{Binding HasProgress}">
								<ProgressBar Grid.Column="0"
											 VerticalOptions="Center"
											 Progress="{Binding ProgressValue}"
											 ProgressColor="{DynamicResource ContentAccessWL}" />
								<Label Grid.Column="1"
									   VerticalOptions="Center"
									   FontFamily="HaasGroteskMedium"
									   FontSize="13"
									   Text="{Binding ProgressText}"
									   TextColor="{DynamicResource ContentPrimaryWL}" />
							</Grid>

							<Grid ColumnDefinitions="auto, *"
								  ColumnSpacing="6"
								  IsVisible="{Binding HasDeadline}">
								<Path Grid.Column="0"
									  VerticalOptions="Center"
									  HeightRequest="14"
									  WidthRequest="14"
									  Aspect="Uniform"
									  Data="{x:Static ui:Geometries.CalendarPath}"
									  Fill="{DynamicResource ContentSecondaryWL}">
									<Path.Triggers>
										<DataTrigger Binding="{Binding IsDeadlineNear}"
													 TargetType="Path"
													 Value="True">
											<Setter Property="Fill" Value="{DynamicResource TnPWarningContentWL}" />
										</DataTrigger>
									</Path.Triggers>
								</Path>
								<Label Grid.Column="1"
									   VerticalOptions="Center"
									   FontFamily="HaasGroteskMedium"
									   FontSize="13"
									   LineBreakMode="WordWrap"
									   Text="{Binding DeadlineText}"
									   TextColor="{DynamicResource ContentSecondaryWL}">
									<Label.Triggers>
										<DataTrigger Binding="{Binding IsDeadlineNear}"
													 TargetType="Label"
													 Value="True">
											<Setter Property="TextColor" Value="{DynamicResource TnPWarningContentWL}" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
							</Grid>

							<controls:TemplatedButton Command="{Binding GoToReviewCommand}">
								<Grid ColumnDefinitions="*, auto"
									  ColumnSpacing="4">
									<Label Grid.Column="0"
										   Style="{StaticResource RowActionLabel}"
										   Text="{l:Localize ContractReadWhole}" />
									<Label Grid.Column="1"
										   Style="{StaticResource RowChevronLabel}"
										   TextColor="{DynamicResource ContentAccessWL}" />
								</Grid>
							</controls:TemplatedButton>
						</VerticalStackLayout>
					</Border>

					<!-- The key values, and a link to all of them -->
					<Label IsVisible="{Binding HasKeyDetails}"
						   Style="{DynamicResource ListCardSectionLabel}"
						   Text="{l:Localize ContractKeyDetails}" />
					<Border IsVisible="{Binding HasKeyDetails}"
							Style="{DynamicResource ListCardBorder}">
						<VerticalStackLayout Style="{StaticResource RowsLayout}">
							<VerticalStackLayout BindableLayout.ItemTemplateSelector="{StaticResource ParameterRowSelector}"
												 BindableLayout.ItemsSource="{Binding KeyDetails}"
												 Style="{StaticResource RowsLayout}" />
							<controls:TemplatedButton IsVisible="{Binding HasMoreDetails}"
													  Command="{Binding GoToParametersCommand}">
								<Grid ColumnDefinitions="*, auto"
									  Style="{StaticResource RowGrid}">
									<Label Grid.Column="0"
										   Style="{StaticResource RowActionLabel}"
										   Text="{Binding AllDetailsText}" />
									<Label Grid.Column="1"
										   Style="{StaticResource RowChevronLabel}"
										   TextColor="{DynamicResource ContentAccessWL}" />
								</Grid>
							</controls:TemplatedButton>
						</VerticalStackLayout>
					</Border>

					<!-- Everyone in the contract, role by role, and who has signed -->
					<Label Style="{DynamicResource ListCardSectionLabel}"
						   Text="{l:Localize ContractPeople}" />
					<Border Style="{DynamicResource ListCardBorder}">
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Contract.Roles}"
											 Style="{StaticResource RowsLayout}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="objectModel:ObservableRole">
									<VerticalStackLayout Style="{StaticResource RowsLayout}">
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}"
															 Style="{StaticResource RowsLayout}">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="objectModel:ObservablePart">
													<Grid ColumnDefinitions="auto, *, auto"
														  MinimumHeightRequest="60"
														  Style="{StaticResource RowGrid}">
														<Border Grid.Column="0"
																Style="{StaticResource AvatarBorder}">
															<Border.Triggers>
																<DataTrigger Binding="{Binding IsMe}"
																			 TargetType="Border"
																			 Value="True">
																	<Setter Property="BackgroundColor" Value="{DynamicResource SurfaceElevation2WL}" />
																</DataTrigger>
															</Border.Triggers>
															<Label Style="{StaticResource AvatarLabel}"
																   Text="{Binding Initials}" />
														</Border>
														<VerticalStackLayout Grid.Column="1"
																			 VerticalOptions="Center"
																			 Spacing="2">
															<Label Style="{StaticResource PersonNameLabel}"
																   Text="{Binding DisplayName}" />
															<Label Style="{StaticResource PersonDetailLabel}"
																   Text="{Binding Role}" />
															<Label IsVisible="{Binding Description, Source={RelativeSource AncestorType={x:Type objectModel:ObservableRole}}, x:DataType=objectModel:ObservableRole, Converter={mct:IsStringNotNullOrEmptyConverter}}"
																   LineBreakMode="TailTruncation"
																   MaxLines="2"
																   Style="{StaticResource PersonDetailLabel}"
																   Text="{Binding Description, Source={RelativeSource AncestorType={x:Type objectModel:ObservableRole}}, x:DataType=objectModel:ObservableRole}" />
															<!-- Until a part shows their identity, the app has no address to send them the invitation -->
															<VerticalStackLayout IsVisible="{Binding CanManageParts, Source={RelativeSource AncestorType={x:Type base:ViewContractViewModel}}, x:DataType=base:ViewContractViewModel}"
																				 Spacing="2">
																<Label IsVisible="{Binding HasSentPetition}"
																	   Style="{StaticResource PersonDetailLabel}"
																	   Text="{l:Localize IDRequestSent}"
																	   TextColor="{DynamicResource TnPWarningContentWL}" />
																<Label IsVisible="{Binding IsIdentityDeclined}"
																	   Style="{StaticResource PersonDetailLabel}"
																	   Text="{l:Localize IdentityDeclined}"
																	   TextColor="{DynamicResource TnPDangerContentWL}" />
																<Label IsVisible="{Binding CanRequestIdentityToInvite}"
																	   Style="{StaticResource PersonDetailLabel}"
																	   Text="{l:Localize InviteRequestIdentityHint}" />
																<controls:TextButton HorizontalOptions="Start"
																					 IsVisible="{Binding CanRequestIdentityToInvite}"
																					 Command="{Binding RequestIdentityCommand}"
																					 Style="{DynamicResource TransparentTextButton}"
																					 LabelData="{l:Localize RequestIdentity}" />
															</VerticalStackLayout>
														</VerticalStackLayout>
														<Label Grid.Column="2"
															   VerticalOptions="Center"
															   FontFamily="HaasGroteskMedium"
															   FontSize="13"
															   Text="{Binding SignedText}"
															   TextColor="{DynamicResource TnPWarningContentWL}">
															<Label.Triggers>
																<DataTrigger Binding="{Binding HasSigned}"
																			 TargetType="Label"
																			 Value="True">
																	<Setter Property="TextColor" Value="{DynamicResource TnPSuccessContentWL}" />
																</DataTrigger>
															</Label.Triggers>
														</Label>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>

										<!-- A role nobody has taken yet -->
										<Grid ColumnDefinitions="auto, *"
											  IsVisible="{Binding HasNoParts}"
											  MinimumHeightRequest="60"
											  Style="{StaticResource RowGrid}">
											<Border Grid.Column="0"
													HeightRequest="40"
													WidthRequest="40"
													Style="{DynamicResource ListCardEmptyTileBorder}"
													StrokeShape="RoundRectangle 20">
												<Label Style="{StaticResource AvatarLabel}"
													   Text="?"
													   TextColor="{DynamicResource ContentSecondaryWL}" />
											</Border>
											<VerticalStackLayout Grid.Column="1"
																 VerticalOptions="Center"
																 Spacing="2">
												<Label Style="{StaticResource PersonNameLabel}"
													   Text="{Binding Name}" />
												<Label Style="{StaticResource PersonDetailLabel}"
													   Text="{l:Localize ContractNoOneYet}" />
											</VerticalStackLayout>
										</Grid>
									</VerticalStackLayout>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</Border>

					<!-- Tokens the contract created, shown for signed token-creation contracts -->
					<views:ContractTokensView ContractId="{Binding CreatedTokensContractId}" />

					<!-- Dates, the template, attachments, technical details, and what else can be done -->
					<Label Style="{DynamicResource ListCardSectionLabel}"
						   Text="{l:Localize More}" />
					<Border Style="{DynamicResource ListCardBorder}">
						<VerticalStackLayout Style="{StaticResource RowsLayout}">
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasSigningWindow}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractSigningWindow}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding SigningWindowText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasValidFrom}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractValidFrom}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding ValidFromText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasValidTo}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractValidTo}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding ValidToText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasDuration}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize Duration}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding DurationText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasArchivedUntil}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractArchivedUntil}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding ArchivedUntilText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasArchiveRequired}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractArchiveRequired}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding ArchiveRequiredText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasArchiveOptional}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractArchiveOptional}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding ArchiveOptionalText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize Created}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding CreatedText}" />
							</Grid>
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasUpdated}"
								  Style="{StaticResource RowGrid}">
								<Label Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize Updated}" />
								<Label Grid.Column="1"
									   Style="{StaticResource RowValueLabel}"
									   Text="{Binding UpdatedText}" />
							</Grid>

							<!-- The template the contract was created from -->
							<controls:TemplatedButton IsVisible="{Binding HasTemplate}"
													  Command="{Binding OpenContractCommand}"
													  CommandParameter="{Binding TemplateId}">
								<Grid ColumnDefinitions="4*, 6*"
									  Style="{StaticResource RowGrid}">
									<Label Style="{StaticResource RowKeyLabel}"
										   Text="{l:Localize ContractSectionTemplate}" />
									<Label Grid.Column="1"
										   LineBreakMode="CharacterWrap"
										   MaxLines="2"
										   Style="{StaticResource RowValueLabel}"
										   Text="{Binding TemplateId}"
										   TextColor="{DynamicResource ContentAccessWL}" />
								</Grid>
							</controls:TemplatedButton>

							<!-- Attachments, by file name -->
							<Grid ColumnDefinitions="4*, 6*"
								  IsVisible="{Binding HasAttachments}"
								  Style="{StaticResource RowGrid}">
								<Label VerticalOptions="Start"
									   Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize ContractSectionAttachments}" />
								<VerticalStackLayout Grid.Column="1"
													 BindableLayout.ItemsSource="{Binding AttachmentNames}"
													 Spacing="2">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="x:String">
											<Label LineBreakMode="TailTruncation"
												   Style="{StaticResource RowValueLabel}"
												   Text="{Binding .}" />
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</Grid>

							<!-- Technical details, collapsed -->
							<controls:TemplatedButton Command="{Binding ToggleTechnicalDetailsCommand}">
								<Grid ColumnDefinitions="*, auto"
									  Style="{StaticResource RowGrid}">
									<Label Grid.Column="0"
										   FontSize="{StaticResource FontSizeMd}"
										   Style="{StaticResource RowKeyLabel}"
										   Text="{l:Localize ContractSectionTechnicalDetails}"
										   TextColor="{DynamicResource ContentPrimaryWL}" />
									<Label Grid.Column="1"
										   IsVisible="{Binding IsTechnicalDetailsExpanded, Converter={mct:InvertedBoolConverter}}"
										   Style="{StaticResource RowActionLabel}"
										   Text="{l:Localize ContractShowDetails}" />
									<Label Grid.Column="1"
										   IsVisible="{Binding IsTechnicalDetailsExpanded}"
										   Style="{StaticResource RowActionLabel}"
										   Text="{l:Localize ContractHideDetails}" />
								</Grid>
							</controls:TemplatedButton>

							<VerticalStackLayout Padding="16,12"
												 Spacing="{DynamicResource SmallSpacing}"
												 IsVisible="{Binding IsTechnicalDetailsExpanded}"
												 BackgroundColor="{DynamicResource SurfaceElevation1WL}">
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="12">
									<Label Style="{StaticResource RowKeyLabel}"
										   Text="{l:Localize ContractId}" />
									<Label controls:ButtonRole.IsButton="True" Grid.Column="1"
										   LineBreakMode="CharacterWrap"
										   Style="{StaticResource RowValueLabel}"
										   Text="{Binding Contract.ContractId}">
										<Label.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding CopyCommand}"
																  CommandParameter="{Binding Contract.ContractId}" />
										</Label.GestureRecognizers>
									</Label>
								</Grid>

								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="12">
									<Label Style="{StaticResource RowKeyLabel}"
										   Text="{l:Localize Visibility}" />
									<Label Grid.Column="1"
										   Style="{StaticResource RowValueLabel}"
										   Text="{Binding Visibility}" />
								</Grid>

								<Image controls:ButtonRole.IsButton="True" x:Name="QrCode"
									   HorizontalOptions="Center"
									   HeightRequest="{Binding QrCodeHeight}"
									   WidthRequest="{Binding QrCodeWidth}"
									   IsVisible="{Binding HasQrCode}"
									   Source="{Binding QrCode}">
									<Image.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding CopyCommand}"
															  CommandParameter="{Binding Contract.ContractId}" />
									</Image.GestureRecognizers>
								</Image>

								<views:OverviewItemButton BottomLabelText="{l:Localize ServerSignatureButtonDescription}"
														  Command="{Binding OpenServerSignatureCommand}"
														  IconData="{x:Static ui:Geometries.ContractIconPath}"
														  TopLabelText="{l:Localize ServerSignatureButtonTitle}" />

								<Label IsVisible="{Binding HasMachineReadableXml}"
									   Style="{StaticResource RowKeyLabel}"
									   Text="{l:Localize MachineReadableText}" />
								<!-- Read-only, so the text can be selected and copied -->
								<Editor AutoSize="TextChanges"
										IsVisible="{Binding HasMachineReadableXml}"
										FontSize="{StaticResource FontSizeSm}"
										IsReadOnly="True"
										Text="{Binding MachineReadableXml}"
										TextColor="{DynamicResource ContentPrimaryWL}" />
							</VerticalStackLayout>

							<!-- What else can be done with the contract -->
							<controls:TemplatedButton IsVisible="{Binding CanWithdrawContract}"
													  Command="{Binding WithdrawContractCommand}">
								<Grid Style="{StaticResource RowGrid}">
									<Label Style="{StaticResource RowActionLabel}"
										   Text="{l:Localize WithdrawContract}"
										   TextColor="{DynamicResource TnPDangerContentWL}" />
								</Grid>
							</controls:TemplatedButton>
							<controls:TemplatedButton IsVisible="{Binding CanDeleteContract}"
													  Command="{Binding DeleteContractCommand}">
								<Grid Style="{StaticResource RowGrid}">
									<Label Style="{StaticResource RowActionLabel}"
										   Text="{l:Localize DeleteContract}"
										   TextColor="{DynamicResource TnPDangerContentWL}" />
								</Grid>
							</controls:TemplatedButton>
							<controls:TemplatedButton IsVisible="{Binding CanRemoveFromList}"
													  Command="{Binding RemoveFromListCommand}">
								<Grid Style="{StaticResource RowGrid}">
									<Label Style="{StaticResource RowActionLabel}"
										   Text="{l:Localize RemoveFromList}"
										   TextColor="{DynamicResource ContentPrimaryWL}" />
								</Grid>
							</controls:TemplatedButton>
						</VerticalStackLayout>
					</Border>

				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>

		<!-- One main action at the bottom -->
		<Grid Grid.Row="1">
			<!-- While the contract that was just created is being completed -->
			<Border IsVisible="{Binding IsAwaitingPostCreateCompletion}"
					Style="{DynamicResource BottomBarBorder}">
				<ActivityIndicator VerticalOptions="Center"
								   HorizontalOptions="Center"
								   Margin="{DynamicResource SmallMargins}"
								   IsRunning="True" />
			</Border>

			<!-- The user can sign: review and sign, or decline -->
			<Border IsVisible="{Binding CanShowSignBar}"
					Style="{DynamicResource BottomBarBorder}">
				<VerticalStackLayout Padding="{DynamicResource SmallMargins}"
									 Spacing="4">
					<controls:TextButton Command="{Binding GoToSignCommand}"
										 Style="{DynamicResource FilledTextButton}"
										 LabelData="{Binding PrimaryActionText}" />
					<controls:TextButton IsVisible="{Binding CanDeclineInvitation}"
										 Command="{Binding DeclineInvitationCommand}"
										 Style="{DynamicResource TransparentTextButton}"
										 LabelData="{l:Localize Decline}" />
				</VerticalStackLayout>
			</Border>

			<!-- Others still have to sign: invite them -->
			<Border IsVisible="{Binding CanShowInviteBar}"
					Style="{DynamicResource BottomBarBorder}">
				<controls:TextButton Margin="{DynamicResource SmallMargins}"
									 Command="{Binding InvitePartsCommand}"
									 Style="{DynamicResource OutlinedTextButton}"
									 LabelData="{l:Localize InviteToSign}" />
			</Border>
		</Grid>
	</Grid>
</views:BaseViewContractView>
