<?xml version="1.0" encoding="utf-8"?>
<views:BaseViewContractView x:Name="ThisPage"
									 x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.OverviewView"
									 x:DataType="base:ViewContractViewModel"
									 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
									 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
									 xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
									 xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
									 xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
									 xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Registration.Views"
									 xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
									 xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views"
									 xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract"
									 xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
									 xmlns:contract="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts"
									 xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel">

	<ContentView.Resources>
		<ResourceDictionary>
			<Style x:Key="ItemTitleLabel"
					 TargetType="Label"
					 BaseResourceKey="BoldItemTitleLabel">
				<Setter Property="TextColor"
						  Value="{DynamicResource ContentPrimaryWL}" />
				<Setter Property="FontSize"
						  Value="{StaticResource FontSizeMd}" />
				<Setter Property="FontFamily"
						  Value="SpaceGroteskSemiBold" />
				<Setter Property="LineBreakMode"
						  Value="WordWrap" />
				<Setter Property="VerticalTextAlignment"
						  Value="Center" />
				<Setter Property="VerticalOptions"
						  Value="Start" />
				<Setter Property="HorizontalTextAlignment"
						  Value="Start" />
			</Style>

			<Style x:Key="ItemValueLabel"
					 TargetType="Label">
				<Setter Property="TextColor"
						  Value="{DynamicResource ContentPrimaryWL}" />
				<Setter Property="FontSize"
						  Value="{StaticResource FontSizeMd}" />
				<Setter Property="FontFamily"
						  Value="HaasGroteskRegular" />
				<Setter Property="LineBreakMode"
						  Value="WordWrap" />
				<Setter Property="VerticalTextAlignment"
						  Value="Center" />
				<Setter Property="HorizontalTextAlignment"
						  Value="End" />
				<Setter Property="HorizontalOptions"
						  Value="End" />
			</Style>

			<Style x:Key="ChipBorder"
				   TargetType="Border">
				<Setter Property="StrokeShape"
						Value="RoundRectangle 12" />
				<Setter Property="StrokeThickness"
						Value="0" />
				<Setter Property="Padding"
						Value="8,2" />
				<Setter Property="VerticalOptions"
						Value="Center" />
			</Style>

		</ResourceDictionary>
	</ContentView.Resources>

	<Grid RowDefinitions="*, auto"
			ColumnDefinitions="*">
		<RefreshView IsRefreshing="{Binding IsRefreshing}"
					 Command="{Binding RefreshContractCommand}">
			<ScrollView Grid.Row="0"
						Padding="{DynamicResource MediumBottomMargins}">
				<VerticalStackLayout Padding="{DynamicResource MediumLeftRightMargins}"
									 Spacing="{DynamicResource MediumSpacing}">
					<!-- Status banner: deleted on the server, or no access -->
					<Border Style="{DynamicResource AccentInfoBorder}"
							BackgroundColor="{DynamicResource TnPDangerbgWL}"
							Padding="{DynamicResource SmallMargins}"
							IsVisible="{Binding HasStatusBanner}">
						<Grid ColumnDefinitions="auto, *"
							  RowDefinitions="auto, auto, auto, auto"
							  RowSpacing="{DynamicResource SmallSpacing}">
							<Path Grid.Column="0"
								  Grid.Row="0"
								  HorizontalOptions="Center"
								  VerticalOptions="Start"
								  Data="{x:Static ui:Geometries.InfoCirclePath}"
								  HeightRequest="16"
								  WidthRequest="16"
								  Aspect="Uniform"
								  Fill="{DynamicResource TnPDangerContentWL}" />
							<Label Grid.Column="1"
								   Grid.Row="0"
								   Style="{DynamicResource AccentInfoLabel}"
								   TextColor="{DynamicResource TnPDangerContentWL}"
								   Margin="{DynamicResource SmallLeftMargins}"
								   Text="{l:Localize ContractDeletedBanner}"
								   IsVisible="{Binding IsDeletedOnServer}" />
							<Label Grid.Column="1"
								   Grid.Row="1"
								   Style="{DynamicResource AccentInfoLabel}"
								   TextColor="{DynamicResource TnPDangerContentWL}"
								   Margin="{DynamicResource SmallLeftMargins}"
								   Text="{l:Localize ContractAccessDeniedBanner}"
								   IsVisible="{Binding IsAccessDenied}" />
							<Label Grid.Column="1"
								   Grid.Row="2"
								   Style="{DynamicResource AccentInfoLabel}"
								   TextColor="{DynamicResource TnPDangerContentWL}"
								   Margin="{DynamicResource SmallLeftMargins}"
								   Text="{l:Localize ContractAccessAskSender}"
								   IsVisible="{Binding ShowAskSenderHint}" />
							<controls:TextButton Grid.Column="0"
												 Grid.ColumnSpan="2"
												 Grid.Row="3"
												 LabelData="{l:Localize AskForAccess}"
												 Style="{DynamicResource OutlinedTextButton}"
												 Command="{Binding RequestAccessCommand}"
												 IsVisible="{Binding ShowRequestAccess}" />
						</Grid>
					</Border>

					<!-- Header: the state, and the user's invitation -->
					<Border Style="{DynamicResource BorderSet}"
							Margin="0">
						<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
							<Grid ColumnDefinitions="auto, *"
								  ColumnSpacing="{DynamicResource MediumSpacing}">
								<Label Grid.Column="0"
									   Text="{l:Localize Status}"
									   Style="{DynamicResource ItemTitleLabel}" />
								<!-- One state chip, colored by state -->
								<Border Grid.Column="1"
										Style="{StaticResource ChipBorder}"
										HorizontalOptions="End"
										BackgroundColor="{DynamicResource TnPInfobgWL}">
									<Border.Triggers>
										<DataTrigger TargetType="Border" Binding="{Binding IsStateSuccess}" Value="True">
											<Setter Property="BackgroundColor" Value="{DynamicResource TnPSuccessbgWL}" />
										</DataTrigger>
										<DataTrigger TargetType="Border" Binding="{Binding IsStateDanger}" Value="True">
											<Setter Property="BackgroundColor" Value="{DynamicResource TnPDangerbgWL}" />
										</DataTrigger>
									</Border.Triggers>
									<Label Text="{Binding StateText}"
										   Style="{DynamicResource ItemValueLabel}"
										   TextColor="{DynamicResource TnPInfoContentWL}">
										<Label.Triggers>
											<DataTrigger TargetType="Label" Binding="{Binding IsStateSuccess}" Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPSuccessContentWL}" />
											</DataTrigger>
											<DataTrigger TargetType="Label" Binding="{Binding IsStateDanger}" Value="True">
												<Setter Property="TextColor" Value="{DynamicResource TnPDangerContentWL}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>
							</Grid>

							<Border Style="{DynamicResource AccentInfoBorder}"
									Padding="{DynamicResource SmallMargins}"
									IsVisible="{Binding IsProposal}">
								<Grid ColumnDefinitions="auto, *">
									<Path Grid.Column="0"
										  HorizontalOptions="Center"
										  VerticalOptions="Center"
										  Data="{x:Static ui:Geometries.InfoCirclePath}"
										  HeightRequest="16"
										  WidthRequest="16"
										  Aspect="Uniform"
										  Fill="{DynamicResource TnPInfoContentWL}" />

									<controls:ConditionView Condition="{Binding ProposalRole, Converter={mct:IsStringNullOrEmptyConverter}}" Grid.Column="1">
										<controls:ConditionView.True>
											<Label 
												   Style="{DynamicResource AccentInfoLabel}"
												   VerticalOptions="Start"
												   VerticalTextAlignment="Start"
												   Margin="{DynamicResource SmallLeftMargins}"
												   Text="{l:Localize InvitationToSign}" />
										</controls:ConditionView.True>
										<controls:ConditionView.False>
											<Label 
												   Style="{DynamicResource AccentInfoLabel}"
												   VerticalOptions="Start"
												   VerticalTextAlignment="Start"
												   Margin="{DynamicResource SmallLeftMargins}"
												   Text="{l:Localize InvitationToSignFormat, Arg={Binding ProposalRole}}"/>
										</controls:ConditionView.False>
									</controls:ConditionView>
								</Grid>
							</Border>
							<Border Style="{DynamicResource BorderSubSet}"
									IsVisible="{Binding IsProposal}"
									Margin="0">
								<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
									<Grid ColumnDefinitions="auto, *"
										  ColumnSpacing="{DynamicResource MediumSpacing}">
										<Label Grid.Column="0"
											   Text="{l:Localize From}"
											   Style="{DynamicResource ItemTitleLabel}" />
										<Label Grid.Column="1"
											   Text="{Binding Path=ProposalFriendlyName,Converter={converters:HyphenIfEmpty}}"
											   Style="{DynamicResource ItemValueLabel}" />
									</Grid>

									<Grid ColumnDefinitions="auto, *">
										<Label Grid.Column="0"
											   Text="{l:Localize Message}"
											   Style="{DynamicResource ItemTitleLabel}" />
										<Label Grid.Column="1"
											   Text="{Binding Path=ProposalMessage,Converter={converters:HyphenIfEmpty}}"
											   Style="{DynamicResource ItemValueLabel}" />
									</Grid>

									<controls:TextButton LabelData="{l:Localize DeclineInvitation}"
														 Style="{DynamicResource OutlinedTextButton}"
														 Command="{Binding DeclineInvitationCommand}"
														 IsVisible="{Binding CanDeclineInvitation}"
														 Margin="{DynamicResource SmallTopMargins}" />
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>
					</Border>

					<!-- Parties: each role with its parts, the user's role marked, and the signatures collected -->
					<Border Style="{DynamicResource BorderSet}"
							Margin="0">
						<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
							<Label Text="{l:Localize ContractSectionParties}"
								   Style="{DynamicResource SectionTitleLabel}" />
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding Contract.Roles}"
												 Spacing="{DynamicResource SmallSpacing}">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="objectModel:ObservableRole">
										<Border Style="{DynamicResource BorderSubSet}"
												Margin="0">
											<VerticalStackLayout Spacing="4">
												<Grid ColumnDefinitions="*, auto"
													  ColumnSpacing="{DynamicResource SmallSpacing}">
													<Label Grid.Column="0"
														   Text="{Binding Name}"
														   Style="{DynamicResource ItemTitleLabel}" />
													<Border Grid.Column="1"
															Style="{StaticResource ChipBorder}"
															BackgroundColor="{DynamicResource TnPInfobgWL}"
															IsVisible="{Binding IsMyRole}">
														<Label Text="{l:Localize YourRole}"
															   FontSize="{StaticResource FontSizeSm}"
															   TextColor="{DynamicResource TnPInfoContentWL}" />
													</Border>
												</Grid>
												<Label Text="{Binding SignaturesText}"
													   Style="{DynamicResource ItemDescriptionLabel}" />
												<VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}"
																	 Spacing="2">
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="objectModel:ObservablePart">
															<VerticalStackLayout Spacing="2">
																<Grid ColumnDefinitions="*, auto"
																	  ColumnSpacing="{DynamicResource SmallSpacing}">
																	<Label Grid.Column="0"
																		   Text="{Binding FriendlyName}"
																		   Style="{DynamicResource ItemValueLabel}"
																		   HorizontalOptions="Start"
																		   HorizontalTextAlignment="Start" />
																	<Label Grid.Column="1"
																		   Text="{l:Localize Signed}"
																		   Style="{DynamicResource ItemDescriptionLabel}"
																		   TextColor="{DynamicResource TnPSuccessContentWL}"
																		   VerticalOptions="Center"
																		   IsVisible="{Binding HasSigned}" />
																	<Label Grid.Column="1"
																		   Text="{l:Localize PendingSignature}"
																		   Style="{DynamicResource ItemDescriptionLabel}"
																		   TextColor="{DynamicResource BrandColorsNeuroOrange}"
																		   VerticalOptions="Center"
																		   IsVisible="{Binding HasSigned, Converter={mct:InvertedBoolConverter}}" />
																</Grid>
																<!-- Until a part shows their identity, the app has no address to send them the invitation. -->
																<VerticalStackLayout Spacing="2"
																					 IsVisible="{Binding CanManageParts, Source={RelativeSource AncestorType={x:Type base:ViewContractViewModel}}, x:DataType=base:ViewContractViewModel}">
																	<Label Text="{l:Localize IDRequestSent}"
																		   Style="{DynamicResource ItemDescriptionLabel}"
																		   TextColor="{DynamicResource TnPWarningContentWL}"
																		   HorizontalOptions="Start"
																		   IsVisible="{Binding HasSentPetition}" />
																	<Label Text="{l:Localize IdentityDeclined}"
																		   Style="{DynamicResource ItemDescriptionLabel}"
																		   TextColor="{DynamicResource TnPDangerContentWL}"
																		   HorizontalOptions="Start"
																		   IsVisible="{Binding IsIdentityDeclined}" />
																	<Grid ColumnDefinitions="*, auto"
																		  ColumnSpacing="{DynamicResource SmallSpacing}"
																		  IsVisible="{Binding CanRequestIdentityToInvite}">
																		<Label Grid.Column="0"
																			   Text="{l:Localize InviteRequestIdentityHint}"
																			   Style="{DynamicResource ItemDescriptionLabel}"
																			   HorizontalOptions="Start"
																			   HorizontalTextAlignment="Start"
																			   VerticalOptions="Center" />
																		<controls:TextButton Grid.Column="1"
																							 LabelData="{l:Localize RequestIdentity}"
																							 Style="{DynamicResource TransparentTextButton}"
																							 Command="{Binding RequestIdentityCommand}" />
																	</Grid>
																</VerticalStackLayout>
															</VerticalStackLayout>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</VerticalStackLayout>
												<Label Text="{l:Localize None}"
													   Style="{DynamicResource ItemDescriptionLabel}"
													   IsVisible="{Binding HasNoParts}" />
											</VerticalStackLayout>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
							<controls:TextButton LabelData="{l:Localize InviteToSign}"
												 Style="{DynamicResource FilledTextButton}"
												 Command="{Binding Path=InvitePartsCommand}"
												 IsVisible="{Binding Path=CanInviteParts}" />
						</VerticalStackLayout>
					</Border>

					<!-- Dates, in local time -->
					<Border Style="{DynamicResource BorderSet}"
							Margin="0">
						<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
							<Label Text="{l:Localize ContractSectionDates}"
								   Style="{DynamicResource SectionTitleLabel}" />
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasSigningWindow}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractSigningWindow}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding SigningWindowText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasValidFrom}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractValidFrom}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding ValidFromText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasValidTo}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractValidTo}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding ValidToText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasDuration}">
									<Label Grid.Column="0"
										   Text="{l:Localize Duration}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding DurationText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasArchivedUntil}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractArchivedUntil}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding ArchivedUntilText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasArchiveRequired}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractArchiveRequired}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding ArchiveRequiredText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasArchiveOptional}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractArchiveOptional}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding ArchiveOptionalText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}">
									<Label Grid.Column="0"
										   Text="{l:Localize Created}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding CreatedText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}"
									  IsVisible="{Binding HasUpdated}">
									<Label Grid.Column="0"
										   Text="{l:Localize Updated}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding UpdatedText}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>
						</VerticalStackLayout>
					</Border>

					<!-- The template the contract was created from -->
					<Border Style="{DynamicResource BorderSet}"
							Margin="0"
							IsVisible="{Binding HasTemplate}">
						<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
							<Label Text="{l:Localize ContractSectionTemplate}"
								   Style="{DynamicResource SectionTitleLabel}" />
							<controls:TemplatedButton Command="{Binding OpenContractCommand}"
													  CommandParameter="{Binding TemplateId}">
								<Label Text="{Binding TemplateId}"
									   Style="{DynamicResource ClickableValueLabel}"
									   LineBreakMode="CharacterWrap" />
							</controls:TemplatedButton>
						</VerticalStackLayout>
					</Border>

					<!-- Attachments. Opening and verifying them comes with the attachments section (R30). -->
					<Border Style="{DynamicResource BorderSet}"
							Margin="0"
							IsVisible="{Binding HasAttachments}">
						<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
							<Label Text="{l:Localize ContractSectionAttachments}"
								   Style="{DynamicResource SectionTitleLabel}" />
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachmentNames}"
												 Spacing="2">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Label Text="{Binding .}"
											   Style="{DynamicResource ItemDescriptionLabel}"
											   LineBreakMode="TailTruncation" />
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>

					<views:OverviewItemButton IconData="{x:Static ui:Geometries.ContractPath}"
											  TopLabelText="{l:Localize ReviewContractTitle}"
											  BottomLabelText="{l:Localize ReviewContractDescription2}"
											  Command="{Binding GoToReviewCommand}" />

					<!-- Roles Button -->
					<views:OverviewItemButton IconData="{x:Static ui:Geometries.RolesPath}"
											  TopLabelText="{l:Localize ViewRolesTitle}"
											  BottomLabelText="{l:Localize ViewRolesDescription}"
											  Command="{Binding GoToRolesCommand}" />

					<!-- Parameters Button -->
					<views:OverviewItemButton IconData="{x:Static ui:Geometries.ContractEditPath}"
											  TopLabelText="{l:Localize ViewParametersTitle}"
											  BottomLabelText="{l:Localize ViewParametersDescription}"
											  Command="{Binding GoToParametersCommand}" />

					<!-- Actions -->
					<controls:TextButton LabelData="{l:Localize WithdrawContract}"
										 Style="{DynamicResource FilledTextButtonNoRoundedCorners}"
										 Command="{Binding Path=WithdrawContractCommand}"
										 IsVisible="{Binding Path=CanWithdrawContract}"
										 Margin="{DynamicResource SmallTopBottomMargins}" />
					<controls:TextButton LabelData="{l:Localize DeleteContract}"
										 Style="{DynamicResource FilledTextButtonDecline}"
										 Command="{Binding Path=DeleteContractCommand}"
										 IsVisible="{Binding Path=CanDeleteContract}"
										 Margin="{DynamicResource SmallBottomMargins}" />
					<controls:TextButton LabelData="{l:Localize RemoveFromList}"
										 Style="{DynamicResource OutlinedTextButton}"
										 Command="{Binding Path=RemoveFromListCommand}"
										 IsVisible="{Binding Path=CanRemoveFromList}"
										 Margin="{DynamicResource SmallBottomMargins}" />

					<!-- Tokens the contract created, shown for signed token-creation contracts -->
					<views:ContractTokensView ContractId="{Binding CreatedTokensContractId}" />

					<!-- Technical details, collapsed -->
					<Border Style="{DynamicResource BorderSet}"
							Margin="0">
						<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
							<controls:TemplatedButton Command="{Binding ToggleTechnicalDetailsCommand}">
								<Grid ColumnDefinitions="*, auto">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractSectionTechnicalDetails}"
										   Style="{DynamicResource SectionTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{l:Localize ContractShowDetails}"
										   Style="{DynamicResource ClickableValueLabel}"
										   VerticalOptions="Center"
										   IsVisible="{Binding IsTechnicalDetailsExpanded, Converter={mct:InvertedBoolConverter}}" />
									<Label Grid.Column="1"
										   Text="{l:Localize ContractHideDetails}"
										   Style="{DynamicResource ClickableValueLabel}"
										   VerticalOptions="Center"
										   IsVisible="{Binding IsTechnicalDetailsExpanded}" />
								</Grid>
							</controls:TemplatedButton>

							<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}"
												 IsVisible="{Binding IsTechnicalDetailsExpanded}">
								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}">
									<Label Grid.Column="0"
										   Text="{l:Localize ContractId}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding Contract.ContractId}"
										   Style="{DynamicResource ItemValueLabel}"
										   LineBreakMode="CharacterWrap">
										<Label.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding CopyCommand}"
																  CommandParameter="{Binding Contract.ContractId}" />
										</Label.GestureRecognizers>
									</Label>
								</Grid>

								<Grid ColumnDefinitions="auto, *"
									  ColumnSpacing="{DynamicResource MediumSpacing}">
									<Label Grid.Column="0"
										   Text="{l:Localize Visibility}"
										   Style="{DynamicResource ItemTitleLabel}" />
									<Label Grid.Column="1"
										   Text="{Binding Visibility}"
										   Style="{DynamicResource ItemValueLabel}" />
								</Grid>

								<Image x:Name="QrCode"
									   Source="{Binding QrCode}"
									   IsVisible="{Binding HasQrCode}"
									   WidthRequest="{Binding QrCodeWidth}"
									   HeightRequest="{Binding QrCodeHeight}"
									   HorizontalOptions="Center">
									<Image.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding CopyCommand}"
															  CommandParameter="{Binding Contract.ContractId}" />
									</Image.GestureRecognizers>
								</Image>

								<views:OverviewItemButton IconData="{x:Static ui:Geometries.ContractIconPath}"
														  TopLabelText="{l:Localize ServerSignatureButtonTitle}"
														  BottomLabelText="{l:Localize ServerSignatureButtonDescription}"
														  Command="{Binding OpenServerSignatureCommand}" />

								<Label Text="{l:Localize MachineReadableText}"
									   Style="{DynamicResource ItemTitleLabel}"
									   IsVisible="{Binding HasMachineReadableXml}" />
								<!-- Read-only, so the text can be selected and copied -->
								<Editor Text="{Binding MachineReadableXml}"
										IsReadOnly="True"
										AutoSize="TextChanges"
										FontSize="{StaticResource FontSizeSm}"
										TextColor="{DynamicResource ContentPrimaryWL}"
										IsVisible="{Binding HasMachineReadableXml}" />
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>

				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>

		<!-- BOTTOM BAR -->
		<Grid Grid.Row="1" RowDefinitions="*">
			<!-- Loading bottom bar while awaiting post-create completion -->
			<Border Style="{DynamicResource BottomBarBorder}" IsVisible="{Binding IsAwaitingPostCreateCompletion}">
				<Grid HorizontalOptions="Fill" VerticalOptions="Center" Padding="{DynamicResource SmallMargins}">
					<ActivityIndicator IsRunning="True" IsVisible="True" VerticalOptions="Center" HorizontalOptions="Center" />
				</Grid>
			</Border>

			<!-- Sign bottom bar shown only when signable and not awaiting -->
			<Border Style="{DynamicResource BottomBarBorder}" IsVisible="{Binding CanShowSignBar}">
				<Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="{DynamicResource SmallSpacing}" Padding="{DynamicResource SmallMargins}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<controls:TextButton Style="{DynamicResource TransparentTextButton}" Grid.Column="0" LabelData="{l:Localize Back}" Command="{Binding BackCommand}" />
					<controls:TextButton Style="{DynamicResource FilledTextButton}" Grid.Column="1" LabelData="{l:Localize Sign}" Command="{Binding GoToSignCommand}" />
				</Grid>
			</Border>
		</Grid>

	</Grid>
</views:BaseViewContractView>
