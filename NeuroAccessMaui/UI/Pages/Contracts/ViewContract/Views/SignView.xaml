<?xml version="1.0" encoding="utf-8" ?>
<views:BaseViewContractView
	x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.SignView"
	x:DataType="base:ViewContractViewModel"
	x:Name="ThisPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract"
	xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
	xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
	xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
	xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views">

	<Grid RowDefinitions="*,Auto">
		<CollectionView Grid.Row="0" ItemsSource="{Binding SignableRoles}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems" Margin="16,4,16,20">
			<CollectionView.Header>
				<VerticalStackLayout Spacing="14" Margin="0,0,0,16">
					<VerticalStackLayout Spacing="4">
						<Label SemanticProperties.HeadingLevel="Level2" Style="{DynamicResource SectionTitleLabel}" Text="{l:Localize Sign}" />
						<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{l:Localize SelectYourRoleInThisContract}" TextColor="{DynamicResource ContentSecondaryWL}" />
					</VerticalStackLayout>
					<Border Margin="0" Padding="16" Style="{DynamicResource BorderSet}">
						<VerticalStackLayout Spacing="8">
							<Label FontAttributes="Bold" Text="{l:Localize SelectYourRole}" TextColor="{DynamicResource ContentPrimaryWL}" />
							<controls:CompositePicker Style="{DynamicResource RegularCompositePicker}" Placeholder="{l:Localize SelectYourRoleInThisContract}" ItemsSource="{Binding SignableRoles}" SelectedItem="{Binding SelectedRole}">
								<controls:CompositePicker.ItemDisplayBinding x:DataType="objectModel:ObservableRole">
									<Binding Path="Name" x:DataType="objectModel:ObservableRole" />
								</controls:CompositePicker.ItemDisplayBinding>
							</controls:CompositePicker>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>
			</CollectionView.Header>
			<CollectionView.ItemsLayout>
				<LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
			</CollectionView.ItemsLayout>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="objectModel:ObservableRole">
					<Border Margin="0" Padding="16" Style="{DynamicResource BorderSet}">
						<VerticalStackLayout Spacing="12">
							<VerticalStackLayout Spacing="2">
								<Label FontAttributes="Bold" FontSize="18" Text="{Binding Name}" TextColor="{DynamicResource ContentPrimaryWL}" />
								<Label Style="{DynamicResource ItemDescriptionLabel}" Text="{Binding Description}" TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="8">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="objectModel:ObservablePart">
										<Border BackgroundColor="{DynamicResource SurfaceElevation2WL}" Padding="12" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
												<Border Grid.RowSpan="2" BackgroundColor="{DynamicResource SurfaceElevation1WL}" HeightRequest="40" Padding="9" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10" WidthRequest="40">
													<controls:SvgView InputTransparent="True" Source="person.svg" TintColor="{DynamicResource ContentPrimaryWL}" />
												</Border>
												<controls:TemplatedButton Grid.Column="1" Command="{Binding OpenIdentityCommand}" HorizontalOptions="Start" Padding="0">
													<Label FontAttributes="Bold" Text="{Binding FriendlyName}" TextColor="{DynamicResource ButtonAccessTertiaryContentWL}" />
												</controls:TemplatedButton>
												<controls:StatusPill Grid.Row="1" Grid.Column="1" HorizontalOptions="Start" IsVisible="{Binding HasIdentity, Converter={StaticResource InvertedBoolConverter}}" Text="{l:Localize IDRequestSent}" Tone="Warning" />
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
							<Border BackgroundColor="{DynamicResource SurfaceElevation2WL}" IsVisible="{Binding HasReachedMaxCount, Converter={StaticResource InvertedBoolConverter}}" Padding="12" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
								<Label HorizontalTextAlignment="Center" Style="{DynamicResource ItemDescriptionLabel}" Text="{l:Localize None}" TextColor="{DynamicResource ContentSecondaryWL}" />
							</Border>
						</VerticalStackLayout>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Border Grid.Row="1" Style="{DynamicResource BottomBarBorder2}">
			<Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,10" RowDefinitions="Auto,Auto" RowSpacing="8">
				<Border Grid.ColumnSpan="2" BackgroundColor="{DynamicResource SurfaceElevation1WL}" Padding="10,8" Stroke="{DynamicResource SurfaceStrokeWL}" StrokeShape="RoundRectangle 10">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
						<CheckBox IsChecked="{Binding IsContractOk}" Color="{DynamicResource ContentPrimaryWL}" />
						<Label Grid.Column="1" Text="{l:Localize IHaveReadAndUnderstoodTheContract}" Style="{DynamicResource BottomBarLabel}" VerticalTextAlignment="Center" />
					</Grid>
				</Border>
				<controls:TextButton Grid.Row="1" LabelData="{l:Localize Back}" Command="{Binding BackCommand}" Style="{DynamicResource SecondaryButton}" />
				<controls:TextButton Grid.Row="1" Grid.Column="1" LabelData="{l:Localize Sign}" Command="{Binding SignCommand}" IsEnabled="{Binding ReadyToSign}" Style="{DynamicResource PrimaryButton}" />
			</Grid>
		</Border>
	</Grid>
</views:BaseViewContractView>
