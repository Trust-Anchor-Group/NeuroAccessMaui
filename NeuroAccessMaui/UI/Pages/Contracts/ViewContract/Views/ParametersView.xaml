<?xml version="1.0" encoding="utf-8"?>

<views:BaseViewContractView x:Name="ThisPage"
							x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.ParametersView"
							x:DataType="base:ViewContractViewModel"
							xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views"
							xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract"
							xmlns:contracts="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts"
							xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
							xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							xmlns:ui="clr-namespace:NeuroAccessMaui.UI">

	<ScrollView>
		<VerticalStackLayout Padding="16,0,16,24"
							 Spacing="8">
			<Label Text="{l:Localize ViewParametersTitle}"
				   FontFamily="SpaceGroteskSemiBold"
				   FontSize="20"
				   TextColor="{DynamicResource ContentPrimaryWL}"
				   Margin="4,0,4,4"
				   SemanticProperties.HeadingLevel="Level1" />

			<Label Text="{l:Localize ContractHasNoParameters}"
				   Style="{DynamicResource InfoLabel}"
				   HorizontalOptions="Center"
				   IsVisible="{Binding HasParameters, Converter={StaticResource InvertedBoolConverter}}" />

			<!-- The values, then the calculated ones, the ones from IDs and the rest, each group in one card -->
			<VerticalStackLayout Spacing="8"
								 BindableLayout.ItemsSource="{Binding ParameterGroups}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="contracts:ParameterGroup">
						<VerticalStackLayout Spacing="6">
							<HorizontalStackLayout Spacing="6"
												   Margin="4,8,4,0"
												   IsVisible="{Binding HasTitle}">
								<Path Data="{Binding Icon}"
									  Fill="{DynamicResource ContentSecondaryWL}"
									  Aspect="Uniform"
									  WidthRequest="14"
									  HeightRequest="14"
									  VerticalOptions="Center"
									  IsVisible="{Binding HasIcon}" />
								<Label Text="{Binding Title}"
									   FontFamily="HaasGroteskMedium"
									   FontSize="13"
									   TextColor="{DynamicResource ContentSecondaryWL}"
									   VerticalOptions="Center"
									   SemanticProperties.HeadingLevel="Level2" />
							</HorizontalStackLayout>

							<!-- The 1 px gaps between rows show the card's divider colour as lines -->
							<Border Style="{DynamicResource ListCardBorder}">
								<VerticalStackLayout Spacing="1"
													 BackgroundColor="{DynamicResource SurfaceDividerWL}"
													 BindableLayout.ItemsSource="{Binding Items}"
													 BindableLayout.ItemTemplateSelector="{StaticResource ParameterRowSelector}" />
							</Border>
						</VerticalStackLayout>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>
</views:BaseViewContractView>
