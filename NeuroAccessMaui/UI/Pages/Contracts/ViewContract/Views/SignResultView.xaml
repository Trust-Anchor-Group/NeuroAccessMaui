<?xml version="1.0" encoding="utf-8"?>
<views:BaseViewContractView x:Name="ThisPage"
							x:Class="NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views.SignResultView"
							x:DataType="base:ViewContractViewModel"
							xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
							xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
							xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
							xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
							xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract"
							xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
							xmlns:views="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ViewContract.Views">
	<Grid RowDefinitions="*, auto">
		<ScrollView Grid.Row="0">
			<VerticalStackLayout VerticalOptions="Center"
								 Padding="24"
								 Spacing="12">
				<!-- A check when signed, a cross when not -->
				<Border HorizontalOptions="Center"
						Padding="0"
						HeightRequest="72"
						WidthRequest="72"
						IsVisible="{Binding IsSignSuccess}"
						BackgroundColor="{DynamicResource TnPSuccessbgWL}"
						StrokeShape="RoundRectangle 36"
						StrokeThickness="0">
					<Path VerticalOptions="Center"
						  HorizontalOptions="Center"
						  HeightRequest="30"
						  WidthRequest="30"
						  Aspect="Uniform"
						  Data="{x:Static ui:Geometries.SuccessCheckmarkPath}"
						  Fill="{DynamicResource TnPSuccessContentWL}" />
				</Border>
				<Border HorizontalOptions="Center"
						Padding="0"
						HeightRequest="72"
						WidthRequest="72"
						IsVisible="{Binding IsSignFailure}"
						BackgroundColor="{DynamicResource TnPDangerbgWL}"
						StrokeShape="RoundRectangle 36"
						StrokeThickness="0">
					<Path VerticalOptions="Center"
						  HorizontalOptions="Center"
						  HeightRequest="30"
						  WidthRequest="30"
						  Aspect="Uniform"
						  Data="{x:Static ui:Geometries.ErrorPath}"
						  Fill="{DynamicResource TnPDangerContentWL}" />
				</Border>

				<Label HorizontalTextAlignment="Center"
					   FontFamily="SpaceGroteskBold"
					   FontSize="{StaticResource FontSize4xl}"
					   LineBreakMode="WordWrap"
					   SemanticProperties.HeadingLevel="Level1"
					   Text="{Binding SignResultTitle}"
					   TextColor="{DynamicResource ContentPrimaryWL}" />
				<Label HorizontalTextAlignment="Center"
					   FontSize="{StaticResource FontSizeMd}"
					   LineBreakMode="WordWrap"
					   Text="{Binding SignResultText}"
					   TextColor="{DynamicResource ContentSecondaryWL}" />

				<!-- How far signing has come, while others still have to sign -->
				<Border Margin="0,8,0,0"
						Padding="16,12"
						IsVisible="{Binding HasProgress}"
						Style="{DynamicResource ListCardBorder}">
					<Grid ColumnDefinitions="*, auto"
						  ColumnSpacing="10">
						<ProgressBar Grid.Column="0"
									 VerticalOptions="Center"
									 Progress="{Binding ProgressValue}"
									 ProgressColor="{DynamicResource ContentAccessWL}" />
						<Label Grid.Column="1"
							   VerticalOptions="Center"
							   FontFamily="HaasGroteskMedium"
							   FontSize="13"
							   Text="{Binding ProgressText}"
							   TextColor="{DynamicResource ContentPrimaryWL}" />
					</Grid>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<!-- Done when signed; back, or try again, when not -->
		<Border Grid.Row="1"
				Style="{DynamicResource BottomBarBorder}">
			<VerticalStackLayout Padding="{DynamicResource SmallMargins}"
								 Spacing="4">
				<controls:TextButton IsVisible="{Binding IsSignSuccess}"
									 Command="{Binding FinishSigningCommand}"
									 Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize ContractSignDone}" />
				<controls:TextButton IsVisible="{Binding IsSignFailure}"
									 Command="{Binding RetrySigningCommand}"
									 Style="{DynamicResource FilledTextButton}"
									 LabelData="{l:Localize ContractSignTryAgain}" />
				<controls:TextButton IsVisible="{Binding IsSignFailure}"
									 Command="{Binding FinishSigningCommand}"
									 Style="{DynamicResource TransparentTextButton}"
									 LabelData="{l:Localize Back}" />
			</VerticalStackLayout>
		</Border>
	</Grid>
</views:BaseViewContractView>
