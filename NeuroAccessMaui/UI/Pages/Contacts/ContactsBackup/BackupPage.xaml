<?xml version="1.0" encoding="utf-8" ?>
<base:BaseContentPage x:Name="ThisPage"
					  x:Class="NeuroAccessMaui.UI.Pages.Contacts.ContactsBackup.BackupPage"
					  x:DataType="viewmodel:BackupViewModel"
					  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					  xmlns:base="clr-namespace:NeuroAccessMaui.UI.Pages"
					  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Pages.Contacts.ContactsBackup"
					  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls">

	<VisualElement.Resources>
		<Style x:Key="BackupIcon"
			   TargetType="Path">
			<Setter Property="Aspect"
					Value="None" />
			<Setter Property="WidthRequest"
					Value="24" />
			<Setter Property="HeightRequest"
					Value="24" />
			<Setter Property="StrokeThickness"
					Value="2" />
			<Setter Property="StrokeLineCap"
					Value="Round" />
			<Setter Property="StrokeLineJoin"
					Value="Round" />
			<Setter Property="HorizontalOptions"
					Value="Center" />
			<Setter Property="VerticalOptions"
					Value="Center" />
		</Style>

		<Style x:Key="Card"
			   TargetType="Border">
			<Setter Property="StrokeThickness"
					Value="1" />
			<Setter Property="Stroke"
					Value="{DynamicResource SurfaceDividerWL}" />
			<Setter Property="BackgroundColor"
					Value="{DynamicResource SurfaceElevation1WL}" />
			<Setter Property="StrokeShape"
					Value="RoundRectangle 20" />
		</Style>

		<Style x:Key="SectionLabel"
			   TargetType="Label">
			<Setter Property="Margin"
					Value="8,0,0,8" />
			<Setter Property="FontFamily"
					Value="HaasGroteskMedium" />
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="TextColor"
					Value="{DynamicResource ContentSecondaryWL}" />
		</Style>

		<Style x:Key="BodyText"
			   TargetType="Label">
			<Setter Property="FontFamily"
					Value="HaasGroteskRegular" />
			<Setter Property="FontSize"
					Value="15" />
			<Setter Property="LineBreakMode"
					Value="WordWrap" />
			<Setter Property="TextColor"
					Value="{DynamicResource ContentPrimaryWL}" />
		</Style>
	</VisualElement.Resources>

	<Grid RowDefinitions="Auto,*"
		  BackgroundColor="{DynamicResource SurfaceBackgroundWL}">

		<!-- Header: back and title -->
		<Grid Grid.Row="0"
			  ColumnDefinitions="48,*,48"
			  Padding="16,12,16,8"
			  ColumnSpacing="8">
			<controls:TemplatedButton Grid.Column="0"
									  Command="{Binding GoBackCommand}"
									  SemanticProperties.Description="{l:Localize Back}">
				<Grid WidthRequest="48"
					  HeightRequest="48"
					  InputTransparent="True">
					<Path Data="M15 18l-6-6 6-6"
						  Stroke="{DynamicResource ContentPrimaryWL}"
						  Style="{StaticResource BackupIcon}" />
				</Grid>
			</controls:TemplatedButton>
			<Label Grid.Column="1"
				   VerticalOptions="Center"
				   HorizontalTextAlignment="Center"
				   FontFamily="SpaceGroteskBold"
				   FontSize="22"
				   LineBreakMode="TailTruncation"
				   Text="{l:Localize ContactBackupTitle}"
				   TextColor="{DynamicResource ContentPrimaryWL}"
				   SemanticProperties.HeadingLevel="Level1" />
		</Grid>

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Padding="16,8,16,32"
								 Spacing="18">

				<!-- What is kept, where, and what for -->
				<Border Padding="16"
						Style="{StaticResource Card}">
					<Grid ColumnDefinitions="24,*"
						  ColumnSpacing="14">
						<Path VerticalOptions="Start"
							  Data="M12 3l8 3v6c0 4.5-3.4 8.2-8 9.5-4.6-1.3-8-5-8-9.5V6l8-3z M9 12l2 2 4-4"
							  Stroke="{DynamicResource ContentAccessWL}"
							  Style="{StaticResource BackupIcon}" />
						<VerticalStackLayout Grid.Column="1"
											 Spacing="8">
							<Label Text="{l:Localize ContactBackupExplanation}"
								   Style="{StaticResource BodyText}" />
							<Label Text="{l:Localize ContactBackupWhat}"
								   Style="{StaticResource BodyText}" />
							<Label Text="{l:Localize ContactBackupWhy}"
								   Style="{StaticResource BodyText}"
								   TextColor="{DynamicResource ContentSecondaryWL}" />
						</VerticalStackLayout>
					</Grid>
				</Border>

				<!-- The switch, when the contacts were last backed up, and back up now -->
				<Border Padding="16,4"
						Style="{StaticResource Card}">
					<VerticalStackLayout>
						<Grid ColumnDefinitions="*,Auto"
							  MinimumHeightRequest="64"
							  ColumnSpacing="12">
							<VerticalStackLayout VerticalOptions="Center"
												 Padding="0,8">
								<Label FontFamily="HaasGroteskMedium"
									   FontSize="16"
									   LineBreakMode="WordWrap"
									   Text="{l:Localize ContactBackupSwitch}"
									   TextColor="{DynamicResource ContentPrimaryWL}" />
								<Label FontFamily="HaasGroteskRegular"
									   FontSize="14"
									   LineBreakMode="WordWrap"
									   Text="{Binding LastBackupText}"
									   TextColor="{DynamicResource ContentSecondaryWL}" />
							</VerticalStackLayout>
							<Switch Grid.Column="1"
									VerticalOptions="Center"
									MinimumHeightRequest="48"
									MinimumWidthRequest="48"
									IsToggled="{Binding IsEnabled, Mode=TwoWay}"
									OnColor="{DynamicResource ButtonAccessPrimarybgWL}"
									SemanticProperties.Description="{l:Localize ContactBackupSwitch}" />
						</Grid>
						<BoxView HeightRequest="1"
								 Color="{DynamicResource SurfaceDividerWL}" />
						<controls:TemplatedButton Command="{Binding BackupNowCommand}"
												  SemanticProperties.Description="{l:Localize ContactBackupNow}">
							<controls:TemplatedButton.Triggers>
								<Trigger Property="IsEnabled"
										 TargetType="controls:TemplatedButton"
										 Value="False">
									<Setter Property="Opacity"
											Value="0.4" />
								</Trigger>
							</controls:TemplatedButton.Triggers>
							<Grid ColumnDefinitions="24,*"
								  Padding="0,10"
								  MinimumHeightRequest="56"
								  ColumnSpacing="14"
								  InputTransparent="True">
								<Path Data="M12 15V3 M7 8l5-5 5 5 M5 14v6h14v-6"
									  Stroke="{DynamicResource ContentAccessWL}"
									  Style="{StaticResource BackupIcon}" />
								<Label Grid.Column="1"
									   VerticalOptions="Center"
									   FontFamily="HaasGroteskMedium"
									   FontSize="16"
									   LineBreakMode="WordWrap"
									   Text="{l:Localize ContactBackupNow}"
									   TextColor="{DynamicResource ContentAccessWL}" />
							</Grid>
						</controls:TemplatedButton>
					</VerticalStackLayout>
				</Border>

				<!-- Restore: what the backup holds, and restore -->
				<VerticalStackLayout>
					<Label Text="{l:Localize ContactBackupRestoreTitle}"
						   Style="{StaticResource SectionLabel}"
						   SemanticProperties.HeadingLevel="Level2" />
					<Border Padding="16"
							Style="{StaticResource Card}">
						<VerticalStackLayout Spacing="12">
							<Label Text="{Binding BackupText}"
								   Style="{StaticResource BodyText}" />
							<ActivityIndicator IsVisible="{Binding IsWorking}"
											   IsRunning="{Binding IsWorking}"
											   HorizontalOptions="Center"
											   Color="{DynamicResource ContentPrimaryWL}" />
							<controls:TemplatedButton IsVisible="{Binding HasBackup}"
													  Command="{Binding RestoreCommand}"
													  SemanticProperties.Description="{l:Localize ContactBackupRestore}">
								<controls:TemplatedButton.Triggers>
									<Trigger Property="IsEnabled"
											 TargetType="controls:TemplatedButton"
											 Value="False">
										<Setter Property="Opacity"
												Value="0.4" />
									</Trigger>
								</controls:TemplatedButton.Triggers>
								<Border Padding="16,10"
										MinimumHeightRequest="48"
										InputTransparent="True"
										StrokeThickness="0"
										BackgroundColor="{DynamicResource ButtonAccessPrimarybgWL}"
										StrokeShape="RoundRectangle 14">
									<Label HorizontalTextAlignment="Center"
										   VerticalOptions="Center"
										   FontFamily="HaasGroteskMedium"
										   FontSize="16"
										   LineBreakMode="WordWrap"
										   Text="{l:Localize ContactBackupRestore}"
										   TextColor="White" />
								</Border>
							</controls:TemplatedButton>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

				<!-- Delete the backup -->
				<Border IsVisible="{Binding HasBackup}"
						Padding="0,4"
						Style="{StaticResource Card}">
					<controls:TemplatedButton Command="{Binding DeleteCommand}"
											  SemanticProperties.Description="{l:Localize ContactBackupDelete}">
						<controls:TemplatedButton.Triggers>
							<Trigger Property="IsEnabled"
									 TargetType="controls:TemplatedButton"
									 Value="False">
								<Setter Property="Opacity"
										Value="0.4" />
							</Trigger>
						</controls:TemplatedButton.Triggers>
						<Grid ColumnDefinitions="24,*"
							  Padding="16,10"
							  MinimumHeightRequest="56"
							  ColumnSpacing="14"
							  InputTransparent="True">
							<Path Data="M4 7h16 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3"
								  Stroke="{DynamicResource TnPDangerContentWL}"
								  Style="{StaticResource BackupIcon}" />
							<Label Grid.Column="1"
								   VerticalOptions="Center"
								   FontFamily="HaasGroteskMedium"
								   FontSize="16"
								   LineBreakMode="WordWrap"
								   Text="{l:Localize ContactBackupDelete}"
								   TextColor="{DynamicResource TnPDangerContentWL}" />
						</Grid>
					</controls:TemplatedButton>
				</Border>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</base:BaseContentPage>
