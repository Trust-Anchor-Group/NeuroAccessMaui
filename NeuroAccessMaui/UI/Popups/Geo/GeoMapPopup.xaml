<?xml version="1.0" encoding="UTF-8" ?>
<base:BasePopup x:Class="NeuroAccessMaui.UI.Popups.Geo.GeoMapPopup"
				x:DataType="viewmodel:GeoMapViewModel"
				xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
				xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
				xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
				xmlns:base="clr-namespace:NeuroAccessMaui.UI.Popups"
				xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
				xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Popups.Geo"
				xmlns:maps="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui">
	<!-- The place is the point under the pin in the middle; the map moves under it. -->
	<Grid RowDefinitions="Auto,*,Auto"
		  RowSpacing="{DynamicResource MediumSpacing}"
		  HeightRequest="520">
		<Label Grid.Row="0"
			   Text="{l:Localize ParameterPickOnMap}"
			   Style="{DynamicResource PageTitleLabel}" />

		<Border Grid.Row="1"
				StrokeShape="RoundRectangle 16"
				StrokeThickness="0">
			<Grid>
				<maps:MapControl x:Name="GeoMapControl" />
				<!-- The pin. Its tip is at the middle of the map. -->
				<controls:SvgView Source="kyc_location.svg"
								  WidthRequest="36"
								  HeightRequest="36"
								  TranslationY="-18"
								  HorizontalOptions="Center"
								  VerticalOptions="Center"
								  InputTransparent="True"
								  TintColor="{DynamicResource ButtonAccessPrimarybgWL}" />
			</Grid>
		</Border>

		<Grid Grid.Row="2"
			  ColumnDefinitions="*,*"
			  ColumnSpacing="{DynamicResource SmallSpacing}">
			<controls:TextButton Grid.Column="0"
								 Style="{DynamicResource SecondaryButton}"
								 LabelData="{l:Localize Cancel}"
								 Command="{Binding CancelCommand}" />
			<controls:TextButton Grid.Column="1"
								 Style="{DynamicResource PrimaryButton}"
								 LabelData="{l:Localize Confirm}"
								 Command="{Binding ConfirmCommand}" />
		</Grid>
	</Grid>
</base:BasePopup>
