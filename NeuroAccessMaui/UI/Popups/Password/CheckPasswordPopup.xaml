<?xml version="1.0" encoding="UTF-8" ?>
<popups:BasePopup x:Class="NeuroAccessMaui.UI.Popups.Password.CheckPasswordPopup"
                  x:DataType="viewmodel:CheckPasswordViewModel"
                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:automation="clr-namespace:NeuroAccessMaui.UI.Automation"
                  xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
                  xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
                  xmlns:popups="clr-namespace:NeuroAccessMaui.UI.Popups"
                  xmlns:viewmodel="clr-namespace:NeuroAccessMaui.UI.Popups.Password" >
    <ScrollView x:Name="InnerScrollView" VerticalOptions="Center" HorizontalOptions="Fill" AutomationId="{x:Static automation:AutomationIds.PopupSecurityPassword}">
        <VerticalStackLayout Spacing="{DynamicResource MediumSpacing}">
            <Label Style="{DynamicResource SectionTitleLabel}" Text="{l:Localize EnterPassword}"  AutomationId="{x:Static automation:AutomationIds.LabelSecurityPasswordTitle}"/>
            <controls:CompositeEntry x:Name="PasswordEntry" AutomationId="{x:Static automation:AutomationIds.InputSecurityPasswordValue}"
                                     Style="{DynamicResource RegularCompositeEntry}"
                                     EntryData="{Binding PasswordText}"
                                     IsPassword="{Binding IsPasswordHidden}" HeightRequest="48">
                <controls:CompositeEntry.RightView>
                    <controls:TemplatedButton VerticalOptions="Center"
                                              HeightRequest="20"
                                              WidthRequest="20"
                                              Command="{Binding TogglePasswordVisibilityCommand}">
                        <Path Aspect="Uniform"
                              Data="{Binding PasswordVisibilityPathData}"
                              Fill="{DynamicResource ContentPrimaryWL}" />
                    </controls:TemplatedButton>
                </controls:CompositeEntry.RightView>
            </controls:CompositeEntry>
            <controls:TextButton Command="{Binding EnterPasswordCommand}" AutomationId="{x:Static automation:AutomationIds.ButtonSecurityPasswordEnter}"
                                 Style="{DynamicResource FilledTextButton}"
                                 LabelData="{l:Localize Enter}" />
            <controls:TextButton Command="{Binding CancelCommand}" AutomationId="{x:Static automation:AutomationIds.ButtonSecurityPasswordCancel}"
                                 Style="{DynamicResource OutlinedTextButton}"
                                 LabelData="{l:Localize Cancel}" />
        </VerticalStackLayout>
    </ScrollView>
</popups:BasePopup>
