<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- Text styles shared by identity flow pages (KYC form, travel document, capture, application status) -->
	<Style x:Key="IdentityFlowHeaderTitleLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontFamily"
				Value="SpaceGroteskBold" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeXl}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentPrimaryWL}" />
		<Setter Property="MaxLines"
				Value="1" />
		<Setter Property="LineBreakMode"
				Value="TailTruncation" />
	</Style>

	<Style x:Key="IdentityFlowTitleLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontFamily"
				Value="SpaceGroteskBold" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSize6xl}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentPrimaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
		<Setter Property="SemanticProperties.HeadingLevel"
				Value="Level1" />
	</Style>

	<Style x:Key="IdentityFlowSectionTitleLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontFamily"
				Value="SpaceGroteskBold" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeXl}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentPrimaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
		<Setter Property="SemanticProperties.HeadingLevel"
				Value="Level2" />
	</Style>

	<Style x:Key="IdentityFlowBodyLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeLg}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentPrimaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<Style x:Key="IdentityFlowBodySecondaryLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeLg}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentSecondaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<Style x:Key="IdentityFlowCaptionLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeSm}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentSecondaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<Style x:Key="IdentityFlowKeyLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontFamily"
				Value="SpaceGroteskRegular" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeSm}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentSecondaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<Style x:Key="IdentityFlowValueLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontFamily"
				Value="SpaceGroteskMedium" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeLg}" />
		<Setter Property="TextColor"
				Value="{DynamicResource ContentPrimaryWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<Style x:Key="IdentityFlowErrorLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeSm}" />
		<Setter Property="TextColor"
				Value="{DynamicResource TnPDangerContentWL}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<!-- State chip: a small pill for the current stage of a flow -->
	<Style x:Key="IdentityFlowStateChipBorder"
		   ApplyToDerivedTypes="False"
		   TargetType="Border">
		<Setter Property="Padding"
				Value="10,6" />
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPInfobgWL}" />
		<Setter Property="Stroke"
				Value="Transparent" />
		<Setter Property="StrokeShape"
				Value="RoundRectangle 12" />
		<Setter Property="HorizontalOptions"
				Value="Start" />
	</Style>

	<Style x:Key="IdentityFlowStateChipLabel"
		   ApplyToDerivedTypes="False"
		   TargetType="Label">
		<Setter Property="FontFamily"
				Value="SpaceGroteskBold" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeSm}" />
		<Setter Property="TextColor"
				Value="{DynamicResource TnPInfoContentWL}" />
	</Style>

	<!-- Sticky footer: a hairline along the top with rounded corners, fading down the sides -->
	<Style x:Key="IdentityFlowFooterBorder"
		   ApplyToDerivedTypes="False"
		   TargetType="Border">
		<Setter Property="BackgroundColor"
				Value="{DynamicResource NavMenuBody2WL}" />
		<Setter Property="Padding"
				Value="16,16,16,8" />
		<Setter Property="Margin"
				Value="0" />
		<Setter Property="StrokeThickness"
				Value="1" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="16,16,0,0" />
			</Setter.Value>
		</Setter>
		<Setter Property="Stroke">
			<Setter.Value>
				<LinearGradientBrush EndPoint="0,1">
					<GradientStop Color="{DynamicResource NavMenuStroke1WL}"
								  Offset="0.1" />
					<GradientStop Color="Transparent"
								  Offset="0.3" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Cards in the flow: a raised card with a hairline, and tinted cards for errors, warnings, information, and success -->
	<Style x:Key="IdentityFlowCard"
		   ApplyToDerivedTypes="False"
		   TargetType="Border">
		<Setter Property="Padding"
				Value="16" />
		<Setter Property="Margin"
				Value="0" />
		<Setter Property="BackgroundColor"
				Value="{DynamicResource SurfaceElevation1WL}" />
		<Setter Property="Stroke"
				Value="{DynamicResource SurfaceDividerWL}" />
		<Setter Property="StrokeThickness"
				Value="1" />
		<Setter Property="StrokeShape"
				Value="RoundRectangle 16" />
	</Style>

	<Style x:Key="IdentityFlowErrorCard"
		   ApplyToDerivedTypes="False"
		   TargetType="Border"
		   BasedOn="{StaticResource IdentityFlowCard}">
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPDangerbgWL}" />
		<Setter Property="Stroke"
				Value="Transparent" />
		<Setter Property="StrokeThickness"
				Value="0" />
	</Style>

	<Style x:Key="IdentityFlowWarningCard"
		   ApplyToDerivedTypes="False"
		   TargetType="Border"
		   BasedOn="{StaticResource IdentityFlowCard}">
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPWarningbgWL}" />
		<Setter Property="Stroke"
				Value="Transparent" />
		<Setter Property="StrokeThickness"
				Value="0" />
	</Style>

	<Style x:Key="IdentityFlowInfoCard"
		   ApplyToDerivedTypes="False"
		   TargetType="Border"
		   BasedOn="{StaticResource IdentityFlowCard}">
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPInfobgWL}" />
		<Setter Property="Stroke"
				Value="Transparent" />
		<Setter Property="StrokeThickness"
				Value="0" />
	</Style>

	<Style x:Key="IdentityFlowSuccessCard"
		   ApplyToDerivedTypes="False"
		   TargetType="Border"
		   BasedOn="{StaticResource IdentityFlowCard}">
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPSuccessbgWL}" />
		<Setter Property="Stroke"
				Value="Transparent" />
		<Setter Property="StrokeThickness"
				Value="0" />
	</Style>

	<!-- Round icon bubble shown before a card or section title -->
	<Style x:Key="IdentityFlowIconBubble"
		   ApplyToDerivedTypes="False"
		   TargetType="Border">
		<Setter Property="WidthRequest"
				Value="36" />
		<Setter Property="HeightRequest"
				Value="36" />
		<Setter Property="Padding"
				Value="8" />
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPSuccessbgWL}" />
		<Setter Property="StrokeThickness"
				Value="0" />
		<Setter Property="StrokeShape"
				Value="Ellipse" />
		<Setter Property="VerticalOptions"
				Value="Center" />
	</Style>

</ResourceDictionary>
