<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					xmlns:objectModel="clr-namespace:NeuroAccessMaui.UI.Pages.Contracts.ObjectModel"
					xmlns:controls="clr-namespace:NeuroAccessMaui.UI.Controls"
					xmlns:converters="clr-namespace:NeuroAccessMaui.UI.Converters"
					xmlns:extended="clr-namespace:NeuroAccessMaui.UI.Controls.Extended"
					xmlns:ui="clr-namespace:NeuroAccessMaui.UI"
					xmlns:l="clr-namespace:NeuroAccessMaui.Services.Localization"
					xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

	<converters:HyphenIfEmpty x:Key="HyphenIfEmptyConverter" />

	<!-- Styles -->
	<Style x:Key="ParameterItemTitleLabel"
		   TargetType="Label"
		   BaseResourceKey="BoldItemTitleLabel">
		<Setter Property="TextColor"
				Value="{DynamicResource ContentSecondaryWL}" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeMd}" />
		<Setter Property="FontFamily"
				Value="HaasGroteskRegular" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
		<Setter Property="VerticalTextAlignment"
				Value="Center" />
		<Setter Property="HorizontalTextAlignment"
				Value="Start" />
	</Style>

	<Style x:Key="ParameterItemValueLabel"
		   TargetType="Label">
		<Setter Property="TextColor"
				Value="{DynamicResource ContentPrimaryWL}" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeMd}" />
		<Setter Property="FontFamily"
				Value="SpaceGroteskSemiBold" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
		<Setter Property="VerticalTextAlignment"
				Value="Center" />
	</Style>

	<!-- Which values are allowed, under an input -->
	<Style x:Key="ParameterHintLabel"
		   TargetType="Label">
		<Setter Property="TextColor"
				Value="{DynamicResource ContentSecondaryWL}" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeSm}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<!-- Why a value isn't accepted, for inputs that don't show it themselves -->
	<Style x:Key="ParameterErrorLabel"
		   TargetType="Label">
		<Setter Property="TextColor"
				Value="{DynamicResource InputFieldsContentDangerv500}" />
		<Setter Property="FontSize"
				Value="{StaticResource FontSizeSm}" />
		<Setter Property="LineBreakMode"
				Value="WordWrap" />
	</Style>

	<!-- A small label that says where a value comes from, such as "Calculated" -->
	<Style x:Key="ParameterSourceChip"
		   TargetType="Border">
		<Setter Property="StrokeShape"
				Value="RoundRectangle 12" />
		<Setter Property="StrokeThickness"
				Value="0" />
		<Setter Property="Padding"
				Value="8,2" />
		<Setter Property="BackgroundColor"
				Value="{DynamicResource TnPInfobgWL}" />
		<Setter Property="HorizontalOptions"
				Value="Start" />
	</Style>

	<!-- BooleanParameterTemplate -->
	<DataTemplate x:Key="BooleanParameterTemplate"
				  x:DataType="objectModel:ObservableBooleanParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<Grid ColumnDefinitions="*, Auto"
					  ColumnSpacing="{DynamicResource MediumSpacing}">
					<VerticalStackLayout Grid.Column="0"
										 VerticalOptions="Center">
						<controls:ParameterHeader Text="{Binding Label}"
												  ShowsInfo="{Binding HasLongDescription}"
												  InfoCommand="{Binding ShowDescriptionCommand}"
												  IsEncrypted="{Binding IsEncrypted}"
												  IsTransient="{Binding IsTransient}"
												  TextColor="{DynamicResource ContentPrimaryWL}" />
						<Label Text="{Binding BooleanText}"
							   Style="{DynamicResource ParameterHintLabel}" />
					</VerticalStackLayout>
					<Switch Grid.Column="1"
							IsToggled="{Binding BooleanValue, Mode=TwoWay}"
							OnColor="{DynamicResource ButtonAccessPrimarybgWL}"
							VerticalOptions="Center" />
				</Grid>
				<Label Text="{Binding ValidationText}"
					   IsVisible="{Binding CanShowError}"
					   Style="{DynamicResource ParameterErrorLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- DateParameterTemplate -->
	<DataTemplate x:Key="DateParameterTemplate"
				  x:DataType="objectModel:ObservableDateParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<controls:CompositeDatePicker Style="{DynamicResource RegularCompositeDatePicker}"
											  IsValid="{Binding IsValid}"
											  ValidationText="{Binding ValidationText}"
											  NullableDate="{Binding DateValue}"
											  Placeholder="{Binding Placeholder}"
											  VerticalOptions="Center" />
				<Label Text="{Binding Hint}"
					   IsVisible="{Binding HasHint}"
					   Style="{DynamicResource ParameterHintLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- NumericalParameterTemplate -->
	<DataTemplate x:Key="NumericalParameterTemplate"
				  x:DataType="objectModel:ObservableNumericalParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<controls:CompositeEntry Style="{DynamicResource RegularCompositeEntry}"
										 EntryData="{Binding DecimalValue, Converter={StaticResource StringToDecimalConverter}}"
										 Keyboard="Numeric"
										 Placeholder="{Binding Placeholder}"
										 VerticalOptions="Center"
										 IsValid="{Binding IsValid}"
										 ValidationText="{Binding ValidationText}">
					<!-- The unit or currency the number is in, inside the field -->
					<controls:CompositeEntry.RightView>
						<Border StrokeShape="RoundRectangle 6"
								StrokeThickness="0"
								Padding="8,3"
								BackgroundColor="{DynamicResource SurfaceDividerWL}"
								VerticalOptions="Center"
								IsVisible="{Binding HasUnit}">
							<Label Text="{Binding Unit}"
								   FontFamily="HaasGroteskMedium"
								   FontSize="13"
								   TextColor="{DynamicResource ContentSecondaryWL}" />
						</Border>
					</controls:CompositeEntry.RightView>
				</controls:CompositeEntry>
				<Label Text="{Binding Hint}"
					   IsVisible="{Binding HasHint}"
					   Style="{DynamicResource ParameterHintLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- StringParameterTemplate -->
	<DataTemplate x:Key="StringParameterTemplate"
				  x:DataType="objectModel:ObservableStringParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<controls:CompositeEntry Style="{DynamicResource RegularCompositeEntry}"
										 EntryData="{Binding StringValue, Mode=TwoWay}"
										 Keyboard="Text"
										 Placeholder="{Binding Placeholder}"
										 MaxLength="{Binding MaxLength}"
										 VerticalOptions="Center"
										 IsValid="{Binding IsValid}"
										 ValidationText="{Binding ValidationText}" />
				<Grid ColumnDefinitions="*, Auto"
					  IsVisible="{Binding HasHintOrCounter}">
					<Label Grid.Column="0"
						   Text="{Binding Hint}"
						   IsVisible="{Binding HasHint}"
						   Style="{DynamicResource ParameterHintLabel}" />
					<!-- How long the text is, when the contract limits its length -->
					<Label Grid.Column="1"
						   Text="{Binding LengthCounter}"
						   IsVisible="{Binding HasLengthCounter}"
						   Style="{DynamicResource ParameterHintLabel}" />
				</Grid>
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- TimeParameterTemplate -->
	<DataTemplate x:Key="TimeParameterTemplate"
				  x:DataType="objectModel:ObservableTimeParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<controls:CompositeInputView Style="{DynamicResource BaseCompositeInputView}"
											 IsValid="{Binding IsValid}"
											 ValidationText="{Binding ValidationText}">
					<controls:CompositeInputView.CenterView>
						<TimePicker Time="{Binding TimeSpanValue, Mode=TwoWay}"
									BackgroundColor="Transparent"
									TextColor="{DynamicResource ContentPrimaryWL}"
									VerticalOptions="Center"
									FontFamily="HaasGroteskRegular"
									FontSize="{StaticResource FontSizeXl}" />
					</controls:CompositeInputView.CenterView>
				</controls:CompositeInputView>
				<Label Text="{l:Localize ParameterNotSet}"
					   IsVisible="{Binding IsValueMissing}"
					   Style="{DynamicResource ParameterHintLabel}" />
				<Label Text="{Binding Hint}"
					   IsVisible="{Binding HasHint}"
					   Style="{DynamicResource ParameterHintLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- DurationParameterTemplate -->
	<DataTemplate x:Key="DurationParameterTemplate"
				  x:DataType="objectModel:ObservableDurationParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<controls:DurationInput DurationValue="{Binding NullableDurationValue, Mode=TwoWay}"
										AllowNegative="{Binding AllowsNegative}"
										IsValid="{Binding IsValid}" />
				<Label Text="{Binding ValidationText}"
					   IsVisible="{Binding CanShowError}"
					   Style="{DynamicResource ParameterErrorLabel}" />
				<Label Text="{Binding Hint}"
					   IsVisible="{Binding HasHint}"
					   Style="{DynamicResource ParameterHintLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- Unreadable Protected Template -->
	<DataTemplate x:Key="ProtectedParameterTemplate"
				  x:DataType="objectModel:ObservableParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<Grid RowDefinitions="Auto,Auto"
				  ColumnSpacing="{DynamicResource SmallSpacing}">
				<Label Grid.Row="0"
					   Text="{Binding Label}"
					   Style="{DynamicResource ParameterItemTitleLabel}"
					   HorizontalTextAlignment="Start" />
				<controls:ParameterProtectionIndicator Grid.Row="1"
													   IsTransient="{Binding IsTransient}"
													   IsEncrypted="{Binding IsEncrypted}"
													   TransientText="{l:Localize NotAvailable}"
													   IsVisible="{Binding IsProtected}" />
			</Grid>
		</Border>
	</DataTemplate>

	<!-- DefaultParameterTemplate -->
	<DataTemplate x:Key="DefaultParameterTemplate"
				  x:DataType="objectModel:ObservableParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<Label Text="{Binding Value, Converter={StaticResource HyphenIfEmptyConverter}}"
					   Style="{DynamicResource ParameterItemValueLabel}" />
				<Label Text="{Binding ValidationText}"
					   IsVisible="{Binding CanShowError}"
					   Style="{DynamicResource ParameterErrorLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- DateTimeParameterTemplate -->
	<DataTemplate x:Key="DateTimeParameterTemplate"
				  x:DataType="objectModel:ObservableDateTimeParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<!-- Date and time side by side -->
				<Grid ColumnDefinitions="3*,2*"
					  ColumnSpacing="{DynamicResource SmallSpacing}">
					<controls:CompositeDatePicker Grid.Column="0"
												  Style="{DynamicResource RegularCompositeDatePicker}"
												  IsValid="{Binding IsValid}"
												  ValidationText="{Binding ValidationText}"
												  NullableDate="{Binding SelectedDate}"
												  Placeholder="{Binding Placeholder}"
												  VerticalOptions="Start" />

					<controls:CompositeInputView Grid.Column="1"
												 Style="{DynamicResource BaseCompositeInputView}"
												 IsValid="{Binding IsValid}"
												 VerticalOptions="Start">
						<controls:CompositeInputView.CenterView>
							<TimePicker Time="{Binding SelectedTime, Mode=TwoWay}"
										BackgroundColor="Transparent"
										TextColor="{DynamicResource ContentPrimaryWL}"
										VerticalOptions="Center"
										FontFamily="HaasGroteskRegular"
										FontSize="{StaticResource FontSizeXl}">
								<TimePicker.Triggers>
									<DataTrigger TargetType="TimePicker"
												 Binding="{Binding IsValid}"
												 Value="False">
										<Setter Property="TextColor"
												Value="{DynamicResource InputFieldsContentDangerv500}" />
									</DataTrigger>
								</TimePicker.Triggers>
							</TimePicker>
						</controls:CompositeInputView.CenterView>
					</controls:CompositeInputView>
				</Grid>
				<Label Text="{l:Localize ParameterNotSet}"
					   IsVisible="{Binding IsValueMissing}"
					   Style="{DynamicResource ParameterHintLabel}" />
				<Label Text="{Binding Hint}"
					   IsVisible="{Binding HasHint}"
					   Style="{DynamicResource ParameterHintLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- AttachmentParameterTemplate: a file attached to the contract. The app can't attach files yet. -->
	<DataTemplate x:Key="AttachmentParameterTemplate"
				  x:DataType="objectModel:ObservableParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />
				<Label Text="{Binding Value, Converter={StaticResource HyphenIfEmptyConverter}}"
					   Style="{DynamicResource ParameterItemValueLabel}"
					   LineBreakMode="MiddleTruncation" />
				<Label Text="{l:Localize ParameterFilesNotSupported}"
					   Style="{DynamicResource ParameterHintLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- ContractReferenceParameterTemplate: a contract the new one refers to, shown as a small card -->
	<DataTemplate x:Key="ContractReferenceParameterTemplate"
				  x:DataType="objectModel:ObservableContractReferenceParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />

				<!-- The chosen contract -->
				<Border StrokeShape="RoundRectangle 12"
						StrokeThickness="1"
						Stroke="{DynamicResource SurfaceDividerWL}"
						Padding="12,10"
						IsVisible="{Binding HasContract}">
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="12">
						<Border Grid.Column="0"
								WidthRequest="40"
								HeightRequest="40"
								StrokeShape="RoundRectangle 10"
								StrokeThickness="0"
								BackgroundColor="{DynamicResource TnPSuccessbgWL}"
								VerticalOptions="Center">
							<Path Data="{x:Static ui:Geometries.ContractPath}"
								  Fill="{DynamicResource TnPSuccessContentWL}"
								  Aspect="Uniform"
								  WidthRequest="20"
								  HeightRequest="20"
								  HorizontalOptions="Center"
								  VerticalOptions="Center" />
						</Border>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="2"
											 VerticalOptions="Center">
							<Label Text="{Binding ContractTitle}"
								   Style="{DynamicResource ParameterItemValueLabel}"
								   LineBreakMode="TailTruncation"
								   MaxLines="1" />
							<Label Text="{Binding ContractSubtitle}"
								   FontSize="{StaticResource FontSizeXs}"
								   TextColor="{DynamicResource ContentSecondaryWL}"
								   LineBreakMode="TailTruncation"
								   MaxLines="1" />
						</VerticalStackLayout>
						<Label Grid.Column="2"
							   Text="{l:Localize Change}"
							   FontFamily="HaasGroteskMedium"
							   FontSize="{StaticResource FontSizeSm}"
							   TextColor="{DynamicResource ContentAccessWL}"
							   MinimumWidthRequest="48"
							   MinimumHeightRequest="48"
							   HorizontalTextAlignment="End"
							   VerticalTextAlignment="Center"
							   VerticalOptions="Center">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding PickContractReferenceCommand}" />
							</Label.GestureRecognizers>
						</Label>
					</Grid>
				</Border>

				<!-- Nothing chosen yet: a dashed row to choose one -->
				<Border StrokeShape="RoundRectangle 12"
						StrokeThickness="1"
						StrokeDashArray="4,3"
						Stroke="{DynamicResource InputFieldsSurfaceStroke}"
						HeightRequest="48"
						Padding="12,0"
						IsVisible="{Binding HasContract, Converter={mct:InvertedBoolConverter}}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding PickContractReferenceCommand}" />
					</Border.GestureRecognizers>
					<HorizontalStackLayout Spacing="10"
										   VerticalOptions="Center">
						<Path Data="{x:Static ui:Geometries.ContractPath}"
							  Fill="{DynamicResource ContentAccessWL}"
							  Aspect="Uniform"
							  WidthRequest="18"
							  HeightRequest="18"
							  VerticalOptions="Center" />
						<Label Text="{l:Localize SelectContract}"
							   FontFamily="HaasGroteskMedium"
							   FontSize="{StaticResource FontSizeMd}"
							   TextColor="{DynamicResource ContentAccessWL}"
							   VerticalOptions="Center" />
					</HorizontalStackLayout>
				</Border>

				<!-- "Optional", and a link to paste the contract's ID -->
				<HorizontalStackLayout Spacing="16">
					<Label Text="{l:Localize Optional}"
						   Style="{DynamicResource ParameterHintLabel}"
						   VerticalOptions="Center"
						   IsVisible="{Binding IsOptional}" />
					<Label Text="{l:Localize ParameterPasteId}"
						   FontFamily="HaasGroteskMedium"
						   FontSize="{StaticResource FontSizeSm}"
						   TextColor="{DynamicResource ContentAccessWL}"
						   MinimumWidthRequest="48"
						   MinimumHeightRequest="48"
						   VerticalTextAlignment="Center"
						   IsVisible="{Binding CanPasteId}">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding PasteIdCommand}" />
						</Label.GestureRecognizers>
					</Label>
				</HorizontalStackLayout>
				<controls:CompositeEntry Style="{DynamicResource RegularCompositeEntry}"
										 EntryData="{Binding ContractReferenceValue, Mode=TwoWay}"
										 Placeholder="{Binding Placeholder}"
										 IsValid="{Binding IsValid}"
										 IsVisible="{Binding IsPastingId}" />

				<Label Text="{Binding ValidationText}"
					   IsVisible="{Binding CanShowError}"
					   Style="{DynamicResource ParameterErrorLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- GeoParameterTemplate: a place, picked on a map or from the phone's location, never typed -->
	<DataTemplate x:Key="GeoParameterTemplate"
				  x:DataType="objectModel:ObservableGeoParameter">
		<Border Style="{DynamicResource BorderSet}"
				Margin="{DynamicResource MediumLeftRightMargins}">
			<VerticalStackLayout Spacing="{DynamicResource SmallSpacing}">
				<controls:ParameterHeader Text="{Binding Label}"
										  ShowsInfo="{Binding HasLongDescription}"
										  InfoCommand="{Binding ShowDescriptionCommand}"
										  IsEncrypted="{Binding IsEncrypted}"
										  IsTransient="{Binding IsTransient}" />

				<!-- The place on a map, with the allowed area dashed. Tapping it opens the map to pick the place. -->
				<Border StrokeShape="RoundRectangle 12"
						StrokeThickness="0"
						HeightRequest="170"
						IsVisible="{Binding HasMap}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding PickOnMapCommand}" />
					</Border.GestureRecognizers>
					<controls:GeoMapPreview Position="{Binding GeoValue}"
											AreaMin="{Binding AreaMin}"
											AreaMax="{Binding AreaMax}" />
				</Border>

				<Label Text="{Binding GeoText}"
					   FontFamily="SpaceGroteskSemiBold"
					   FontSize="{StaticResource FontSizeLg}"
					   TextColor="{DynamicResource ContentPrimaryWL}">
					<Label.Triggers>
						<DataTrigger TargetType="Label"
									 Binding="{Binding HasGeoValue}"
									 Value="False">
							<Setter Property="TextColor"
									Value="{DynamicResource ContentSecondaryWL}" />
							<Setter Property="FontFamily"
									Value="HaasGroteskRegular" />
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<Label Text="{Binding Hint}"
					   IsVisible="{Binding HasHint}"
					   Style="{DynamicResource ParameterHintLabel}" />
				<Border Style="{StaticResource ParameterSourceChip}"
						IsVisible="{Binding IsContractLocation}">
					<Label Text="{l:Localize ParameterContractPlace}"
						   FontSize="{StaticResource FontSizeSm}"
						   TextColor="{DynamicResource TnPInfoContentWL}" />
				</Border>

				<Grid ColumnDefinitions="*,*"
					  ColumnSpacing="{DynamicResource SmallSpacing}">
					<controls:TextButton Grid.Column="0"
										 LabelData="{l:Localize ParameterPickOnMap}"
										 Style="{DynamicResource SecondaryButton}"
										 Command="{Binding PickOnMapCommand}" />
					<controls:ConditionView Grid.Column="1"
											Condition="{Binding IsCheckinglocation}">
						<controls:ConditionView.True>
							<ActivityIndicator IsRunning="True"
											   VerticalOptions="Center"
											   HorizontalOptions="Center" />
						</controls:ConditionView.True>
						<controls:ConditionView.False>
							<controls:TextButton LabelData="{l:Localize UseCurrentLocation}"
												 Style="{DynamicResource SecondaryButton}"
												 Command="{Binding SetCurrentLocationCommand}" />
						</controls:ConditionView.False>
					</controls:ConditionView>
				</Grid>

				<Label Text="{Binding ValidationText}"
					   IsVisible="{Binding CanShowError}"
					   Style="{DynamicResource ParameterErrorLabel}" />
			</VerticalStackLayout>
		</Border>
	</DataTemplate>

	<!-- One value: what it is on the left, the value on the right. Notes such as "Hidden from you" are dimmed, and a
		 value that opens a contract or a place is a link. -->
	<DataTemplate x:Key="ParameterRowTemplate"
				  x:DataType="objectModel:ObservableParameter">
		<Grid ColumnDefinitions="4*,6*"
			  ColumnSpacing="12"
			  Padding="16,12"
			  MinimumHeightRequest="48"
			  BackgroundColor="{DynamicResource SurfaceElevation1WL}">
			<Grid.GestureRecognizers>
				<TapGestureRecognizer Command="{Binding RowCommand}" />
			</Grid.GestureRecognizers>
			<Label Grid.Column="0"
				   Text="{Binding Label}"
				   FontSize="{StaticResource FontSizeSm}"
				   TextColor="{DynamicResource ContentSecondaryWL}"
				   LineBreakMode="WordWrap"
				   VerticalOptions="Center" />
			<!-- A hidden value: a lock and a short note -->
			<HorizontalStackLayout Grid.Column="1"
								   Spacing="5"
								   HorizontalOptions="End"
								   VerticalOptions="Center"
								   IsVisible="{Binding RowShowsLock}">
				<Path Data="{x:Static ui:Geometries.LockPath}"
					  Fill="{DynamicResource ContentSecondaryWL}"
					  Aspect="Uniform"
					  WidthRequest="14"
					  HeightRequest="14"
					  VerticalOptions="Center" />
				<Label Text="{Binding RowValue}"
					   FontSize="13"
					   TextColor="{DynamicResource ContentSecondaryWL}"
					   VerticalOptions="Center" />
			</HorizontalStackLayout>
			<!-- A value, which wraps when it is long -->
			<Grid Grid.Column="1"
				  ColumnDefinitions="*,Auto"
				  ColumnSpacing="4"
				  VerticalOptions="Center"
				  IsVisible="{Binding RowShowsLock, Converter={mct:InvertedBoolConverter}}">
				<Label Grid.Column="0"
					   Text="{Binding RowValue}"
					   FontFamily="SpaceGroteskSemiBold"
					   FontSize="{StaticResource FontSizeMd}"
					   TextColor="{DynamicResource ContentPrimaryWL}"
					   HorizontalTextAlignment="End"
					   LineBreakMode="WordWrap"
					   VerticalOptions="Center">
					<Label.Triggers>
						<DataTrigger TargetType="Label"
									 Binding="{Binding RowIsMuted}"
									 Value="True">
							<Setter Property="FontFamily"
									Value="HaasGroteskRegular" />
							<Setter Property="FontSize"
									Value="{StaticResource FontSizeSm}" />
							<Setter Property="TextColor"
									Value="{DynamicResource ContentSecondaryWL}" />
						</DataTrigger>
						<DataTrigger TargetType="Label"
									 Binding="{Binding RowIsLink}"
									 Value="True">
							<Setter Property="TextColor"
									Value="{DynamicResource ContentAccessWL}" />
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<Label Grid.Column="1"
					   Text="›"
					   FontFamily="SpaceGroteskSemiBold"
					   FontSize="{StaticResource FontSizeXl}"
					   TextColor="{DynamicResource ContentAccessWL}"
					   VerticalOptions="Center"
					   IsVisible="{Binding RowIsLink}" />
			</Grid>
		</Grid>
	</DataTemplate>

	<!-- A place: a small map, the coordinates, and a link that opens the map -->
	<DataTemplate x:Key="GeoParameterRowTemplate"
				  x:DataType="objectModel:ObservableGeoParameter">
		<Grid ColumnDefinitions="Auto,*"
			  ColumnSpacing="12"
			  Padding="12"
			  BackgroundColor="{DynamicResource SurfaceElevation1WL}">
			<Border Grid.Column="0"
					WidthRequest="72"
					HeightRequest="72"
					StrokeShape="RoundRectangle 10"
					StrokeThickness="0"
					VerticalOptions="Center"
					IsVisible="{Binding HasGeoValue}">
				<controls:GeoMapPreview Position="{Binding GeoValue}"
										AreaMin="{Binding AreaMin}"
										AreaMax="{Binding AreaMax}"
										PinSize="22" />
			</Border>
			<VerticalStackLayout Grid.Column="1"
								 Spacing="3"
								 VerticalOptions="Center">
				<Label Text="{Binding Label}"
					   FontSize="13"
					   TextColor="{DynamicResource ContentSecondaryWL}" />
				<Label Text="{Binding RowValue}"
					   FontFamily="SpaceGroteskSemiBold"
					   FontSize="{StaticResource FontSizeMd}"
					   TextColor="{DynamicResource ContentPrimaryWL}">
					<Label.Triggers>
						<DataTrigger TargetType="Label"
									 Binding="{Binding RowIsMuted}"
									 Value="True">
							<Setter Property="FontFamily"
									Value="HaasGroteskRegular" />
							<Setter Property="FontSize"
									Value="{StaticResource FontSizeSm}" />
							<Setter Property="TextColor"
									Value="{DynamicResource ContentSecondaryWL}" />
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<HorizontalStackLayout Spacing="8">
					<Border StrokeShape="RoundRectangle 6"
							StrokeThickness="0"
							Padding="6,2"
							BackgroundColor="{DynamicResource SurfaceElevation2WL}"
							VerticalOptions="Center"
							IsVisible="{Binding IsContractLocation}">
						<Label Text="{l:Localize ParameterContractPlace}"
							   FontFamily="HaasGroteskMedium"
							   FontSize="11"
							   TextColor="{DynamicResource ContentAccessWL}" />
					</Border>
					<Label Text="{l:Localize ParameterOpenMap}"
						   FontFamily="HaasGroteskMedium"
						   FontSize="13"
						   TextColor="{DynamicResource ContentAccessWL}"
						   MinimumHeightRequest="48"
						   MinimumWidthRequest="48"
						   VerticalTextAlignment="Center"
						   VerticalOptions="Center"
						   IsVisible="{Binding HasGeoValue}">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding OpenMapCommand}" />
						</Label.GestureRecognizers>
					</Label>
				</HorizontalStackLayout>
			</VerticalStackLayout>
		</Grid>
	</DataTemplate>

	<!-- Places get a map; everything else, and a place that is hidden, gets a plain row -->
	<objectModel:ParameterTemplateSelector x:Key="ParameterRowSelector"
										   GeoTemplate="{StaticResource GeoParameterRowTemplate}"
										   ProtectedTemplate="{StaticResource ParameterRowTemplate}"
										   DefaultTemplate="{StaticResource ParameterRowTemplate}" />

</ResourceDictionary>
