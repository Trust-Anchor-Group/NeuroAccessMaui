<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="DevStorybook.Controls.FullscreenPreviewHost"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid AutomationId="storybook_fullscreen_preview">
        <ContentView x:Name="PreviewContentHost" />

        <Button x:Name="ExitGestureArea"
                WidthRequest="64"
                HeightRequest="64"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Padding="0"
                BorderWidth="0"
                BackgroundColor="Transparent"
                Text=""
                AutomationId="storybook_fullscreen_exit"
                InputTransparent="False"
                AutomationProperties.IsInAccessibleTree="False" />
    </Grid>
</ContentView>
