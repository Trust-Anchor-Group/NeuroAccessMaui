<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="DevStorybook.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="{DynamicResource SurfaceElevation1WL}" />
                <Setter Property="BarTextColor" Value="{DynamicResource ContentPrimaryWL}" />
            </Style>
            <Style x:Key="StoryCardButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceElevation1WL}" />
                <Setter Property="TextColor" Value="{DynamicResource ContentPrimaryWL}" />
                <Setter Property="FontFamily" Value="SpaceGroteskSemiBold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
