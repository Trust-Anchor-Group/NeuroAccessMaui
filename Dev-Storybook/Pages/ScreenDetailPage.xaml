<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DevStorybook.Pages.ScreenDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DevStorybook.ViewModels"
             x:DataType="viewmodels:ScreenDetailViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22"
                             AutomationId="{Binding AutomationId}">
            <VerticalStackLayout Spacing="5">
                <Label Style="{DynamicResource PageTitleLabel}" Text="{Binding Title}" />
                <Label FontSize="12" Text="{Binding Breadcrumb}" TextColor="{DynamicResource ContentSecondaryWL}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="9">
                <Label Style="{DynamicResource SectionTitleLabel}" Text="PREVIEW" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FullScreenStories}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StoryListItemViewModel">
                            <Button Style="{DynamicResource StoryCardButton}"
                                    AutomationId="{Binding AutomationId}"
                                    Text="Full Screen"
                                    Command="{Binding OpenCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="9">
                <Label Style="{DynamicResource SectionTitleLabel}" Text="STATES" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding StateStories}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StoryListItemViewModel">
                            <Button Style="{DynamicResource StoryCardButton}"
                                    AutomationId="{Binding AutomationId}"
                                    Text="{Binding Name}"
                                    Command="{Binding OpenCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasComponents}" Spacing="9">
                <Label Style="{DynamicResource SectionTitleLabel}" Text="COMPONENTS" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ComponentStories}" Spacing="9">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StoryListItemViewModel">
                            <Button Style="{DynamicResource StoryCardButton}"
                                    AutomationId="{Binding AutomationId}"
                                    Text="{Binding Name}"
                                    Command="{Binding OpenCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
